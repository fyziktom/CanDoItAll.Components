{
  "name": "candoitall-components-tailwind",
  "private": true,
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.7",
    "tailwindcss": "^4.1.7"
  },
  "scripts": {
    "build": "npm run build:baselib && npm run build:sandbox",
    "build:baselib": "tailwindcss -i ./input.css -o ../src/CanDoItAll.Components.BaseLib/wwwroot/css/output.css",
    "build:sandbox": "tailwindcss -i ./sandbox-input.css -o ../src/CanDoItAll.Components.Sandbox/wwwroot/tailwind-sandbox.css",
    "watch": "tailwindcss -i ./input.css -o ../src/CanDoItAll.Components.BaseLib/wwwroot/css/output.css --watch"
  }
}
