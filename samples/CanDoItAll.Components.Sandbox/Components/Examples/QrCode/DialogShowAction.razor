@namespace CanDoItAll.Components.Sandbox.Components.Examples.QrCode

<QrCodeButton Payload="@(new QrCodePayload(Payload, QrPayloadKind.Generic, "Component repository", Caption))"
              Label="Show QR dialog"
              TestId="sandbox-qr-dialog-button" />

@code {
