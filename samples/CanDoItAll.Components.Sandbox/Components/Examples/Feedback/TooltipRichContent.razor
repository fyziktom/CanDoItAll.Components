@namespace CanDoItAll.Components.Sandbox.Components.Examples.Feedback

<span data-testid="sandbox-feedback-tooltip-rich-trigger">
                                <TooltipTarget Position="@(TooltipPosition.Bottom)"
                                               TestId="sandbox-feedback-tooltip-rich">
                                    <TooltipContent>
                                        <div class="space-y-1 text-left">
                                            <p class="m-0 font-semibold">Rich tooltip content</p>
                                            <p class="m-0">The tooltip host can render any markup passed to it, not just plain strings.</p>
                                        </div>
                                    </TooltipContent>
                                    <ChildContent>
                                        <Button Text="Rich content" Icon="info" Tone="@(ButtonTone.Default)"
                                                Variant="@(Variant.Outlined)" />
                                    </ChildContent>
                                </TooltipTarget>
                            </span>
