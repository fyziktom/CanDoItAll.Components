@namespace CanDoItAll.Components.Sandbox.Components.Examples.Feedback
@inject NotificationService NotificationService

<Cluster Gap="LayoutGap.Medium">
    <Button Text="Info toast"
            ButtonStyle="ButtonStyle.Light"
            Variant="Variant.Outlined"
            Click="@(() => NotificationService.Notify(NotificationSeverity.Info, "Sandbox refreshed", "The current group examples have been reloaded for review."))" />
    <Button Text="Success toast"
            Click="@(() => NotificationService.Notify(NotificationSeverity.Success, "Screenshot saved", "The desktop proof image is ready for validation.", position: NotificationPosition.TopCenter))" />
    <Button Text="Warning toast"
            ButtonStyle="ButtonStyle.Warning"
            Variant="Variant.Outlined"
            Click="@(() => NotificationService.Notify(NotificationSeverity.Warning, "Review needed", "The mobile proof still has a spacing concern to resolve.", position: NotificationPosition.BottomLeft))" />
    <Button Text="Clear toasts"
            ButtonStyle="ButtonStyle.Danger"
            Variant="Variant.Text"
            Click="@(() => NotificationService.Clear())" />
</Cluster>
