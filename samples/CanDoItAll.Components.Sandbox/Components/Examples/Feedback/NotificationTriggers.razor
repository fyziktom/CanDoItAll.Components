@namespace CanDoItAll.Components.Sandbox.Components.Examples.Feedback
@inject NotificationService NotificationService

<Cluster Gap="LayoutGap.Small" data-testid="sandbox-feedback-notification-triggers">
    <Button Text="Success toast" Icon="check_circle" ButtonStyle="@(ButtonStyle.Success)" Variant="@(Variant.Outlined)"
            Click="ShowSuccessToast" />
    <Button Text="Warning toast" Icon="warning" ButtonStyle="@(ButtonStyle.Warning)" Variant="@(Variant.Outlined)"
            Click="ShowWarningToast" />
    <Button Text="Error toast" Icon="error" ButtonStyle="@(ButtonStyle.Danger)" Variant="@(Variant.Outlined)"
            Click="ShowErrorToast" />
</Cluster>

@code {
    private void ShowSuccessToast() => NotificationService.Success("Feedback saved", "The reviewer queue picked up your latest change.", position: NotificationPosition.BottomCenter);
    private void ShowWarningToast() => NotificationService.Warning("Needs a second look", "Dense and mobile variants still need a closer proof pass.", position: NotificationPosition.BottomCenter);
    private void ShowErrorToast() => NotificationService.Error("Could not refresh", "The status summary failed to refresh. Try again.", position: NotificationPosition.BottomCenter);
}
