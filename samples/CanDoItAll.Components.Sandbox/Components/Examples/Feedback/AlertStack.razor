@namespace CanDoItAll.Components.Sandbox.Components.Examples.Feedback

<div class="space-y-3">
    <Alert AlertStyle="@(AlertStyle.Info)">The sandbox route loaded the shared assets and the page scaffold is ready for
        proof review.
    </Alert>
    <Alert AlertStyle="@(AlertStyle.Warning)">Dense proof still needs a screenshot review before the migration can be
        accepted.
    </Alert>
    <Alert AlertStyle="@(AlertStyle.Danger)">Longer explanatory alerts should still remain readable without forcing
        the user to decode an oversized block of red text or lose the rest of the page hierarchy.
    </Alert>
    <Alert AlertStyle="@(AlertStyle.Success)">The standard pass is stable enough to move on to the next proof.
    </Alert>
</div>
