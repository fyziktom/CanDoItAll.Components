@namespace CanDoItAll.Components.Sandbox.Components.Examples.DataVisualization

<DataGrid TItem="DataGridExampleRow"
          Data="@(new List<DataGridExampleRow>
                {
                    new("Shell registry", "groups / routes", "Ready"),
                    new("Canvas contract", "surface / state", "Active")
                })"
          Caption="Component hardening records with status badges">
    <Columns>
        <DataGridColumn TItem="DataGridExampleRow" Property="Title" Title="Surface" />
        <DataGridColumn TItem="DataGridExampleRow" Property="Meta" Title="Scope" />
        <DataGridColumn TItem="DataGridExampleRow" Title="State">
            <Template>
                <StatusBadge Tone="@(context.State == "Ready" ? "success" : "info")" Text="@context.State" />
            </Template>
        </DataGridColumn>
    </Columns>
</DataGrid>
