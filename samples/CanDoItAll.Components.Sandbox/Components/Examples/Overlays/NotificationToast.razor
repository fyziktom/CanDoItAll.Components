@namespace CanDoItAll.Components.Sandbox.Components.Examples.Overlays
@inject NotificationService NotificationService

<Button Text="Show toast" Tone="@(ButtonTone.Success)" Variant="@(Variant.Outlined)" Click="@ShowOverlayToast" data-testid="show-overlay-toast" />

@code {
    private Task ShowOverlayToast()
    {
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Overlay service toast", Detail = "NotificationService rendered this bottom-center toast from the shared layout host.", Duration = 0, Position = NotificationPosition.BottomCenter, TestId = "overlay-service-toast" });
        return Task.CompletedTask;
    }
}
