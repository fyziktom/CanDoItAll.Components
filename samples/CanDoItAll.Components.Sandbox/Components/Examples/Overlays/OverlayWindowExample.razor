@namespace CanDoItAll.Components.Sandbox.Components.Examples.Overlays

<div class="relative min-h-[28rem] overflow-hidden rounded-[1.5rem] border border-chrome-200 bg-white shadow-sm shadow-chrome-200/60" data-cda-overlay-frame data-cda-overlay-container data-testid="sandbox-overlay-window-frame">
    <div class="relative z-[2] flex flex-wrap items-center justify-between gap-3 border-b border-chrome-200 bg-chrome-50/95 px-4 py-3" data-cda-overlay-safe-top data-testid="sandbox-overlay-window-safe-top">
        <div class="min-w-0"><Eyebrow Text="OverlayLib" /><p class="break-words text-sm font-semibold text-chrome-800">Window host frame</p></div>
        <Cluster Gap="LayoutGap.Small"><Button Text="Show window" Tone="@(ButtonTone.Default)" Variant="@(Variant.Outlined)" Click="@ShowOverlayWindow" data-testid="show-overlay-window" /><Button Text="Reset" Tone="@(ButtonTone.Default)" Variant="@(Variant.Outlined)" Click="@ResetOverlayWindow" data-testid="reset-overlay-window" /></Cluster>
    </div>
    <div class="grid min-h-[22rem] gap-4 p-4 md:grid-cols-[minmax(0,1fr)_minmax(14rem,0.65fr)]">
        <div class="min-w-0 space-y-3 rounded-[1rem] border border-dashed border-chrome-300 bg-chrome-50/70 p-4">
            <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Host content remains available" />
            <TextBlock TextStyle="@(TextStyle.Body2)" Value="@OverlayWindowHostCopy" />
            <Cluster Gap="LayoutGap.Small"><StatusBadge Text="Bounded" Tone="success" /><StatusBadge Text="Safe top" Tone="info" /><StatusBadge Text="@OverlayWindowStateLabel" Tone="@OverlayWindowStateTone" /></Cluster>
        </div>
        <div class="min-w-0 space-y-3 rounded-[1rem] border border-chrome-200 bg-white/90 p-4"><TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Frame acceptance" /><div class="sandbox-proof-list"><p>Window geometry must stay inside the bordered frame.</p><p>Header actions must remain icon-sized and reachable.</p><p>Hidden state must return through the shared show action.</p></div></div>
    </div>
    @if (overlayWindowState.IsVisible)
    {
        <OverlayWindow WindowId="sandbox-overlay-window" Title="Inspector window" Kicker="OverlayLib" Summary="@OverlayWindowSummary" TestId="sandbox-overlay-window" State="@overlayWindowState" StateChanged="HandleOverlayWindowStateChanged" DefaultWidth="360" DefaultHeight="300" MinHeight="220" MaxWidth="460" DefaultPlacement="top-right" ContainerSelector="[data-testid='sandbox-overlay-window-frame']" SafeTopSelector="[data-testid='sandbox-overlay-window-safe-top']">
            <ChildContent>
                <Stack GapScale="LayoutGap.Medium">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="@OverlayWindowBodyCopy" />
                    <Alert AlertStyle="@(AlertStyle.Info)">This floating surface is rendered by OverlayLib, while the surrounding sandbox content remains ordinary BaseLib layout.</Alert>
                    <Toolbar data-testid="sandbox-overlay-window-toolbar"><ToolbarRow><ToolbarFields><TextInput Value="@OverlayWindowSearch" ValueChanged="@(value => OverlayWindowSearch = value ?? string.Empty)" ValueExpression="@(() => OverlayWindowSearch)" readonly="true" aria-label="Overlay window search preview" data-testid="sandbox-overlay-window-search" /></ToolbarFields><ToolbarActions><Button Text="Refresh" Tone="@(ButtonTone.Default)" Variant="@(Variant.Outlined)" Disabled="@IsDisabled" /></ToolbarActions></ToolbarRow></Toolbar>
                    <Cluster Gap="LayoutGap.Small"><StatusBadge Text="Geometry" Tone="success" /><StatusBadge Text="Minimize" Tone="info" /><StatusBadge Text="Hide/show" Tone="warning" /></Cluster>
                </Stack>
            </ChildContent>
        </OverlayWindow>
    }
</div>

@code {
    private OverlayWindowState overlayWindowState = new();
    private const bool IsDisabled = false;
    private Task HandleOverlayWindowStateChanged(OverlayWindowState state) { overlayWindowState = OverlayWindowState.Normalize(state); return Task.CompletedTask; }
    private Task ShowOverlayWindow() { overlayWindowState = OverlayWindowState.Normalize(new OverlayWindowState { IsVisible = true }); return Task.CompletedTask; }
    private Task ResetOverlayWindow() { overlayWindowState = new OverlayWindowState { IsVisible = true }; return Task.CompletedTask; }
    private const string OverlayWindowSummary = "Longer title and summary copy still need to stay readable without pushing action buttons off the header.";
    private const string OverlayWindowHostCopy = "The host frame deliberately includes enough ordinary page content to prove the floating surface supports the workflow instead of replacing the surrounding page.";
    private const string OverlayWindowBodyCopy = "Overlay body copy can grow, but it should wrap inside the floating surface and leave the header controls reachable.";
    private string OverlayWindowSearch = "Filter overlay evidence and acceptance checkpoints";
    private string OverlayWindowStateLabel => overlayWindowState.IsVisible ? overlayWindowState.IsMinimized ? "Minimized" : "Visible" : "Hidden";
    private string OverlayWindowStateTone => overlayWindowState.IsVisible ? overlayWindowState.IsMinimized ? "warning" : "success" : "warning";
}
