@namespace CanDoItAll.Components.Sandbox.Components.Examples.Overlays

<StickyActionFooter StatusLabel="Overlay state"
                     StatusMessage="Sticky actions should keep the last decision visible without overpowering the page."
                     StatusTone="info">
    <SecondaryActions>
        <Button Text="Save draft" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
    </SecondaryActions>
    <PrimaryActions>
        <Button Text="Approve" />
    </PrimaryActions>
    <DangerActions>
        <Button Text="Reject" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" />
    </DangerActions>
</StickyActionFooter>
