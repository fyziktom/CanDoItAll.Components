@namespace CanDoItAll.Components.Sandbox.Components.Examples.Overlays
@inject DialogService DialogService

<Stack GapScale="LayoutGap.Medium">
    <Cluster Gap="LayoutGap.Small">
        <Button Text="Compact dialog" Tone="@(ButtonTone.Default)" Variant="@(Variant.Outlined)"
                Click="@(() => OpenSizedDialog(ModalSize.Compact))" data-testid="open-compact-dialog" />
        <Button Text="Wide dialog" Tone="@(ButtonTone.Info)" Variant="@(Variant.Outlined)"
                Click="@(() => OpenSizedDialog(ModalSize.Wide))" data-testid="open-wide-dialog" />
        <Button Text="Full dialog" Tone="@(ButtonTone.Secondary)" Variant="@(Variant.Outlined)"
                Click="@(() => OpenSizedDialog(ModalSize.Full))" data-testid="open-full-dialog" />
        <Button Text="Return object" Click="@OpenResultDialog" data-testid="open-result-dialog" />
        <Button Text="Backdrop locked" Tone="@(ButtonTone.Warning)" Variant="@(Variant.Outlined)"
                Click="@OpenBackdropLockedDialog" data-testid="open-backdrop-dialog" />
    </Cluster>
    <Alert AlertStyle="@(AlertStyle.Info)"><span data-testid="dialog-result">@DialogResultText</span></Alert>
</Stack>

@code {
    private const string ApprovedStatus = "Approved";
    private const string ReviewStatus = "Needs review";
    private const string LockedCloseResult = "locked dialog closed";
    private string DialogResultText { get; set; } = "No dialog result returned yet.";

    private Task OpenSizedDialog(ModalSize size)
    {
        var label = ResolveSizeLabel(size);
        var slug = ResolveSizeSlug(size);
        _ = DialogService.OpenAsync($"{label} service dialog", dialog => @<Stack GapScale="LayoutGap.Medium">
                                                                             <TextBlock TextStyle="@(TextStyle.Body2)"
                                                                                        Value="@($"This {label.ToLowerInvariant()} modal is opened by DialogService and rendered through the shared DialogHost.")" />
                                                                             <Alert AlertStyle="@(AlertStyle.Info)">The
                                                                                 modal keeps the existing BaseLib dialog
                                                                                 chrome while the service owns result
                                                                                 completion.
                                                                             </Alert>
                                                                             <Cluster Gap="LayoutGap.Small">
                                                                                 <Button Text="Close"
                                                                                         Tone="@(ButtonTone.Default)"
                                                                                         Variant="@(Variant.Outlined)"
                                                                                         Click="@(() => CloseDialogWithResult(dialog, $"{label} closed"))"
                                                                                         data-testid="close-sized-dialog" />
                                                                             </Cluster>
                                                                         </Stack>, new DialogOptions { Size = size, Subtitle = "Service-driven modal size proof.", TestId = $"service-dialog-{slug}" });
        return Task.CompletedTask;
    }

    private async Task OpenResultDialog()
    {
        var result = await DialogService.OpenAsync("Return a decision object", dialog => @<Stack
                                                                                             GapScale="LayoutGap.Medium">
                                                                                             <TextBlock
                                                                                                 TextStyle="@(TextStyle.Body2)"
                                                                                                 Value="Close this dialog with an object so the caller can continue the workflow with typed data." />
                                                                                             <Cluster
                                                                                                 Gap="LayoutGap.Small">
                                                                                                 <Button
                                                                                                     Text="Return approval"
                                                                                                     Click="@(() => CloseDialogWithDecision(dialog, ApprovedStatus))"
                                                                                                     data-testid="return-dialog-object" />
                                                                                                 <Button
                                                                                                     Text="Return review"
                                                                                                     Tone="@(ButtonTone.Warning)"
                                                                                                     Variant="@(Variant.Outlined)"
                                                                                                     Click="@(() => CloseDialogWithDecision(dialog, ReviewStatus))" />
                                                                                             </Cluster>
                                                                                         </Stack>, new DialogOptions { Size = ModalSize.Medium, Subtitle = "The awaited service call receives the object supplied by dialog.CloseAsync.", TestId = "service-dialog-result" });
        DialogResultText = result is DialogDecision decision ? $"Dialog returned: {decision.Status} from {decision.Source}" : "Dialog returned no object.";
    }

    private Task OpenBackdropLockedDialog()
    {
        _ = DialogService.OpenAsync("Backdrop close disabled", dialog => @<Stack GapScale="LayoutGap.Medium">
                                                                             <TextBlock TextStyle="@(TextStyle.Body2)"
                                                                                        Value="Clicking outside this modal should leave it open. Use the explicit action to close it." />
                                                                             <Button Text="Close locked dialog"
                                                                                     Tone="@(ButtonTone.Warning)"
                                                                                     Variant="@(Variant.Outlined)"
                                                                                     Click="@(() => CloseDialogWithResult(dialog, LockedCloseResult))"
                                                                                     data-testid="close-backdrop-dialog" />
                                                                         </Stack>, new DialogOptions { Size = ModalSize.Compact, CloseOnBackdrop = false, Subtitle = "CloseOnBackdrop is false for this service dialog.", TestId = "service-dialog-backdrop-locked" });
        return Task.CompletedTask;
    }

    private static Task CloseDialogWithResult(DialogReference dialog, object result) => dialog.CloseAsync(result);
    private static Task CloseDialogWithDecision(DialogReference dialog, string status) => dialog.CloseAsync(new DialogDecision(status, "service-demo"));
    private static string ResolveSizeLabel(ModalSize size) => size switch { ModalSize.Compact => "Compact", ModalSize.Wide => "Wide", ModalSize.Full => "Full", _ => "Medium" };
    private static string ResolveSizeSlug(ModalSize size) => size switch { ModalSize.Compact => "compact", ModalSize.Wide => "wide", ModalSize.Full => "full", _ => "medium" };

    private sealed record DialogDecision(string Status, string Source);

}
