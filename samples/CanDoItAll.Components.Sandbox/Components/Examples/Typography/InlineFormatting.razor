@namespace CanDoItAll.Components.Sandbox.Components.Examples.Typography

<div class="space-y-4">
    <TextBlock TextStyle="TextStyle.Body1">
        Component acceptance starts with <strong>clear hierarchy</strong> and <em>calm</em> supporting language.
    </TextBlock>
    <TextBlock TextStyle="TextStyle.Body2">
        Mixed emphasis works inline too &mdash; <strong><em>bold and italic together</em></strong>, or a plain <a href="#typeblock">link</a>.
    </TextBlock>
    <TextBlock TextStyle="TextStyle.Note" Value="A plain Value string like this one is still HTML-encoded, so <strong> tags here would render literally, not as bold." />
</div>
