@namespace CanDoItAll.Components.Sandbox.Components.Examples.Typography

<div class="space-y-4">
    <div class="space-y-1">
        <TextBlock TextStyle="TextStyle.Caption" Value="Default (block)" />
        <SmallText Text="Changes save automatically as you type." />
    </div>

    <div class="space-y-1">
        <TextBlock TextStyle="TextStyle.Caption" Value="Inline" />
        <p>Draft saved <SmallText Inline="true" Text="just now" />.</p>
    </div>

    <div class="space-y-1">
        <TextBlock TextStyle="TextStyle.Caption" Value="Paragraph" />
        <SmallText Paragraph="true" Text="Small print explaining a setting's effect, wrapped in its own paragraph so it never runs into adjacent copy." />
    </div>
</div>
