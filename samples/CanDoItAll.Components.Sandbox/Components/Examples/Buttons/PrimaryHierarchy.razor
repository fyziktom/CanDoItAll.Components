@namespace CanDoItAll.Components.Sandbox.Components.Examples.Buttons

<Cluster Gap="LayoutGap.Medium">
    <Button
        Text="Approve shared component update and publish the acceptance proof bundle" />
    <Button Text="Save draft"
            ButtonStyle="ButtonStyle.Light"
            Variant="Variant.Outlined"
            />
    <Button Text="Request changes"
            ButtonStyle="ButtonStyle.Warning"
            Variant="Variant.Outlined"
            />
    <Button Text="Archive"
            ButtonStyle="ButtonStyle.Danger"
            Variant="Variant.Text"
            />
    <Button Text="Unavailable while approval is pending" Disabled="true" />
</Cluster>
