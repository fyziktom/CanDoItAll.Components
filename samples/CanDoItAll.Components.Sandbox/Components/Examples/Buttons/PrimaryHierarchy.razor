@namespace CanDoItAll.Components.Sandbox.Components.Examples.Buttons

<Cluster Gap="LayoutGap.Medium">
    <Button
        Text="@(ToolbarState?.Scenario == SandboxScenarioKey.LongText ? "Approve shared component update and publish the acceptance proof bundle" : "Approve update")"
        IsBusy="@(ToolbarState?.Scenario == SandboxScenarioKey.LoadingState)"
        Disabled="@(ToolbarState?.Scenario == SandboxScenarioKey.DisabledState)" />
    <Button Text="Save draft"
            ButtonStyle="ButtonStyle.Light"
            Variant="Variant.Outlined"
            Disabled="@(ToolbarState?.Scenario == SandboxScenarioKey.DisabledState)" />
    <Button Text="Request changes"
            ButtonStyle="ButtonStyle.Warning"
            Variant="Variant.Outlined"
            Disabled="@(ToolbarState?.Scenario == SandboxScenarioKey.DisabledState)" />
    <Button Text="Archive"
            ButtonStyle="ButtonStyle.Danger"
            Variant="Variant.Text"
            Disabled="@(ToolbarState?.Scenario == SandboxScenarioKey.DisabledState)" />
</Cluster>

@code {
    [CascadingParameter] public SandboxToolbarState? ToolbarState { get; set; }
}
