@namespace CanDoItAll.Components.Sandbox.Components.Examples.Buttons

<Grid Gap="LayoutGap.Large"
      ColumnTemplate="repeat(auto-fit,minmax(min(100%,16rem),1fr))"
      data-testid="sandbox-actions-icon-badge-surface">
    <div class="space-y-3">
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="Icon-only actions" />
        <Cluster Gap="LayoutGap.Small">
            <Button Icon="visibility" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                    Disabled="@(ToolbarState?.Scenario == SandboxScenarioKey.DisabledState)"
                    data-testid="sandbox-actions-icon-only-view" />
            <Button Icon="download" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Info"
                    Disabled="@(ToolbarState?.Scenario == SandboxScenarioKey.DisabledState)"
                    data-testid="sandbox-actions-icon-only-download" />
            <Button Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger"
                    Disabled="@(ToolbarState?.Scenario == SandboxScenarioKey.DisabledState)"
                    data-testid="sandbox-actions-icon-only-delete" />
        </Cluster>
    </div>
    <div class="space-y-3">
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="Long action label" />
        <Button
            Text="@(ToolbarState?.Scenario == SandboxScenarioKey.LongText ? "Open the acceptance evidence package with a deliberately long label" : "Open acceptance evidence")"
            Icon="rocket_launch" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Info"
            Disabled="@(ToolbarState?.Scenario == SandboxScenarioKey.DisabledState)"
            data-testid="sandbox-actions-long-button" />
    </div>
</Grid>

@code {
    [CascadingParameter] public SandboxToolbarState? ToolbarState { get; set; }
}
