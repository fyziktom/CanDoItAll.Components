@namespace CanDoItAll.Components.Sandbox.Components.Examples.Lists

<div data-testid="sandbox-lists-panel-header">
    <ListPanelHeader Title="Shared records"
                     Description="Records visible to the current workspace."
                     Count="@("12")"
                     HelpText="Records sync from the shared catalog every five minutes.">
        <Actions>
            <Button Text="Add record" Size="ButtonSize.Small" />
        </Actions>
        <Filters>
            <TextInput Value="@panelHeaderFilter" ValueChanged="@(value => panelHeaderFilter = value ?? string.Empty)"
                       ValueExpression="@(() => panelHeaderFilter)"
                       placeholder="Filter records" Immediate="true" />
        </Filters>
    </ListPanelHeader>
</div>

@code { private string panelHeaderFilter = string.Empty; }
