@namespace CanDoItAll.Components.Sandbox.Components.Examples.Lists

<FactTable data-testid="sandbox-lists-fact-table">
    <div class="grid gap-x-4 gap-y-3 md:grid-cols-2">
        <div class="min-w-0">
            <p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-chrome-500">Owner</p>
            <p class="mb-0 mt-1 text-sm text-chrome-700">A. Rossi</p>
        </div>
        <div class="min-w-0">
            <p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-chrome-500">Created</p>
            <p class="mb-0 mt-1 text-sm text-chrome-700">3 months ago</p>
        </div>
        <div class="min-w-0">
            <p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-chrome-500">Status</p>
            <p class="mb-0 mt-1 text-sm text-chrome-700">Active</p>
        </div>
        <div class="min-w-0">
            <p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-chrome-500">Storage used</p>
            <p class="mb-0 mt-1 text-sm text-chrome-700">4.2 GB of 10 GB</p>
        </div>
    </div>
</FactTable>
