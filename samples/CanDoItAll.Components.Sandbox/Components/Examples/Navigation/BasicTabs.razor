@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inherits NavigationExampleBase

<Tabs SelectedIndex="@basicTabIndex"
      SelectedIndexChanged="HandleBasicTabChanged"
      Variant="@(TabsVariant.WorkspacePrimary)"
      BorderMode="@(TabsBorderMode.Soft)"
      Tone="@(TabsTone.Primary)"
      AriaLabel="Basic workspace tabs"
      data-testid="sandbox-navigation-basic-tabs">
    <TabItems>
        <TabsItem Text="Overview" Icon="bars_staggered">
            <TextBlock TextStyle="@(TextStyle.Body2)"
                       Value="The basic tabs setup should feel readable, calm, and clearly selected without needing any special styling tricks." />
        </TabsItem>
        <TabsItem Text="Activity log" Icon="calendar" BadgeText="@ActivityBadgeText">
            <TextBlock TextStyle="@(TextStyle.Body2)"
                       Value="The selected header and content surface should feel like one connected control instead of two disconnected shapes." />
        </TabsItem>
        <TabsItem Text="@EvidenceTabLabel" Icon="circle_info" Disabled="@IsDisabled">
            <TextBlock TextStyle="@(TextStyle.Body2)"
                       Value="Longer supporting labels should stay readable and the disabled state should read clearly instead of making every tab look unavailable." />
        </TabsItem>
    </TabItems>
</Tabs>
