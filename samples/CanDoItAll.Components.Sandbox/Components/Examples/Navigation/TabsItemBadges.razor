@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inherits NavigationExampleBase

<Stack GapScale="LayoutGap.Small">
    <Switch Value="@tabsItemAuditVisible" ValueChanged="@(value => tabsItemAuditVisible = value)" AriaLabel="Show audit tab" />
    <Tabs SelectedIndex="@tabsItemDemoIndex" SelectedIndexChanged="@(index => tabsItemDemoIndex = index)" data-testid="sandbox-navigation-tabs-item">
        <TabItems>
            <TabsItem Text="Overview" />
            <TabsItem Text="Reviewer notes" BadgeText="2" />
            <TabsItem Text="Legacy" Disabled="true" />
            <TabsItem Text="Audit trail" Visible="@tabsItemAuditVisible" />
        </TabItems>
    </Tabs>
</Stack>
