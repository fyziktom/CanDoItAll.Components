@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inherits NavigationExampleBase

<FilterBar ResultText="128 results" data-testid="sandbox-navigation-filter-bar">
    <ChildContent>
        <TextInput Value="@filterBarQuery" ValueChanged="@(value => filterBarQuery = value ?? string.Empty)" ValueExpression="@(() => filterBarQuery)" Immediate="true" placeholder="Search" aria-label="Search" />
        <SelectInput TValue="string" Value="@filterBarScope" ValueChanged="@(value => filterBarScope = value ?? ToolbarScopeAll)" ValueExpression="@(() => filterBarScope)" aria-label="Scope">
            @foreach (var scope in ToolbarScopes)
            {
                <option value="@scope">@scope</option>
            }
        </SelectInput>
    </ChildContent>
    <Actions>
        <Button Text="Reset" Tone="@(ButtonTone.Default)" Variant="@(Variant.Outlined)" Click="@(() => { filterBarQuery = string.Empty; filterBarScope = ToolbarScopeAll; })" />
    </Actions>
</FilterBar>
