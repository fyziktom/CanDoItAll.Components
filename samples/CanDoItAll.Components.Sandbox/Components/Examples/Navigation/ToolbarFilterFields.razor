@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inherits NavigationExampleBase

<Toolbar data-testid="sandbox-navigation-toolbar-fields">
    <ToolbarRow>
        <ToolbarFields>
            <TextInput Value="@toolbarFieldsQuery" ValueChanged="@(value => toolbarFieldsQuery = value ?? string.Empty)" ValueExpression="@(() => toolbarFieldsQuery)" Immediate="true" placeholder="Search records" aria-label="Search records" />
            <SelectInput TValue="string" Value="@toolbarFieldsScope" ValueChanged="@(value => toolbarFieldsScope = value ?? ToolbarScopeAll)" ValueExpression="@(() => toolbarFieldsScope)" aria-label="Field scope">
                @foreach (var scope in ToolbarScopes)
                {
                    <option value="@scope">@scope</option>
                }
            </SelectInput>
        </ToolbarFields>
    </ToolbarRow>
</Toolbar>
