@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inherits NavigationExampleBase

<div class="sandbox-demo-grid--two">
    <div class="w-full min-w-0 max-w-[21rem]" data-testid="tabs-lab-wrap-shell">
        <Tabs SelectedIndex="@wrapTabIndex"
              SelectedIndexChanged="HandleWrapTabChanged"
              BorderMode="@(TabsBorderMode.Soft)"
              Tone="@(TabsTone.Primary)"
              OverflowMode="@(TabsOverflowMode.Wrap)"
              AriaLabel="Wrapping tabs in a narrow column"
              data-testid="tabs-lab-wrap">
            <TabItems>
                <TabsItem Text="@WrapFirstTabLabel" Icon="bars_staggered">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Wrapped tabs should become a tidy multi-row control instead of an accidental broken seam." />
                </TabsItem>
                <TabsItem Icon="circle_info">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="This second tab keeps the missing-title fallback visible in a tighter layout." />
                </TabsItem>
                <TabsItem Text="@WrapThirdTabLabel" BadgeText="beta">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Badges and multi-line labels need to remain aligned even when the row wraps." />
                </TabsItem>
            </TabItems>
        </Tabs>
    </div>

    <div class="w-full min-w-0 max-w-[21rem]" data-testid="tabs-lab-scroll-shell">
        <Tabs SelectedIndex="@scrollTabIndex"
              SelectedIndexChanged="HandleScrollTabChanged"
              BorderMode="@(TabsBorderMode.Soft)"
              Tone="@(TabsTone.Info)"
              OverflowMode="@(TabsOverflowMode.Scroll)"
              AriaLabel="Scrollable tabs in a narrow column"
              data-testid="tabs-lab-scroll">
            <TabItems>
                <TabsItem Text="Overview">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Keep the strip single-line when horizontal movement is easier to understand than wrapping." />
                </TabsItem>
                <TabsItem Text="Automation checkpoints">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Long labels should still be fully visible while the row scrolls." />
                </TabsItem>
                <TabsItem Text="Validation questions">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Keyboard focus and active state should remain strong even when some tabs start off-screen." />
                </TabsItem>
                <TabsItem Text="Regression notes">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="The right edge should not clip the final tab or its hover border." />
                </TabsItem>
                <TabsItem Text="Stakeholder sign-off">
                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="An additional tab keeps the overflow behavior obvious." />
                </TabsItem>
            </TabItems>
        </Tabs>
    </div>
</div>
