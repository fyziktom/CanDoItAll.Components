@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation

<Toolbar>
    <ToolbarRow>
        <ToolbarFields>
            <TextBox Value="@query"
                     ValueChanged="@(value => query = value ?? string.Empty)"
                     Immediate="true"
                     Placeholder="Filter standard navigation"
                     aria-label="Filter standard navigation" />
            <DropDown TValue="string"
                      Data="@Scopes"
                      Value="@scope"
                      ValueChanged="@(value => scope = value ?? Scopes[0])"
                      aria-label="Navigation scope" />
        </ToolbarFields>
        <ToolbarActions>
            <Button Text="Reset"
                    ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Outlined"
                    Click="@(() => { query = string.Empty; scope = Scopes[0]; })" />
        </ToolbarActions>
    </ToolbarRow>
</Toolbar>

@code {
    private static readonly IReadOnlyList<string> Scopes = ["All standard groups", "Navigation only", "Overlay dependencies"];

    private string query = string.Empty;
    private string scope = Scopes[0];
}
