@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inherits NavigationExampleBase

<Tabs SelectedIndex="@verticalTabIndex"
      SelectedIndexChanged="HandleVerticalTabChanged"
      BorderMode="@(TabsBorderMode.Soft)"
      Tone="@(TabsTone.Success)"
      TabPosition="@(TabPosition.Left)"
      AriaLabel="Vertical settings tabs"
      data-testid="tabs-lab-vertical">
    <TabItems>
        <TabsItem Text="General">
            <TextBlock TextStyle="@(TextStyle.Body2)" Value="Vertical tabs should read like a settings rail instead of an unrelated side list." />
        </TabsItem>
        <TabsItem Text="@VerticalNotificationsTabLabel" BadgeText="3">
            <TextBlock TextStyle="@(TextStyle.Body2)" Value="Longer labels still need to align cleanly and keep the panel seam intact." />
        </TabsItem>
        <TabsItem Text="Audit trail" Disabled="true">
            <TextBlock TextStyle="@(TextStyle.Body2)" Value="Disabled items must remain visible while clearly opting out of interaction." />
        </TabsItem>
    </TabItems>
</Tabs>
