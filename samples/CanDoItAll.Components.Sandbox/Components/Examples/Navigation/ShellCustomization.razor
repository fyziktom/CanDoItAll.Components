@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inherits NavigationExampleBase

<div class="sandbox-demo-grid--two">
    <Tabs SelectedIndex="@classTabIndex"
          SelectedIndexChanged="HandleClassTabChanged"
          BorderMode="@(TabsBorderMode.Soft)"
          Tone="@(TabsTone.Secondary)"
          Class="rounded-[1.5rem] border border-violet-200/70 bg-[linear-gradient(135deg,rgba(255,255,255,0.98)_0%,rgba(250,245,255,0.95)_100%)] p-3 shadow-[0_18px_45px_-32px_rgba(88,28,135,0.25)]"
          AriaLabel="Tabs customized with root classes"
          data-testid="tabs-lab-class">
        <TabItems>
            <TabsItem Text="Review queue" Icon="bars_staggered">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="The root Class can add a page-level shell without rewriting the shared tabs structure." />
            </TabsItem>
            <TabsItem Text="Pinned notes" Icon="calendar" BadgeText="4">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="TabsItem can still take extra Tailwind classes for a one-off emphasis treatment." />
            </TabsItem>
            <TabsItem Text="History" Icon="circle_info">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="The variant and tone enums still own the internal spacing and selected-state behavior." />
            </TabsItem>
        </TabItems>
    </Tabs>

    <Tabs SelectedIndex="@workstationTabIndex"
          SelectedIndexChanged="HandleWorkstationTabChanged"
          BorderMode="@(TabsBorderMode.Soft)"
          Class="rounded-[1.6rem] border border-emerald-200/20 bg-[linear-gradient(180deg,rgba(19,38,43,0.98)_0%,rgba(12,28,31,0.96)_100%)] p-4 shadow-[0_24px_56px_-34px_rgba(2,6,23,0.72)]"
          AriaLabel="Workstation shell tabs"
          data-testid="tabs-lab-workstation">
        <TabItems>
            <TabsItem Text="Workbench">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="The workstation variant can be dramatic, but it still needs readable text and a clear active state." />
            </TabsItem>
            <TabsItem Text="Operator queue" BadgeText="5">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="This variant now carries its own local text and surface tokens so it remains readable in isolation." />
            </TabsItem>
            <TabsItem Text="Escalations">
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Use this style when a darker shell is intentional, not as the default tabs example." />
            </TabsItem>
        </TabItems>
    </Tabs>
</div>
