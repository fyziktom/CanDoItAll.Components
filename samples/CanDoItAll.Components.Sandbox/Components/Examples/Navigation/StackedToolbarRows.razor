@namespace CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inherits NavigationExampleBase

<Toolbar data-testid="sandbox-navigation-toolbar-row">
    <ToolbarRow>
        <ToolbarFields>
            <TextInput Value="@toolbarRowsQuery" ValueChanged="@(value => toolbarRowsQuery = value ?? string.Empty)" ValueExpression="@(() => toolbarRowsQuery)" Immediate="true" placeholder="Filter" aria-label="Filter" />
        </ToolbarFields>
    </ToolbarRow>
    <ToolbarRow>
        <ToolbarActions>
            <StatusBadge Text="3 selected" Tone="info" />
            <Button Text="Archive" Tone="@(ButtonTone.Default)" Variant="@(Variant.Outlined)" />
        </ToolbarActions>
    </ToolbarRow>
</Toolbar>
