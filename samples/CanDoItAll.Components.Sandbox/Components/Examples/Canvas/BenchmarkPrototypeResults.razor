@namespace CanDoItAll.Components.Sandbox.Components.Examples.Canvas
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="w-full min-w-0 space-y-4">
    <canvas @ref="prototypeCanvas"
            class="h-[26rem] w-full rounded-[1.75rem] border border-slate-200 bg-slate-950"
            data-testid="canvas-benchmark-prototype-canvas"></canvas>
    <Alert AlertStyle="@(AlertStyle.Light)">The prototype draws node rectangles, titles, links, and group frames. It
        intentionally omits selection mirrors, floating overlays, export, and semantic accessibility layers.
    </Alert>

    @if (BenchmarkState.Result is null)
    {
        <Alert AlertStyle="@(AlertStyle.Light)">Run the benchmark above to capture workbench-versus-prototype
            materialization timings and the explicit go or no-go recommendation.
        </Alert>
    }
    else
    {
        <div class="overflow-x-auto" data-testid="canvas-example-results">
            <table class="min-w-full divide-y divide-chrome-200 text-sm">
                <thead class="bg-chrome-50 text-left text-xs font-semibold uppercase tracking-[0.16em] text-chrome-500">
                <tr>
                    <th class="px-4 py-3">Tier</th>
                    <th class="px-4 py-3">Scene</th>
                    <th class="px-4 py-3">Workbench Avg</th>
                    <th class="px-4 py-3">Prototype Avg</th>
                    <th class="px-4 py-3">Delta</th>
                    <th class="px-4 py-3">Workbench DOM</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-chrome-100 bg-white">
                @foreach (var measurement in BenchmarkState.Result.Tiers)
                {
                    <tr>
                        <td class="px-4 py-3 font-semibold text-chrome-900">@measurement.Label</td>
                        <td class="px-4 py-3 text-chrome-600">@($"{measurement.NodeCount} nodes / {measurement.LinkCount} links")</td>
                        <td class="px-4 py-3 text-chrome-900">@FormatDuration(measurement.RetainedAverageMs)</td>
                        <td class="px-4 py-3 text-chrome-900">@FormatDuration(measurement.CanvasAverageMs)</td>
                        <td class="px-4 py-3">
                            <StatusBadge Text="@FormatDelta(measurement.ImprovementRatio)"
                                         Tone="@(measurement.ImprovementRatio >= 0 ? "success" : "warning")" />
                        </td>
                        <td class="px-4 py-3 text-chrome-600">@measurement.RetainedDomNodeCount.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <Alert AlertStyle="@(AlertStyle.Warning)" data-testid="canvas-benchmark-decision"><strong
                class="font-semibold">@BenchmarkState.Result.Recommendation:</strong><span
                class="ml-2">@BenchmarkState.Result.Summary</span></Alert>
    }
</div>

@code {
    [CascadingParameter] public CanvasBenchmarkShowcaseState BenchmarkState { get; set; } = default!;
    private readonly IReadOnlyList<CanvasBenchmarkSurfaceDefinition> definitions = CanvasBenchmarkSamples.CreateDefinitions();
    private ElementReference prototypeCanvas;
    private IJSObjectReference? module;
    private string? renderedTierKey;

    protected override void OnInitialized()
    {
        BenchmarkState.Changed += HandleBenchmarkStateChanged;
        BenchmarkState.RunRequested += RunBenchmarkAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvasBenchmarkPage.js");
        }

        if (module is not null && !string.Equals(renderedTierKey, BenchmarkState.SelectedTierKey, StringComparison.Ordinal))
        {
            renderedTierKey = BenchmarkState.SelectedTierKey;
            await module.InvokeVoidAsync("renderPrototype", prototypeCanvas, CanvasBenchmarkSamples.GetDefinition(renderedTierKey));
        }
    }

    private async Task<bool> RunBenchmarkAsync()
    {
        if (module is null)
        {
            return false;
        }

        var result = await module.InvokeAsync<CanvasBenchmarkRunResult>("runBenchmarkSuite", prototypeCanvas, definitions, 4);
        BenchmarkState.SetResult(result);
        return true;
    }

    private void HandleBenchmarkStateChanged() => _ = InvokeAsync(StateHasChanged);

    private static string FormatDuration(double value) => $"{value:F2} ms";

    private static string FormatDelta(double value)
    {
        var percent = value * 100d;
        return percent >= 0 ? $"{percent:F1}% faster" : $"{Math.Abs(percent):F1}% slower";
    }

    public async ValueTask DisposeAsync()
    {
        BenchmarkState.Changed -= HandleBenchmarkStateChanged;
        BenchmarkState.RunRequested -= RunBenchmarkAsync;
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

}
