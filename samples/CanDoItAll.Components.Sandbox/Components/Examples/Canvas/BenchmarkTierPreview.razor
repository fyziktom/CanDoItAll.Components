@namespace CanDoItAll.Components.Sandbox.Components.Examples.Canvas

<div class="space-y-4">
    <div class="flex flex-wrap items-center gap-3">
        @foreach (var definition in Definitions)
        {
            <Button Text="@definition.Label"
                    Tone="@(definition.Key == BenchmarkState.SelectedTierKey ? ButtonTone.Primary : ButtonTone.Default)"
                    Variant="@(definition.Key == BenchmarkState.SelectedTierKey ? Variant.Filled : Variant.Outlined)"
                    Click="@(() => BenchmarkState.SelectTier(definition.Key))"
                    data-testid="@($"canvas-benchmark-tier-{definition.Key}")" />
        }
        <Button Text="Run benchmark" Tone="@(ButtonTone.Success)" IsBusy="@BenchmarkState.IsRunning"
                Click="BenchmarkState.RunAsync" data-testid="canvas-benchmark-run" />
        @if (!string.IsNullOrWhiteSpace(BenchmarkState.LastMeasuredLabel))
        {
            <StatusBadge Text="@BenchmarkState.LastMeasuredLabel" Tone="success" />
        }
    </div>

    <SummaryTiles>
        <SummaryTile Label="Nodes"
                     Value="@SelectedDefinition.NodeCount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     HelperText="Typed workbench nodes rendered by both paths." Tone="info" />
        <SummaryTile Label="Links"
                     Value="@SelectedDefinition.LinkCount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     HelperText="Connector count used by the shipped and prototype scenes." Tone="success" />
    </SummaryTiles>

    <div
        class="min-h-[26rem] w-full min-w-0 overflow-hidden rounded-[1.75rem] border border-chrome-200 bg-chrome-50/80 p-3"
        data-testid="canvas-benchmark-retained-preview">
        <CanvasWorkbench Surface="@SelectedDefinition.Surface" />
    </div>
</div>

@code {
    [CascadingParameter] public CanvasBenchmarkShowcaseState BenchmarkState { get; set; } = default!;
    private readonly IReadOnlyList<CanvasBenchmarkSurfaceDefinition> Definitions = CanvasBenchmarkSamples.CreateDefinitions();

    private CanvasBenchmarkSurfaceDefinition SelectedDefinition => CanvasBenchmarkSamples.GetDefinition(BenchmarkState.SelectedTierKey);
}
