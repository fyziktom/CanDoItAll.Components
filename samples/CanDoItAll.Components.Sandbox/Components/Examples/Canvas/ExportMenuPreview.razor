@namespace CanDoItAll.Components.Sandbox.Components.Examples.Canvas

<div class="space-y-4">
    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-slate-500"
       data-testid="calendar-export-status">@calendarExportStatus</p>
    <CalendarExportMenu Snapshot="@Snapshot" />
</div>

@code {
    [CascadingParameter] public SandboxToolbarState? ToolbarState { get; set; }
    private string calendarExportStatus = "No calendar export requested";
    private CanvasCalendarSurface Surface => SandboxCanvasSamples.CreateCalendarSurface(ToolbarState?.Scenario ?? SandboxScenarioKey.Default);

    private CalendarExportMenuSnapshot Snapshot => CalendarExportMenuFactory.Create(Surface);
}
