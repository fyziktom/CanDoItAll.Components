@namespace CanDoItAll.Components.Sandbox.Components.Examples.Canvas

<div class="sandbox-demo-grid sandbox-demo-grid--three">
    <CanvasSceneHostPreview Snapshot="@CanvasSceneHostPreviewFactory.CreateForWorkbench(Surface)" />
    <LayerStackPreview Snapshot="@LayerStackPreviewFactory.CreateForWorkbench()" />
    <ViewportControllerPreview Snapshot="@ViewportControllerPreviewFactory.CreateForWorkbench(Surface)" />
    <SerializationPersistencePackPreview Snapshot="@SerializationPersistencePackPreviewFactory.CreateForWorkbench(Surface)" />
    <TextMeasureServicePreview Snapshot="@TextMeasurePreviewFactory.CreateForWorkbench(Surface)" />
    <JsInteropBridgePreview Snapshot="@JsInteropBridgePreviewFactory.CreateForWorkbench(Surface)" />
    <CommandHistoryStorePreview Snapshot="@CommandHistoryStorePreviewFactory.CreateForWorkbench(Surface)" />
    <AnimationTimelinePreview Snapshot="@AnimationTimelinePreviewFactory.CreateForWorkbench(Surface)" />
</div>

@code {
    private static readonly CanvasWorkbenchSurface Surface = SandboxCanvasSamples.CreateWorkbenchSurface(
        SandboxScenarioKey.HappyPath,
        SandboxCanvasSamples.CreateWorkbenchUiState(SandboxScenarioKey.HappyPath),
        SandboxCanvasSamples.CreateInspectorWindowState(SandboxScenarioKey.HappyPath));
}
