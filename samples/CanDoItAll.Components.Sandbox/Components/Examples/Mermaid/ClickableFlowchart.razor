@namespace CanDoItAll.Components.Sandbox.Components.Examples.Mermaid

<div class="sandbox-mermaid-stack">
    <MermaidDiagram Title="Change-delivery flow" Description="Click nodes, use the toolbar buttons, scroll to zoom, or drag the SVG to pan." Source="@FlowchartSource" Options="@DefaultOptions" NodeClicked="HandleNodeClicked" Rendered="HandleRendered" Error="HandleError" data-testid="mermaid-flowchart" />
    <div class="sandbox-mermaid-event" data-testid="mermaid-click-result">
        <div><TextBlock TextStyle="@(TextStyle.Eyebrow)" Value="Last node event" /><TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="@ClickedNodeLabel" /></div>
        <div class="sandbox-mermaid-event__meta"><span>Id: @(_lastClick?.NodeId ?? "none")</span><span>SVG: @(_lastClick?.SvgElementId ?? "none")</span><span>Nodes: @(_render?.NodeCount.ToString() ?? "pending")</span></div>
    </div>
    @if (_lastError is not null)
    {
        <Alert AlertStyle="@(AlertStyle.Warning)" data-testid="mermaid-last-error">@_lastError.LocationText @_lastError.Message</Alert>
    }
</div>

@code {
    private static readonly MermaidDiagramOptions DefaultOptions = new() { Theme = "default", SecurityLevel = "loose" };
    private static readonly string FlowchartSource = """
        flowchart LR
            intake([Request])
            normalize[Normalize requirements]
            bundle{Bundle needed?}
            package[Mermaid wrapper package]
            sandbox[Sandbox proof]
            mcp[MCP syntax guidance]
            done([Ready for consumers])

            intake --> normalize --> bundle
            bundle -- yes --> package
            bundle -- also --> sandbox
            bundle -- document --> mcp
            package --> done
            sandbox --> done
            mcp --> done
        """;
    private MermaidNodeClickEventArgs? _lastClick;
    private MermaidRenderResult? _render;
    private MermaidRenderError? _lastError;
    private string ClickedNodeLabel => _lastClick?.Text ?? _lastClick?.NodeId ?? "No node selected";
    private void HandleNodeClicked(MermaidNodeClickEventArgs args) { _lastClick = args; _lastError = null; }
    private void HandleRendered(MermaidRenderResult result) => _render = result;
    private void HandleError(MermaidRenderError error) => _lastError = error;
}
