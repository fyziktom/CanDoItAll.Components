@namespace CanDoItAll.Components.Sandbox.Components.Examples.Mermaid

<MermaidDiagram Title="@Example.Title" Description="@Example.Description" Source="@Example.Source"
                Options="@DefaultOptions" PanZoomEnabled="true" ShowControls="false"
                Style="@($"--cda-mermaid-min-height: {Example.Height};")"
                data-testid="@($"mermaid-gallery-diagram-{Example.Key}")" />

@code {
    [Parameter, EditorRequired]
    public MermaidGalleryExample Example { get; set; } = null!;

    private static readonly MermaidDiagramOptions DefaultOptions = new() { Theme = "default", SecurityLevel = "loose" };

    public static readonly IReadOnlyList<MermaidGalleryExample> Examples =
    [
        new("flowchart", "Flowchart", "Directional process graph with a decision node.", """
            flowchart LR
                A[Source] --> B{Valid?}
                B -- yes --> C[Render SVG]
                B -- no --> D[Show error]
            """),
        new("sequence", "Sequence diagram", "Participants, messages, and response ordering.", """
            sequenceDiagram
                actor User
                participant Sandbox
                participant MermaidDiagram
                User->>Sandbox: Edit source
                Sandbox->>MermaidDiagram: Render
                MermaidDiagram-->>User: SVG and events
            """),
        new("class", "Class diagram", "Component model and render result relationship.", """
            classDiagram
                class MermaidDiagram {
                    +string Source
                    +bool PanZoomEnabled
                    +EventCallback NodeClicked
                }
                class MermaidRenderResult {
                    +bool Succeeded
                    +int NodeCount
                }
                MermaidDiagram --> MermaidRenderResult
            """),
        new("state", "State diagram", "Wrapper render lifecycle.", """
            stateDiagram-v2
                [*] --> Idle
                Idle --> Rendering: source changed
                Rendering --> Ready: success
                Rendering --> Error: parse failure
                Error --> Idle: edit source
            """),
        new("er", "Entity relationship", "Diagram, node, and edge relationships.", """
            erDiagram
                DIAGRAM ||--o{ NODE : contains
                NODE ||--o{ EDGE : connects
                DIAGRAM {
                    string id
                    string source
                }
                NODE {
                    string label
                }
            """),
        new("journey", "User journey", "Authoring and proof steps with scores.", """
            journey
                title Mermaid wrapper adoption
                section Author
                    Write diagram: 5: User
                    Preview render: 4: User
                section Runtime
                    Click node: 5: Browser
                    Handle event: 5: Blazor
            """),
        new("gantt", "Gantt", "Schedule-style task chart.", """
            gantt
                title Mermaid package rollout
                dateFormat  YYYY-MM-DD
                section Wrapper
                    Package API       :done,    api, 2026-04-20, 2d
                    Sandbox examples  :active,  demo, after api, 3d
                section Proof
                    Screenshots       :proof, after demo, 2d
            """),
        new("pie", "Pie", "Share-of-effort chart.", """
            pie title Mermaid proof mix
                "Wrapper" : 35
                "Sandbox" : 35
                "MCP" : 20
                "Validation" : 10
            """),
        new("quadrant", "Quadrant chart", "Graph types plotted by value and syntax risk.", """
            quadrantChart
                title Diagram readiness
                x-axis Low syntax risk --> High syntax risk
                y-axis Low value --> High value
                quadrant-1 Teach carefully
                quadrant-2 Good defaults
                quadrant-3 Optional
                quadrant-4 Validate first
                Flowchart: [0.25, 0.80]
                Architecture-beta: [0.78, 0.92]
                Pie: [0.16, 0.45]
                Wardley: [0.72, 0.70]
            """),
        new("requirement", "Requirement diagram", "SysML-style requirement and element link.", """
            requirementDiagram
                requirement wrapper {
                    id: R1
                    text: First party Mermaid wrapper
                    risk: medium
                    verifymethod: test
                }
                element sandbox {
                    type: ui proof
                }
                sandbox - satisfies -> wrapper
            """),
        new("gitgraph", "Git graph", "Branching and merge sequence.", """
            gitGraph
                commit id: "start"
                branch mermaid
                checkout mermaid
                commit id: "wrapper"
                commit id: "gallery"
                checkout main
                merge mermaid
                commit id: "proof"
            """),
        new("mindmap", "Mindmap", "Nested concept map.", """
            mindmap
              root((Mermaid wrapper))
                Render
                  SVG
                  Errors
                Interact
                  Clicks
                  Pan and zoom
                Guide
                  MCP rules
            """),
        new("timeline", "Timeline", "Milestones for the wrapper work.", """
            timeline
                title Mermaid wrapper path
                Package : Official asset : JS interop
                Sandbox : Graph gallery : Click proof
                MCP : Syntax rules : Forbidden symbols
            """),
        new("sankey", "Sankey", "Flow weights between work areas.", """
            sankey-beta
                Wrapper,SVG,8
                Wrapper,Events,5
                Sandbox,Proof,6
                Sandbox,SVG,3
                Proof,Confidence,7
                Events,Confidence,4
            """),
        new("xychart", "XY chart", "Bar and line chart in Mermaid syntax.", """
            xychart
                title "Validation runs"
                x-axis [build, test, browser, bundle]
                y-axis "Checks" 0 --> 10
                bar [3, 9, 6, 1]
                line [3, 9, 6, 1]
            """),
        new("block", "Block diagram", "Explicitly positioned system blocks.", """
            block
                columns 3
                source["Source"] wrapper["Wrapper"] svg["SVG"]
                source --> wrapper
                wrapper --> svg
            """),
        new("packet", "Packet", "Network packet field layout.", """
            packet
                title Wrapper event packet
                +16: "Diagram id"
                +16: "Node id"
                +32: "SVG element"
                +32: "Node label"
            """),
        new("kanban", "Kanban", "Task columns and cards.", """
            kanban
                todo[Todo]
                    source[Write source]
                rendering[Rendering]
                    svg[Render SVG]
                done[Done]
                    proof[Screenshot proof]
            """),
        new("architecture", "Architecture beta", "Groups, services, icons, and directional ports.", """
            architecture-beta
                group browser(cloud)[Browser]
                group app(cloud)[Blazor host]
                group package(server)[Mermaid package] in app
                service user(internet)[User] in browser
                service sandbox(server)[Components sandbox] in app
                service wrapper(server)[MermaidDiagram] in package
                user:R --> L:sandbox
                sandbox:R --> L:wrapper
            """, "20rem"),
        new("radar", "Radar beta", "Multi-axis comparison chart.", """
            radar-beta
                title Wrapper readiness
                axis render["Render"], events["Events"], errors["Errors"], docs["Docs"]
                curve current["Current"]{90, 80, 85, 75}
                curve target["Target"]{95, 90, 90, 90}
                max 100
                min 0
            """),
        new("treemap", "Treemap beta", "Nested rectangles sized by value.", """
            treemap-beta
            "Mermaid"
                "Wrapper": 35
                "Sandbox": 30
                "MCP": 20
                "Proof": 15
            """),
        new("venn", "Venn beta", "Overlapping capability sets.", """
            venn-beta
                title "Wrapper overlap"
                set Render["Render"]:20
                set Interact["Interact"]:12
                union Render,Interact["Clickable SVG"]:5
            """),
        new("ishikawa", "Ishikawa beta", "Cause-and-effect fishbone.", """
            ishikawa-beta
                Blank diagram
                Source
                    Unsupported syntax
                    Forbidden symbol
                Runtime
                    Concurrent render
                    Missing asset
                Proof
                    No screenshot
            """),
        new("wardley", "Wardley beta", "Value-chain map with evolution axis.", """
            wardley-beta
            title Diagram Capability Map
            component User [0.95, 0.70]
            component Sandbox [0.72, 0.55]
            component Wrapper [0.55, 0.68]
            component Mermaid [0.35, 0.88]
            User -> Sandbox
            Sandbox -> Wrapper
            Wrapper -> Mermaid
            evolve Wrapper 0.78
            """, "20rem"),
        new("treeview", "TreeView beta", "Directory-style hierarchy.", """
            treeView-beta
                "src"
                    "CanDoItAll.Components.Mermaid"
                        "MermaidDiagram.razor"
                        "mermaidDiagram.js"
                    "CanDoItAll.Mcp.Mermaid"
            """),
        new("info", "Info", "Built-in Mermaid information diagram from the vendored package.", """
            info
            """, "12rem"),
        new("c4", "C4 context", "System context notation compatible with C4-PlantUML style.", """
            C4Context
                title Mermaid wrapper context
                Person(user, "Diagram author")
                System(sandbox, "Components sandbox")
                System(wrapper, "MermaidDiagram")
                System_Ext(mermaid, "Official Mermaid.js")
                Rel(user, sandbox, "Previews")
                Rel(sandbox, wrapper, "Uses")
                Rel(wrapper, mermaid, "Imports")
            """, "20rem")
    ];

    public sealed record MermaidGalleryExample(string Key, string Title, string Description, string Source, string Height = "18rem");
}
