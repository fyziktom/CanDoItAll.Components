@namespace CanDoItAll.Components.Sandbox.Components.Examples.Identity

<div class="space-y-6">
    <div class="sandbox-demo-grid--three">
        <div class="sandbox-icon-tile">
            <Avatar DefaultImageSeed="tomas" Alt="Tomas" Size="AvatarSize.Small" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Small" />
        </div>
        <div class="sandbox-icon-tile">
            <Avatar DefaultImageSeed="tomas" Alt="Tomas" Size="AvatarSize.Medium" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Medium" />
        </div>
        <div class="sandbox-icon-tile">
            <Avatar DefaultImageSeed="tomas" Alt="Tomas" Size="AvatarSize.Large" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Large" />
        </div>
    </div>

    <div class="sandbox-demo-grid--three">
        <div class="sandbox-icon-tile">
            <Avatar DefaultImageSeed="morgan" Alt="Morgan" Shape="AvatarShape.Circle" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Circle" />
        </div>
        <div class="sandbox-icon-tile">
            <Avatar DefaultImageSeed="morgan" Alt="Morgan" Shape="AvatarShape.Rounded" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Rounded" />
        </div>
        <div class="sandbox-icon-tile">
            <Avatar FallbackText="AL" Alt="Ada Lovelace" UseDefaultImageWhenMissing="false" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Initials fallback" />
        </div>
    </div>
</div>
