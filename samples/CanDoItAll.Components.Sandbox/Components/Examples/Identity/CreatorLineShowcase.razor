@namespace CanDoItAll.Components.Sandbox.Components.Examples.Identity

<div class="space-y-4">
    <CreatorLine>
        <Avatar DefaultImageSeed="reese" Alt="Reese" Size="AvatarSize.Small" />
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="Reese Carter" />
        <MutedInline Text="Design systems" />
    </CreatorLine>

    <CreatorLine>
        <Avatar DefaultImageSeed="quinn" Alt="Quinn" Size="AvatarSize.Small" />
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="Quinn Ahmadi" />
        <CreatorSocialLink Href="https://x.com/example" Target="_blank" Rel="noopener">
            <Icon Name="link" />
            <span>@@example</span>
        </CreatorSocialLink>
        <CreatorSocialLink Href="https://example.com" Target="_blank" Rel="noopener">
            <Icon Name="link" />
            <span>example.com</span>
        </CreatorSocialLink>
    </CreatorLine>
</div>
