@namespace CanDoItAll.Components.Sandbox.Components.Examples.Identity
@using CanDoItAll.Components.BaseLib

<div class="space-y-6">
    <TextBlock TextStyle="TextStyle.Body2" Value="Semantic shorthand aliases resolved to Material Symbols. This is not the full set of valid icon names — any raw Material Symbols name also resolves." />

    <div class="sandbox-demo-grid--three">
        @foreach (var (token, iconName) in SemanticAliases)
        {
            <div class="flex items-center gap-4 min-w-0 py-1 px-4">
                <Icon Name="@token" />
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="@token" />
            </div>
        }
    </div>
</div>

@code {
    private static readonly IReadOnlyList<(string Token, string IconName)> SemanticAliases = MaterialIconCatalog.Aliases
        .Where(pair => !pair.Key.StartsWith("fa-", StringComparison.OrdinalIgnoreCase))
        .OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
        .Select(pair => (pair.Key, pair.Value))
        .ToArray();

    private static readonly IReadOnlyList<(string Token, string IconName)> FontAwesomeAliases = MaterialIconCatalog.Aliases
        .Where(pair => pair.Key.StartsWith("fa-", StringComparison.OrdinalIgnoreCase))
        .OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
        .Select(pair => (pair.Key, pair.Value))
        .ToArray();
}
