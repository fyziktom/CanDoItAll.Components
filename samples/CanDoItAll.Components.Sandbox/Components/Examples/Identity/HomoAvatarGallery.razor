@namespace CanDoItAll.Components.Sandbox.Components.Examples.Identity

<div class="space-y-6">
    <div class="sandbox-demo-grid--three">
        @foreach (var seed in Seeds)
        {
            <div class="sandbox-icon-tile">
                <HomoAvatar Seed="@seed" SizePx="48" Title="@seed" Variant="RoboAvatarVariant.Gradient" LineWidth=".75" Dark="@(ThemeState?.IsDark ?? false)" />
                <TextBlock TextStyle="TextStyle.Subtitle2" Value="@seed" />
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    public SandboxThemeState? ThemeState { get; set; }

    private static readonly IReadOnlyList<string> Seeds =
    [
        "Tomas",
        "Connor",
        "Morgan",
        "Reese",
        "Roxane",
        "Tracy",
        "John",
        "Paul",
        "Ringo",
        "George"
    ];
}
