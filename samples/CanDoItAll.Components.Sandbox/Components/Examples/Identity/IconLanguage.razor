@namespace CanDoItAll.Components.Sandbox.Components.Examples.Identity

<div class="sandbox-demo-grid--three">
    @foreach (var icon in (ToolbarState?.Scenario == SandboxScenarioKey.DenseContent
        ? new[] { ("add_2", "Create"), ("filter_alt", "Filter"), ("calendar", "Schedule"), ("circle_info", "Context"), ("save", "Save"), ("risk", "Warning"), ("flow", "Flow"), ("bars_staggered", "Density"), ("research", "Inspect") }
        : new[] { ("add_2", "Create"), ("filter_alt", "Filter"), ("calendar", "Schedule"), ("circle_info", "Context"), ("save", "Save"), ("risk", "Warning") }))
    {
        <div class="sandbox-icon-tile">
            <Icon Name="@icon.Item1" />
            <div class="space-y-1">
                <TextBlock TextStyle="TextStyle.Subtitle2" Value="@icon.Item2" />
                <TextBlock TextStyle="TextStyle.Caption" Value="@icon.Item1" />
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    public SandboxToolbarState? ToolbarState { get; set; }
}
