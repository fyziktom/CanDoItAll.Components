@namespace CanDoItAll.Components.Sandbox.Components.Examples.Charts

<CdaChart Title="Multi-line house overview"
          Description="Several operational signals share one datetime axis with tuned colors and stable legend ordering."
          Series="@(new List<CdaChartSeries>
                  {
                      new()
                      {
                          Name = "House kWh",
                          Type = CdaChartType.Area,
                          Color = "#2563eb",
                          Points =
                          [
                              new(new DateTime(2026, 4, 30, 6, 0, 0, DateTimeKind.Utc), 1.4m),
                              new(new DateTime(2026, 4, 30, 12, 0, 0, DateTimeKind.Utc), 4.8m),
                              new(new DateTime(2026, 4, 30, 18, 0, 0, DateTimeKind.Utc), 6.1m)
                          ]
                      },
                      new()
                      {
                          Name = "Solar kWh",
                          Type = CdaChartType.Area,
                          Color = "#16a34a",
                          Points =
                          [
                              new(new DateTime(2026, 4, 30, 6, 0, 0, DateTimeKind.Utc), 0.0m),
                              new(new DateTime(2026, 4, 30, 12, 0, 0, DateTimeKind.Utc), 4.1m),
                              new(new DateTime(2026, 4, 30, 18, 0, 0, DateTimeKind.Utc), 0.6m)
                          ]
                      },
                      new()
                      {
                          Name = "Battery kWh",
                          Type = CdaChartType.Line,
                          Color = "#7c3aed",
                          StrokeDash = 5,
                          Points =
                          [
                              new(new DateTime(2026, 4, 30, 6, 0, 0, DateTimeKind.Utc), 3.4m),
                              new(new DateTime(2026, 4, 30, 12, 0, 0, DateTimeKind.Utc), 0.9m),
                              new(new DateTime(2026, 4, 30, 18, 0, 0, DateTimeKind.Utc), 2.2m)
                          ]
                      }
                  })"
          Options="@(new CdaChartOptions
                   {
                       Type = CdaChartType.Area,
                       Unit = "kWh",
                       XAxisType = CdaChartAxisType.DateTime,
                       YAxisTitle = "Energy (kWh)",
                       FillOpacity = 0.22,
                       Curve = CdaChartCurve.Straight,
                       LegendPosition = CdaChartLegendPosition.Top,
                       Palette = ["#2563eb", "#16a34a", "#7c3aed"]
                   })"
          Height="390" />
