@namespace CanDoItAll.Components.Sandbox.Components.Examples.Actions

<Stack GapScale="LayoutGap.Medium">
    <Cluster Gap="LayoutGap.Small">
        <Button Icon="visibility"
                Variant="Variant.Outlined"
                ButtonStyle="ButtonStyle.Light" />
        <Button Icon="download"
                Variant="Variant.Outlined"
                ButtonStyle="ButtonStyle.Info" />
        <Button Icon="delete"
                Variant="Variant.Text"
                ButtonStyle="ButtonStyle.Danger" />
    </Cluster>

    <BadgesGroup>
        <Badge Text="Ready" Tone="BadgeTone.Success" />
        <Badge Text="Proof required" Tone="BadgeTone.Info" Button="true" />
        <StatusBadge Text="Waiting proof" Tone="warning" />
    </BadgesGroup>

    <ChipRow>
        <Chip Text="Approval" />
        <Chip Text="Desktop proof" />
    </ChipRow>
</Stack>
