@namespace CanDoItAll.Components.Sandbox.Components.Examples.Actions

<div class="sandbox-list">
    <SelectionListItem Title="Navigation polish"
                       Eyebrow="Review"
                       Meta="tabs / shell"
                       Summary="Primary navigation needs calmer focus treatment.">
        <Status>
            <StatusBadge Text="Needs attention" Tone="warning" />
        </Status>
        <Actions>
            <Cluster Wrap="FlexWrap.NoWrap" Gap="LayoutGap.Small">
                <Button Text="Open" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
                <Button Text="Promote" />
            </Cluster>
        </Actions>
    </SelectionListItem>

    <SelectionListItem Title="Feedback states"
                       Eyebrow="Proof"
                       Meta="alerts / toasts"
                       Summary="Empty and loading surfaces are ready for screenshot review.">
        <Status>
            <StatusBadge Text="Ready" Tone="success" />
        </Status>
        <Actions>
            <Cluster Wrap="FlexWrap.NoWrap" Gap="LayoutGap.Small">
                <Button Text="Open" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
                <Button Text="Promote" />
            </Cluster>
        </Actions>
    </SelectionListItem>
</div>
