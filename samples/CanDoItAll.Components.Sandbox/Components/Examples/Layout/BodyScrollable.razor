@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<Body FillHeight="true"
      Scrollable="true"
      Style="height:14rem;"
      Class="rounded-[1.25rem] border border-slate-200 bg-white p-4"
      data-testid="sandbox-layout-body">
<div class="space-y-3">
    <div class="rounded-[0.85rem] border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">Release
        acceptance checklist
    </div>
    <div class="rounded-[0.85rem] border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">Reviewer lane
        assignments
    </div>
    <div class="rounded-[0.85rem] border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">Priority
        threshold history
    </div>
    <div class="rounded-[0.85rem] border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">Budget reference
        audit
    </div>
    <div class="rounded-[0.85rem] border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">Notification
        delivery log
    </div>
    <div class="rounded-[0.85rem] border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">Mobile viewport
        proof
    </div>
    <div class="rounded-[0.85rem] border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">Tablet viewport
        proof
    </div>
    <div class="rounded-[0.85rem] border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">Accessibility
        pass notes
    </div>
</div>
</Body>
