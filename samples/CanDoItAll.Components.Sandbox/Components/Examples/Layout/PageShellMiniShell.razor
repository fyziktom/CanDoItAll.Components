@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<PageShell Class="flex overflow-hidden rounded-[1.25rem] border border-slate-200 bg-white" Style="height:14rem;">
    <Sidebar Class="w-40 shrink-0 border-r border-slate-200 bg-slate-50 p-3">
        <div class="space-y-2 text-sm text-slate-600">
            <p class="m-0 font-semibold text-slate-800">Navigation</p>
            <p class="m-0">Feedback</p>
            <p class="m-0">Forms</p>
            <p class="m-0">Layout</p>
        </div>
    </Sidebar>
    <Body FillHeight="true" Scrollable="true" Class="flex-1 p-4">
        <p class="m-0 text-sm text-slate-600">PageShell keeps the sidebar and main content in one predictable structure.</p>
    </Body>
</PageShell>
