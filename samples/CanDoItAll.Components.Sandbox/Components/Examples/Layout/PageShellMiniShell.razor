@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<PageShell Class="flex overflow-hidden rounded-[1.25rem] border border-chrome-200 bg-white"
           Style="height:14rem;"
           data-testid="sandbox-layout-page-shell">
    <Sidebar Class="w-40 shrink-0 border-r border-chrome-200 bg-chrome-50 p-3">
        <div class="space-y-2 text-sm text-chrome-600">
            <p class="m-0 font-semibold text-chrome-800">Navigation</p>
            <p class="m-0">Feedback</p>
            <p class="m-0">Forms</p>
            <p class="m-0">Layout</p>
        </div>
    </Sidebar>
    <Body FillHeight="true" Scrollable="true" Class="flex-1 p-4">
        <p class="m-0 text-sm text-chrome-600">PageShell keeps the sidebar and main content in one predictable structure.</p>
    </Body>
</PageShell>
