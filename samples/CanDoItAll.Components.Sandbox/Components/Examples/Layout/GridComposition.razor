@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout
@inherits LayoutCompositionShowcaseBase

<div class="@HeroSurfaceClass" data-testid="layout-composition-grid">
    <Grid Gap="LayoutGap.XLarge" Class="w-full">
        <Grid Gap="LayoutGap.XLarge"
              ColumnTemplateLg="minmax(0,1fr) minmax(0,0.85fr)"
              Class="w-full">
            <Stack Orientation="Orientation.Vertical" Gap="1rem">
                <span class="cda-shell-pill cda-shell-pill--neutral">@HeroEyebrow</span>
                <div class="space-y-2">
                    <p class="text-base font-semibold text-chrome-950">@HeroTitle</p>
                    <p class="text-sm leading-6 text-chrome-600">@HeroDescription</p>
                </div>
            </Stack>

            <Stack Orientation="Orientation.Vertical" Class="w-full" Gap="1rem">
                <Stack Orientation="Orientation.Horizontal"
                       JustifyContent="JustifyContent.End"
                       Wrap="FlexWrap.Wrap"
                       Class="w-full"
                       Gap="1rem">
                    <PillList>
                        <Pill>@SelectedModeLabel</Pill>
                        <Pill>@WindowLabel</Pill>
                        <Pill>@FreshnessLabel</Pill>
                    </PillList>
                </Stack>

                <Stack Orientation="Orientation.Horizontal"
                       JustifyContent="JustifyContent.End"
                       Wrap="FlexWrap.Wrap"
                       Class="w-full"
                       Gap="1rem">
                    <Button Text="Refresh"
                            Icon="refresh"
                            Tone="ButtonTone.Default"
                            Click="HandleRefreshAsync"
                            Disabled="@ActionsDisabled" />
                    <Button Text="Reset Data"
                            Icon="delete"
                            Tone="ButtonTone.Danger"
                            Click="HandleResetAsync"
                            Disabled="@ActionsDisabled" />
                </Stack>
            </Stack>
        </Grid>

        <FormRow Split="true" Class="w-full">
            <FormField Text="Mode" ContainerClass="w-full">
                <ChildContent>
                    <DropDown TValue="string"
                              Data="@ModeOptions"
                              Value="@selectedMode"
                              Change="OnModeChanged"
                              Style="width:100%" />
                </ChildContent>
            </FormField>

            <FormField Text="Time Window" ContainerClass="w-full">
                <ChildContent>
                    <DropDown TValue="int"
                              Data="@WindowOptions"
                              Value="@selectedWindowDays"
                              Change="OnWindowChanged"
                              Style="width:100%" />
                </ChildContent>
            </FormField>
        </FormRow>
    </Grid>
</div>
