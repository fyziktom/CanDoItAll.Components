@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<WorkspaceSplit data-testid="sandbox-layout-workspace-split">
    <WorkspacePanel Wide="true">
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em] text-chrome-500">Main panel</p>
        <p class="mt-1 text-sm text-chrome-700">The wide panel spans both grid tracks at desktop width via Wide.</p>
    </WorkspacePanel>
    <WorkspacePanel Tone="WorkspacePanelTone.Ghost">
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em] text-chrome-500">Side panel</p>
        <p class="mt-1 text-sm text-chrome-700">The narrower side panel stays a single track.</p>
    </WorkspacePanel>
</WorkspaceSplit>
