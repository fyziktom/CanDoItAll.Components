@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<StickyActionFooter StatusLabel="Layout state"
                     StatusMessage="Shared layout components should make the next step obvious without inventing one-off page wrappers."
                     StatusTone="info">
    <SecondaryActions>
        <Button Text="Save draft" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
    </SecondaryActions>
    <PrimaryActions>
        <Button Text="Approve layout" />
    </PrimaryActions>
    <DangerActions>
        <Button Text="Discard" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" />
    </DangerActions>
</StickyActionFooter>
