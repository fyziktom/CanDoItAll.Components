@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<Grid Gap="LayoutGap.Medium" Columns="1" ColumnsMd="2" data-testid="sandbox-layout-theme-host">
    <ThemeHost ThemeKey="@CadThemes.Light" Class="rounded-[1.25rem] border border-chrome-400 p-4">
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em]">Light</p>
        <p class="mt-1 text-sm text-chrome-500">Scoped to the light theme.</p>
    </ThemeHost>
    <ThemeHost ThemeKey="@CadThemes.Dark" Class="rounded-[1.25rem] border border-chrome-400 p-4">
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em]">Dark</p>
        <p class="mt-1 text-sm text-chrome-500">Scoped to the dark theme.</p>
    </ThemeHost>
</Grid>
