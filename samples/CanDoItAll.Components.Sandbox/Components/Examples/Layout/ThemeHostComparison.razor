@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<Grid Gap="LayoutGap.Medium" Columns="1" ColumnsMd="2" data-testid="sandbox-layout-theme-host">
    <ThemeHost ThemeKey="@CadThemes.Light" Class="rounded-[1.25rem] border border-slate-200 bg-white p-4">
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Light</p>
        <p class="mt-1 text-sm text-slate-700">Scoped to the light theme.</p>
    </ThemeHost>
    <ThemeHost ThemeKey="@CadThemes.Dark" Class="rounded-[1.25rem] border border-slate-800 bg-slate-900 p-4">
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Dark</p>
        <p class="mt-1 text-sm text-slate-100">Scoped to the dark theme.</p>
    </ThemeHost>
</Grid>
