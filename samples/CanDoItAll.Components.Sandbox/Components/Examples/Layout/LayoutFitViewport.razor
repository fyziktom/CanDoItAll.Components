@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<CanDoItAll.Components.BaseLib.Layout FitViewport="true"
                                       ViewportOffset="0px"
                                       LockOverflow="true"
                                       Style="height:14rem;"
                                       Class="overflow-hidden rounded-[1.25rem] border border-slate-200 bg-white">
    <PageShell Class="flex h-full">
        <Sidebar Class="w-36 shrink-0 border-r border-slate-200 bg-slate-50 p-3">
            <p class="m-0 text-sm text-slate-600">Rail</p>
        </Sidebar>
        <Body FillHeight="true" Scrollable="true" Class="flex-1 p-4">
            <p class="m-0 text-sm text-slate-600">FitViewport and LockOverflow stay active here; only the computed height is capped for this preview.</p>
        </Body>
    </PageShell>
</CanDoItAll.Components.BaseLib.Layout>
