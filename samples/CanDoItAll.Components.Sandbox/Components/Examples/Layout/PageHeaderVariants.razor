@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<div class="space-y-4">
    <PageHeader Eyebrow="Shared layout"
                Title="Standard page header"
                Description="The default header carries an eyebrow, title, description, and trailing actions.">
        <Actions>
            <Button Text="Share view" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
            <Button Text="Open checklist" />
        </Actions>
    </PageHeader>

    <PageHeader Eyebrow="List pane" Title="Compact header" Compact="true" />
</div>
