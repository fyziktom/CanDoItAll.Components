@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<Grid Columns="1" ColumnsSm="1" ColumnsMd="2" ColumnTemplateLg="minmax(0,1fr) minmax(0,0.85fr)" Gap="LayoutGap.XLarge">
    <Row GapScale="LayoutGap.XLarge">
        <Column GapScale="LayoutGap.Medium" JustifyContent="JustifyContent.Center">
            <span class="cda-shell-pill cda-shell-pill--neutral">Practice analytics</span>
            <p class="text-base font-semibold text-slate-950">Switch the mode or time window.</p>
            <p class="text-sm leading-6 text-slate-600">Preferred pattern. The same-row columns inherit and override tracks through the shared primitives, so the layout can collapse to one column and expand again without custom structural CSS.</p>
        </Column>

        <Column GapScale="LayoutGap.Large" AlignItems="AlignItems.End" JustifyContent="JustifyContent.SpaceBetween">
            <PillList>
                <Pill>All modes</Pill>
                <Pill>30-day window</Pill>
            </PillList>
            <Row Columns="1" ColumnsSm="2" GapScale="LayoutGap.Large">
                <Column>
                    <Button Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" />
                </Column>
                <Column>
                    <Button Text="Reset Data" Icon="delete" ButtonStyle="ButtonStyle.Danger" />
                </Column>
            </Row>
        </Column>
    </Row>

    <Row Columns="1" ColumnsSm="1" ColumnsMd="2" ColumnTemplateLg="repeat(2,minmax(0,1fr))" GapScale="LayoutGap.XLarge">
        <Column>
            <FormField Text="Mode">
                <ChildContent>
                    <DropDown TValue="string" Data="@ModeOptions" Value="@ModeOptions[0]" Style="width:100%" />
                </ChildContent>
            </FormField>
        </Column>
        <Column>
            <FormField Text="Time Window">
                <ChildContent>
                    <DropDown TValue="int" Data="@WindowOptions" Value="30" Style="width:100%" />
                </ChildContent>
            </FormField>
        </Column>
    </Row>
</Grid>

@code {
    private static readonly IReadOnlyList<string> ModeOptions = ["All modes", "Interval speed", "Harmony"];
    private static readonly IReadOnlyList<int> WindowOptions = [7, 14, 30, 90];
}
