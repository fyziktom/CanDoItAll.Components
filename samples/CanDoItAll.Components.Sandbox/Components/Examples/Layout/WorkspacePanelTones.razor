@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<Grid Gap="LayoutGap.Medium" Columns="1" ColumnsMd="2">
    <WorkspacePanel Tone="WorkspacePanelTone.Default">
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Default</p>
        <p class="mt-1 text-sm text-slate-700">A solid card for primary workspace content.</p>
    </WorkspacePanel>
    <WorkspacePanel Tone="WorkspacePanelTone.Ghost">
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Ghost</p>
        <p class="mt-1 text-sm text-slate-700">A dashed placeholder tone for secondary or empty content.</p>
    </WorkspacePanel>
</Grid>
