@namespace CanDoItAll.Components.Sandbox.Components.Examples.Layout

<Split Breakpoint="LayoutBreakpoint.Md"
       AlignItems="AlignItems.Center"
       JustifyContent="JustifyContent.SpaceBetween"
       Gap="LayoutGap.Medium"
       Class="rounded-[1.25rem] border border-chrome-200 bg-white px-4 py-3"
       data-testid="sandbox-layout-split">
    <div class="space-y-1">
        <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Release acceptance" />
        <TextBlock TextStyle="@(TextStyle.Caption)" Value="Collapses to a stacked column below the Md breakpoint." />
    </div>
    <Cluster Gap="LayoutGap.Small">
        <Button Text="Share view" Tone="@(ButtonTone.Default)" Variant="@(Variant.Outlined)" Size="ButtonSize.Small" />
        <Button Text="Open checklist" Size="ButtonSize.Small" />
    </Cluster>
</Split>
