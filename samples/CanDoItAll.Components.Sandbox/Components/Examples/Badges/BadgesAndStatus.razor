@namespace CanDoItAll.Components.Sandbox.Components.Examples.Badges

<div class="space-y-3">
    <BadgesGroup>
        <Badge Text="Operational" Tone="@(BadgeTone.Info)" />
        <Badge Text="@LongBadgeText" Tone="@(BadgeTone.Warn)" />
        <StatusBadge Text="@LongStatusText" Tone="danger" />
    </BadgesGroup>
    <Cluster Gap="LayoutGap.Small">
        <StatusBadge Text="Healthy" Tone="success" />
        <StatusBadge Text="Waiting proof" Tone="warning" />
        <StatusBadge Text="Blocked" Tone="danger" />
        <StatusBadge Text="Info" Tone="info" />
    </Cluster>
</div>

@code {
    [CascadingParameter] public SandboxToolbarState? ToolbarState { get; set; }
    private string LongBadgeText => ToolbarState?.Scenario == SandboxScenarioKey.LongText ? "mobile warning requires screenshot confirmation" : "Mobile warning";
    private string LongStatusText => ToolbarState?.Scenario == SandboxScenarioKey.LongText ? "Blocked by extended publication evidence copy" : "Blocked";
}
