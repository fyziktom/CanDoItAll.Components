@namespace CanDoItAll.Components.Sandbox.Components.Examples.Badges

<ChipRow>
    <Chip Text="Toast proof" />
    <Chip Text="@LongChipText" />
</ChipRow>

@code {
    [CascadingParameter] public SandboxToolbarState? ToolbarState { get; set; }
    private string LongChipText => ToolbarState?.Scenario == SandboxScenarioKey.LongText ? "Long chip copy should wrap inside the available feedback column" : "Review copy";
}
