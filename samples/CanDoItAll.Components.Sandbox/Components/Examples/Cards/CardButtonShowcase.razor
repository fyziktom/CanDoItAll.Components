@namespace CanDoItAll.Components.Sandbox.Components.Examples.Cards

<div class="sandbox-demo-grid--three">
    <div class="sandbox-icon-tile">
        <CardButton Text="Confirm" />
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="Solid" />
    </div>
    <div class="sandbox-icon-tile">
        <CardButton Text="Cancel" Ghost="true" />
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="Ghost" />
    </div>
    <div class="sandbox-icon-tile">
        <CardButton Text="Open docs" Href="https://example.com" Target="_blank" Rel="noopener" />
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="Link (Href)" />
    </div>
</div>
