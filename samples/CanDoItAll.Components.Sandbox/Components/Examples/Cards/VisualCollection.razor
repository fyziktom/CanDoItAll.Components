@namespace CanDoItAll.Components.Sandbox.Components.Examples.Cards

<CardGrid>
    <Card>
        <Media>
            <img src="_content/CanDoItAll.Components.BaseLib/assets/identity/avatars/avatar-01.jpg" alt="" />
        </Media>
        <Header>
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Small"
                   AlignItems="AlignItems.Start"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Summary card" />
                    <TextBlock TextStyle="TextStyle.Subtitle1" Value="Migration review" />
                </Stack>
                <StatusBadge Text="Healthy" Tone="success" />
            </Split>
        </Header>
        <Tags>
            <StatusBadge Text="Owner: Architecture" Tone="neutral" />
            <StatusBadge Text="Scope: Base + canvas" Tone="neutral" />
        </Tags>
        <ChildContent>
            <TextBlock TextStyle="TextStyle.Body2" Value="Shared component uptake stays visible through a stable card shell and supporting metadata." />
        </ChildContent>
        <Actions>
            <Button Text="Edit" Icon="edit" ButtonStyle="ButtonStyle.Primary" />
        </Actions>
    </Card>
</CardGrid>
