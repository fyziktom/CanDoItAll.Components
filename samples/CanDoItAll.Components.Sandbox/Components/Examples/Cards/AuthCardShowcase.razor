@namespace CanDoItAll.Components.Sandbox.Components.Examples.Cards

<AuthCard>
    <Stack GapScale="LayoutGap.Medium">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.Subtitle1" Value="Sign in" />
            <MutedInline Text="Use your workspace email to continue." />
        </Stack>
        <FormField Text="Email">
            <TextBox Value="team@example.com" />
        </FormField>
        <FormField Text="Password">
            <Password Value="" />
        </FormField>
        <Button Text="Continue" ButtonStyle="ButtonStyle.Primary" />
    </Stack>
</AuthCard>
