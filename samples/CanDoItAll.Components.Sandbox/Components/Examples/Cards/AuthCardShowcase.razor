@namespace CanDoItAll.Components.Sandbox.Components.Examples.Cards

<AuthCard>
    <Stack GapScale="LayoutGap.Medium">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.Subtitle1" Value="Sign in" />
            <MutedInline Text="Use your workspace email to continue." />
        </Stack>
        <FormField Text="Email">
            <TextInput Value="@email" ValueChanged="@(value => email = value ?? string.Empty)" ValueExpression="@(() => email)" />
        </FormField>
        <FormField Text="Password">
            <Password Value="" />
        </FormField>
        <Button Text="Continue" Tone="ButtonTone.Primary" />
    </Stack>
</AuthCard>

@code {
    private string email = "team@example.com";
}
