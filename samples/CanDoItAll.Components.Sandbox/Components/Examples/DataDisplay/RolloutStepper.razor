@namespace CanDoItAll.Components.Sandbox.Components.Examples.DataDisplay

<TimelineStepper CurrentStep="@stepperCurrentStep"
                 TotalSteps="5"
                 AvailableStep="3"
                 Mode="@stepperMode"
                 ModeChanged="@(mode => stepperMode = mode)"
                 ShowModeToggle="true"
                 StepLabel="Rollout stage"
                 StatusText="@(stepperCurrentStep < stepperAvailableStep ? "Data available" : "Awaiting next stage")"
                 StatusTone="@(stepperCurrentStep < stepperAvailableStep ? "success" : "warning")"
                 Ticks="@(new List<TimelineStepperTick>
                        {
                            new() { Step = 1, Label = "Build", Description = "Artifact built and signed.", Major = true },
                            new() { Step = 2, Label = "Canary", Description = "5% traffic shifted." },
                            new() { Step = 3, Label = "Bake", Description = "Soak period before full rollout." },
                            new() { Step = 4, Label = "Rollout", Description = "Remaining traffic shifted.", Disabled = true },
                            new() { Step = 5, Label = "Complete", Description = "Rollout finished.", Major = true, Disabled = true }
                        })"
                 PreviousClicked="@(() => stepperCurrentStep = Math.Max(1, stepperCurrentStep - 1))"
                 NextClicked="@(() => stepperCurrentStep = Math.Min(5, stepperCurrentStep + 1))"
                 StepSelected="@(step => stepperCurrentStep = step)" />

@code {
    private int stepperCurrentStep = 2;
    private readonly int stepperAvailableStep = 3;
    private TimelineStepperMode stepperMode = TimelineStepperMode.Manual;
}
