@namespace CanDoItAll.Components.Sandbox.Components.Examples.DataDisplay

<Stack GapScale="LayoutGap.Medium">
    <Stack GapScale="LayoutGap.Tiny">
        <MutedInline Text="Default: inline cluster of actions." />
        <CardActions>
            <Button Text="Edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
            <Button Text="Save" ButtonStyle="ButtonStyle.Primary" />
        </CardActions>
    </Stack>
    <Stack GapScale="LayoutGap.Tiny">
        <MutedInline Text="Secondary: bordered footer row, split to the edges." />
        <CardActions Secondary="true">
            <MutedInline Text="Last updated 2 hours ago" />
            <Button Text="View details" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
        </CardActions>
    </Stack>
</Stack>
