@namespace CanDoItAll.Components.Sandbox.Components.Examples.DataDisplay

<Dialog IsOpen="true"
        Title="Edit record"
        Subtitle="Edit details without displacing the record list."
        Size="ModalSize.Compact"
        DenseChrome="true">
    <ChildContent>
        <FormStack>
            <FormField Text="Title">
                <TextBox Value="Shell registry" />
            </FormField>
        </FormStack>
    </ChildContent>
    <Footer>
        <Button Text="Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
        <Button Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" />
    </Footer>
</Dialog>
