@namespace CanDoItAll.Components.Sandbox.Components.Examples.DataDisplay

<Stack GapScale="LayoutGap.Medium">
    <div class="sandbox-demo-grid--two">
        <SummaryTile Label="Neutral" Value="42" HelperText="Default tone with an inline helper line." />
        <SummaryTile Label="Warning" Value="7" HelperText="Shown in a hover popover instead of inline." Tone="warning" ShowHelperTextAsTooltip="true" />
    </div>
    <Cluster Gap="LayoutGap.Small">
        <SummaryTile Label="Accent" Value="Live" Tone="accent" Badge="true" />
        <MutedInline Text="Badge is an inline-sized pill, meant for flex rows rather than a stretching grid." />
    </Cluster>
</Stack>
