@namespace CanDoItAll.Components.Sandbox.Components.Examples.Modals

<DialogScaffold Eyebrow="Migration"
                Title="Shared component uptake"
                Description="Review the affected surfaces before approving the migration.">
    <ContextRail>
        <Stack GapScale="LayoutGap.Small">
            <StatusBadge Tone="info" Text="12 files" />
            <StatusBadge Tone="success" Text="Tests passing" />
        </Stack>
    </ContextRail>
    <ChildContent>
        <TextBlock TextStyle="@(TextStyle.Body2)"
                   Value="ListDetailShell call sites move to the token-driven variant in this pass." />
    </ChildContent>
    <ReviewPanel>
        <TextBlock TextStyle="@(TextStyle.Body2)" Value="Owner: Platform UI" />
    </ReviewPanel>
    <Footer>
        <Button Text="Close" Tone="@(ButtonTone.Default)" Variant="@(Variant.Outlined)" />
        <Button Text="Approve" Icon="check" Tone="@(ButtonTone.Primary)" />
    </Footer>
</DialogScaffold>
