@namespace CanDoItAll.Components.Sandbox.Components.Examples.Modals

<Cluster Gap="LayoutGap.Small">
    <Button Text="Edit record"
            Icon="edit"
            Tone="@(ButtonTone.Primary)"
            Click="OpenEditor" />
</Cluster>
<Dialog IsOpen="@isOpen"
        Title="Edit record"
        Subtitle="Edit details without displacing the rest of the page. Dialog-only state is initialized when this opens."
        Size="ModalSize.Compact"
        DenseChrome="true"
        OnClose="CloseEditor">
    <ChildContent>
        <FormStack>
            <FormField Text="Title">
                <TextInput Value="@title" ValueChanged="@(value => title = value ?? string.Empty)" ValueExpression="@(() => title)" />
            </FormField>
            <FormField Text="Review notes">
                <TextAreaInput Value="@notes"
                               ValueChanged="@(value => notes = value ?? string.Empty)"
                               ValueExpression="@(() => notes)"
                               rows="10" />
            </FormField>
        </FormStack>
    </ChildContent>
    <Footer>
        <Button Text="Cancel"
                Tone="@(ButtonTone.Default)"
                Variant="@(Variant.Outlined)"
                Click="CloseEditor" />
        <Button Text="Save"
                Icon="save"
                Tone="@(ButtonTone.Primary)"
                Disabled="@(string.IsNullOrWhiteSpace(title))"
                Click="CloseEditor" />
    </Footer>
</Dialog>

@code {
    private bool isOpen;
    private string title = "Migration review";
    private string notes = "Shared component uptake stays visible through a stable card shell and supporting metadata.";

    private Task OpenEditor()
    {
        isOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseEditor()
    {
        isOpen = false;
        return Task.CompletedTask;
    }

}
