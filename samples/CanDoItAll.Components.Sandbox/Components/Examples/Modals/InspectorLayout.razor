@namespace CanDoItAll.Components.Sandbox.Components.Examples.Modals

<InspectorDialogLayout Eyebrow="Inspector"
                        Title="Order #48213"
                        Description="Read-only inspection of a single order and its related records.">
    <InspectorRail>
        <Stack GapScale="LayoutGap.Small">
            <TextBlock TextStyle="TextStyle.Body2" Value="Customer" />
            <TextBlock TextStyle="TextStyle.Body2" Value="Fulfillment" />
        </Stack>
    </InspectorRail>
    <ChildContent>
        <TextBlock TextStyle="TextStyle.Body2" Value="Order placed 2026-08-11, shipped 2026-08-13." />
    </ChildContent>
    <InspectorPanel>
        <StatusBadge Tone="success" Text="Shipped" />
    </InspectorPanel>
</InspectorDialogLayout>
