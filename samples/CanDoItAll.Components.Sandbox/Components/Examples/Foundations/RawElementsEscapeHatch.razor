@namespace CanDoItAll.Components.Sandbox.Components.Examples.Foundations

<div class="sandbox-demo-grid sandbox-demo-grid--two">
    <div class="space-y-3">
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Bare elements" />
        <h1>&lt;H1&gt;</h1>
        <h2>&lt;H2&gt;</h2>
        <small>&lt;small&gt;</small>
        <p>Plain paragraphs still read comfortably with <strong>bold</strong> and <em>italic</em> emphasis mixed in.</p>
    </div>
    <div class="space-y-3">
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Classes" />
        <div class="cda-text-block cda-text-block--h1">&lt;H1&gt;</div>
        <div class="cda-text-block cda-text-block--h2">&lt;H2&gt;</div>
        <small>&lt;small&gt;</small>
        <p>Plain paragraphs still read comfortably with <strong>bold</strong> and <em>italic</em> emphasis mixed in.</p>
    </div>
    <div class="space-y-3">
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="TextBlock" />
        <TextBlock TextStyle="TextStyle.H1">&lt;H1&gt;</TextBlock>
        <TextBlock TextStyle="TextStyle.H2">&lt;H2&gt;</TextBlock>
        <TextBlock TextStyle="TextStyle.Small">&lt;small&gt;</TextBlock>
        <TextBlock>Plain paragraphs still read comfortably with <strong>bold</strong> and <em>italic</em> emphasis mixed in.</TextBlock>
    </div>
</div>
