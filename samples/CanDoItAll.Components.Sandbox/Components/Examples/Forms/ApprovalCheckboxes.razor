@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms

<Grid Gap="LayoutGap.Large" ColumnTemplate="repeat(auto-fit,minmax(16rem,1fr))">
    <div class="rounded-[1rem] border border-slate-200 bg-white px-4 py-3">
        <Cluster AlignItems="AlignItems.Start" Wrap="FlexWrap.NoWrap" Gap="LayoutGap.Medium">
            <CheckBox TValue="bool" Value="@requiresApproval" ValueChanged="@(value => requiresApproval = value)" aria-label="Requires approval" />
            <div class="space-y-1">
                <TextBlock TextStyle="TextStyle.Subtitle2" Value="Requires approval" />
                <TextBlock TextStyle="TextStyle.Caption" Value="Gate release until the designated reviewer signs off." />
            </div>
        </Cluster>
    </div>

    <div class="rounded-[1rem] border border-slate-200 bg-white px-4 py-3">
        <Cluster AlignItems="AlignItems.Start" Wrap="FlexWrap.NoWrap" Gap="LayoutGap.Medium">
            <CheckBox TValue="bool" Value="@publishExternally" ValueChanged="@(value => publishExternally = value)" aria-label="Publish externally" />
            <div class="space-y-1">
                <TextBlock TextStyle="TextStyle.Subtitle2" Value="Publish externally" />
                <TextBlock TextStyle="TextStyle.Caption" Value="Expose the final draft to downstream reporting and partner tooling." />
            </div>
        </Cluster>
    </div>
</Grid>

@code {
    private bool requiresApproval = true;
    private bool publishExternally;
}
