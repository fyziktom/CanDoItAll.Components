@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms

<Stack GapScale="LayoutGap.Medium">
    <Split Breakpoint="LayoutBreakpoint.None" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Medium">
        <SettingsSwitchLabel Text="Publish externally" />
        <Switch Value="@publishExternally" ValueChanged="@(value => publishExternally = value)" />
    </Split>
    <Split Breakpoint="LayoutBreakpoint.None" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Medium">
        <SettingsSwitchLabel>
            <Cluster AlignItems="AlignItems.Center" Gap="LayoutGap.Small">
                <span>Notify reviewer leads</span>
                <StatusBadge Text="Recommended" Tone="info" />
            </Cluster>
        </SettingsSwitchLabel>
        <Switch Value="@notifyLeads" ValueChanged="@(value => notifyLeads = value)" />
    </Split>
</Stack>

@code {
    private bool publishExternally;
    private bool notifyLeads = true;
}
