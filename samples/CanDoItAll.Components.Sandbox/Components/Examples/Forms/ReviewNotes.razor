@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms

<FormField Text="Notes">
    <TextArea Value="@notes"
              ValueChanged="@(value => notes = value ?? string.Empty)"
              Placeholder="Explain context, risk, and reviewer expectations." />
</FormField>

@code {
    private string notes = "Capture enough context for the reviewer to understand the request without reading surrounding application code.";
}
