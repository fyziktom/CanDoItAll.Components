@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms
@inherits FormsShowcaseBase

<Grid Gap="LayoutGap.Large" ColumnTemplate="repeat(auto-fit,minmax(16rem,1fr))">
    <FormField Text="Status">
        <SelectInput TValue="string"
                     Value="@FormState.Status"
                     ValueChanged="HandleStatusChanged"
                     ValueExpression="@(() => FormState.Status)"
                     disabled="@IsDisabled">
            <option value="">Select status</option>
            @foreach (var option in StatusOptions)
            {
                <option value="@option.Value">@option.Text</option>
            }
        </SelectInput>
    </FormField>

    <FormField Text="Status (enum values, disabled option)">
        <SelectInput TValue="ReviewStatus?"
                     Value="@NativeModel.Status"
                     ValueChanged="@(value => NativeModel.Status = value)"
                     ValueExpression="@(() => NativeModel.Status)"
                     data-testid="native-status">
            <option value="">Unset</option>
            @foreach (var status in Enum.GetValues<ReviewStatus>())
            {
                <option value="@status" disabled="@(status == ReviewStatus.Blocked)">@status</option>
            }
        </SelectInput>
    </FormField>
</Grid>
