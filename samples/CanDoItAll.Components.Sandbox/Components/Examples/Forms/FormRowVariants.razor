@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms
@inherits FormsShowcaseBase

<Stack GapScale="LayoutGap.Medium" data-testid="sandbox-forms-row-variants">
    <FormRow Split="true">
        <FormField Text="Priority threshold">
            <Slider TValue="int"
                    Value="@AdvancedState.Priority"
                    ValueChanged="HandlePriorityChanged"
                    Min="0"
                    Max="100"
                    Step="5"
                    Disabled="@IsDisabled" />
        </FormField>
        <FormField Text="Budget reference">
            <TextInput Value="@AdvancedState.BudgetCode"
                       ValueChanged="HandleBudgetCodeChanged"
                       ValueExpression="@(() => AdvancedState.BudgetCode)"
                       placeholder="Review budget code"
                       disabled="@IsDisabled" />
        </FormField>
    </FormRow>
    <FormRow Split="false">
        <FormField Text="Notes">
            <TextAreaInput Value="@FormState.Notes"
                            ValueChanged="HandleNotesChanged"
                            ValueExpression="@(() => FormState.Notes)"
                            placeholder="@NotesPlaceholder"
                            disabled="@IsDisabled" />
        </FormField>
    </FormRow>
</Stack>
