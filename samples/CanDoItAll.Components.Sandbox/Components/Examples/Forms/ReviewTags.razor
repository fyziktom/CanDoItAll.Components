@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms

<FormField Text="Tags">
    <TagEditor Value="@tags"
               ValueChanged="@(value => tags = value)"
               Suggestions="@TagSuggestions"
               Placeholder="Add review tag"
               Hint="Press comma or Enter to add a tag. Suggestions appear while the field is focused."
               MaxTags="8"
               MaxLength="36" />
</FormField>

@code {
    private static readonly IReadOnlyList<string> TagSuggestions =
    [
        "accessibility", "api-contract", "density", "mobile-layout", "publishing", "visual-proof", "wrapping"
    ];

    private IReadOnlyList<string> tags = ["accessibility", "publishing"];
}
