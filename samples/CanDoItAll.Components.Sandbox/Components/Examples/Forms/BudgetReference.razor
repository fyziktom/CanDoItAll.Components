@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms
@inherits FormsShowcaseBase

<FormField Text="Budget reference">
    <PrefixedField Prefix="@BudgetPrefix"
                   Suffix="@BudgetSuffix"
                   StackOnMobile="true"
                   data-testid="sandbox-inputs-prefixed-field">
        <TextInput Value="@AdvancedState.BudgetCode"
                   ValueChanged="HandleBudgetCodeChanged"
                   ValueExpression="@(() => AdvancedState.BudgetCode)"
                   Immediate="true"
                   placeholder="@BudgetCodePlaceholder"
                   disabled="@IsDisabled"
                   data-testid="sandbox-inputs-prefixed-field-input" />
    </PrefixedField>
</FormField>
