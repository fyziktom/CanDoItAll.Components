@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms
@inherits FormsShowcaseBase

<Grid Gap="LayoutGap.Large" ColumnTemplate="repeat(auto-fit,minmax(16rem,1fr))">
    <FormField Text="Confidence">
        <NumberInput TValue="int"
                     Value="@FormState.Confidence"
                     ValueChanged="HandleConfidenceChanged"
                     ValueExpression="@(() => FormState.Confidence)"
                     min="0"
                     max="100"
                     step="5"
                     disabled="@IsDisabled" />
    </FormField>

    <FormField Text="Confidence (disabled)">
        <NumberInput TValue="int"
                     Value="@FormState.Confidence"
                     ValueChanged="HandleConfidenceChanged"
                     ValueExpression="@(() => FormState.Confidence)"
                     min="0"
                     max="100"
                     step="5"
                     disabled="true" />
    </FormField>
</Grid>
