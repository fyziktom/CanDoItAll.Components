@namespace CanDoItAll.Components.Sandbox.Components.Examples.Forms
@inherits FormsShowcaseBase

<FormField Text="Reference code" data-testid="sandbox-forms-field-slots">
    <Start>
        <Icon Name="tag" />
    </Start>
    <ChildContent>
        <TextBox Value="@AdvancedState.BudgetCode"
                 ValueChanged="HandleBudgetCodeChanged"
                 Placeholder="Review budget code"
                 Disabled="@IsDisabled"
                 Class="cda-input" />
    </ChildContent>
    <End>
        <StatusBadge Text="Synced" Tone="success" />
    </End>
</FormField>
