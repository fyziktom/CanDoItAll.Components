@namespace CanDoItAll.Components.Sandbox.Components.Examples.Benchmark
@using System.Text
@using System.Text.Json
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="space-y-4">
    <FormField Text="Items to aggregate" ContainerClass="max-w-xs">
        <DropDown TValue="int"
                  Data="@ItemCounts"
                  Value="@itemCount"
                  ValueChanged="HandleItemCountChanged"
                  aria-label="Worker C# items to aggregate" />
    </FormField>

    <Button Text="Run worker C# benchmark" Click="RunBenchmarkAsync" Disabled="@(worker is null)" data-testid="benchmark-worker-wasm-run" />

    @if (initializationError is not null)
    {
        <p class="text-sm text-red-700">@initializationError</p>
    }
    else if (result is null)
    {
        <p class="text-sm opacity-70">No result yet.</p>
    }
    else
    {
        <div class="space-y-3" data-testid="benchmark-worker-wasm-result">
            <div class="flex justify-between items-baseline">
                <div class="text-2xl font-semibold whitespace-nowrap">@($"{result.ElapsedMilliseconds:F1} ms")</div>
                <div class="flex flex-wrap justify-end gap-x-3 gap-y-1 text-base">
                    <span class="whitespace-nowrap">Runs: @samples.Count</span>
                    <span class="whitespace-nowrap">Min: @($"{MinimumMilliseconds:F1} ms")</span>
                    <span class="whitespace-nowrap">Max: @($"{MaximumMilliseconds:F1} ms")</span>
                    <span class="whitespace-nowrap">Avg: <span class="font-semibold">@($"{AverageMilliseconds:F1} ms")</span></span>
                </div>
            </div>
            <p class="text-sm opacity-70">C# runs in a separate Web Worker; array generation and worker messaging are excluded.</p>
            <dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-5">
                @foreach (var fruit in Fruits)
                {
                    <div>
                        <dt class="opacity-70">@fruit</dt>
                        <dd class="font-semibold opacity-70">@result.Counts[fruit]</dd>
                    </div>
                }
            </dl>
        </div>
    }
</div>

@code {
    private static readonly int[] ItemCounts = [100, 1_000, 10_000, 1_000_000];
    private static readonly string[] Fruits = ["Apple", "Banana", "Cherry", "Mango", "Pear"];
    private const string JavaScriptModule = """
        const workerSource = `
            let assemblyExports;
            let startupError;

            self.addEventListener('message', async event => {
                try {
                    if (event.data.command === 'initialize') {
                        const { dotnet } = await import(event.data.frameworkUrl);
                        const { getAssemblyExports, getConfig } = await dotnet.create();
                        const config = getConfig();
                        assemblyExports = await getAssemblyExports(config.mainAssemblyName);
                        self.postMessage({ command: 'initialized' });
                        return;
                    }

                    if (!assemblyExports) throw new Error(startupError || 'The .NET worker runtime did not start.');
                    const result = assemblyExports.CanDoItAll.Components.SandboxWasm.BenchmarkWorkerMethods.AggregateFruitCounts(event.data.itemCount);
                    self.postMessage({ requestId: event.data.requestId, result });
                } catch (error) {
                    const message = error instanceof Error ? error.message : String(error);
                    if (event.data.command === 'initialize') {
                        self.postMessage({ command: 'initializationError', error: message });
                    } else {
                        self.postMessage({ requestId: event.data.requestId, error: message });
                    }
                }
            });`;

        export async function create() {
            const frameworkUrl = new URL('_framework/dotnet.js', document.baseURI).href;
            const workerUrl = URL.createObjectURL(new Blob([workerSource], { type: 'text/javascript' }));
            const worker = new Worker(workerUrl, { type: 'module' });
            let nextRequestId = 0;
            const pendingRequests = new Map();
            let initialize;
            const initialized = new Promise((resolve, reject) => initialize = { resolve, reject });

            worker.addEventListener('message', event => {
                if (event.data.command === 'initialized') {
                    initialize.resolve();
                    return;
                }

                if (event.data.command === 'initializationError') {
                    initialize.reject(new Error(event.data.error));
                    return;
                }

                const pending = pendingRequests.get(event.data.requestId);
                if (!pending) return;
                pendingRequests.delete(event.data.requestId);
                event.data.error ? pending.reject(new Error(event.data.error)) : pending.resolve(event.data.result);
            });

            worker.addEventListener('error', event => {
                const error = new Error(event.message || 'The .NET worker failed.');
                initialize.reject(error);
                for (const pending of pendingRequests.values()) pending.reject(error);
                pendingRequests.clear();
            });

            worker.postMessage({ command: 'initialize', frameworkUrl });
            await initialized;

            return {
                aggregateFruitCounts(itemCount) {
                    const requestId = ++nextRequestId;
                    return new Promise((resolve, reject) => {
                        pendingRequests.set(requestId, { resolve, reject });
                        worker.postMessage({ requestId, itemCount });
                    });
                },
                dispose() {
                    worker.terminate();
                    URL.revokeObjectURL(workerUrl);
                    for (const pending of pendingRequests.values()) pending.reject(new Error('The .NET worker was disposed.'));
                    pendingRequests.clear();
                }
            };
        }
        """;
    private int itemCount = 10_000;
    private Result? result;
    private string? initializationError;
    private IJSObjectReference? module;
    private IJSObjectReference? worker;
    private readonly List<double> samples = [];

    private double MinimumMilliseconds => samples.Min();
    private double MaximumMilliseconds => samples.Max();
    private double AverageMilliseconds => samples.Average();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var moduleUrl = $"data:text/javascript;base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(JavaScriptModule))}";
            module = await JS.InvokeAsync<IJSObjectReference>("import", moduleUrl);
            worker = await module.InvokeAsync<IJSObjectReference>("create");
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            initializationError = "The .NET Web Worker benchmark is available only in SandboxWasm.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleItemCountChanged(int value)
    {
        itemCount = value;
        result = null;
        samples.Clear();
    }

    private async Task RunBenchmarkAsync()
    {
        if (worker is null)
        {
            return;
        }

        var resultJson = await worker.InvokeAsync<string>("aggregateFruitCounts", itemCount);
        result = JsonSerializer.Deserialize<Result>(resultJson);
        if (result is not null)
        {
            samples.Add(result.ElapsedMilliseconds);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (worker is not null)
        {
            await worker.InvokeVoidAsync("dispose");
            await worker.DisposeAsync();
        }

        if (module is not null)
        {
            await module.DisposeAsync();
        }
    }

    private sealed record Result(double ElapsedMilliseconds, Dictionary<string, int> Counts);
}
