@namespace CanDoItAll.Components.Sandbox.Components.Examples.Inputs

<FormField Text="Timed secret">
    <SecretField Value="@secret"
                 ValueChanged="@(value => secret = value ?? string.Empty)"
                 SecretName="sandbox-api-key"
                 ShowNameCopy="true"
                 ShowValueCopy="true"
                 RevealDurationSeconds="30"
                 Placeholder="Managed secret" />
</FormField>

@code {
    private string secret = "secret-token";
}
