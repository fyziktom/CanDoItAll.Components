@namespace CanDoItAll.Components.Sandbox.Components.Examples.Inputs

<Grid Gap="LayoutGap.Large" ColumnTemplate="repeat(auto-fit,minmax(14rem,1fr))">
    <FormField Text="Title">
        <Editable TItem="EditableReviewItem"
                  Item="@item"
                  ItemChanged="@(updated => item = updated)"
                  ParameterName="@nameof(EditableReviewItem.Title)"
                  Placeholder="Review title" />
    </FormField>

    <FormField Text="Confidence">
        <Editable TItem="EditableReviewItem"
                  Item="@item"
                  ItemChanged="@(updated => item = updated)"
                  ParameterName="@nameof(EditableReviewItem.Confidence)"
                  Extension="%" />
    </FormField>

    <FormField Text="Effort">
        <Editable TItem="EditableReviewItem"
                  Item="@item"
                  ItemChanged="@(updated => item = updated)"
                  ParameterName="@nameof(EditableReviewItem.EffortHours)"
                  Format="0.0"
                  Extension=" h" />
    </FormField>

    <FormField Text="Approval">
        <Editable TItem="EditableReviewItem"
                  Item="@item"
                  ItemChanged="@(updated => item = updated)"
                  ParameterName="@nameof(EditableReviewItem.RequiresApproval)"
                  TrueText="Approval required"
                  FalseText="Self review" />
    </FormField>
</Grid>

@code {
    private sealed class EditableReviewItem
    {
        public string Title { get; set; } = "Component validation pass";
        public int Confidence { get; set; } = 70;
        public double EffortHours { get; set; } = 6.5;
        public bool RequiresApproval { get; set; } = true;
    }

    private EditableReviewItem item = new();
}
