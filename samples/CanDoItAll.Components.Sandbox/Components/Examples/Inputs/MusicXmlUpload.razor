@namespace CanDoItAll.Components.Sandbox.Components.Examples.Inputs
@using Microsoft.AspNetCore.Components.Forms

<Grid Gap="LayoutGap.Large" Columns="1" ColumnsLg="2">
    <FileUpload PrimaryText="Drag and drop MusicXML"
                SecondaryText="or browse for a plain `.musicxml` / `.xml` source."
                ButtonText="Choose MusicXML"
                Accept=".musicxml,.xml,text/xml,application/xml"
                Change="HandleUploadChanged" />

    <div class="rounded-[1rem] border border-slate-200 bg-white px-4 py-4">
        <div class="space-y-1">
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Latest selection" />
            <TextBlock TextStyle="TextStyle.Caption" Value="Use this panel to confirm that browse and drop both resolve through the same stable callback." />
        </div>

        @if (uploadedFileNames.Count == 0)
        {
            <p class="mt-3 text-sm leading-6 text-slate-500">No files selected yet.</p>
        }
        else
        {
            <ul class="mt-3 space-y-2 text-sm text-slate-700">
                @foreach (var fileName in uploadedFileNames)
                {
                    <li class="rounded-[0.85rem] bg-slate-50 px-3 py-2">@fileName</li>
                }
            </ul>
        }
    </div>
</Grid>

@code {
    private IReadOnlyList<string> uploadedFileNames = [];

    private Task HandleUploadChanged(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles(10);
        uploadedFileNames = files.Select(file => file.Name).ToArray();
        return Task.CompletedTask;
    }
}
