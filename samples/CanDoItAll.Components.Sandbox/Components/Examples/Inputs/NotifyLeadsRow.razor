@namespace CanDoItAll.Components.Sandbox.Components.Examples.Inputs

<SettingsSwitchRow>
    <div class="min-w-0 space-y-1">
        <SettingsSwitchLabel Text="Notify reviewer leads" />
        <TextBlock TextStyle="TextStyle.Caption" Value="Send a compact summary whenever priority, tags, or selected lane changes." />
    </div>
    <Switch Value="@notifyLeads" ValueChanged="@(value => notifyLeads = value)" AriaLabel="Notify reviewer leads" />
</SettingsSwitchRow>

@code {
    private bool notifyLeads = true;
}
