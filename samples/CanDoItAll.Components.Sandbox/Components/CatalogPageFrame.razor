@namespace CanDoItAll.Components.Sandbox.Components

<div class="sandbox-page">
    <PageScaffold MaxWidthClass="max-w-[1720px]">
            <Header>
                <PageHeader Title="@Group.Title"
                            Description="@Group.Summary" />

                @if (ToolbarState is { ShowCoverage: true })
                {
                    <div class="sandbox-page-section flex flex-col gap-4 cda-section-card">
                        <SectionCard Title="Coverage" Description="Areas the default/dense/empty screenshots need to make obvious.">
                            <ul class="list-decimal ml-5">
                                @foreach (var note in Group.ProofNotes)
                                {
                                    <li>@note</li>
                                }
                            </ul>
                        </SectionCard>
                    </div>
                }
            </Header>

            <ChildContent>
                <div class="sandbox-page-section flex flex-col gap-4">
                    <div class="sandbox-demo-frame @Frame.ToSurfaceClass()" data-testid="sandbox-demo-surface">
                        <div class="sandbox-demo-stage">
                            @ChildContent
                        </div>
                    </div>
                </div>

                @* Examples and API tables sit outside the demo frame so the Desktop/Mobile
                   presets constrain only the proof surface, not the reference material. *@
                @if (Examples is not null)
                {
                    <div class="sandbox-page-section flex flex-col gap-4">
                        <SectionCard Title="Examples"
                                     Description="Copy-ready markup. Each snippet is the embedded source of the component rendering above it.">
                            <div class="sandbox-example-list" data-testid="sandbox-examples">
                                @Examples
                            </div>
                        </SectionCard>
                    </div>
                }

                @if (Api is not null)
                {
                    <div class="sandbox-page-section flex flex-col gap-4">
                        <SectionCard Title="Component API"
                                     Description="Parameters reflected from the compiled assembly; descriptions come from the /// comments on each component.">
                            <div class="sandbox-api-list" data-testid="sandbox-api">
                                @Api
                            </div>
                        </SectionCard>
                    </div>
                }
            </ChildContent>
    </PageScaffold>
</div>

@code {
    [Parameter, EditorRequired]
    public SandboxGroupDefinition Group { get; set; } = default!;

    [Parameter, EditorRequired]
    public SandboxScenarioKey Scenario { get; set; }

    [Parameter, EditorRequired]
    public SandboxFramePreset Frame { get; set; }

    [Parameter]
    public int ExampleCount { get; set; }

    // No longer invoked by this component — scenario/frame changes are now driven by the
    // fixed top toolbar via SandboxToolbarState, wired through CatalogPageBase.SetParametersAsync.
    // Kept as parameters so existing <CatalogPageFrame ScenarioChanged="NavigateScenario" ...>
    // markup on the other catalog pages keeps compiling unchanged.
    [Parameter]
    public EventCallback<SandboxScenarioKey> ScenarioChanged { get; set; }

    [Parameter]
    public EventCallback<SandboxFramePreset> FrameChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Copy-ready examples rendered below the scenario proof surface.</summary>
    [Parameter]
    public RenderFragment? Examples { get; set; }

    /// <summary>Component API tables rendered below the examples.</summary>
    [Parameter]
    public RenderFragment? Api { get; set; }

    [CascadingParameter]
    public SandboxToolbarState? ToolbarState { get; set; }
}
