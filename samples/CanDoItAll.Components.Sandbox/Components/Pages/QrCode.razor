@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/qr"
@inherits CatalogPageBase
@using CanDoItAll.Components.QRCode.Components
@using CanDoItAll.Components.Sandbox.Components.Examples.QrCode

<PageTitle>QR Code</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @foreach (var section in Sections)
        {
            <section id="@section.Anchor" class="sandbox-component-section">
                <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                @if (section.ComponentName == "QrCodeView")
                {
                    <ExampleBlock Title="Rendered payload"
                                  Description="Direct SVG output with a visible caption and accessible name. Long payloads increase density and error correction; the empty scenario proves the no-payload state."
                                  SourceId="examples/QrCode/RenderedPayload.razor"
                                  ApiTypes="@QrCodeViewApiTypes">
                        <RenderedPayload />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "QrCodeButton")
                {
                    <ExampleBlock Title="Dialog show action"
                                  Description="Opens the payload inside a BaseLib dialog instead of rendering it inline."
                                  SourceId="examples/QrCode/DialogShowAction.razor"
                                  ApiTypes="@QrCodeButtonApiTypes">
                        <DialogShowAction />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "QrScanButton")
                {
                    <ExampleBlock Title="Manual scanner fallback"
                                  Description="Camera access is disabled here, so the scan dialog always offers a manual paste fallback."
                                  SourceId="examples/QrCode/ManualScannerFallback.razor"
                                  ApiTypes="@QrScanButtonApiTypes">
                        <ManualScannerFallback />
                    </ExampleBlock>
                }
            </section>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.QrCode);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.QrCode);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/qr");

    private static readonly IReadOnlyList<Type> QrCodeViewApiTypes = [typeof(QrCodeView)];
    private static readonly IReadOnlyList<Type> QrCodeButtonApiTypes = [typeof(QrCodeButton)];
    private static readonly IReadOnlyList<Type> QrScanButtonApiTypes = [typeof(QrScanButton)];

}
