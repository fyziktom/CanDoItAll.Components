@namespace CanDoItAll.Components.Sandbox.Components
@page "/"

<PageTitle>Components Sandbox</PageTitle>

<div class="sandbox-page">
    <PageScaffold MaxWidthClass="max-w-[1720px]">
        <Header>
            <PageHeader Title="Components Sandbox">
                <Actions>
                    <StatusBadge Text="@($"{SandboxCatalogRegistry.UniqueComponentCount} components")" />
                </Actions>
            </PageHeader>
        </Header>

        <ChildContent>
            <div class="sandbox-list">
                @foreach (var group in SandboxCatalogRegistry.Groups)
                {
                    var sections = SandboxCatalogRegistry.GetSections(group.Route);

                    <div class="space-y-1">
                        <a href="@group.Route" class="sandbox-toc-group block">@group.Title</a>

                        @if (sections.Count > 0)
                        {
                            <p class="sandbox-toc-items">
                                @for (var i = 0; i < sections.Count; i++)
                                {
                                    var section = sections[i];
                                    <a href="@($"{group.Route}#{section.Anchor}")">@(section.ComponentName)</a>@(i < sections.Count - 1 ? ", " : "")
                                }
                            </p>
                        }
                    </div>
                }
            </div>
        </ChildContent>
    </PageScaffold>
</div>
