@namespace CanDoItAll.Components.Sandbox.Components
@page "/"
@inject NavigationManager NavigationManager

<PageTitle>Components Sandbox</PageTitle>

<div class="sandbox-page">
    <PageScaffold MaxWidthClass="max-w-[1720px]">
        <Header>
            <PageHeader Title="Components Sandbox">
                <Actions>
                    <StatusBadge Text="@($"{VisibleComponentCount} components")" />
                </Actions>
            </PageHeader>
        </Header>

        <ChildContent>
            <div class="sandbox-list">
                @foreach (var group in SandboxCatalogRegistry.Groups)
                {
                    var sections = VisibleSections(SandboxCatalogRegistry.GetSections(group.Route));
                    if (sections.Count == 0)
                    {
                        continue;
                    }

                    <div class="space-y-1">
                        <a href="@BuildGroupLink(group.Route)" data-sandbox-route
                           class="sandbox-toc-group block @(SandboxCatalogRegistry.IsGroupUnused(group.Route) ? "is-unused" : string.Empty)">@group.Title</a>

                        <p class="sandbox-toc-items">
                            @for (var i = 0; i < sections.Count; i++)
                            {
                                var section = sections[i];
                                <a href="@BuildGroupLink(group.Route, section.Anchor)" data-sandbox-route
                                   class="@(SandboxCatalogRegistry.IsUnused(section.ComponentName) ? "is-unused" : string.Empty)">@(section.ComponentName)</a>@(i < sections.Count - 1 ? ", " : "")
                            }
                        </p>
                    </div>
                }
            </div>
        </ChildContent>
    </PageScaffold>
</div>

@code {
    [CascadingParameter]
    public SandboxToolbarState? ToolbarState { get; set; }

    /// <summary>Unused directly; accepted so the hash-routing shim in Routes.razor can route
    /// here (as it does for every other catalog page) without an unknown-parameter error.</summary>
    [Parameter]
    public string? HashRouteState { get; set; }

    private string BuildGroupLink(string route, string? anchor = null)
        => SandboxQueryLinks.BuildCrossPageLink(
            NavigationManager,
            route,
            frame: SandboxQueryLinks.GetCurrentFrame(NavigationManager),
            isDark: false,
            fragment: anchor);

    private IReadOnlyList<SandboxPageSection> VisibleSections(IReadOnlyList<SandboxPageSection> sections)
        => SandboxCatalogRegistry.FilterVisible(sections, ToolbarState is { ShowUnused: true });

    private int VisibleComponentCount
        => SandboxCatalogRegistry.VisibleComponentCount(ToolbarState is { ShowUnused: true });
}
