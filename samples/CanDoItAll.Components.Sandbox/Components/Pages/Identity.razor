@namespace CanDoItAll.Components.Sandbox.Components
@page "/identity"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Identity

<PageTitle>Identity</PageTitle>

<CatalogPageFrame Group="@Group"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  FrameChanged="NavigateFrame">
    <ChildContent>

            @foreach (var section in VisibleSections(Sections))
            {
                <section id="@(section.Anchor)" class="sandbox-component-section">
                    @RenderSectionHeading(section)

                    @if (section.ComponentName == "Icon")
                    {
                        <ExampleBlock Title="Icon language"
                                      Description="Icons should support scanning rather than act like decoration."
                                      SourceId="examples/Identity/IconLanguage.razor"
                                      ApiTypes="@IconApiTypes">
                            <IconLanguage />
                        </ExampleBlock>

                        <ExampleBlock Title="Icon playground"
                                      Description="Adjust size and the Material Symbols variation axes to see how a glyph responds."
                                      SourceId="examples/Identity/IconPlayground.razor"
                                      ApiTypes="@IconApiTypes">
                            <IconPlayground />
                        </ExampleBlock>

                        <ExampleBlock Title="Icon alias catalog"
                                      Description="The full set of semantic shorthand tokens the icon resolver understands, previewed against their resolved Material Symbols glyph."
                                      SourceId="examples/Identity/MaterialIconCatalogGallery.razor">
                            <MaterialIconCatalogGallery />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Avatar")
                    {
                        <ExampleBlock Title="Avatar"
                                      Description="An image avatar with automatic fallback to a bundled stock photo or initials text, in three sizes and two shapes."
                                      SourceId="examples/Identity/AvatarShowcase.razor"
                                      ApiTypes="@AvatarApiTypes">
                            <AvatarShowcase />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "CreatorLine")
                    {
                        <ExampleBlock Title="Creator byline"
                                      Description="A flex row that composes an avatar, name, and social links into a compact byline."
                                      SourceId="examples/Identity/CreatorLineShowcase.razor"
                                      ApiTypes="@CreatorLineApiTypes">
                            <CreatorLineShowcase />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "CreatorSocialLink")
                    {
                        <ExampleBlock Title="Social link"
                                      Description="A styled anchor for a creator's social or external profile link."
                                      SourceId="examples/Identity/CreatorSocialLinkShowcase.razor"
                                      ApiTypes="@CreatorSocialLinkApiTypes">
                            <CreatorSocialLinkShowcase />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "HomoAvatar")
                    {
                        <ExampleBlock Title="Seed-generated avatars"
                                      Description="Deterministic human avatars generated purely from a seed string, with harmonized body/mouth/eye coloring."
                                      SourceId="examples/Identity/HomoAvatarGallery.razor"
                                      ApiTypes="@HomoAvatarApiTypes">
                            <HomoAvatarGallery />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "RoboAvatar")
                    {
                        <ExampleBlock Title="Seed-generated avatars"
                                      Description="Deterministic robot avatars generated purely from a seed string, with harmonized body/mouth/eye coloring."
                                      SourceId="examples/Identity/RoboAvatarGallery.razor"
                                      ApiTypes="@RoboAvatarApiTypes">
                            <RoboAvatarGallery />
                        </ExampleBlock>
                    }
                </section>
            }

    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Identity);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Identity);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/identity");

    private static readonly IReadOnlyList<Type> IconApiTypes = [typeof(Icon)];
    private static readonly IReadOnlyList<Type> AvatarApiTypes = [typeof(Avatar)];
    private static readonly IReadOnlyList<Type> CreatorLineApiTypes = [typeof(CreatorLine)];
    private static readonly IReadOnlyList<Type> CreatorSocialLinkApiTypes = [typeof(CreatorSocialLink)];
    private static readonly IReadOnlyList<Type> HomoAvatarApiTypes = [typeof(HomoAvatar)];
    private static readonly IReadOnlyList<Type> RoboAvatarApiTypes = [typeof(RoboAvatar)];

}
