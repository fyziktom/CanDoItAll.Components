@namespace CanDoItAll.Components.Sandbox.Components
@page "/lists"
@inherits CatalogPageBase
@using CanDoItAll.Components.Common
@using CanDoItAll.Components.Sandbox.Components.Examples.Lists

<PageTitle>Lists</PageTitle>

<CatalogPageFrame Group="@Group"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  FrameChanged="NavigateFrame">
    <ChildContent>

            @foreach (var section in VisibleSections(Sections))
            {
                <section id="@(section.Anchor)" class="sandbox-component-section" data-testid="data-display-selection-rows">
                    @RenderSectionHeading(section)

                    @if (section.ComponentName == "ListDetailShell")
                    {
                        <ExampleBlock Title="Shared records list-detail"
                                      Description="The lower split region should still orient the user, whether it holds full record content or an explanatory empty state."
                                      SourceId="examples/Lists/RecordListDetailShell.razor"
                                      ApiTypes="@ListDetailShellApiTypes">
                        <RecordListDetailShell />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "SelectionListItem")
                    {
                        <ExampleBlock Title="Records"
                                      Description="The primary list owns the useful first viewport."
                                      SourceId="examples/Lists/Records.razor"
                                      ApiTypes="@SelectionListItemApiTypes">
                        <Records />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "FactTable")
                    {
                        <ExampleBlock Title="Fact grid"
                                      Description="A bordered card for label/value fact pairs — the same wrapper StorageSummaryCard uses to lay out its facts grid."
                                      SourceId="examples/Lists/FactGrid.razor"
                                      ApiTypes="@FactTableApiTypes">
                        <FactGrid />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "ListGroup")
                    {
                        <ExampleBlock Title="Grouped list"
                                      Description="Vertical rhythm container for stacking bordered ListItem rows."
                                      SourceId="examples/Lists/GroupedItems.razor"
                                      ApiTypes="@ListGroupApiTypes">
                        <GroupedItems />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "ListItem")
                    {
                        <ExampleBlock Title="List item card"
                                      Description="A single bordered, shadowed card row — the atomic unit ListGroup and ListDetailShell arrange."
                                      SourceId="examples/Lists/ProfileCard.razor"
                                      ApiTypes="@ListItemApiTypes">
                        <ProfileCard />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "ListPanelHeader")
                    {
                        <ExampleBlock Title="Panel header"
                                      Description="Title, count pill, help popover, actions, and filters composed above a list."
                                      SourceId="examples/Lists/PanelHeader.razor"
                                      ApiTypes="@ListPanelHeaderApiTypes">
                        <PanelHeader />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "MetaList")
                    {
                        <ExampleBlock Title="Metadata row"
                                      Description="Inline wrapping row for lightweight metadata such as timestamps and counts."
                                      SourceId="examples/Lists/MetaRow.razor"
                                      ApiTypes="@MetaListApiTypes">
                        <MetaRow />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "PlainList")
                    {
                        <ExampleBlock Title="Plain bulleted list"
                                      Description="A simple disc-bulleted list for supporting checklist or requirement content."
                                      SourceId="examples/Lists/BulletList.razor"
                                      ApiTypes="@PlainListApiTypes">
                        <BulletList />
                        </ExampleBlock>
                    }
                </section>
            }

    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Lists);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Lists);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/lists");

    private static readonly IReadOnlyList<Type> ListDetailShellApiTypes = [typeof(ListDetailShell)];
    private static readonly IReadOnlyList<Type> SelectionListItemApiTypes = [typeof(SelectionListItem)];
    private static readonly IReadOnlyList<Type> FactTableApiTypes = [typeof(FactTable)];
    private static readonly IReadOnlyList<Type> ListGroupApiTypes = [typeof(ListGroup)];
    private static readonly IReadOnlyList<Type> ListItemApiTypes = [typeof(ListItem)];
    private static readonly IReadOnlyList<Type> ListPanelHeaderApiTypes = [typeof(ListPanelHeader)];
    private static readonly IReadOnlyList<Type> MetaListApiTypes = [typeof(MetaList)];
    private static readonly IReadOnlyList<Type> PlainListApiTypes = [typeof(PlainList)];

    private string panelHeaderFilter = string.Empty;

    private const bool IsDisabled = false;

    private WorkspaceItem SelectedItem => WorkspaceItems[0];

    private IReadOnlyList<WorkspaceItem> WorkspaceItems => DenseItems;

    private IReadOnlyList<DisplayRowModel> Rows => LongRows;

    private static readonly IReadOnlyList<WorkspaceItem> BaseItems =
    [
        new("layout-shell", "Layout shell", "Header / rail", "Shared shell keeps main content, supporting rail, and sticky actions in distinct regions.", "Ready", "success", "The default page composition holds together without one-off wrappers."),
        new("detail-pane", "Detail pane", "Split view", "The selected record has enough room for operational detail without hiding the list.", "Active", "info", "Split layout should preserve both orientation and detail context.")
    ];

    private static readonly IReadOnlyList<WorkspaceItem> DenseItems =
    [
        new("layout-shell", "Layout shell", "Header / rail", "Shared shell keeps main content, supporting rail, and sticky actions in distinct regions.", "Ready", "success", "The default page composition holds together without one-off wrappers."),
        new("detail-pane", "Detail pane", "Split view", "The selected record has enough room for operational detail without hiding the list.", "Active", "info", "Split layout should preserve both orientation and detail context."),
        new("dense-review", "Dense review lane", "Proof / actions", "Denser sections still need obvious grouping and a visible path to completion.", "Review", "warning", "Dense mode cannot become an undifferentiated grid of bordered boxes.")
    ];

    private static readonly IReadOnlyList<DisplayRowModel> BaseRows =
    [
        new(DisplayItemId.New(), "Shell registry", "Catalog", "groups / routes", "Each shared group page feeds both the sandbox navigation and the future MCP search index.", "Ready", "success", [new("Catalog", "info"), new("Shared", "neutral")]),
        new(DisplayItemId.New(), "Canvas contract", "Canvas", "surface / state", "Workbench and calendar contracts keep typed surfaces and reusable preview evidence.", "Active", "info", [new("Typed", "success"), new("Preview", "warning")])
    ];

    private static readonly IReadOnlyList<DisplayRowModel> DenseRows =
    [
        new(DisplayItemId.New(), "Shell registry", "Catalog", "groups / routes", "Each shared group page feeds both the sandbox navigation and the future MCP search index.", "Ready", "success", [new("Catalog", "info"), new("Shared", "neutral")]),
        new(DisplayItemId.New(), "Canvas contract", "Canvas", "surface / state", "Workbench and calendar contracts keep typed surfaces and reusable preview evidence.", "Active", "info", [new("Typed", "success"), new("Preview", "warning")]),
        new(DisplayItemId.New(), "Screenshot proof", "Validation", "desktop / mobile", "Dense and empty proof captures stay attached to the same shared group model.", "Pending", "warning", [new("Dense", "warning"), new("Empty", "success")])
    ];

    private static readonly IReadOnlyList<DisplayRowModel> LongRows =
    [
        new(DisplayItemId.New(), "Shell registry with extended explanatory summary", "Catalog", "groups / routes", "Longer row summaries still need clear separation between the title, metadata, supporting chips, and the open action.", "Ready", "success", [new("Catalog", "info"), new("Shared", "neutral")]),
        new(DisplayItemId.New(), "Canvas contract and boundary previews", "Canvas", "surface / state", "Longer row labels should not break the right edge or hide the state treatment on narrower frames.", "Active", "info", [new("Typed", "success"), new("Preview", "warning")])
    ];

    private sealed record WorkspaceItem(string Id, string Title, string Eyebrow, string Summary, string State, string Tone, string Detail)
    {
        public string Meta => Id;
    }

    private readonly record struct DisplayItemId(Guid Value)
    {
        public static DisplayItemId New() => new(Guid.NewGuid());
    }

    private sealed record DisplayRowChip(string Text, string Tone);

    private sealed record DisplayRowModel(
        DisplayItemId Id,
        string Title,
        string Eyebrow,
        string Meta,
        string Summary,
        string State,
        string Tone,
        IReadOnlyList<DisplayRowChip> Chips);
}
