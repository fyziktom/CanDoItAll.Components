@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/storage"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Storage

<PageTitle>Storage</PageTitle>

<CatalogPageFrame Group="@Group"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  FrameChanged="NavigateFrame">
    <ChildContent>

            @foreach (var section in Sections)
            {
                <section id="@section.Anchor" class="sandbox-component-section">
                    <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                    @if (section.ComponentName == "StorageBadgeStrip")
                    {
                        <ExampleBlock Title="Storage status badges"
                                      Description="A compact row of tone-driven status badges."
                                      SourceId="examples/Storage/StorageStatusBadges.razor"
                                      ApiTypes="@StorageBadgeStripApiTypes">
                            <StorageStatusBadges />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "StorageSummaryCard")
                    {
                        <ExampleBlock Title="Storage summary card"
                                      Description="Badge strip and fact grid together, with an emphasized variant for the active plan."
                                      SourceId="examples/Storage/StorageSummary.razor"
                                      ApiTypes="@StorageSummaryCardApiTypes">
                            <StorageSummary />
                        </ExampleBlock>
                    }
                </section>
            }

    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Storage);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Storage);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/storage");

    private static readonly IReadOnlyList<Type> StorageBadgeStripApiTypes = [typeof(StorageBadgeStrip)];
    private static readonly IReadOnlyList<Type> StorageSummaryCardApiTypes = [typeof(StorageSummaryCard)];

}
