@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/navigation"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Navigation

<PageTitle>Navigation</PageTitle>

<CatalogPageFrame Group="@Group"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @foreach (var section in Sections)
        {
            <section id="@section.Anchor" class="sandbox-component-section">
                <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                @if (section.ComponentName == "Tabs")
                {
                    <ExampleBlock Title="Basic tabs"
                                  Description="This is the default recommendation: readable labels, a visible selected state, and a panel surface that feels attached to the active tab."
                                  SourceId="examples/Navigation/BasicTabs.razor"
                                  ApiTypes="@TabsApiTypes">
                        <BasicTabs />
                    </ExampleBlock>

                    <ExampleBlock Title="Advanced accent colors"
                                  Description="Accent colors are an advanced option. They should change the emphasis, not rescue an otherwise weak selected state."
                                  SourceId="examples/Navigation/AccentColors.razor">
                        <AccentColors />
                    </ExampleBlock>

                    <ExampleBlock Title="Shell customization"
                                  Description="Use the shared tabs contract first, then add a consumer shell with the root Class when the page needs stronger atmosphere. The dark workstation shell is a specialized treatment, not the baseline look."
                                  SourceId="examples/Navigation/ShellCustomization.razor">
                        <ShellCustomization />
                    </ExampleBlock>

                    <ExampleBlock Title="Optional borderless compact mode"
                                  Description="Compact modal usage can intentionally remove the button border when the pill treatment reads better."
                                  SourceId="examples/Navigation/CompactBorderless.razor">
                        <CompactBorderless />
                    </ExampleBlock>

                    <ExampleBlock Title="Missing title fallback"
                                  Description="The fallback label should read like a real control, not like the component broke when a title was omitted."
                                  SourceId="examples/Navigation/MissingTitleFallback.razor">
                        <MissingTitleFallback />
                    </ExampleBlock>

                    <ExampleBlock Title="Overflow strategies"
                                  Description="When wrapping becomes too noisy, scroll mode keeps the control to one row without clipping labels or breaking focus behavior."
                                  SourceId="examples/Navigation/OverflowStrategies.razor">
                        <OverflowStrategies />
                    </ExampleBlock>

                    <ExampleBlock Title="Vertical tabs for settings rails"
                                  Description="Left-positioned tabs need the same visual confidence and should collapse back to a sensible mobile stack."
                                  SourceId="examples/Navigation/VerticalRail.razor">
                        <VerticalRail />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "Toolbar")
                {
                    <ExampleBlock Title="Filter toolbar"
                                  Description="Shared sheet toolbar structure groups filter fields and reset actions without custom page chrome."
                                  SourceId="examples/Navigation/FilterToolbar.razor"
                                  ApiTypes="@ToolbarApiTypes">
                        <FilterToolbar />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "TreeView")
                {
                    <ExampleBlock Title="Adaptive tree with context menu"
                                  Description="Hierarchical selection, expansion, and right-click actions stay bounded and connected to the selected node."
                                  SourceId="examples/Navigation/AdaptiveTree.razor"
                                  ApiTypes="@TreeViewApiTypes">
                        <AdaptiveTree />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "Steps")
                {
                    <ExampleBlock Title="Linear step flow"
                                  Description="Step flow should read clearly at a glance and support linear progression."
                                  SourceId="examples/Navigation/LinearSteps.razor"
                                  ApiTypes="@StepsApiTypes">
                        <LinearSteps />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "PageHeader")
                {
                    <ExampleBlock Title="Header variants"
                                  Description="A standard header carries eyebrow, title, description, and trailing actions; a compact header fits inside list-detail and rail panes."
                                  SourceId="examples/Navigation/PageHeaderVariants.razor"
                                  ApiTypes="@PageHeaderApiTypes">
                        <PageHeaderVariants />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "SideMenu")
                {
                    <ExampleBlock Title="Responsive side menu with service-driven context"
                                  Description="Parameter-fed and declarative items, measured overflow, bottom utilities, custom panels, and service-driven context switching in one bounded workspace."
                                  SourceId="examples/Navigation/SideMenuWorkspace.razor"
                                  ApiTypes="@SideMenuApiTypes">
                        <SideMenuWorkspace />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "ContextMenu")
                {
                    <ExampleBlock Title="Trigger-driven context menu"
                                  Description="Opens at a real cursor/click position and closes on selection, Escape, or an outside click."
                                  SourceId="examples/Navigation/ContextMenuDemo.razor"
                                  ApiTypes="@ContextMenuApiTypes">
                        <ContextMenuDemo />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "FilterBar")
                {
                    <ExampleBlock Title="Filter bar"
                                  Description="Rounded bar pairing filter controls with a result count and reset action."
                                  SourceId="examples/Navigation/FilterBarDemo.razor"
                                  ApiTypes="@FilterBarApiTypes">
                        <FilterBarDemo />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "LegalToc")
                {
                    <ExampleBlock Title="Collapsible table of contents"
                                  Description="A disclosure wrapper for a section's table of contents."
                                  SourceId="examples/Navigation/LegalTableOfContents.razor"
                                  ApiTypes="@LegalTocApiTypes">
                        <LegalTableOfContents />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "LegalTocNav")
                {
                    <ExampleBlock Title="Standalone link nav"
                                  Description="LegalTocNav has no dependency on LegalToc — it can render as an always-visible related-links list."
                                  SourceId="examples/Navigation/RelatedLinksNav.razor"
                                  ApiTypes="@LegalTocNavApiTypes">
                        <RelatedLinksNav />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "PageHeaderActionButton")
                {
                    <ExampleBlock Title="Quick action buttons"
                                  Description="Icon buttons with tooltip fallback text, meant to sit inline in a PageHeader's Actions region."
                                  SourceId="examples/Navigation/QuickActionButtons.razor"
                                  ApiTypes="@PageHeaderActionButtonApiTypes">
                        <QuickActionButtons />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "RibbonTabs")
                {
                    <ExampleBlock Title="Ribbon tool tabs"
                                  Description="A collapsible ribbon strip with tool tabs and a panel region, e.g. for document-editor-style toolbars."
                                  SourceId="examples/Navigation/RibbonToolbar.razor"
                                  ApiTypes="@RibbonTabsApiTypes">
                        <RibbonToolbar />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "SecondaryTabs")
                {
                    <ExampleBlock Title="Pill status filter"
                                  Description="Key-based pill tab switcher, distinct from the index-based Tabs component."
                                  SourceId="examples/Navigation/StatusFilterTabs.razor"
                                  ApiTypes="@SecondaryTabsApiTypes">
                        <StatusFilterTabs />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "SideMenuItem")
                {
                    <ExampleBlock Title="Declarative side menu items"
                                  Description="SideMenuItem registers itself with its parent SideMenu; this focuses on item-level parameters like badges, disabled state, and nested children."
                                  SourceId="examples/Navigation/SideMenuItemShowcase.razor"
                                  ApiTypes="@SideMenuItemStandaloneApiTypes">
                        <SideMenuItemShowcase />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "StepsItem")
                {
                    <ExampleBlock Title="Steps with icons and a disabled step"
                                  Description="StepsItem-specific parameters: a custom badge icon and a step disabled from selection."
                                  SourceId="examples/Navigation/StepsWithIcons.razor"
                                  ApiTypes="@StepsItemApiTypes">
                        <StepsWithIcons />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "TabsItem")
                {
                    <ExampleBlock Title="Tab item parameters"
                                  Description="BadgeText, Disabled, and dynamic Visible toggling on individual tabs."
                                  SourceId="examples/Navigation/TabsItemBadges.razor"
                                  ApiTypes="@TabsItemStandaloneApiTypes">
                        <TabsItemBadges />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "ToolbarActions")
                {
                    <ExampleBlock Title="Action button cluster"
                                  Description="Grouped action buttons within a toolbar row, independent of any filter fields."
                                  SourceId="examples/Navigation/ToolbarActionCluster.razor"
                                  ApiTypes="@ToolbarActionsApiTypes">
                        <ToolbarActionCluster />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "ToolbarFields")
                {
                    <ExampleBlock Title="Filter field cluster"
                                  Description="Grouped filter fields within a toolbar row, without any action buttons."
                                  SourceId="examples/Navigation/ToolbarFilterFields.razor"
                                  ApiTypes="@ToolbarFieldsApiTypes">
                        <ToolbarFilterFields />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "ToolbarRow")
                {
                    <ExampleBlock Title="Stacked toolbar rows"
                                  Description="Multiple ToolbarRow elements inside one Toolbar, e.g. a filter row above a bulk-actions row."
                                  SourceId="examples/Navigation/StackedToolbarRows.razor"
                                  ApiTypes="@ToolbarRowApiTypes">
                        <StackedToolbarRows />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "TreeViewNodeRow")
                {
                    <ExampleBlock Title="Adaptive row contract"
                                  Description="TreeViewNodeRow renders one recursive row: adaptive labels, compact badges, and a right-positioned tooltip for long content."
                                  SourceId="examples/Navigation/AdaptiveRowContract.razor"
                                  ApiTypes="@TreeViewNodeRowApiTypes">
                        <AdaptiveRowContract />
                    </ExampleBlock>
                }
            </section>
        }
    </ChildContent>
</CatalogPageFrame>


@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Navigation);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Navigation);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/navigation");

    private static readonly IReadOnlyList<Type> TabsApiTypes = [typeof(Tabs), typeof(TabsItem)];
    private static readonly IReadOnlyList<Type> ToolbarApiTypes = [typeof(Toolbar)];
    private static readonly IReadOnlyList<Type> TreeViewApiTypes = [typeof(TreeView), typeof(ContextMenu)];
    private static readonly IReadOnlyList<Type> StepsApiTypes = [typeof(Steps)];
    private static readonly IReadOnlyList<Type> PageHeaderApiTypes = [typeof(PageHeader)];
    private static readonly IReadOnlyList<Type> SideMenuApiTypes = [typeof(SideMenu), typeof(SideMenuItem)];
    private static readonly IReadOnlyList<Type> ContextMenuApiTypes = [typeof(ContextMenu)];
    private static readonly IReadOnlyList<Type> FilterBarApiTypes = [typeof(FilterBar)];
    private static readonly IReadOnlyList<Type> LegalTocApiTypes = [typeof(LegalToc)];
    private static readonly IReadOnlyList<Type> LegalTocNavApiTypes = [typeof(LegalTocNav)];
    private static readonly IReadOnlyList<Type> PageHeaderActionButtonApiTypes = [typeof(PageHeaderActionButton)];
    private static readonly IReadOnlyList<Type> RibbonTabsApiTypes = [typeof(RibbonTabs<string>)];
    private static readonly IReadOnlyList<Type> SecondaryTabsApiTypes = [typeof(SecondaryTabs)];
    private static readonly IReadOnlyList<Type> SideMenuItemStandaloneApiTypes = [typeof(SideMenuItem)];
    private static readonly IReadOnlyList<Type> StepsItemApiTypes = [typeof(StepsItem)];
    private static readonly IReadOnlyList<Type> TabsItemStandaloneApiTypes = [typeof(TabsItem)];
    private static readonly IReadOnlyList<Type> ToolbarActionsApiTypes = [typeof(ToolbarActions)];
    private static readonly IReadOnlyList<Type> ToolbarFieldsApiTypes = [typeof(ToolbarFields)];
    private static readonly IReadOnlyList<Type> ToolbarRowApiTypes = [typeof(ToolbarRow)];
    private static readonly IReadOnlyList<Type> TreeViewNodeRowApiTypes = [typeof(TreeViewNodeRow)];

}
