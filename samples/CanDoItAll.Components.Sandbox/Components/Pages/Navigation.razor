@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/navigation"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Navigation
@inject SideMenuService SideMenus

<PageTitle>Navigation</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  HeroTitle="Tabs, steps, and list-detail movement that remain keyboard-ready."
                  HeroSummary="The navigation page focuses on active-state clarity, keyboard movement, and whether denser navigation shells still explain themselves quickly."
                  DemoTitle="Navigation primitives"
                  DemoSummary="Shared tabs, steps, and list-detail surfaces for the current scenario."
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <Notes>
        <div class="sandbox-proof-list">
            <p>Users should understand the route hierarchy by scanning headings and active states only.</p>
            <p>Dense navigation should add information, not extra ambiguity.</p>
            <p>Keyboard and focus behavior matter here more than decoration.</p>
        </div>
    </Notes>

    <ChildContent>
        @foreach (var section in Sections)
        {
            <section id="@section.Anchor" class="sandbox-component-section">
                <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                @if (section.ComponentName == "Tabs")
                {
                    <ExampleBlock Title="Basic tabs"
                                  Description="This is the default recommendation: readable labels, a visible selected state, and a panel surface that feels attached to the active tab."
                                  SourceId="examples/Navigation/BasicTabs.razor"
                                  ApiTypes="@TabsApiTypes">
                        <Tabs SelectedIndex="@basicTabIndex"
                              SelectedIndexChanged="HandleBasicTabChanged"
                              Variant="@(TabsVariant.WorkspacePrimary)"
                              BorderMode="@(TabsBorderMode.Soft)"
                              Tone="@(TabsTone.Primary)"
                              AriaLabel="Basic workspace tabs"
                              data-testid="sandbox-navigation-basic-tabs">
                            <TabItems>
                                <TabsItem Text="Overview" Icon="bars_staggered">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="The basic tabs setup should feel readable, calm, and clearly selected without needing any special styling tricks." />
                                </TabsItem>
                                <TabsItem Text="Activity log" Icon="calendar" BadgeText="@ActivityBadgeText">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="The selected header and content surface should feel like one connected control instead of two disconnected shapes." />
                                </TabsItem>
                                <TabsItem Text="@EvidenceTabLabel" Icon="circle_info" Disabled="@IsDisabled">
                                    @if (CurrentScenario == SandboxScenarioKey.EmptyState)
                                    {
                                        <EmptyState Eyebrow="Evidence" Title="No review notes yet" Description="The panel should still feel connected to the selected tab even when there is no content to render." />
                                    }
                                    else
                                    {
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="Longer supporting labels should stay readable and the disabled state should read clearly instead of making every tab look unavailable." />
                                    }
                                </TabsItem>
                            </TabItems>
                        </Tabs>
                    </ExampleBlock>

                    <ExampleBlock Title="Advanced accent colors"
                                  Description="Accent colors are an advanced option. They should change the emphasis, not rescue an otherwise weak selected state."
                                  SourceId="examples/Navigation/AccentColors.razor">
                        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                            <Card>
                                <div class="space-y-4">
                                    <div class="space-y-1">
                                        <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Info accent" />
                                        <TextBlock TextStyle="@(TextStyle.Note)" Value="Useful for review and documentation flows." />
                                    </div>
                                    <Tabs SelectedIndex="1" Variant="@(TabsVariant.WorkspaceSecondary)" BorderMode="@(TabsBorderMode.Soft)" Tone="@(TabsTone.Info)" AriaLabel="Info accent tabs" data-testid="tabs-lab-tone-info">
                                        <TabItems>
                                            <TabsItem Text="Summary">
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Information-heavy tabs keep a cool accent while the selected state still reads immediately." />
                                            </TabsItem>
                                            <TabsItem Text="Reviewer notes" BadgeText="2">
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Use the tone to shift emphasis, not readability." />
                                            </TabsItem>
                                        </TabItems>
                                    </Tabs>
                                </div>
                            </Card>
                            <Card>
                                <div class="space-y-4">
                                    <div class="space-y-1">
                                        <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Success accent" />
                                        <TextBlock TextStyle="@(TextStyle.Note)" Value="Useful for completed or healthy workflow branches." />
                                    </div>
                                    <Tabs SelectedIndex="1" Variant="@(TabsVariant.WorkspaceSecondary)" BorderMode="@(TabsBorderMode.Soft)" Tone="@(TabsTone.Success)" AriaLabel="Success accent tabs" data-testid="tabs-lab-tone-success">
                                        <TabItems>
                                            <TabsItem Text="Healthy">
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="The same shared structure can shift into a success-oriented accent without turning into a different component." />
                                            </TabsItem>
                                            <TabsItem Text="Ready to ship">
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Keep the content and header seam intact even when the accent changes." />
                                            </TabsItem>
                                        </TabItems>
                                    </Tabs>
                                </div>
                            </Card>
                            <Card>
                                <div class="space-y-4">
                                    <div class="space-y-1">
                                        <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Warning accent" />
                                        <TextBlock TextStyle="@(TextStyle.Note)" Value="Useful when the selected area carries caution or review pressure." />
                                    </div>
                                    <Tabs SelectedIndex="1" Variant="@(TabsVariant.WorkspaceSecondary)" BorderMode="@(TabsBorderMode.Soft)" Tone="@(TabsTone.Warning)" AriaLabel="Warning accent tabs" data-testid="tabs-lab-tone-warning">
                                        <TabItems>
                                            <TabsItem Text="Checks">
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Warning tone should feel deliberate, not noisy." />
                                            </TabsItem>
                                            <TabsItem Text="Needs attention" BadgeText="3">
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Selected emphasis should remain obvious at a glance." />
                                            </TabsItem>
                                        </TabItems>
                                    </Tabs>
                                </div>
                            </Card>
                        </div>
                    </ExampleBlock>

                    <ExampleBlock Title="Shell customization"
                                  Description="Use the shared tabs contract first, then add a consumer shell with the root Class when the page needs stronger atmosphere. The dark workstation shell is a specialized treatment, not the baseline look."
                                  SourceId="examples/Navigation/ShellCustomization.razor">
                        <div class="sandbox-demo-grid sandbox-demo-grid--two">
                            <Tabs SelectedIndex="@classTabIndex"
                                  SelectedIndexChanged="HandleClassTabChanged"
                                  Variant="@(TabsVariant.WorkspaceSecondary)"
                                  BorderMode="@(TabsBorderMode.Soft)"
                                  Tone="@(TabsTone.Secondary)"
                                  Class="rounded-[1.5rem] border border-violet-200/70 bg-[linear-gradient(135deg,rgba(255,255,255,0.98)_0%,rgba(250,245,255,0.95)_100%)] p-3 shadow-[0_18px_45px_-32px_rgba(88,28,135,0.25)]"
                                  AriaLabel="Tabs customized with root classes"
                                  data-testid="tabs-lab-class">
                                <TabItems>
                                    <TabsItem Text="Review queue" Icon="bars_staggered">
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="The root Class can add a page-level shell without rewriting the shared tabs structure." />
                                    </TabsItem>
                                    <TabsItem Text="Pinned notes" Icon="calendar" BadgeText="4">
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="TabsItem can still take extra Tailwind classes for a one-off emphasis treatment." />
                                    </TabsItem>
                                    <TabsItem Text="History" Icon="circle_info">
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="The variant and tone enums still own the internal spacing and selected-state behavior." />
                                    </TabsItem>
                                </TabItems>
                            </Tabs>

                            <Tabs SelectedIndex="@workstationTabIndex"
                                  SelectedIndexChanged="HandleWorkstationTabChanged"
                                  Variant="@(TabsVariant.Workstation)"
                                  BorderMode="@(TabsBorderMode.Soft)"
                                  Class="rounded-[1.6rem] border border-emerald-200/20 bg-[linear-gradient(180deg,rgba(19,38,43,0.98)_0%,rgba(12,28,31,0.96)_100%)] p-4 shadow-[0_24px_56px_-34px_rgba(2,6,23,0.72)]"
                                  AriaLabel="Workstation shell tabs"
                                  data-testid="tabs-lab-workstation">
                                <TabItems>
                                    <TabsItem Text="Workbench">
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="The workstation variant can be dramatic, but it still needs readable text and a clear active state." />
                                    </TabsItem>
                                    <TabsItem Text="Operator queue" BadgeText="5">
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="This variant now carries its own local text and surface tokens so it remains readable in isolation." />
                                    </TabsItem>
                                    <TabsItem Text="Escalations">
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="Use this style when a darker shell is intentional, not as the default tabs example." />
                                    </TabsItem>
                                </TabItems>
                            </Tabs>
                        </div>
                    </ExampleBlock>

                    <ExampleBlock Title="Optional borderless compact mode"
                                  Description="Compact modal usage can intentionally remove the button border when the pill treatment reads better."
                                  SourceId="examples/Navigation/CompactBorderless.razor">
                        <Tabs SelectedIndex="@modalTabIndex"
                              SelectedIndexChanged="HandleModalTabChanged"
                              RenderMode="@(TabRenderMode.Client)"
                              Variant="@(TabsVariant.ModalCompact)"
                              BorderMode="@(TabsBorderMode.None)"
                              Tone="@(TabsTone.Info)"
                              AriaLabel="Compact borderless tabs"
                              data-testid="tabs-lab-modal">
                            <TabItems>
                                <TabsItem Text="Summary">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="This variant keeps the panel minimal and uses rounded pills for lighter modal chrome." />
                                </TabsItem>
                                <TabsItem Text="Warnings" BadgeText="2">
                                    <Alert AlertStyle="@(AlertStyle.Warning)">
                                        Borderless tabs should still keep hover, focus, and active state obvious.
                                    </Alert>
                                </TabsItem>
                                <TabsItem Text="Approval path">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Client render mode keeps the whole set rendered so the tab switch remains instantaneous." />
                                </TabsItem>
                            </TabItems>
                        </Tabs>
                    </ExampleBlock>

                    <ExampleBlock Title="Missing title fallback"
                                  Description="The fallback label should read like a real control, not like the component broke when a title was omitted."
                                  SourceId="examples/Navigation/MissingTitleFallback.razor">
                        <Tabs SelectedIndex="@missingTitleTabIndex"
                              SelectedIndexChanged="HandleMissingTitleTabChanged"
                              Variant="@(TabsVariant.WorkspaceSecondary)"
                              BorderMode="@(TabsBorderMode.Soft)"
                              Tone="@(TabsTone.Secondary)"
                              AriaLabel="Missing title fallback tabs"
                              data-testid="tabs-lab-missing-title">
                            <TabItems>
                                <TabsItem Text="Configured tab">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="The configured tab uses the normal text path." />
                                </TabsItem>
                                <TabsItem Icon="circle_info">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="This example intentionally omits Text. The fallback label should still feel stable and readable." />
                                </TabsItem>
                                <TabsItem Text="Another tab">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="The surrounding tabs should not collapse just because one label is missing." />
                                </TabsItem>
                            </TabItems>
                        </Tabs>
                    </ExampleBlock>

                    <ExampleBlock Title="Overflow strategies"
                                  Description="When wrapping becomes too noisy, scroll mode keeps the control to one row without clipping labels or breaking focus behavior."
                                  SourceId="examples/Navigation/OverflowStrategies.razor">
                        <div class="sandbox-demo-grid sandbox-demo-grid--two">
                            <div class="w-full min-w-0 max-w-[21rem]" data-testid="tabs-lab-wrap-shell">
                                <Tabs SelectedIndex="@wrapTabIndex"
                                      SelectedIndexChanged="HandleWrapTabChanged"
                                      Variant="@(TabsVariant.WorkspaceSecondary)"
                                      BorderMode="@(TabsBorderMode.Soft)"
                                      Tone="@(TabsTone.Primary)"
                                      OverflowMode="@(TabsOverflowMode.Wrap)"
                                      AriaLabel="Wrapping tabs in a narrow column"
                                      data-testid="tabs-lab-wrap">
                                    <TabItems>
                                        <TabsItem Text="@WrapFirstTabLabel" Icon="bars_staggered">
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="Wrapped tabs should become a tidy multi-row control instead of an accidental broken seam." />
                                        </TabsItem>
                                        <TabsItem Icon="circle_info">
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="This second tab keeps the missing-title fallback visible in a tighter layout." />
                                        </TabsItem>
                                        <TabsItem Text="@WrapThirdTabLabel" BadgeText="beta">
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="Badges and multi-line labels need to remain aligned even when the row wraps." />
                                        </TabsItem>
                                    </TabItems>
                                </Tabs>
                            </div>

                            <div class="w-full min-w-0 max-w-[21rem]" data-testid="tabs-lab-scroll-shell">
                                <Tabs SelectedIndex="@scrollTabIndex"
                                      SelectedIndexChanged="HandleScrollTabChanged"
                                      Variant="@(TabsVariant.WorkspaceSecondary)"
                                      BorderMode="@(TabsBorderMode.Soft)"
                                      Tone="@(TabsTone.Info)"
                                      OverflowMode="@(TabsOverflowMode.Scroll)"
                                      AriaLabel="Scrollable tabs in a narrow column"
                                      data-testid="tabs-lab-scroll">
                                    <TabItems>
                                        <TabsItem Text="Overview">
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="Keep the strip single-line when horizontal movement is easier to understand than wrapping." />
                                        </TabsItem>
                                        <TabsItem Text="Automation checkpoints">
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="Long labels should still be fully visible while the row scrolls." />
                                        </TabsItem>
                                        <TabsItem Text="Validation questions">
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="Keyboard focus and active state should remain strong even when some tabs start off-screen." />
                                        </TabsItem>
                                        <TabsItem Text="Regression notes">
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="The right edge should not clip the final tab or its hover border." />
                                        </TabsItem>
                                        @if (CurrentScenario == SandboxScenarioKey.DenseContent)
                                        {
                                            <TabsItem Text="Stakeholder sign-off">
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Dense scenarios add one more tab so the overflow behavior stays obvious." />
                                            </TabsItem>
                                        }
                                    </TabItems>
                                </Tabs>
                            </div>
                        </div>
                    </ExampleBlock>

                    <ExampleBlock Title="Vertical tabs for settings rails"
                                  Description="Left-positioned tabs need the same visual confidence and should collapse back to a sensible mobile stack."
                                  SourceId="examples/Navigation/VerticalRail.razor">
                        <Tabs SelectedIndex="@verticalTabIndex"
                              SelectedIndexChanged="HandleVerticalTabChanged"
                              Variant="@(TabsVariant.WorkspaceTertiary)"
                              BorderMode="@(TabsBorderMode.Soft)"
                              Tone="@(TabsTone.Success)"
                              TabPosition="@(TabPosition.Left)"
                              AriaLabel="Vertical settings tabs"
                              data-testid="tabs-lab-vertical">
                            <TabItems>
                                <TabsItem Text="General">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Vertical tabs should read like a settings rail instead of an unrelated side list." />
                                </TabsItem>
                                <TabsItem Text="@VerticalNotificationsTabLabel" BadgeText="3">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Longer labels still need to align cleanly and keep the panel seam intact." />
                                </TabsItem>
                                <TabsItem Text="Audit trail" Disabled="@(CurrentScenario == SandboxScenarioKey.DisabledState)">
                                    <TextBlock TextStyle="@(TextStyle.Body2)" Value="Disabled items must remain visible while clearly opting out of interaction." />
                                </TabsItem>
                            </TabItems>
                        </Tabs>
                    </ExampleBlock>
                }
                else if (section.ComponentName == "Toolbar")
                {
                    <ExampleBlock Title="Filter toolbar"
                                  Description="Shared sheet toolbar structure groups filter fields and reset actions without custom page chrome."
                                  SourceId="examples/Navigation/FilterToolbar.razor"
                                  ApiTypes="@ToolbarApiTypes">
                        <Toolbar data-testid="sandbox-navigation-toolbar">
                            <ToolbarRow>
                                <ToolbarFields>
                                    <TextBox Value="@toolbarQuery"
                                             ValueChanged="HandleToolbarQueryChanged"
                                             Immediate="true"
                                             Placeholder="Filter standard navigation"
                                             aria-label="Filter standard navigation"
                                             data-testid="sandbox-navigation-toolbar-query" />
                                    <DropDown TValue="string"
                                              Data="@ToolbarScopes"
                                              Value="@toolbarScope"
                                              ValueChanged="HandleToolbarScopeChanged"
                                              aria-label="Navigation scope"
                                              data-testid="sandbox-navigation-toolbar-scope" />
                                </ToolbarFields>
                                <ToolbarActions>
                                    <Button Text="Reset"
                                            ButtonStyle="@(ButtonStyle.Light)"
                                            Variant="@(Variant.Outlined)"
                                            Click="@ResetNavigationTools"
                                            data-testid="sandbox-navigation-toolbar-reset" />
                                </ToolbarActions>
                            </ToolbarRow>
                        </Toolbar>
                    </ExampleBlock>
                }
                else if (section.ComponentName == "TreeView")
                {
                    <ExampleBlock Title="Adaptive tree with context menu"
                                  Description="Hierarchical selection, expansion, and right-click actions stay bounded and connected to the selected node."
                                  SourceId="examples/Navigation/AdaptiveTree.razor"
                                  ApiTypes="@TreeViewApiTypes">
                        <Grid Gap="LayoutGap.Large"
                              ColumnTemplate="minmax(0,1fr)"
                              ColumnTemplateLg="minmax(16rem,0.85fr) minmax(0,1.15fr)">
                            <div class="relative min-w-0 rounded-[1.25rem] border border-slate-200 bg-white p-3 shadow-sm shadow-slate-200/60"
                                 data-testid="sandbox-navigation-tree-panel">
                                <TreeView Items="@TreeNodes"
                                          Style="@(TreeViewStyle.Workbench)"
                                          AriaLabel="Standard component navigation tree"
                                          EmptyText="No navigation nodes match the current filter."
                                          OnSelect="SelectTreeNode"
                                          OnToggle="ToggleTreeNode"
                                          OnContextMenu="OpenTreeContextMenu"
                                          data-testid="sandbox-navigation-tree" />
                                <ContextMenu IsOpen="@(treeContextMenuRequest is not null)"
                                             X="@(treeContextMenuRequest?.ClientX ?? 16)"
                                             Y="@(treeContextMenuRequest?.ClientY ?? 16)"
                                             Items="@TreeContextMenuItems"
                                             Heading="Tree action"
                                             Description="@(treeContextMenuRequest is null ? null : ResolveTreeNodeLabel(treeContextMenuRequest.NodeId))"
                                             AriaLabel="Tree node actions"
                                             ItemSelected="HandleTreeContextMenuItemSelected"
                                             OnClose="CloseTreeContextMenu"
                                             TestId="sandbox-navigation-tree-context-menu" />
                            </div>

                            <div class="min-w-0 rounded-[1.25rem] border border-slate-200 bg-slate-50/80 p-4"
                                 data-testid="sandbox-navigation-tree-detail">
                                <Stack GapScale="LayoutGap.Medium">
                                    <div class="space-y-1">
                                        <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="@ResolveTreeNodeLabel(selectedTreeNodeId)" />
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="@ResolveTreeNodeSummary(selectedTreeNodeId)" />
                                    </div>
                                    <Cluster Gap="LayoutGap.Small">
                                        <StatusBadge Text="@toolbarScope" Tone="info" />
                                        <StatusBadge Text="@TreeFilterStatus" Tone="success" />
                                        <StatusBadge Text="@ExpandedTreeStatus" Tone="warning" />
                                    </Cluster>
                                </Stack>
                            </div>
                        </Grid>
                    </ExampleBlock>
                }
                else if (section.ComponentName == "Steps")
                {
                    <ExampleBlock Title="Linear step flow"
                                  Description="Step flow should read clearly at a glance and support linear progression."
                                  SourceId="examples/Navigation/LinearSteps.razor"
                                  ApiTypes="@StepsApiTypes">
                        <Steps Value="@stepIndex"
                               ValueChanged="HandleStepChanged"
                               data-testid="sandbox-navigation-steps"
                               PreviousButtonTestId="sandbox-navigation-steps-previous"
                               NextButtonTestId="sandbox-navigation-steps-next"
                               NavigationPosition="@(StepsNavigationPosition.Both)"
                               Linear="@IsDisabled">
                            <StepsItem Text="Scope" Description="Frame the request and choose the demo group.">
                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Scope the request and set the acceptance expectation before opening the implementation details." />
                            </StepsItem>
                            <StepsItem Text="Review" Description="Inspect the current variation and proof notes.">
                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Review how the component behaves in dense, empty, and mobile conditions." />
                            </StepsItem>
                            <StepsItem Text="Proof" Description="Capture the screenshots and sign off.">
                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Proof means screenshots, validation questions, and a clear answer on whether the layout still works." />
                            </StepsItem>
                        </Steps>
                    </ExampleBlock>
                }
                else if (section.ComponentName == "ListDetailShell")
                {
                    <ExampleBlock Title="Selection and detail shell"
                                  Description="Selection and detail context should stay readable with or without a chosen item."
                                  SourceId="examples/Navigation/SelectionShell.razor"
                                  ApiTypes="@ListDetailShellApiTypes">
                        <ListDetailShell ListPaneWidth="20rem"
                                         data-testid="sandbox-navigation-list-detail">
                            <ListHeader>
                                <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Navigation items" />
                            </ListHeader>
                            <ListContent>
                                <div class="sandbox-list">
                                    @foreach (var item in NavigationItems)
                                    {
                                        <SelectionListItem IsSelected="@(item.Id == selectedItemId)"
                                                           Title="@item.Title"
                                                           Eyebrow="@item.Eyebrow"
                                                           Meta="@item.Meta"
                                                           Summary="@item.Summary"
                                                           OnSelect="@(() => SelectItem(item.Id))">
                                            <Status>
                                                <StatusBadge Text="@item.State" Tone="@item.Tone" />
                                            </Status>
                                        </SelectionListItem>
                                    }
                                </div>
                            </ListContent>
                            <DetailHeader>
                                <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Detail" />
                            </DetailHeader>
                            <DetailContent>
                                @if (CurrentScenario == SandboxScenarioKey.EmptyState)
                                {
                                    <EmptyState Eyebrow="Navigation" Title="Nothing selected" Description="Choose an item from the left pane to inspect the active route and proof notes." />
                                }
                                else
                                {
                                    <div class="space-y-3">
                                        <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="@SelectedItem.Title" />
                                        <TextBlock TextStyle="@(TextStyle.Body2)" Value="@SelectedItem.Summary" />
                                        <StatusBadge Text="@SelectedItem.State" Tone="@SelectedItem.Tone" />
                                    </div>
                                }
                            </DetailContent>
                        </ListDetailShell>
                    </ExampleBlock>
                }
                else if (section.ComponentName == "SideMenu")
                {
                    <ExampleBlock Title="Responsive side menu with service-driven context"
                                  Description="Parameter-fed and declarative items, measured overflow, bottom utilities, custom panels, and service-driven context switching in one bounded workspace."
                                  SourceId="examples/Navigation/SideMenuWorkspace.razor"
                                  ApiTypes="@SideMenuApiTypes">
                        <Stack GapScale="LayoutGap.Large">
                            <div class="sandbox-side-menu-toolbar" data-testid="side-menu-service-controls">
                                <div>
                                    <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Service controls" />
                                    <TextBlock TextStyle="@(TextStyle.Note)" Value="These buttons act through SideMenuService rather than a component reference." />
                                </div>
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                    <Button Text="Project context"
                                            Icon="folder_open"
                                            Size="ButtonSize.Small"
                                            Click="UseProjectContextAsync"
                                            data-testid="side-menu-context-project" />
                                    <Button Text="Analytics context"
                                            Icon="analytics"
                                            ButtonStyle="@(ButtonStyle.Info)"
                                            Variant="@(Variant.Outlined)"
                                            Size="ButtonSize.Small"
                                            Click="UseAnalyticsContextAsync"
                                            data-testid="side-menu-context-analytics" />
                                    <Button Text="Restore declared items"
                                            Icon="restart_alt"
                                            ButtonStyle="@(ButtonStyle.Light)"
                                            Variant="@(Variant.Outlined)"
                                            Size="ButtonSize.Small"
                                            Click="RestoreDeclaredItemsAsync"
                                            data-testid="side-menu-context-declared" />
                                    <Button Text="Select first externally"
                                            Icon="ads_click"
                                            ButtonStyle="@(ButtonStyle.Light)"
                                            Variant="@(Variant.Outlined)"
                                            Size="ButtonSize.Small"
                                            Click="SelectFirstExternallyAsync"
                                            data-testid="side-menu-select-external" />
                                    <Button Text="Toggle via service"
                                            Icon="swap_horiz"
                                            ButtonStyle="@(ButtonStyle.Light)"
                                            Variant="@(Variant.Outlined)"
                                            Size="ButtonSize.Small"
                                            Click="ToggleFromServiceAsync"
                                            data-testid="side-menu-toggle-external" />
                                </Cluster>
                            </div>

                            <div class="sandbox-side-menu-lab @(CurrentScenario == SandboxScenarioKey.DenseContent ? "is-height-stressed" : null)"
                                 data-scenario="@CurrentScenario.ToSlug()"
                                 data-testid="side-menu-lab">
                                <div class="sandbox-side-menu-host" data-testid="side-menu-host">
                                    <SideMenu MenuId="@SideMenuId"
                                              Title="Delivery workspace"
                                              Subtitle="@sideMenuContextLabel"
                                              Icon="apps"
                                              Expanded="@sideMenuExpanded"
                                              ExpandedChanged="HandleSideMenuExpandedChanged"
                                              Items="@SideMenuDeclaredPropertyItems"
                                              MoreItems="@SideMenuDeclaredMoreItems"
                                              BottomItems="@SideMenuDeclaredBottomItems"
                                              ItemSelected="HandleSideMenuComponentSelection"
                                              data-testid="side-menu-proof">
                                        <MenuItems>
                                            @if (CurrentScenario != SandboxScenarioKey.EmptyState)
                                            {
                                                <SideMenuItem Id="timeline"
                                                              Text="Timeline"
                                                              Icon="timeline"
                                                              Description="Milestones and delivery dates."
                                                              Selected="HandleSideMenuDeclarativeSelection" />
                                                <SideMenuItem Id="requirements"
                                                              Text="Requirements"
                                                              Icon="fact_check"
