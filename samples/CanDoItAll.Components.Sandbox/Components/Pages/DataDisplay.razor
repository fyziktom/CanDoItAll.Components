    private sealed record SummaryTileModel(string Label, string Value, string HelperText, string Tone);

    private enum ItemEditorMode
    {
        Create,
        Edit
    }

    private enum ItemEditorTarget
    {
        Record,
        Card
    }

    private sealed record ItemEditorState(
        ItemEditorMode Mode,
        ItemEditorTarget Target,
        string Title,
        string Notes,
        DisplayItemId? ItemId)
    {
        public static ItemEditorState CreateRecord()
            => new(ItemEditorMode.Create, ItemEditorTarget.Record, string.Empty, string.Empty, null);

        public static ItemEditorState EditRecord(DisplayRowModel row)
            => new(ItemEditorMode.Edit, ItemEditorTarget.Record, row.Title, row.Summary, row.Id);

        public static ItemEditorState EditCard(DisplayCardModel card)
            => new(ItemEditorMode.Edit, ItemEditorTarget.Card, card.Title, card.Summary, card.Id);
    }

    private readonly record struct DisplayItemId(Guid Value)
    {
        public static DisplayItemId New() => new(Guid.NewGuid());
    }

    private sealed record DisplayCardFact(string Label, string Value);

    private sealed record DisplayCardModel(
        DisplayItemId Id,
        string Eyebrow,
        string Title,
        string Summary,
        string State,
        string Tone,
        string ImageSource,
        IReadOnlyList<DisplayCardFact> Facts);

    private sealed record DisplayRowChip(string Text, string Tone);

    private sealed record DisplayRowModel(
        DisplayItemId Id,
        string Title,
        string Eyebrow,
        string Meta,
        string Summary,
        string State,
        string Tone,
        IReadOnlyList<DisplayRowChip> Chips);
}
