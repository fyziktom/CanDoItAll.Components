@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/data-display"
@inherits CatalogPageBase

<PageTitle>Data Display</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        <EmptyState Eyebrow="Data Display" Title="No components wired up yet" Description="DiffViewer, Timeline, and TimelineStepper are catalogued in BaseLib but not yet added to the sandbox." />
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.DataDisplay);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.DataDisplay);
}
