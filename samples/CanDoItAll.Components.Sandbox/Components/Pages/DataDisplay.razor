@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/data-display"
@inherits CatalogPageBase
@using CanDoItAll.Components.Common
@using CanDoItAll.Components.Sandbox.Components.Examples.DataDisplay

<PageTitle>Data Display</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Data display" Title="Loading summary surface" Description="Cards and list rows keep their structure while the record set and computed metrics load." />
        }
        else if (CurrentScenario == SandboxScenarioKey.EmptyState)
        {
            <div data-testid="data-display-empty-state">
                <EmptyState Eyebrow="Data display" Title="No results" Description="Adjust the current filters or add records before the shared card and list views can render detail." />
            </div>
        }
        else
        {
            @foreach (var section in Sections)
            {
                @if (section.ComponentName == "CompactStat")
                {
                    <section id="@section.Anchor" class="sandbox-component-section" data-testid="data-display-summary-strip">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Supporting metrics"
                                      Description="Simple counts stay inline so the record list remains the dominant surface."
                                      SourceId="examples/DataDisplay/SupportingMetrics.razor"
                                      ApiTypes="@CompactStatApiTypes">
                            <CompactStatStrip>
                                @foreach (var tile in Tiles)
                                {
                                    <CompactStat Label="@tile.Label"
                                                 Value="@tile.Value"
                                                 HelperText="@tile.HelperText"
                                                 Tone="@tile.Tone" />
                                }
                            </CompactStatStrip>
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "SelectionListItem")
                {
                    <section id="@section.Anchor" class="sandbox-component-section" data-testid="data-display-selection-rows">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Records"
                                      Description="The primary list owns the useful first viewport; editing opens only when requested."
                                      SourceId="examples/DataDisplay/Records.razor"
                                      ApiTypes="@SelectionListItemApiTypes">
                            <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
                                <Button Text="Add record"
                                        Icon="add"
                                        ButtonStyle="@(ButtonStyle.Primary)"
                                        Disabled="@IsDisabled"
                                        Click="OpenNewItemEditor" />
                            </Cluster>
                            <div class="sandbox-list">
                                @foreach (var row in Rows)
                                {
                                    <SelectionListItem Title="@row.Title"
                                                       Eyebrow="@row.Eyebrow"
                                                       Meta="@row.Meta"
                                                       Summary="@row.Summary"
                                                       Dense="true"
                                                       Disabled="@IsDisabled"
                                                       OnSelect="@(() => OpenItemEditor(row))">
                                        <Status>
                                            <StatusBadge Text="@row.State" Tone="@row.Tone" />
                                        </Status>
                                        <Actions>
                                            <Button Text="Edit"
                                                    ButtonStyle="@(ButtonStyle.Light)"
                                                    Variant="@(Variant.Outlined)"
                                                    Disabled="@IsDisabled"
                                                    Click="@(() => OpenItemEditor(row))" />
                                        </Actions>
                                        <ChildContent>
                                            <Cluster Gap="LayoutGap.Small">
                                                @foreach (var chip in row.Chips)
                                                {
                                                    <StatusBadge Text="@chip.Text" Tone="@chip.Tone" />
                                                }
                                            </Cluster>
                                        </ChildContent>
                                    </SelectionListItem>
                                }
                            </div>
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "Card")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Visual collection"
                                      Description="Use cards only when media and independent item actions improve recognition."
                                      SourceId="examples/DataDisplay/VisualCollection.razor"
                                      ApiTypes="@CardApiTypes">
                            <CardGrid data-testid="data-display-card-grid">
                                @foreach (var card in Cards)
                                {
                                    <Card>
                                        <Media>
                                            <img src="@card.ImageSource" alt="" />
                                        </Media>
                                        <Header>
                                            <Split Breakpoint="LayoutBreakpoint.None"
                                                   Gap="LayoutGap.Small"
                                                   AlignItems="AlignItems.Start"
                                                   JustifyContent="JustifyContent.SpaceBetween"
                                                   Wrap="FlexWrap.Wrap">
                                                <Stack GapScale="LayoutGap.Tiny">
                                                    <TextBlock TextStyle="@(TextStyle.Eyebrow)" Value="@card.Eyebrow" />
                                                    <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="@card.Title" />
                                                </Stack>
                                                <StatusBadge Text="@card.State" Tone="@card.Tone" />
                                            </Split>
                                        </Header>
                                        <Tags>
                                            @foreach (var fact in card.Facts.Take(2))
                                            {
                                                <StatusBadge Text="@($"{fact.Label}: {fact.Value}")" Tone="neutral" />
                                            }
                                        </Tags>
                                        <ChildContent>
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="@card.Summary" />
                                        </ChildContent>
                                        <Actions>
                                            <Button Text="Edit"
                                                    Icon="edit"
                                                    ButtonStyle="@(ButtonStyle.Primary)"
                                                    Disabled="@IsDisabled"
                                                    Click="@(() => OpenItemEditor(card))" />
                                        </Actions>
                                    </Card>
                                }
                            </CardGrid>
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "Dialog")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Record editor dialog"
                                      Description="Opened from the Add record and Edit actions above; created and edited state stay dialog-only until saved."
                                      SourceId="examples/DataDisplay/RecordDialog.razor"
                                      ApiTypes="@DialogApiTypes">
                            <Dialog IsOpen="@(editorState is not null)"
                                    Title="@EditorDialogTitle"
                                    Subtitle="@EditorDialogSubtitle"
                                    Size="ModalSize.Compact"
                                    DenseChrome="true"
                                    OnClose="CloseCardEditor">
                                <ChildContent>
                                    @if (editorState is not null)
                                    {
                                        <FormStack>
                                            <FormField Text="Title">
                                                <TextBox Value="@editorState.Title"
                                                         ValueChanged="UpdateEditorTitle" />
                                            </FormField>
                                            <FormField Text="Review notes">
                                                <TextArea Value="@editorState.Notes"
                                                          ValueChanged="UpdateEditorNotes"
                                                          Size="@(CurrentScenario == SandboxScenarioKey.LongText ? TextAreaSize.Extended : TextAreaSize.Standard)" />
                                            </FormField>
                                        </FormStack>
                                    }
                                </ChildContent>
                                <Footer>
                                    <Button Text="Cancel"
                                            ButtonStyle="@(ButtonStyle.Light)"
                                            Variant="@(Variant.Outlined)"
                                            Click="CloseCardEditor" />
                                    <Button Text="@EditorPrimaryActionText"
                                            Icon="save"
                                            ButtonStyle="@(ButtonStyle.Primary)"
                                            Disabled="@IsEditorSaveDisabled"
                                            Click="SaveItemEditor" />
                                </Footer>
                            </Dialog>
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "ActionCard")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Action card"
                                      Description="A selectable card shell with an active and inactive tone."
                                      SourceId="examples/DataDisplay/ActionCardShowcase.razor"
                                      ApiTypes="@ActionCardApiTypes">
                            <ActionCardShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "ActionReviewPanel")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Action review panel"
                                      Description="Summarizes the facts a reviewer should see before confirming an action."
                                      SourceId="examples/DataDisplay/ActionReviewPanelShowcase.razor"
                                      ApiTypes="@ActionReviewPanelApiTypes">
                            <ActionReviewPanelShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "AuthCard")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Auth card"
                                      Description="A centered shell sized for sign-in and account entry flows."
                                      SourceId="examples/DataDisplay/AuthCardShowcase.razor"
                                      ApiTypes="@AuthCardApiTypes">
                            <AuthCardShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "CardActions")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Card actions"
                                      Description="An inline action cluster, or a bordered footer row when Secondary is set."
                                      SourceId="examples/DataDisplay/CardActionsShowcase.razor"
                                      ApiTypes="@CardActionsApiTypes">
                            <CardActionsShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "CardButton")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Card button"
                                      Description="A solid or ghost action button that renders as a link when Href is set."
                                      SourceId="examples/DataDisplay/CardButtonShowcase.razor"
                                      ApiTypes="@CardButtonApiTypes">
                            <CardButtonShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "CardGrid")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Card grid"
                                      Description="A responsive auto-fit grid for laying out Card and other card-family items."
                                      SourceId="examples/DataDisplay/CardGridShowcase.razor"
                                      ApiTypes="@CardGridApiTypes">
                            <CardGridShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "CardStatsWithNumber")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Card stat with number"
                                      Description="A compact stat card with small, normal, and large sizes, and an optional icon."
                                      SourceId="examples/DataDisplay/CardStatsWithNumberShowcase.razor"
                                      ApiTypes="@CardStatsWithNumberApiTypes">
                            <CardStatsWithNumberShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "HeroCard")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Hero card"
                                      Description="A gradient hero surface for introducing a page or section."
                                      SourceId="examples/DataDisplay/HeroCardShowcase.razor"
                                      ApiTypes="@HeroCardApiTypes">
                            <HeroCardShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "MetricCard")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Metric card"
                                      Description="A label and value pair, with an optional custom ValueContent fragment."
                                      SourceId="examples/DataDisplay/MetricCardShowcase.razor"
                                      ApiTypes="@MetricCardApiTypes">
                            <MetricCardShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "PanelCard")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Panel card"
                                      Description="A general-purpose bordered panel, with a quieter Soft variant."
                                      SourceId="examples/DataDisplay/PanelCardShowcase.razor"
                                      ApiTypes="@PanelCardApiTypes">
                            <PanelCardShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "ParitySectionCard")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Parity section card"
                                      Description="A plain bordered card that renders as a section by default, or an article."
                                      SourceId="examples/DataDisplay/ParitySectionCardShowcase.razor"
                                      ApiTypes="@ParitySectionCardApiTypes">
                            <ParitySectionCardShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "PriceBar")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Price bar"
                                      Description="A full-width price or value row with default and success tones."
                                      SourceId="examples/DataDisplay/PriceBarShowcase.razor"
                                      ApiTypes="@PriceBarApiTypes">
                            <PriceBarShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "PriceRow")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Price row"
                                      Description="A space-between flex row for pairing a label with a price or value."
                                      SourceId="examples/DataDisplay/PriceRowShowcase.razor"
                                      ApiTypes="@PriceRowApiTypes">
                            <PriceRowShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "SectionCard")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Section card"
                                      Description="A titled section shell with description, help popover, and header actions — used throughout the Sandbox chrome itself."
                                      SourceId="examples/DataDisplay/SectionCardShowcase.razor"
                                      ApiTypes="@SectionCardApiTypes">
                            <SectionCardShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "StatBox")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Stat box"
                                      Description="A compact stat card, with a Simple variant for dense rows."
                                      SourceId="examples/DataDisplay/StatBoxShowcase.razor"
                                      ApiTypes="@StatBoxApiTypes">
                            <StatBoxShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "StatsCardRow")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Stats card row"
                                      Description="A flex row container for laying out CardStatsWithNumber items."
                                      SourceId="examples/DataDisplay/StatsCardRowShowcase.razor"
                                      ApiTypes="@StatsCardRowApiTypes">
                            <StatsCardRowShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "StatsGrid")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Stats grid"
                                      Description="A responsive grid intended for SummaryTile items."
                                      SourceId="examples/DataDisplay/StatsGridShowcase.razor"
                                      ApiTypes="@StatsGridApiTypes">
                            <StatsGridShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "SummaryTile")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Summary tile"
                                      Description="A single label/value tile with tone, compact, badge, and tooltip-helper variants."
                                      SourceId="examples/DataDisplay/SummaryTileShowcase.razor"
                                      ApiTypes="@SummaryTileApiTypes">
                            <SummaryTileShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "SurfaceCard")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Surface card"
                                      Description="A general-purpose surface wrapper, with a quieter Soft variant."
                                      SourceId="examples/DataDisplay/SurfaceCardShowcase.razor"
                                      ApiTypes="@SurfaceCardApiTypes">
                            <SurfaceCardShowcase />
                        </ExampleBlock>
                    </section>
                }
                else if (section.ComponentName == "CompactStatStrip")
                {
                    <section id="@section.Anchor" class="sandbox-component-section">
                        <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                        <ExampleBlock Title="Wider stat strip"
                                      Description="A CompactStatStrip holding more tiles than the summary example, proving it stays a single row of stats."
                                      SourceId="examples/DataDisplay/CompactStatStripShowcase.razor"
                                      ApiTypes="@CompactStatStripApiTypes">
                            <CompactStatStrip>
                                <CompactStat Label="Open" Value="12" Tone="info" />
                                <CompactStat Label="Blocked" Value="2" Tone="danger" />
                                <CompactStat Label="Shipped" Value="47" Tone="success" />
                                <CompactStat Label="At risk" Value="5" Tone="warning" />
                            </CompactStatStrip>
                        </ExampleBlock>
                    </section>
                }
            }
        }

        @{
            var dataGridSection = Sections.FirstOrDefault(s => s.ComponentName == "DataGrid");
        }
        @if (dataGridSection is not null)
        {
            <section id="@dataGridSection.Anchor" class="sandbox-component-section">
                <h2 class="sandbox-component-section__heading">@($"<{dataGridSection.ComponentName}>")</h2>
                <ExampleBlock Title="Data grid states"
                              Description="The shared grid proves keyboard row activation, paging boundaries, captions, loading, empty, dense, and long-content behavior."
                              SourceId="examples/DataDisplay/DataGridStates.razor"
                              ApiTypes="@DataGridApiTypes">
                    <Stack GapScale="LayoutGap.Medium">
                        <DataGrid TItem="DisplayRowModel"
                                  Data="@GridRows"
                                  Caption="Component hardening records"
                                  Loading="@(CurrentScenario == SandboxScenarioKey.LoadingState)"
                                  LoadingText="Loading component hardening records…"
                                  EmptyText="No component hardening records match this scenario."
                                  AllowPaging="true"
                                  PageSize="2"
                                  RowSelect="SelectGridRow"
                                  data-testid="sandbox-data-grid">
                            <Columns>
                                <DataGridColumn TItem="DisplayRowModel" Property="Title" Title="Surface" />
                                <DataGridColumn TItem="DisplayRowModel" Property="Meta" Title="Scope" />
                                <DataGridColumn TItem="DisplayRowModel" Property="State" Title="State" />
                            </Columns>
                        </DataGrid>
                        <Alert AlertStyle="AlertStyle.Info">
                            Selected grid row: @(selectedGridRowTitle ?? "none — activate a row with click, Enter, or Space").
                        </Alert>
                    </Stack>
                </ExampleBlock>
            </section>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.DataDisplay);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.DataDisplay);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/data-display");

    private static readonly IReadOnlyList<Type> CompactStatApiTypes = [typeof(CompactStat)];
    private static readonly IReadOnlyList<Type> CompactStatStripApiTypes = [typeof(CompactStatStrip)];
    private static readonly IReadOnlyList<Type> SelectionListItemApiTypes = [typeof(SelectionListItem)];
    private static readonly IReadOnlyList<Type> CardApiTypes = [typeof(Card), typeof(CardGrid)];
    private static readonly IReadOnlyList<Type> DialogApiTypes = [typeof(Dialog)];
    private static readonly IReadOnlyList<Type> ActionCardApiTypes = [typeof(ActionCard)];
    private static readonly IReadOnlyList<Type> ActionReviewPanelApiTypes = [typeof(ActionReviewPanel)];
    private static readonly IReadOnlyList<Type> AuthCardApiTypes = [typeof(AuthCard)];
    private static readonly IReadOnlyList<Type> CardActionsApiTypes = [typeof(CardActions)];
    private static readonly IReadOnlyList<Type> CardButtonApiTypes = [typeof(CardButton)];
    private static readonly IReadOnlyList<Type> CardGridApiTypes = [typeof(CardGrid)];
    private static readonly IReadOnlyList<Type> CardStatsWithNumberApiTypes = [typeof(CardStatsWithNumber)];
    private static readonly IReadOnlyList<Type> HeroCardApiTypes = [typeof(HeroCard)];
    private static readonly IReadOnlyList<Type> MetricCardApiTypes = [typeof(MetricCard)];
    private static readonly IReadOnlyList<Type> PanelCardApiTypes = [typeof(PanelCard)];
    private static readonly IReadOnlyList<Type> ParitySectionCardApiTypes = [typeof(ParitySectionCard)];
    private static readonly IReadOnlyList<Type> PriceBarApiTypes = [typeof(PriceBar)];
    private static readonly IReadOnlyList<Type> PriceRowApiTypes = [typeof(PriceRow)];
    private static readonly IReadOnlyList<Type> SectionCardApiTypes = [typeof(SectionCard)];
    private static readonly IReadOnlyList<Type> StatBoxApiTypes = [typeof(StatBox)];
    private static readonly IReadOnlyList<Type> StatsCardRowApiTypes = [typeof(StatsCardRow), typeof(CardStatsWithNumber)];
    private static readonly IReadOnlyList<Type> StatsGridApiTypes = [typeof(StatsGrid), typeof(SummaryTile)];
    private static readonly IReadOnlyList<Type> SummaryTileApiTypes = [typeof(SummaryTile)];
    private static readonly IReadOnlyList<Type> SurfaceCardApiTypes = [typeof(SurfaceCard)];
    private static readonly IReadOnlyList<Type> DataGridApiTypes = [typeof(DataGrid<DisplayRowModel>)];
    private const string PrimaryCardImageSource = "_content/CanDoItAll.Components.BaseLib/assets/identity/avatars/avatar-01.jpg";
    private const string SecondaryCardImageSource = "_content/CanDoItAll.Components.BaseLib/assets/identity/avatars/avatar-02.jpg";
    private string? selectedGridRowTitle;
    private ItemEditorState? editorState;
    private SandboxScenarioKey? workingScenario;
    private IReadOnlyList<DisplayRowModel>? editedRows;
    private IReadOnlyList<DisplayCardModel>? editedCards;

    private bool IsDisabled => CurrentScenario == SandboxScenarioKey.DisabledState;
    private string EditorDialogTitle => editorState?.Mode switch
    {
        ItemEditorMode.Create => "Add record",
        ItemEditorMode.Edit => $"Edit {editorState.Title}",
        _ => "Edit record"
    };
    private string EditorDialogSubtitle => editorState?.Mode switch
    {
        ItemEditorMode.Create => "Create the record on demand without reserving permanent page space for an empty form.",
        ItemEditorMode.Edit => "Edit details without displacing the record list. Dialog-only state is initialized when this opens.",
        _ => string.Empty
    };
    private string EditorPrimaryActionText => editorState?.Mode == ItemEditorMode.Create ? "Create" : "Save";
    private bool IsEditorSaveDisabled => editorState is null || string.IsNullOrWhiteSpace(editorState.Title);

    private IReadOnlyList<SummaryTileModel> Tiles => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => DenseTiles,
        SandboxScenarioKey.LongText => LongTiles,
        _ => BaseTiles
    };

    private IReadOnlyList<DisplayCardModel> Cards => editedCards ?? ScenarioCards;

    private IReadOnlyList<DisplayCardModel> ScenarioCards => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => DenseCards,
        SandboxScenarioKey.LongText => LongCards,
        _ => BaseCards
    };

    private IReadOnlyList<DisplayRowModel> Rows => editedRows ?? ScenarioRows;

    private IReadOnlyList<DisplayRowModel> ScenarioRows => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => DenseRows,
        SandboxScenarioKey.LongText => LongRows,
        _ => BaseRows
    };

    private IReadOnlyList<DisplayRowModel> GridRows => CurrentScenario == SandboxScenarioKey.EmptyState
        ? []
        : Rows;

    protected override void OnParametersSet()
    {
        if (workingScenario == CurrentScenario)
        {
            return;
        }

        workingScenario = CurrentScenario;
        editedRows = null;
        editedCards = null;
        editorState = null;
    }

    private Task SelectGridRow(DisplayRowModel row)
    {
        selectedGridRowTitle = row.Title;
        return Task.CompletedTask;
    }

    private Task OpenNewItemEditor()
    {
        editorState = ItemEditorState.CreateRecord();
        return Task.CompletedTask;
    }

    private Task OpenItemEditor(DisplayRowModel row)
    {
        editorState = ItemEditorState.EditRecord(row);
        return Task.CompletedTask;
    }

    private Task OpenItemEditor(DisplayCardModel card)
    {
        editorState = ItemEditorState.EditCard(card);
        return Task.CompletedTask;
    }

    private Task CloseCardEditor()
    {
        editorState = null;
        return Task.CompletedTask;
    }

    private Task UpdateEditorTitle(string? title)
    {
        ItemEditorState current = editorState ?? throw new InvalidOperationException("The item editor must be open before its title can change.");
        editorState = current with { Title = title ?? string.Empty };
        return Task.CompletedTask;
    }

    private Task UpdateEditorNotes(string? notes)
    {
        ItemEditorState current = editorState ?? throw new InvalidOperationException("The item editor must be open before its notes can change.");
        editorState = current with { Notes = notes ?? string.Empty };
        return Task.CompletedTask;
    }

    private Task SaveItemEditor()
    {
        ItemEditorState current = editorState ?? throw new InvalidOperationException("The item editor must be open before it can be saved.");
        var title = current.Title.Trim();

        if (string.IsNullOrWhiteSpace(title))
        {
            throw new InvalidOperationException("A record title is required before saving.");
        }

        switch (current)
        {
            case { Mode: ItemEditorMode.Create, Target: ItemEditorTarget.Record }:
                editedRows =
                [
                    .. Rows,
                    new DisplayRowModel(
                        DisplayItemId.New(),
                        title,
                        "Added",
                        "local / draft",
                        current.Notes,
                        "Draft",
                        "neutral",
                        [])
                ];
                break;
            case { Mode: ItemEditorMode.Edit, Target: ItemEditorTarget.Record, ItemId: not null }:
                editedRows = ReplaceById(
                    Rows,
                    current.ItemId.Value,
                    static row => row.Id,
                    row => row with
                    {
                        Title = title,
                        Summary = current.Notes
                    });
                break;
            case { Mode: ItemEditorMode.Edit, Target: ItemEditorTarget.Card, ItemId: not null }:
                editedCards = ReplaceById(
                    Cards,
                    current.ItemId.Value,
                    static card => card.Id,
                    card => card with
                    {
                        Title = title,
                        Summary = current.Notes
                    });
                break;
            default:
                throw new InvalidOperationException("The item editor state is not valid for saving.");
        }

        editorState = null;
        return Task.CompletedTask;
    }

    private static IReadOnlyList<T> ReplaceById<T>(
        IReadOnlyList<T> source,
        DisplayItemId itemId,
        Func<T, DisplayItemId> idSelector,
        Func<T, T> update)
        where T : notnull
    {
        var items = source.ToArray();
        var index = Array.FindIndex(items, item => idSelector(item) == itemId);

        if (index < 0)
        {
            throw new InvalidOperationException("The edited item is no longer present in the current collection.");
        }

        items[index] = update(items[index]);
        return items;
    }

