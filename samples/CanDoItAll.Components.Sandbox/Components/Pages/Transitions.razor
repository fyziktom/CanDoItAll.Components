@namespace CanDoItAll.Components.Sandbox.Components
@page "/transitions"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Transitions

<PageTitle>Transitions</PageTitle>

<CatalogPageFrame Group="@Group"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  FrameChanged="NavigateFrame">
    <ChildContent>

            @foreach (var section in VisibleSections(Sections))
            {
                <section id="@(section.Anchor)" class="sandbox-component-section">
                    @RenderSectionHeading(section)

                    @if (section.ComponentName == "ExpandTransition")
                    {
                        <ExampleBlock Title="Expand Transition"
                                      Description="Expand and collapse child content."
                                      SourceId="examples/Transitions/ExpandTransitionExample.razor"
                                      ApiTypes="@ExpandTransitionTypes">
                            <ExpandTransitionExample />
                        </ExampleBlock>
                    }
                </section>
            }

    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Transitions);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Transitions);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/transitions");

    private static readonly IReadOnlyList<Type> ExpandTransitionTypes = [typeof(ExpandTransition)];
}
