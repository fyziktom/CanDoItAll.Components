@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/foundations"
@inherits CatalogPageBase
@using System.Globalization
@using CanDoItAll.Components.Sandbox.Components.Examples.Foundations

<PageTitle>Foundations</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Foundations" Title="Loading typographic specimens" Description="The foundation page still communicates structure while token previews are loading." />
        }
        else if (CurrentScenario == SandboxScenarioKey.EmptyState)
        {
            <EmptyState Eyebrow="Foundations" Title="No token pack selected" Description="Choose a foundation pack to inspect type scale, spacing, and icon alignment across the catalog." />
        }
        else
        {
            @foreach (var section in Sections)
            {
                <section id="@section.Anchor" class="sandbox-component-section">
                    <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                    @if (section.ComponentName == "TextBlock")
                    {
                        <ExampleBlock Title="Type scale"
                                      Description="Shared text styles should stay calm, readable, and easy to scan in sequence."
                                      SourceId="examples/Foundations/TypeScale.razor"
                                      ApiTypes="@TextBlockApiTypes">
                            @if (CurrentScenario is SandboxScenarioKey.DenseContent or SandboxScenarioKey.LongText)
                            {
                                <div class="space-y-4">
                                    @foreach (var specimen in TypeSpecimens)
                                    {
                                        <div class="space-y-1">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <TextBlock TextStyle="@(TextStyle.Eyebrow)" Value="@specimen.Label" />
                                                @if (specimen.DuplicateOf is not null)
                                                {
                                                    <StatusBadge Text="@($"renders like {specimen.DuplicateOf}")" />
                                                }
                                            </div>
                                            <TextBlock TextStyle="@specimen.Style" Value="@specimen.Value" />
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <TypeScale />
                            }
                        </ExampleBlock>

                        <ExampleBlock Title="Bare elements and classes vs TextBlock "
                                      Description="Bare HTML now carries sensible defaults; apply cda-text-block classes directly when the required tag and the desired visual weight don't match."
                                      SourceId="examples/Foundations/RawElementsEscapeHatch.razor"
                                      ApiTypes="@TextBlockApiTypes">
                            <RawElementsEscapeHatch />
                        </ExampleBlock>

                        <ExampleBlock Title="Inline formatting"
                                      Description="Value renders as encoded plain text; use ChildContent with raw markup for bold, italic, or mixed emphasis inside a TextBlock."
                                      SourceId="examples/Foundations/InlineFormatting.razor"
                                      ApiTypes="@TextBlockApiTypes">
                            <InlineFormatting />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "SummaryTiles")
                    {
                        <ExampleBlock Title="Surface rhythm"
                                      Description="Spacing, copy length, and support metrics need to feel deliberate without additional chrome."
                                      SourceId="examples/Foundations/SurfaceRhythm.razor"
                                      ApiTypes="@SummaryTilesApiTypes">
                            <div class="space-y-4">
                                <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="Workspace review cadence" />
                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="@SurfaceParagraph" />
                                <SummaryTiles>
                                    <SummaryTile Label="Desktop cadence" Value="24px" HelperText="Default section spacing for the generous pass." Tone="info" />
                                    <SummaryTile Label="Dense cadence" Value="16px" HelperText="Compact variant used when the page carries more metadata." Tone="success" />
                                    <SummaryTile Label="Reading line" Value="66 ch" HelperText="Long copy still needs a controlled reading width." />
                                    <SummaryTile Label="Icon offset" Value="12px" HelperText="Support icons should align to the text rhythm." Tone="warning" />
                                </SummaryTiles>
                            </div>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Icon")
                    {
                        <ExampleBlock Title="Icon language"
                                      Description="Icons should support scanning rather than act like decoration."
                                      SourceId="examples/Foundations/IconLanguage.razor"
                                      ApiTypes="@IconApiTypes">
                            <div class="sandbox-demo-grid--three">
                                @foreach (var icon in IconTokens)
                                {
                                    <div class="sandbox-icon-tile">
                                        <Icon Name="@icon.Token" />
                                        <div class="space-y-1">
                                            <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="@icon.Label" />
                                            <TextBlock TextStyle="@(TextStyle.Caption)" Value="@icon.Token" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </ExampleBlock>

                        <ExampleBlock Title="Icon playground"
                                      Description="Adjust size and the Material Symbols variation axes to see how a glyph responds."
                                      SourceId="examples/Foundations/IconPlayground.razor"
                                      ApiTypes="@IconApiTypes">
                            <div class="sandbox-icon-playground">
                                <div class="sandbox-icon-playground__controls">
                                    <FormField Text="Icon">
                                        <select class="sandbox-icon-playground__select" value="@PlaygroundIconToken" @onchange="HandlePlaygroundIconChanged">
                                            @foreach (var icon in PlaygroundIconTokens)
                                            {
                                                <option value="@icon.Token">@icon.Label</option>
                                            }
                                        </select>
                                    </FormField>
                                    <FormField Text="@($"Size ({PlaygroundSize}px)")">
                                        <Slider TValue="int" Value="@PlaygroundSize" ValueChanged="@(v => PlaygroundSize = v)" Min="24" Max="256" Step="1" />
                                    </FormField>
                                    <FormField Text="Filled">
                                        <Switch Value="@PlaygroundFilled" ValueChanged="@(v => PlaygroundFilled = v)" />
                                    </FormField>
                                    <FormField Text="@($"Weight ({PlaygroundWeight})")">
                                        <Slider TValue="int" Value="@PlaygroundWeight" ValueChanged="@(v => PlaygroundWeight = v)" Min="100" Max="700" Step="10" />
                                    </FormField>
                                    <FormField Text="@($"Grade ({PlaygroundGrade})")">
                                        <Slider TValue="int" Value="@PlaygroundGrade" ValueChanged="@(v => PlaygroundGrade = v)" Min="-25" Max="200" Step="5" />
                                    </FormField>
                                    <FormField Text="@($"Optical size ({PlaygroundOpticalSize})")">
                                        <Slider TValue="int" Value="@PlaygroundOpticalSize" ValueChanged="@(v => PlaygroundOpticalSize = v)" Min="20" Max="48" Step="1" />
                                    </FormField>
                                    <FormField Text="Background checker">
                                        <Switch Value="@PlaygroundShowChecker" ValueChanged="@(v => PlaygroundShowChecker = v)" />
                                    </FormField>
                                </div>
                                <div class="sandbox-icon-playground__stage">
                                    <div class="@PlaygroundCheckerBoxClass" style="@PlaygroundCheckerBoxStyle">
                                        <Icon Name="@PlaygroundIconToken"
                                              Filled="@PlaygroundFilled"
                                              Weight="@PlaygroundWeight"
                                              Grade="@PlaygroundGrade"
                                              OpticalSize="@PlaygroundOpticalSize"
                                              Style="@PlaygroundIconStyle" />
                                    </div>
                                </div>
                            </div>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "MaterialIconCatalogGallery")
                    {
                        <ExampleBlock Title="Icon alias catalog"
                                      Description="The full set of semantic shorthand tokens the icon resolver understands, previewed against their resolved Material Symbols glyph."
                                      SourceId="examples/Foundations/MaterialIconCatalogGallery.razor">
                            <MaterialIconCatalogGallery />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "RoboAvatar")
                    {
                        <ExampleBlock Title="Seed-generated avatars"
                                      Description="Deterministic robot avatars generated purely from a seed string, with harmonized body/mouth/eye coloring."
                                      SourceId="examples/Foundations/RoboAvatarGallery.razor"
                                      ApiTypes="@RoboAvatarApiTypes">
                            <RoboAvatarGallery />
                        </ExampleBlock>
                    }
                </section>
            }
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Foundations);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Foundations);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/foundations");

    private static readonly IReadOnlyList<Type> TextBlockApiTypes = [typeof(TextBlock)];
    private static readonly IReadOnlyList<Type> SummaryTilesApiTypes = [typeof(SummaryTiles), typeof(SummaryTile)];
    private static readonly IReadOnlyList<Type> IconApiTypes = [typeof(Icon)];
    private static readonly IReadOnlyList<Type> RoboAvatarApiTypes = [typeof(RoboAvatar)];

    // Only reached from the Dense/LongText branch — the default specimens live solely
    // in the TypeScale example component (rendered directly, not duplicated here).
    private IReadOnlyList<TypeSpecimen> TypeSpecimens => CurrentScenario == SandboxScenarioKey.DenseContent
        ? DenseTypeSpecimens
        : LongTextTypeSpecimens;

    private string SurfaceParagraph => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "Dense surfaces reduce whitespace but still preserve grouping through headings, helper copy, and contained summary tiles. The page should feel brisk, not cramped.",
        SandboxScenarioKey.LongText => "Long explanatory copy should remain readable without collapsing into a narrow, uncomfortable measure. When the catalog carries more editorial guidance, the surrounding surfaces still need to feel stable and intentional.",
        SandboxScenarioKey.DisabledState => "Foundation surfaces in disabled mode should mute emphasis without flattening hierarchy. The user still needs to understand the structure even when interaction is unavailable.",
        _ => "The generous default keeps the page calm, gives typography room to breathe, and lets the headings explain the layout before color or decoration has to."
    };

    private IReadOnlyList<IconToken> IconTokens => CurrentScenario == SandboxScenarioKey.DenseContent
        ? DenseIcons
        : BaseIcons;

    private static readonly IReadOnlyList<TypeSpecimen> DenseTypeSpecimens =
    [
        new("H1", TextStyle.H1, "Dense review surfaces still need a strong opening line."),
        new("H3", TextStyle.H3, "Dense subheads keep adjacent blocks understandable."),
        new("Subtitle2", TextStyle.Subtitle2, "Metadata headings can compact slightly without losing emphasis."),
        new("Body2", TextStyle.Body2, "Dense copy uses tighter stacking, not smaller text."),
        new("Muted", TextStyle.Muted, "Muted helper text should remain readable inside compact lists.", DuplicateOf: "Note")
    ];

    private static readonly IReadOnlyList<TypeSpecimen> LongTextTypeSpecimens =
    [
        new("H1", TextStyle.H1, "Component acceptance still depends on fast comprehension even when the page needs to carry longer guidance for newer contributors."),
        new("H3", TextStyle.H3, "Longer explanatory headings cannot push the page into awkward wrapping or broken visual rhythm."),
        new("Body2", TextStyle.Body2, "Long-form helper copy must stay readable across the full-width shell without turning the first viewport into a wall of text."),
        new("Note", TextStyle.Note, "Support notes remain short, but they also need a stable line length when the primary copy grows.", DuplicateOf: "Muted"),
        new("Caption", TextStyle.Caption, "The smallest text still needs enough contrast to be usable.", DuplicateOf: "Small")
    ];

    private static readonly IReadOnlyList<IconToken> BaseIcons =
    [
        new("add_2", "Create"),
        new("filter_alt", "Filter"),
        new("calendar", "Schedule"),
        new("circle_info", "Context"),
        new("save", "Save"),
        new("risk", "Warning")
    ];

    private static readonly IReadOnlyList<IconToken> DenseIcons =
    [
        new("add_2", "Create"),
        new("filter_alt", "Filter"),
        new("calendar", "Schedule"),
        new("circle_info", "Context"),
        new("save", "Save"),
        new("risk", "Warning"),
        new("flow", "Flow"),
        new("bars_staggered", "Density"),
        new("research", "Inspect")
    ];

    private static readonly IReadOnlyList<IconToken> PlaygroundIconTokens = BaseIcons;

    private string PlaygroundIconToken = "add_2";
    private int PlaygroundSize = 256;
    private bool PlaygroundFilled;
    private int PlaygroundWeight = 400;
    private int PlaygroundGrade;
    private int PlaygroundOpticalSize = 24;
    private bool PlaygroundShowChecker = true;

    private string PlaygroundCheckerBoxClass => PlaygroundShowChecker
        ? "sandbox-icon-playground__checker-box sandbox-icon-playground__checker-box--checker"
        : "sandbox-icon-playground__checker-box";

    private string PlaygroundCheckerBoxStyle
    {
        get
        {
            var baseStyle = $"width:min({PlaygroundSize}px, 100%);";
            if (!PlaygroundShowChecker)
            {
                return baseStyle;
            }

            // The two offset gradient layers double the visible square count, so dividing by
            // 12 (not 24) yields a 24x24 visible grid matching the Material Symbols design grid.
            var tile = PlaygroundSize / 12.0;
            var half = tile / 2.0;
            return $"{baseStyle} background-size:{tile.ToString(CultureInfo.InvariantCulture)}px {tile.ToString(CultureInfo.InvariantCulture)}px; background-position:0 0, {half.ToString(CultureInfo.InvariantCulture)}px {half.ToString(CultureInfo.InvariantCulture)}px;";
        }
    }

    private string PlaygroundIconStyle => PlaygroundShowChecker
        ? $"font-size:{PlaygroundSize}px; opacity:0.55;"
        : $"font-size:{PlaygroundSize}px;";

    private void HandlePlaygroundIconChanged(ChangeEventArgs e)
        => PlaygroundIconToken = e.Value?.ToString() ?? PlaygroundIconToken;

    private sealed record TypeSpecimen(string Label, TextStyle Style, string Value, string? DuplicateOf = null);

    private sealed record IconToken(string Token, string Label);
}
