@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/charts"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Charts

<PageTitle>Charts</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Charts" Title="Preparing chart samples"
                          Description="The wrapper keeps a stable surface while generated trend and share data are loading." />
        }
        else if (CurrentScenario == SandboxScenarioKey.EmptyState)
        {
            <EmptyState Eyebrow="Charts" Title="No chart data"
                        Description="The chart wrapper can render a calm zero-data state before any consumer has series to show." />
        }
        else
        {
            @foreach (var section in Sections)
            {
                <section id="@section.Anchor" class="sandbox-component-section">
                    <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                    @if (section.ComponentName == "CdaChart")
                    {
                        <ExampleBlock Title="Filled consumption area"
                                      Description="Area fill, datetime labels, unit formatting, and toolbar controls."
                                      SourceId="examples/Charts/FilledConsumptionArea.razor"
                                      ApiTypes="@CdaChartApiTypes">
                            <FilledConsumptionArea />
                        </ExampleBlock>

                        <ExampleBlock Title="Energy source share"
                                      Description="Pie slices use point-level colors while the wrapper owns labels."
                                      SourceId="examples/Charts/EnergySourceShare.razor">
                            <EnergySourceShare />
                        </ExampleBlock>

                        <ExampleBlock Title="Multi-line house overview"
                                      Description="Several operational signals share one datetime axis with tuned colors and stable legend ordering."
                                      SourceId="examples/Charts/MultiLineHouseOverview.razor">
                            <MultiLineHouseOverview />
                        </ExampleBlock>

                        <ExampleBlock Title="Spot price line with labels"
                                      Description="Data labels and smooth curve support labeled trend inspection without leaving the wrapper."
                                      SourceId="examples/Charts/SpotPriceLineWithLabels.razor">
                            <SpotPriceLineWithLabels />
                        </ExampleBlock>

                        <ExampleBlock Title="Color-tuned import/export bars"
                                      Description="Per-point colors distinguish import from export while keeping one public point model."
                                      SourceId="examples/Charts/ColorTunedImportExportBars.razor">
                            <ColorTunedImportExportBars />
                        </ExampleBlock>
                    }
                </section>
            }
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Charts);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Charts);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/charts");
    private static readonly IReadOnlyList<Type> CdaChartApiTypes = [typeof(CdaChart)];
}
