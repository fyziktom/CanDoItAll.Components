@namespace CanDoItAll.Components.Sandbox.Components
@page "/overlays"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Overlays

<PageTitle>Overlays</PageTitle>

<CatalogPageFrame Group="@Group"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  FrameChanged="NavigateFrame">
    <ChildContent>

            @foreach (var section in VisibleSections(Sections))
            {
                <section id="@(section.Anchor)" class="sandbox-component-section">
                    @RenderSectionHeading(section)

                    @if (section.ComponentName == "DialogService")
                    {
                        <ExampleBlock Title="Dialog service"
                                      Description="DialogService examples cover modal sizes, protected backdrop behavior, and close results returned to the caller."
                                      SourceId="examples/Overlays/DialogServiceTriggers.razor"
                                      ApiTypes="@DialogServiceApiTypes">
                            <DialogServiceTriggers />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "TooltipService")
                    {
                        <ExampleBlock Title="Tooltip service"
                                      Description="TooltipService stays host-mounted so local pages only trigger state."
                                      SourceId="examples/Overlays/TooltipServiceTarget.razor"
                                      ApiTypes="@TooltipServiceApiTypes">
                            <TooltipServiceTarget />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "NotificationService")
                    {
                        <ExampleBlock Title="Notification service"
                                      Description="NotificationService stays host-mounted so local pages only trigger state."
                                      SourceId="examples/Overlays/NotificationToast.razor"
                                      ApiTypes="@NotificationServiceApiTypes">
                            <NotificationToast />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "OverlayWindow")
                    {
                        <ExampleBlock Title="Overlay window"
                                      Description="A bounded floating window should stay inside its host frame, preserve a safe top area, and keep action buttons readable while it moves through normal, minimized, and hidden states."
                                      SourceId="examples/Overlays/OverlayWindowExample.razor"
                                      ApiTypes="@OverlayWindowApiTypes">
                            <OverlayWindowExample />
                        </ExampleBlock>
                    }
                </section>
            }

    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Overlays);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Overlays);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/overlays");

    private static readonly IReadOnlyList<Type> DialogServiceApiTypes = [typeof(DialogService), typeof(DialogHost)];
    private static readonly IReadOnlyList<Type> TooltipServiceApiTypes = [typeof(TooltipService), typeof(TooltipTarget)];
    private static readonly IReadOnlyList<Type> NotificationServiceApiTypes = [typeof(NotificationService)];
    private static readonly IReadOnlyList<Type> OverlayWindowApiTypes = [typeof(OverlayWindow)];

    private const string SurfaceCopy = "Longer surrounding copy should not hide the sticky action footer or make the contextual help trigger feel disconnected from the content it supports.";

}
