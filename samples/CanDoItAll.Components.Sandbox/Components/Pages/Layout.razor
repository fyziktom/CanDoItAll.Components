@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/layout"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Layout
@using System.Globalization

<PageTitle>Layout</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  HeroTitle="Page-level composition that uses width intentionally."
                  HeroSummary="The layout page proves that shared shells, headers, rails, sections, and sticky actions still orient the user on both wide and constrained frames."
                  DemoTitle="Layout system"
                  DemoSummary="Page scaffolds, split regions, and sticky actions under the current scenario."
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Layout" Title="Composing the workspace shell" Description="The header, scaffold, and section rhythm stay legible while the content blocks load." />
        }
        else
        {
            @foreach (var section in Sections)
            {
                <section id="@section.Anchor" class="sandbox-component-section">
                    <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                    @if (section.ComponentName == "PageScaffold")
                    {
                        <ExampleBlock Title="Page-level composition"
                                      Description="A shared scaffold keeps header, lead metrics, supporting rail, and primary content in distinct, predictable regions."
                                      SourceId="examples/Layout/PageScaffoldWorkspace.razor"
                                      ApiTypes="@PageScaffoldApiTypes">
                            <PageScaffold MaxWidthClass="max-w-[1280px]"
                                          data-testid="sandbox-layout-scaffold">
                                <Header>
                                    <PageHeader Eyebrow="Shared layout"
                                                Title="@WorkspaceTitle"
                                                Description="@WorkspaceDescription">
                                        <Actions>
                                            <Button Text="Share view" ButtonStyle="@(ButtonStyle.Light)" Variant="@(Variant.Outlined)" />
                                            <Button Text="Open checklist" />
                                        </Actions>
                                    </PageHeader>
                                </Header>

                                <Lead>
                                    <SummaryTiles>
                                        <SummaryTile Label="Regions" Value="@RegionCount.ToString()" HelperText="Primary content, supporting rail, and action footer stay structurally distinct." Tone="info" />
                                        <SummaryTile Label="Sections" Value="@SectionCount.ToString()" HelperText="Grouped sections should read clearly without extra chrome." Tone="success" />
                                        <SummaryTile Label="Viewport" Value="@ViewportLabel" HelperText="Frame changes should preserve orientation and hierarchy." Tone="warning" />
                                    </SummaryTiles>
                                </Lead>

                                <SecondaryRail>
                                    <SectionCard Title="Review rail" Description="The supporting rail should stay concise and useful.">
                                        <div class="sandbox-proof-list">
                                            <p>Use the right rail for compact context, not for duplicate content.</p>
                                            <p>Headings should make the page understandable before the user reads paragraphs.</p>
                                        </div>
                                    </SectionCard>

                                    <SectionCard Title="Current emphasis" Description="Scenario-specific expectations for this pass.">
                                        <div class="sandbox-proof-list">
                                            <p>@ScenarioRailCopy</p>
                                            <p>@WidthRailCopy</p>
                                        </div>
                                    </SectionCard>
                                </SecondaryRail>

                                <ChildContent>
                                    <div class="sandbox-demo-grid sandbox-demo-grid--two"
                                         data-testid="sandbox-layout-primary-grid">
                                        <FormSection Title="Primary workspace" Description="The main region should be able to hold operational content without collapsing the reading rhythm.">
                                            <div class="space-y-4">
                                                <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="Release acceptance workspace" />
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="@WorkspaceCopy" />

                                                <div class="sandbox-demo-grid sandbox-demo-grid--two">
                                                    @foreach (var metric in WorkspaceMetrics)
                                                    {
                                                        <SectionCard Title="@metric.Title" Description="@metric.Description">
                                                            <div class="space-y-2">
                                                                <TextBlock TextStyle="@(TextStyle.H4)" Value="@metric.Value" />
                                                                <StatusBadge Text="@metric.ToneLabel" Tone="@metric.Tone" />
                                                            </div>
                                                        </SectionCard>
                                                    }
                                                </div>
                                            </div>
                                        </FormSection>

                                        <SectionCard Title="Secondary workspace" Description="The supporting column still needs enough substance to justify its width.">
                                            <div class="sandbox-kv-list">
                                                @foreach (var item in SecondaryFacts)
                                                {
                                                    <div class="sandbox-kv-item">
                                                        <strong>@item.Label</strong>
                                                        <span>@item.Value</span>
                                                    </div>
                                                }
                                            </div>
                                        </SectionCard>
                                    </div>
                                </ChildContent>
                            </PageScaffold>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "PageHeader")
                    {
                        <ExampleBlock Title="Header variants"
                                      Description="A standard header carries eyebrow, title, description, and trailing actions; a compact header fits inside list-detail and rail panes."
                                      SourceId="examples/Layout/PageHeaderVariants.razor"
                                      ApiTypes="@PageHeaderApiTypes">
                            <div class="space-y-4">
                                <PageHeader Eyebrow="Shared layout"
                                            Title="@WorkspaceTitle"
                                            Description="@WorkspaceDescription">
                                    <Actions>
                                        <Button Text="Share view" ButtonStyle="@(ButtonStyle.Light)" Variant="@(Variant.Outlined)" />
                                        <Button Text="Open checklist" />
                                    </Actions>
                                </PageHeader>
                                <PageHeader Eyebrow="List pane" Title="Compact header" Compact="true" />
                            </div>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "ZoomPanFrame")
                    {
                        <ExampleBlock Title="Zoom and pan frame"
                                      Description="A standalone raster preview proves the shared interaction boundary without relying on Mermaid rendering."
                                      SourceId="examples/Layout/ZoomPanPreview.razor"
                                      ApiTypes="@ZoomPanFrameApiTypes">
                            <Stack GapScale="LayoutGap.Medium">
                                <ZoomPanFrame AriaLabel="Packaged raster zoom and pan preview"
                                              ResetKey="@CurrentScenario"
                                              Style="block-size: clamp(14rem, 42vw, 24rem); --cda-zoom-pan-min-height: 14rem;"
                                              data-testid="sandbox-zoom-pan-frame">
                                    <img src="@ZoomPanImageSource"
                                         alt="Portrait preview used to validate zoom and pan"
                                         draggable="false"
                                         data-testid="sandbox-zoom-pan-image"
                                         style="block-size: 100%; inline-size: 100%; object-fit: contain;" />
                                </ZoomPanFrame>

                                <Alert AlertStyle="AlertStyle.Info">
                                    Use the toolbar or wheel to zoom, drag or press the arrow keys after zooming, pinch on touch, and choose Reset or press 0 to restore the view.
                                </Alert>
                            </Stack>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "ListDetailShell")
                    {
                        <ExampleBlock Title="Shared records list-detail"
                                      Description="The lower split region should still orient the user, whether it holds full record content or an explanatory empty state."
                                      SourceId="examples/Layout/RecordListDetailShell.razor"
                                      ApiTypes="@ListDetailShellApiTypes">
                            <ListDetailShell ListPaneWidth="22rem"
                                             data-testid="sandbox-layout-list-detail">
                                <ListHeader>
                                    <PageHeader Eyebrow="List pane" Title="Shared records" Compact="true" />
                                </ListHeader>
                                <ListContent>
                                    <div class="sandbox-list">
                                        @foreach (var item in WorkspaceItems)
                                        {
                                            <SelectionListItem IsSelected="@(item.Id == SelectedItem.Id)"
                                                               Title="@item.Title"
                                                               Eyebrow="@item.Eyebrow"
                                                               Meta="@item.Meta"
                                                               Summary="@item.Summary">
                                                <Status>
                                                    <StatusBadge Text="@item.State" Tone="@item.Tone" />
                                                </Status>
                                            </SelectionListItem>
                                        }
                                    </div>
                                </ListContent>
                                <DetailHeader>
                                    <PageHeader Eyebrow="Detail pane" Title="Selected record" Compact="true" />
                                </DetailHeader>
                                <DetailContent>
                                    @if (CurrentScenario == SandboxScenarioKey.EmptyState)
                                    {
                                        <EmptyState Eyebrow="Layout" Title="No records in view" Description="The detail region should stay oriented even when the current filter returns nothing." />
                                    }
                                    else
                                    {
                                        <div class="space-y-4">
                                            <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="@SelectedItem.Title" />
                                            <TextBlock TextStyle="@(TextStyle.Body2)" Value="@SelectedItem.Summary" />
                                            <Alert AlertStyle="@(AlertStyle.Info)">@SelectedItem.Detail</Alert>
                                        </div>
                                    }
                                </DetailContent>
                            </ListDetailShell>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "StickyActionFooter")
                    {
                        <ExampleBlock Title="Sticky action footer"
                                      Description="The sticky footer should close the flow with a clear primary action, without dominating the page."
                                      SourceId="examples/Layout/WorkspaceFooter.razor"
                                      ApiTypes="@StickyActionFooterApiTypes">
                            <StickyActionFooter StatusLabel="Layout state"
                                                StatusMessage="@FooterMessage"
                                                StatusTone="@FooterTone"
                                                data-testid="sandbox-layout-sticky-footer">
                                <SecondaryActions>
                                    <Button Text="Save draft" ButtonStyle="@(ButtonStyle.Light)" Variant="@(Variant.Outlined)" Disabled="@IsActionDisabled" />
                                </SecondaryActions>
                                <PrimaryActions>
                                    <Button Text="@PrimaryActionText" Disabled="@IsActionDisabled" />
                                </PrimaryActions>
                                <DangerActions>
                                    <Button Text="Discard" ButtonStyle="@(ButtonStyle.Danger)" Variant="@(Variant.Text)" Disabled="@IsActionDisabled" />
                                </DangerActions>
                            </StickyActionFooter>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Stack")
                    {
                        <ExampleBlock Title="1. Stack baseline"
                                      Description="Useful when the structure is mostly linear and the right-side region can remain a stack of actions."
                                      SourceId="examples/Layout/StackComposition.razor"
                                      ApiTypes="@StackApiTypes">
                            <div class="@HeroSurfaceClass" data-testid="layout-composition-stack">
                                <Stack Orientation="Orientation.Vertical" Class="w-full" Gap="1.25rem">
                                    <Stack Orientation="Orientation.Horizontal" Class="w-full">
                                        <Stack Orientation="Orientation.Vertical" Gap="1rem">
                                            <span class="cda-shell-pill cda-shell-pill--neutral">@HeroEyebrow</span>
                                            <div class="space-y-2">
                                                <p class="text-base font-semibold text-slate-950">@HeroTitle</p>
                                                <p class="text-sm leading-6 text-slate-600">@HeroDescription</p>
                                            </div>
                                        </Stack>

                                        <Stack Orientation="Orientation.Vertical" Class="w-full" Gap="1rem">
                                            <Stack Orientation="Orientation.Horizontal"
                                                   JustifyContent="JustifyContent.End"
                                                   Class="w-full"
                                                   Gap="1rem">
                                                <PillList>
                                                    <Pill>@SelectedModeLabel</Pill>
                                                    <Pill>@WindowLabel</Pill>
                                                    <Pill>@FreshnessLabel</Pill>
                                                </PillList>
                                            </Stack>

                                            <Stack Orientation="Orientation.Horizontal"
                                                   JustifyContent="JustifyContent.End"
                                                   Class="w-full"
                                                   Gap="1rem">
                                                <Button Text="Refresh"
                                                        Icon="refresh"
                                                        ButtonStyle="ButtonStyle.Light"
                                                        Click="HandleRefreshAsync"
                                                        Disabled="@ActionsDisabled" />
                                                <Button Text="Reset Data"
                                                        Icon="delete"
                                                        ButtonStyle="ButtonStyle.Danger"
                                                        Click="HandleResetAsync"
                                                        Disabled="@ActionsDisabled" />
                                            </Stack>
                                        </Stack>
                                    </Stack>

                                    <FormRow Split="true" Class="w-full">
                                        <FormField Text="Mode" ContainerClass="w-full">
                                            <ChildContent>
                                                <DropDown TValue="string"
                                                          Data="@ModeOptions"
                                                          Value="@selectedMode"
                                                          Change="OnModeChanged"
                                                          Style="width:100%" />
                                            </ChildContent>
                                        </FormField>
                                        <FormField Text="Time Window" ContainerClass="w-full">
                                            <ChildContent>
                                                <DropDown TValue="int"
                                                          Data="@WindowOptions"
                                                          Value="@selectedWindowDays"
                                                          Change="OnWindowChanged"
                                                          Style="width:100%" />
                                            </ChildContent>
                                        </FormField>
                                    </FormRow>
                                </Stack>
                            </div>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Grid")
                    {
                        <ExampleBlock Title="2. Grid version"
                                      Description="A good middle ground when the surface needs track-based composition, but the right side still reads well as nested stacks."
                                      SourceId="examples/Layout/GridComposition.razor"
                                      ApiTypes="@GridApiTypes">
                            <div class="@HeroSurfaceClass" data-testid="layout-composition-grid">
                                <Grid Gap="LayoutGap.XLarge" Class="w-full">
                                    <Grid Gap="LayoutGap.XLarge"
                                          ColumnTemplateLg="minmax(0,1fr) minmax(0,0.85fr)"
                                          Class="w-full">
                                        <Stack Orientation="Orientation.Vertical" Gap="1rem">
                                            <span class="cda-shell-pill cda-shell-pill--neutral">@HeroEyebrow</span>
                                            <div class="space-y-2">
                                                <p class="text-base font-semibold text-slate-950">@HeroTitle</p>
                                                <p class="text-sm leading-6 text-slate-600">@HeroDescription</p>
                                            </div>
                                        </Stack>

                                        <Stack Orientation="Orientation.Vertical" Class="w-full" Gap="1rem">
                                            <Stack Orientation="Orientation.Horizontal"
                                                   JustifyContent="JustifyContent.End"
                                                   Wrap="FlexWrap.Wrap"
                                                   Class="w-full"
                                                   Gap="1rem">
                                                <PillList>
                                                    <Pill>@SelectedModeLabel</Pill>
                                                    <Pill>@WindowLabel</Pill>
                                                    <Pill>@FreshnessLabel</Pill>
                                                </PillList>
                                            </Stack>

                                            <Stack Orientation="Orientation.Horizontal"
                                                   JustifyContent="JustifyContent.End"
                                                   Wrap="FlexWrap.Wrap"
                                                   Class="w-full"
                                                   Gap="1rem">
                                                <Button Text="Refresh"
                                                        Icon="refresh"
                                                        ButtonStyle="ButtonStyle.Light"
                                                        Click="HandleRefreshAsync"
                                                        Disabled="@ActionsDisabled" />
                                                <Button Text="Reset Data"
                                                        Icon="delete"
                                                        ButtonStyle="ButtonStyle.Danger"
                                                        Click="HandleResetAsync"
                                                        Disabled="@ActionsDisabled" />
                                            </Stack>
                                        </Stack>
                                    </Grid>

                                    <FormRow Split="true" Class="w-full">
                                        <FormField Text="Mode" ContainerClass="w-full">
                                            <ChildContent>
                                                <DropDown TValue="string"
                                                          Data="@ModeOptions"
                                                          Value="@selectedMode"
                                                          Change="OnModeChanged"
                                                          Style="width:100%" />
                                            </ChildContent>
                                        </FormField>

                                        <FormField Text="Time Window" ContainerClass="w-full">
                                            <ChildContent>
                                                <DropDown TValue="int"
                                                          Data="@WindowOptions"
                                                          Value="@selectedWindowDays"
                                                          Change="OnWindowChanged"
                                                          Style="width:100%" />
                                            </ChildContent>
                                        </FormField>
                                    </FormRow>
                                </Grid>
                            </div>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Row")
                    {
                        <ExampleBlock Title="3. Grid + Row + Column"
                                      Description="This version keeps the whole composition inside the shared layout primitives while bounding the two-track composition to wider breakpoints."
                                      SourceId="examples/Layout/RowColumnFixed.razor"
                                      ApiTypes="@RowColumnApiTypes">
                            <div class="@HeroSurfaceClass" data-testid="layout-composition-row-column-fixed">
                                <Grid Columns="1"
                                      ColumnsLg="2"
                                      ColumnTemplateLg="minmax(0,1fr) minmax(0,0.85fr)"
                                      Gap="LayoutGap.XLarge"
                                      Class="w-full">
                                    <Row GapScale="LayoutGap.XLarge">
                                        <Column GapScale="LayoutGap.Medium" JustifyContent="JustifyContent.Center">
                                            <span class="cda-shell-pill cda-shell-pill--neutral">@HeroEyebrow</span>
                                            <p class="text-base font-semibold text-slate-950">@HeroTitle</p>
                                            <p class="text-sm leading-6 text-slate-600">@HeroDescription</p>
                                        </Column>

                                        <Column GapScale="LayoutGap.Large"
                                                AlignItems="AlignItems.End"
                                                JustifyContent="JustifyContent.SpaceBetween">
                                            <PillList>
                                                <Pill>@SelectedModeLabel</Pill>
                                                <Pill>@WindowLabel</Pill>
                                                <Pill>@FreshnessLabel</Pill>
                                            </PillList>

                                            <Row Columns="1" ColumnsSm="2" GapScale="LayoutGap.Large">
                                                <Column>
                                                    <Button Text="Refresh"
                                                            Icon="refresh"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Click="HandleRefreshAsync"
                                                            Disabled="@ActionsDisabled" />
                                                </Column>
                                                <Column>
                                                    <Button Text="Reset Data"
                                                            Icon="delete"
                                                            ButtonStyle="ButtonStyle.Danger"
                                                            Click="HandleResetAsync"
                                                            Disabled="@ActionsDisabled" />
                                                </Column>
                                            </Row>
                                        </Column>
                                    </Row>

                                    <Row Columns="1" ColumnsMd="2" GapScale="LayoutGap.XLarge">
                                        <Column>
                                            <FormField Text="Mode" ContainerClass="w-full">
                                                <ChildContent>
                                                    <DropDown TValue="string"
                                                              Data="@ModeOptions"
                                                              Value="@selectedMode"
                                                              Change="OnModeChanged"
                                                              Style="width:100%" />
                                                </ChildContent>
                                            </FormField>
                                        </Column>

                                        <Column>
                                            <FormField Text="Time Window" ContainerClass="w-full">
                                                <ChildContent>
                                                    <DropDown TValue="int"
                                                              Data="@WindowOptions"
                                                              Value="@selectedWindowDays"
                                                              Change="OnWindowChanged"
                                                              Style="width:100%" />
                                                </ChildContent>
                                            </FormField>
                                        </Column>
                                    </Row>
                                </Grid>
                            </div>
                        </ExampleBlock>

                        <ExampleBlock Title="4. Responsive Grid + Row + Column"
                                      Description="Preferred pattern. The same-row columns inherit and override tracks through the shared primitives, so the layout can collapse to one column and expand again without custom structural CSS."
                                      SourceId="examples/Layout/RowColumnResponsive.razor">
                            <div class="@HeroSurfaceClass" data-testid="layout-composition-row-column-responsive">
                                <Grid Columns="1"
                                      ColumnsSm="1"
                                      ColumnsMd="2"
                                      ColumnTemplateLg="minmax(0,1fr) minmax(0,0.85fr)"
                                      Gap="LayoutGap.XLarge"
                                      Class="w-full">
                                    <Row GapScale="LayoutGap.XLarge">
                                        <Column GapScale="LayoutGap.Medium" JustifyContent="JustifyContent.Center">
                                            <span class="cda-shell-pill cda-shell-pill--neutral">@HeroEyebrow</span>
                                            <p class="text-base font-semibold text-slate-950">@HeroTitle</p>
                                            <p class="text-sm leading-6 text-slate-600">@HeroDescription</p>
                                        </Column>

                                        <Column GapScale="LayoutGap.Large"
                                                AlignItems="AlignItems.End"
                                                JustifyContent="JustifyContent.SpaceBetween">
                                            <PillList>
                                                <Pill>@SelectedModeLabel</Pill>
                                                <Pill>@WindowLabel</Pill>
                                                <Pill>@FreshnessLabel</Pill>
                                            </PillList>

                                            <Row Columns="1" ColumnsSm="2" GapScale="LayoutGap.Large">
                                                <Column>
                                                    <Button Text="Refresh"
                                                            Icon="refresh"
                                                            ButtonStyle="ButtonStyle.Light"
                                                            Click="HandleRefreshAsync"
                                                            Disabled="@ActionsDisabled" />
                                                </Column>
                                                <Column>
                                                    <Button Text="Reset Data"
                                                            Icon="delete"
                                                            ButtonStyle="ButtonStyle.Danger"
                                                            Click="HandleResetAsync"
                                                            Disabled="@ActionsDisabled" />
                                                </Column>
                                            </Row>
                                        </Column>
                                    </Row>

                                    <Row Columns="1"
                                         ColumnsSm="1"
                                         ColumnsMd="2"
                                         ColumnTemplateLg="repeat(2,minmax(0,1fr))"
                                         GapScale="LayoutGap.XLarge">
                                        <Column>
                                            <FormField Text="Mode" ContainerClass="w-full">
                                                <ChildContent>
                                                    <DropDown TValue="string"
                                                              Data="@ModeOptions"
                                                              Value="@selectedMode"
                                                              Change="OnModeChanged"
                                                              Style="width:100%" />
                                                </ChildContent>
                                            </FormField>
                                        </Column>

                                        <Column>
                                            <FormField Text="Time Window" ContainerClass="w-full">
                                                <ChildContent>
                                                    <DropDown TValue="int"
                                                              Data="@WindowOptions"
                                                              Value="@selectedWindowDays"
                                                              Change="OnWindowChanged"
                                                              Style="width:100%" />
                                                </ChildContent>
                                            </FormField>
                                        </Column>
                                    </Row>
                                </Grid>
                            </div>
                        </ExampleBlock>
                    }
                </section>
            }
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Layout);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Layout);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/layout");
    private const string ZoomPanImageSource = "_content/CanDoItAll.Components.BaseLib/assets/identity/avatars/avatar-06.jpg";

    private static readonly IReadOnlyList<Type> PageScaffoldApiTypes = [typeof(PageScaffold)];
    private static readonly IReadOnlyList<Type> PageHeaderApiTypes = [typeof(PageHeader)];
    private static readonly IReadOnlyList<Type> ZoomPanFrameApiTypes = [typeof(ZoomPanFrame)];
    private static readonly IReadOnlyList<Type> ListDetailShellApiTypes = [typeof(ListDetailShell)];
    private static readonly IReadOnlyList<Type> StickyActionFooterApiTypes = [typeof(StickyActionFooter)];
    private static readonly IReadOnlyList<Type> StackApiTypes = [typeof(Stack)];
    private static readonly IReadOnlyList<Type> GridApiTypes = [typeof(Grid)];
    private static readonly IReadOnlyList<Type> RowColumnApiTypes = [typeof(Row), typeof(Column)];

    private static readonly IReadOnlyList<string> ModeOptions = ["All modes", "Interval speed", "Harmony", "Sight reading"];
    private static readonly IReadOnlyList<int> WindowOptions = [7, 14, 30, 90, 180];

    private const string HeroSurfaceClass =
        "w-full min-w-0 rounded-[1.75rem] border border-slate-200/80 bg-[linear-gradient(135deg,rgba(255,255,255,0.98)_0%,rgba(244,249,255,0.98)_56%,rgba(220,243,255,0.96)_100%)] p-5 shadow-[0_24px_60px_-34px_rgba(14,116,144,0.3)]";

    private string selectedMode = ModeOptions[0];
    private int selectedWindowDays = 30;
    private DateTimeOffset lastUpdated = new(2026, 4, 4, 11, 9, 0, TimeSpan.FromHours(-4));

    private string WorkspaceTitle => CurrentScenario == SandboxScenarioKey.LongText
        ? "Migration acceptance workspace with extended release notes and validation guidance"
        : "Migration acceptance workspace";

    private string WorkspaceDescription => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "Dense layout still needs a stable main column, a concise supporting rail, and action placement that does not fight the content.",
        SandboxScenarioKey.EmptyState => "The shell should still orient the user even when the active list is empty and the detail panel has nothing to show yet.",
        SandboxScenarioKey.LongText => "Longer page descriptions should not force the scaffold into awkward wrapping or a first viewport that feels like a document instead of a workspace.",
        _ => "Shared page shells should make hierarchy, supporting context, and final actions obvious without inventing custom page structure."
    };

    private string WorkspaceCopy => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "Dense workspace content compresses spacing slightly, but the header, key metrics, and detail region still need enough separation to stay scannable.",
        SandboxScenarioKey.LongText => "Longer explanatory copy belongs in the main region, where it can keep a controlled reading width and still leave the rail available for compact operational context.",
        _ => "The default layout keeps the main work in the primary region, keeps support context in the rail, and uses the sticky footer to close the flow cleanly."
    };

    private string ScenarioRailCopy => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "This pass checks whether denser content still looks composed rather than over-packed.",
        SandboxScenarioKey.EmptyState => "This pass checks whether the shell explains itself before any records are selected.",
        SandboxScenarioKey.LongText => "This pass checks whether longer page copy stays readable without crushing the layout.",
        _ => "This pass checks baseline composition and region clarity."
    };

    private string WidthRailCopy => CurrentFrame switch
    {
        SandboxFramePreset.Mobile => "Mobile should surface the headline, first metric, and next step without forcing horizontal scanning.",
        SandboxFramePreset.Desktop => "Desktop should use breadth deliberately and avoid dead space between sections.",
        _ => "The live viewport should keep the same hierarchy rules as the proof frames."
    };

    private string ViewportLabel => CurrentFrame switch
    {
        SandboxFramePreset.Mobile => "Mobile",
        SandboxFramePreset.Desktop => "Desktop",
        _ => "Live"
    };

    private int RegionCount => 3;

    private int SectionCount => CurrentScenario == SandboxScenarioKey.DenseContent ? 6 : 5;

    private bool IsActionDisabled => CurrentScenario == SandboxScenarioKey.EmptyState;

    private string FooterMessage => CurrentScenario == SandboxScenarioKey.EmptyState
        ? "Choose or create a record before the page-level actions become available."
        : "Shared layout components should make the next step obvious without inventing one-off page wrappers.";

    private string FooterTone => CurrentScenario == SandboxScenarioKey.EmptyState ? "warning" : "info";

    private string PrimaryActionText => CurrentScenario == SandboxScenarioKey.LongText
        ? "Approve workspace layout and capture proof bundle"
        : "Approve layout";

    private WorkspaceItem SelectedItem => WorkspaceItems[0];

    private IReadOnlyList<WorkspaceMetric> WorkspaceMetrics => CurrentScenario == SandboxScenarioKey.DenseContent
        ? DenseMetrics
        : BaseMetrics;

    private IReadOnlyList<WorkspaceFact> SecondaryFacts => CurrentScenario == SandboxScenarioKey.LongText
        ? LongFacts
        : BaseFacts;

    private IReadOnlyList<WorkspaceItem> WorkspaceItems => CurrentScenario == SandboxScenarioKey.DenseContent
        ? DenseItems
        : BaseItems;

    private string HeroEyebrow => CurrentScenario == SandboxScenarioKey.LongText
        ? "Practice analytics composition"
        : "Practice analytics";

    private string HeroTitle => CurrentScenario == SandboxScenarioKey.LongText
        ? "Switch the active practice mode or time window without losing scan rhythm."
        : "Switch the mode or time window.";

    private string HeroDescription => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "Dense metadata and action controls should still read as one coherent control surface.",
        SandboxScenarioKey.EmptyState => "Even with no fresh activity, the layout should remain oriented and calm.",
        SandboxScenarioKey.DisabledState => "Disabled controls should preserve hierarchy instead of collapsing the composition.",
        SandboxScenarioKey.LongText => "Longer explanatory copy should wrap cleanly while the filters, pills, and actions stay aligned.",
        _ => "Compare how the same content behaves when the structure moves from simple stacks to responsive rows and columns."
    };

    private string SelectedModeLabel => CurrentScenario == SandboxScenarioKey.LongText
        ? "All note-identification modes"
        : selectedMode;

    private string WindowLabel => $"{selectedWindowDays}-day window";

    private string FreshnessLabel => CurrentScenario == SandboxScenarioKey.EmptyState
        ? "No attempts yet"
        : $"Updated {lastUpdated.ToString("M/d/yyyy h:mm tt", CultureInfo.InvariantCulture)}";

    private bool ActionsDisabled => CurrentScenario == SandboxScenarioKey.DisabledState;

    private Task OnModeChanged(object value)
    {
        selectedMode = value?.ToString() ?? selectedMode;
        return Task.CompletedTask;
    }

    private Task OnWindowChanged(object value)
    {
        if (value is int days)
        {
            selectedWindowDays = days;
        }
        else if (int.TryParse(value?.ToString(), out var parsedDays))
        {
            selectedWindowDays = parsedDays;
        }

        return Task.CompletedTask;
    }

    private Task HandleRefreshAsync()
    {
        if (!ActionsDisabled && CurrentScenario != SandboxScenarioKey.EmptyState)
        {
            lastUpdated = lastUpdated.AddMinutes(12);
        }

        return Task.CompletedTask;
    }

    private Task HandleResetAsync()
    {
        if (!ActionsDisabled)
        {
            selectedMode = ModeOptions[0];
            selectedWindowDays = 30;
            lastUpdated = new DateTimeOffset(2026, 4, 4, 11, 9, 0, TimeSpan.FromHours(-4));
        }

        return Task.CompletedTask;
    }

