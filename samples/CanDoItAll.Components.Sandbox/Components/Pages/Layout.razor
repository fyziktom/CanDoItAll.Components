@namespace CanDoItAll.Components.Sandbox.Components
@page "/layout"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Layout

<PageTitle>Layout</PageTitle>

<CatalogPageFrame Group="@Group"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  FrameChanged="NavigateFrame">
    <ChildContent>

            @foreach (var section in Sections)
            {
                <section id="@(section.Anchor)" class="sandbox-component-section">
                    <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                    @if (section.ComponentName == "PageScaffold")
                    {
                        <ExampleBlock Title="Page-level composition"
                                      Description="A shared scaffold keeps header, lead metrics, supporting rail, and primary content in distinct, predictable regions."
                                      SourceId="examples/Layout/PageScaffoldWorkspace.razor"
                                      ApiTypes="@PageScaffoldApiTypes">
                            <PageScaffoldWorkspace />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "ZoomPanFrame")
                    {
                        <ExampleBlock Title="Zoom and pan frame"
                                      Description="A standalone raster preview proves the shared interaction boundary without relying on Mermaid rendering."
                                      SourceId="examples/Layout/ZoomPanPreview.razor"
                                      ApiTypes="@ZoomPanFrameApiTypes">
                            <ZoomPanPreview />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "StickyActionFooter")
                    {
                        <ExampleBlock Title="Sticky action footer"
                                      Description="The sticky footer should close the flow with a clear primary action, without dominating the page."
                                      SourceId="examples/Layout/WorkspaceFooter.razor"
                                      ApiTypes="@StickyActionFooterApiTypes">
                            <WorkspaceFooter />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Stack")
                    {
                        <ExampleBlock Title="1. Stack baseline"
                                      Description="Useful when the structure is mostly linear and the right-side region can remain a stack of actions."
                                      SourceId="examples/Layout/StackComposition.razor"
                                      ApiTypes="@StackApiTypes">
                            <StackComposition />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Grid")
                    {
                        <ExampleBlock Title="2. Grid version"
                                      Description="A good middle ground when the surface needs track-based composition, but the right side still reads well as nested stacks."
                                      SourceId="examples/Layout/GridComposition.razor"
                                      ApiTypes="@GridApiTypes">
                            <GridComposition />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Row")
                    {
                        <ExampleBlock Title="3. Grid + Row + Column"
                                      Description="This version keeps the whole composition inside the shared layout primitives while bounding the two-track composition to wider breakpoints."
                                      SourceId="examples/Layout/RowColumnFixed.razor"
                                      ApiTypes="@RowColumnApiTypes">
                            <RowColumnFixed />
                        </ExampleBlock>

                        <ExampleBlock Title="4. Responsive Grid + Row + Column"
                                      Description="Preferred pattern. The same-row columns inherit and override tracks through the shared primitives, so the layout can collapse to one column and expand again without custom structural CSS."
                                      SourceId="examples/Layout/RowColumnResponsive.razor">
                            <RowColumnResponsive />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Body")
                    {
                        <ExampleBlock Title="Scrollable content region"
                                      Description="Body is the main content region inside a shell. FillHeight and Scrollable let it own its own scrollbar instead of the page."
                                      SourceId="examples/Layout/BodyScrollable.razor"
                                      ApiTypes="@BodyApiTypes">
                            <BodyScrollable />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Sidebar")
                    {
                        <ExampleBlock Title="Collapsible sidebar"
                                      Description="Sidebar toggles visibility via Expanded, typically paired with a Body region inside a shell."
                                      SourceId="examples/Layout/SidebarToggle.razor"
                                      ApiTypes="@SidebarApiTypes">
                            <SidebarToggle />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "PageShell")
                    {
                        <ExampleBlock Title="Minimal page wrapper"
                                      Description="PageShell is a thin structural wrapper that composes Sidebar and Body into a single shell region."
                                      SourceId="examples/Layout/PageShellMiniShell.razor"
                                      ApiTypes="@PageShellApiTypes">
                            <PageShellMiniShell />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Layout")
                    {
                        <ExampleBlock Title="App-level shell wrapper"
                                      Description="Layout is the outermost shell primitive. FitViewport locks height to the viewport (minus ViewportOffset) and locks overflow; this preview overrides the computed height to a fixed size so the section stays contained on the page."
                                      SourceId="examples/Layout/LayoutFitViewport.razor"
                                      ApiTypes="@LayoutApiTypes">
                            <LayoutFitViewport />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Cluster")
                    {
                        <ExampleBlock Title="Wrapping action row"
                                      Description="Cluster wraps items into a flexible row, controlling gap, alignment, and justification independent of a specific parent component."
                                      SourceId="examples/Layout/ClusterTags.razor"
                                      ApiTypes="@ClusterApiTypes">
                            <ClusterTags />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Split")
                    {
                        <ExampleBlock Title="Responsive header row"
                                      Description="Split lays out a title and description on one side and actions on the other, collapsing to a stacked column below its Breakpoint."
                                      SourceId="examples/Layout/SplitHeaderRow.razor"
                                      ApiTypes="@SplitApiTypes">
                            <SplitHeaderRow />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "ThemeHost")
                    {
                        <ExampleBlock Title="Scoped theme"
                                      Description="ThemeHost sets data-cad-theme and color-scheme so nested content can be scoped to light or dark independent of the rest of the page."
                                      SourceId="examples/Layout/ThemeHostComparison.razor"
                                      ApiTypes="@ThemeHostApiTypes">
                            <ThemeHostComparison />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "WorkspacePanel")
                    {
                        <ExampleBlock Title="Panel tones"
                                      Description="WorkspacePanel offers a solid Default tone and a dashed Ghost tone for placeholder or secondary content."
                                      SourceId="examples/Layout/WorkspacePanelTones.razor"
                                      ApiTypes="@WorkspacePanelApiTypes">
                            <WorkspacePanelTones />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "WorkspaceSplit")
                    {
                        <ExampleBlock Title="Two-column dashboard grid"
                                      Description="WorkspaceSplit lays out a wide main panel and a narrower side panel, collapsing to one column below 1280px."
                                      SourceId="examples/Layout/WorkspaceSplitDashboard.razor"
                                      ApiTypes="@WorkspaceSplitApiTypes">
                            <WorkspaceSplitDashboard />
                        </ExampleBlock>
                    }
                </section>
            }

    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Layout);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Layout);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/layout");

    private static readonly IReadOnlyList<Type> PageScaffoldApiTypes = [typeof(PageScaffold)];
    private static readonly IReadOnlyList<Type> ZoomPanFrameApiTypes = [typeof(ZoomPanFrame)];
    private static readonly IReadOnlyList<Type> StickyActionFooterApiTypes = [typeof(StickyActionFooter)];
    private static readonly IReadOnlyList<Type> StackApiTypes = [typeof(Stack)];
    private static readonly IReadOnlyList<Type> GridApiTypes = [typeof(Grid)];
    private static readonly IReadOnlyList<Type> RowColumnApiTypes = [typeof(Row), typeof(Column)];
    private static readonly IReadOnlyList<Type> BodyApiTypes = [typeof(Body)];
    private static readonly IReadOnlyList<Type> SidebarApiTypes = [typeof(Sidebar)];
    private static readonly IReadOnlyList<Type> PageShellApiTypes = [typeof(PageShell)];
    private static readonly IReadOnlyList<Type> LayoutApiTypes = [typeof(CanDoItAll.Components.BaseLib.Layout)];
    private static readonly IReadOnlyList<Type> ClusterApiTypes = [typeof(Cluster)];
    private static readonly IReadOnlyList<Type> SplitApiTypes = [typeof(Split)];
    private static readonly IReadOnlyList<Type> ThemeHostApiTypes = [typeof(ThemeHost)];
    private static readonly IReadOnlyList<Type> WorkspacePanelApiTypes = [typeof(WorkspacePanel)];
    private static readonly IReadOnlyList<Type> WorkspaceSplitApiTypes = [typeof(WorkspaceSplit), typeof(WorkspacePanel)];
}
