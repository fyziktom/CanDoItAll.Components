@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/mermaid"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Mermaid

<PageTitle>Mermaid</PageTitle>

<CatalogPageFrame Group="@Group" Frame="@CurrentFrame"
                  ExampleCount="@ExampleCount" FrameChanged="NavigateFrame">
    <ChildContent>

            @foreach (var section in Sections)
            {
                <section id="@section.Anchor" class="sandbox-component-section">
                    <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>
                    @if (section.ComponentName == "MermaidDiagram")
                    {
                        <ExampleBlock Title="Clickable flowchart" Description="Click a node to see its .NET event payload. Pan and zoom controls stay with the diagram."
                                      SourceId="examples/Mermaid/ClickableFlowchart.razor" ApiTypes="@MermaidDiagramApiTypes">
                            <ClickableFlowchart />
                        </ExampleBlock>
                        <ExampleBlock Title="Architecture beta" Description="Groups, services, icons, junctions, and directional ports render through the same wrapper."
                                      SourceId="examples/Mermaid/ArchitectureBeta.razor">
                            <ArchitectureBeta />
                        </ExampleBlock>
                        @foreach (var example in GraphGallery.Examples)
                        {
                            <ExampleBlock Title="@example.Title" Description="@example.Description"
                                          SourceId="examples/Mermaid/GraphGallery.razor">
                                <GraphGallery Example="@example" />
                            </ExampleBlock>
                        }
                    }
                </section>
            }

    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Mermaid);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/mermaid");
    private static readonly IReadOnlyList<Type> MermaidDiagramApiTypes = [typeof(MermaidDiagram)];
    private static readonly int ExampleCount = GraphGallery.Examples.Count + 3;
}
