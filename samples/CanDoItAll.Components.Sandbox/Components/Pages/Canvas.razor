@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/canvas"
@inherits CatalogPageBase
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Canvas</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  HeroTitle="Typed workbench and calendar surfaces with sandbox-owned proof assets."
                  HeroSummary="The canvas page keeps the runtime workbench and calendar real while moving boundary previews, validation cards, and acceptance evidence into the sandbox catalog."
                  DemoTitle="Canvas surfaces"
                  DemoSummary="Workbench, calendar, floating windows, and boundary previews for the current scenario."
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @foreach (var section in Sections)
        {
            <section id="@section.Anchor" class="sandbox-component-section">
                <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                @if (section.ComponentName == "CanvasWorkbench")
                {
                    <ExampleBlock Title="Interactive workbench with floating windows"
                                  Description="The extracted workbench remains real and interactive while inspector and activity windows float above the stage."
                                  SourceId="examples/Canvas/WorkbenchWithFloatingWindows.razor"
                                  ApiTypes="@CanvasWorkbenchApiTypes">
                        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                            <Cluster Gap="LayoutGap.Small">
                                <Button Text="Show inspector"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="@ShowInspectorWindow"
                                        data-testid="show-canvas-inspector" />
                                <Button Text="Reset inspector"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="@ResetInspectorWindow"
                                        data-testid="reset-canvas-inspector" />
                                <Button Text="Show activity"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="@ShowActivityWindow"
                                        data-testid="show-canvas-activity" />
                                <Button Text="Overlap windows"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="@OverlapCanvasWindows"
                                        data-testid="overlap-canvas-windows" />
                                <Button Text="Select three"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="@SelectThreeWorkbenchNodes"
                                        data-testid="select-three-canvas-nodes" />
                                <Button Text="Move selected"
                                        ButtonStyle="@(ButtonStyle.Light)"
                                        Variant="@(Variant.Outlined)"
                                        Click="@MoveSelectedWorkbenchNodes"
                                        data-testid="move-selected-canvas-nodes" />
                            </Cluster>
                            <StatusBadge Text="@InspectorWindowStateLabel" Tone="@InspectorWindowStateTone" />
                        </div>
                        <Alert AlertStyle="AlertStyle.Info" data-testid="canvas-event-status">
                            @lastWorkbenchEvent
                        </Alert>
                        <div class="sandbox-canvas-host">
                            <CanvasWorkbench Surface="@WorkbenchSurface"
                                              SelectionChanged="HandleWorkbenchSelectionChanged"
                                              NodesMoved="HandleWorkbenchNodesMoved"
                                              ContextActionRequested="HandleWorkbenchContextActionRequested"
                                              CreateActionInvoked="HandleWorkbenchCreateActionInvoked"
                                              NodeEdited="HandleWorkbenchNodeEdited"
                                              NodeOpened="HandleWorkbenchNodeOpened"
                                              ClipboardRequested="HandleWorkbenchClipboardRequested"
                                              StateChanged="HandleWorkbenchStateChanged">
                                <ToolbarLeftContent>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <StatusBadge Text="Catalog demo" Tone="info" />
                                        @if (CurrentScenario == SandboxScenarioKey.DenseContent)
                                        {
                                            <StatusBadge Text="Dense review" Tone="warning" />
                                        }
                                        @if (CurrentScenario == SandboxScenarioKey.DisabledState)
                                        {
                                            <StatusBadge Text="Read only" Tone="warning" />
                                        }
                                    </div>
                                </ToolbarLeftContent>

                                <OverlayContent>
                                    @if (InspectorWindowState.IsVisible)
                                    {
                                        <CanvasFloatingWindow WindowId="@SandboxCanvasSamples.InspectorWindowId"
                                                              TestId="sandbox-canvas-inspector"
                                                              AriaLabel="Sandbox canvas inspector"
                                                              Kicker="Sandbox overlay"
                                                              Title="Selection context"
                                                              Summary="@InspectorSummary"
                                                              DefaultPlacement="top-right"
                                                              DefaultWidth="380"
                                                              DefaultHeight="420"
                                                              MinWidth="300"
                                                              MinHeight="220"
                                                              State="@InspectorWindowState"
                                                              StateChanged="HandleInspectorWindowStateChanged">
                                            <div class="sandbox-floating-window-copy">
                                                <StatusBadge Text="@ScenarioBadgeText" Tone="@ScenarioBadgeTone" />
                                                <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Selected node" />
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="@SelectedWorkbenchNodeLabel" />
                                                <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Why this matters" />
                                                <TextBlock TextStyle="@(TextStyle.Body2)" Value="Floating context stays inside the shared canvas system, so runtime pages do not need to rebuild inspector chrome for every use case." />
                                            </div>
                                        </CanvasFloatingWindow>
                                    }
                                    @if (ActivityWindowState.IsVisible)
                                    {
                                        <CanvasFloatingWindow WindowId="sandbox-activity"
                                                              TestId="sandbox-canvas-activity"
                                                              AriaLabel="Sandbox canvas activity"
                                                              Kicker="Event proof"
                                                              Title="Interaction activity"
                                                              Summary="A second shared window proves overlap, activation order, independent geometry, minimize, and close behavior."
                                                              DefaultPlacement="bottom-left"
                                                              DefaultWidth="340"
                                                              DefaultHeight="300"
                                                              MinWidth="280"
                                                              MinHeight="200"
                                                              State="@ActivityWindowState"
                                                              StateChanged="HandleActivityWindowStateChanged">
                                            <div class="sandbox-floating-window-copy">
                                                <StatusBadge Text="@(workbenchUiState.SelectedNodeIds.Count + " selected")" Tone="info" />
                                                <TextBlock TextStyle="TextStyle.Body2" Value="@lastWorkbenchEvent" />
                                            </div>
                                        </CanvasFloatingWindow>
                                    }
                                </OverlayContent>
                            </CanvasWorkbench>
                        </div>
                    </ExampleBlock>

                    <ExampleBlock Title="Benchmark tiers and shipped preview"
                                  Description="P3-01 stays isolated here: compare the shipped workbench create path against a narrow standalone canvas prototype before making any renderer decisions."
                                  SourceId="examples/Canvas/BenchmarkTierPreview.razor"
                                  ApiTypes="@CanvasWorkbenchApiTypes">
                        <div class="space-y-4">
                            <div class="flex flex-wrap items-center gap-3">
                                @foreach (var definition in benchmarkDefinitions)
                                {
                                    <Button Text="@definition.Label"
                                            ButtonStyle="@(definition.Key == selectedTierKey ? ButtonStyle.Primary : ButtonStyle.Light)"
                                            Variant="@(definition.Key == selectedTierKey ? Variant.Filled : Variant.Outlined)"
                                            Click="@(() => SelectTier(definition.Key))"
                                            data-testid="@($"canvas-benchmark-tier-{definition.Key}")" />
                                }

                                <Button Text="Run benchmark"
                                        ButtonStyle="@(ButtonStyle.Success)"
                                        IsBusy="@isBenchmarkRunning"
                                        Click="RunBenchmarkAsync"
                                        data-testid="canvas-benchmark-run" />

                                @if (!string.IsNullOrWhiteSpace(lastMeasuredLabel))
                                {
                                    <StatusBadge Text="@lastMeasuredLabel" Tone="success" />
                                }
                            </div>

                            <SummaryTiles>
                                <SummaryTile Label="Nodes" Value="@SelectedBenchmarkDefinition.NodeCount.ToString(CultureInfo.InvariantCulture)" HelperText="Typed workbench nodes rendered by both paths." Tone="info" />
                                <SummaryTile Label="Links" Value="@SelectedBenchmarkDefinition.LinkCount.ToString(CultureInfo.InvariantCulture)" HelperText="Connector count used by the shipped and prototype scenes." Tone="success" />
                            </SummaryTiles>

                            <div class="min-h-[26rem] w-full min-w-0 overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-50/80 p-3" data-testid="canvas-benchmark-retained-preview">
                                <CanvasWorkbench Surface="@SelectedBenchmarkDefinition.Surface" />
                            </div>
                        </div>
                    </ExampleBlock>

                    <ExampleBlock Title="Standalone prototype and measured results"
                                  Description="A deliberately narrow 2D draw pass with the same typed nodes and links, measured against the shipped workbench create path."
                                  SourceId="examples/Canvas/BenchmarkPrototypeResults.razor">
                        <div class="w-full min-w-0 space-y-4">
                            <canvas @ref="prototypeCanvas"
                                    class="h-[26rem] w-full rounded-[1.75rem] border border-slate-200 bg-slate-950"
                                    data-testid="canvas-benchmark-prototype-canvas"></canvas>
                            <Alert AlertStyle="@(AlertStyle.Light)">
                                The prototype draws node rectangles, titles, links, and group frames. It intentionally omits selection mirrors, floating overlays, export, and semantic accessibility layers.
                            </Alert>

                            @if (benchmarkResult is null)
                            {
                                <Alert AlertStyle="@(AlertStyle.Light)">
                                    Run the benchmark above to capture workbench-versus-prototype materialization timings and the explicit go or no-go recommendation.
                                </Alert>
                            }
                            else
                            {
                                <div class="overflow-x-auto" data-testid="canvas-benchmark-results">
                                    <table class="min-w-full divide-y divide-slate-200 text-sm">
                                        <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">
                                            <tr>
                                                <th class="px-4 py-3">Tier</th>
                                                <th class="px-4 py-3">Scene</th>
                                                <th class="px-4 py-3">Workbench Avg</th>
                                                <th class="px-4 py-3">Prototype Avg</th>
                                                <th class="px-4 py-3">Delta</th>
                                                <th class="px-4 py-3">Workbench DOM</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 bg-white">
                                            @foreach (var measurement in benchmarkResult.Tiers)
                                            {
                                                <tr>
                                                    <td class="px-4 py-3 font-semibold text-slate-900">@measurement.Label</td>
                                                    <td class="px-4 py-3 text-slate-600">@($"{measurement.NodeCount} nodes / {measurement.LinkCount} links")</td>
                                                    <td class="px-4 py-3 text-slate-900">@FormatDuration(measurement.RetainedAverageMs)</td>
                                                    <td class="px-4 py-3 text-slate-900">@FormatDuration(measurement.CanvasAverageMs)</td>
                                                    <td class="px-4 py-3">
                                                        <StatusBadge Text="@FormatDelta(measurement.ImprovementRatio)" Tone="@(measurement.ImprovementRatio >= 0 ? "success" : "warning")" />
                                                    </td>
                                                    <td class="px-4 py-3 text-slate-600">@measurement.RetainedDomNodeCount.ToString(CultureInfo.InvariantCulture)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <Alert AlertStyle="@(AlertStyle.Warning)" data-testid="canvas-benchmark-decision">
                                    <strong class="font-semibold">@benchmarkResult.Recommendation:</strong>
                                    <span class="ml-2">@benchmarkResult.Summary</span>
                                </Alert>
                            }
                        </div>
                    </ExampleBlock>
                }
                else if (section.ComponentName == "CanvasCalendar")
                {
                    <ExampleBlock Title="Calendar runtime"
                                  Description="The shared calendar surface stays typed and keeps its state model outside the JavaScript widget."
                                  SourceId="examples/Canvas/CalendarRuntime.razor"
                                  ApiTypes="@CanvasCalendarApiTypes">
                        <CanvasCalendar Surface="@CurrentCalendarSurface"
                                        HostClass="min-h-[36rem] overflow-hidden rounded-[1.5rem] border border-slate-200 bg-slate-50/80"
                                        SelectionChanged="HandleCalendarSelectionChanged"
                                        StateChanged="HandleCalendarStateChanged"
                                        SaveEventAsync="HandleCalendarEventSaveAsync"
                                        DeleteEventAsync="HandleCalendarEventDeleteAsync"
                                        SearchPlaylistsAsync="HandleCalendarPlaylistSearchAsync"
                                        LinkPlaylistAsync="HandleCalendarPlaylistLinkAsync"
                                        ClonePlaylistAsync="HandleCalendarPlaylistCloneAsync"
                                        UnlinkPlaylistAsync="HandleCalendarPlaylistUnlinkAsync"
                                        ExportAsync="HandleCalendarExportAsync" />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "CalendarSelectionPanel")
                {
                    <ExampleBlock Title="Selection boundary card"
                                  Description="Selected-event, linked playlist, and checklist context is reviewable without entering the runtime page."
                                  SourceId="examples/Canvas/SelectionPanelPreview.razor"
                                  ApiTypes="@CalendarSelectionPanelApiTypes">
                        <CalendarSelectionPanel Snapshot="@CalendarSelectionSnapshot" />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "CalendarExportMenu")
                {
                    <ExampleBlock Title="Export boundary card"
                                  Description="Available export formats and the last requested export stay reviewable in isolation."
                                  SourceId="examples/Canvas/ExportMenuPreview.razor"
                                  ApiTypes="@CalendarExportMenuApiTypes">
                        <div class="space-y-4">
                            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-slate-500" data-testid="calendar-export-status">@calendarExportStatus</p>
                            <CalendarExportMenu Snapshot="@CalendarExportSnapshot" />
                        </div>
                    </ExampleBlock>
                }
                else if (section.ComponentName == "CalendarMiniMonthNavigator")
                {
                    <ExampleBlock Title="Mini month boundary card"
                                  Description="The compact month navigator mirrors the same typed calendar surface used by the runtime widget."
                                  SourceId="examples/Canvas/MiniMonthNavigatorPreview.razor"
                                  ApiTypes="@CalendarMiniMonthNavigatorApiTypes">
                        <CalendarMiniMonthNavigator Snapshot="@CalendarMiniMonthSnapshot" />
                    </ExampleBlock>
                }
                else if (section.ComponentName == "CalendarTimeGridRenderer")
                {
                    <ExampleBlock Title="Time grid boundary card"
                                  Description="Scheduled events render on the shared time-grid boundary card whenever the current scenario has events."
                                  SourceId="examples/Canvas/TimeGridRendererPreview.razor"
                                  ApiTypes="@CalendarTimeGridRendererApiTypes">
                        @if (CurrentCalendarSurface.Events.Count > 0)
                        {
                            <CalendarTimeGridRenderer Snapshot="@CalendarTimeGridSnapshot" />
                        }
                        else
                        {
                            <EmptyState Eyebrow="Canvas" Title="No scheduled events" Description="The time grid boundary card has nothing to render until the calendar surface has events." />
                        }
                    </ExampleBlock>
                }
                else if (section.ComponentName == "CanvasSceneHostPreview")
                {
                    <ExampleBlock Title="Canvas preview assets"
                                  Description="Core workbench boundaries (scene host, layer stack, viewport, serialization, text measurement, JS interop, command history, and animation timeline) remain inspectable inside the sandbox rather than the runtime workbench."
                                  SourceId="examples/Canvas/PreviewAssetsGrid.razor"
                                  ApiTypes="@PreviewAssetsApiTypes">
                        <div class="sandbox-demo-grid sandbox-demo-grid--three">
                            <CanvasSceneHostPreview Snapshot="@SceneHostSnapshot" />
                            <LayerStackPreview Snapshot="@LayerStackSnapshot" />
                            <ViewportControllerPreview Snapshot="@ViewportSnapshot" />
                            <SerializationPersistencePackPreview Snapshot="@SerializationSnapshot" />
                            <TextMeasureServicePreview Snapshot="@TextMeasureSnapshot" />
                            <JsInteropBridgePreview Snapshot="@InteropSnapshot" />
                            <CommandHistoryStorePreview Snapshot="@CommandHistorySnapshot" />
                            <AnimationTimelinePreview Snapshot="@AnimationSnapshot" />
                        </div>
                    </ExampleBlock>
                }
            </section>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Canvas);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Canvas);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/canvas");
    private static readonly DateTimeOffset CalendarProofTimestamp = new(2026, 4, 6, 8, 0, 0, TimeSpan.Zero);

    private static readonly IReadOnlyList<Type> CanvasWorkbenchApiTypes = [typeof(CanvasWorkbench), typeof(CanvasFloatingWindow)];
    private static readonly IReadOnlyList<Type> CanvasCalendarApiTypes = [typeof(CanvasCalendar)];
    private static readonly IReadOnlyList<Type> CalendarSelectionPanelApiTypes = [typeof(CalendarSelectionPanel)];
    private static readonly IReadOnlyList<Type> CalendarExportMenuApiTypes = [typeof(CalendarExportMenu)];
    private static readonly IReadOnlyList<Type> CalendarMiniMonthNavigatorApiTypes = [typeof(CalendarMiniMonthNavigator)];
    private static readonly IReadOnlyList<Type> CalendarTimeGridRendererApiTypes = [typeof(CalendarTimeGridRenderer)];
    private static readonly IReadOnlyList<Type> PreviewAssetsApiTypes =
    [
        typeof(CanvasSceneHostPreview),
        typeof(LayerStackPreview),
        typeof(ViewportControllerPreview),
        typeof(SerializationPersistencePackPreview),
        typeof(TextMeasureServicePreview),
        typeof(JsInteropBridgePreview),
        typeof(CommandHistoryStorePreview),
        typeof(AnimationTimelinePreview)
    ];

    private SandboxScenarioKey? initializedScenario;
    private CanvasWorkbenchUiState workbenchUiState = SandboxCanvasSamples.CreateWorkbenchUiState(SandboxScenarioKey.HappyPath);
    private CanvasWorkbenchWindowState inspectorWindowState = SandboxCanvasSamples.CreateInspectorWindowState(SandboxScenarioKey.HappyPath);
    private CanvasWorkbenchWindowState activityWindowState = CreateActivityWindowState(SandboxScenarioKey.HappyPath);
    private CanvasCalendarSurface currentCalendarSurface = SandboxCanvasSamples.CreateCalendarSurface(SandboxScenarioKey.HappyPath);
    private readonly Dictionary<string, CanvasWorkbenchNodePositionChange> nodePositionOverrides = new(StringComparer.Ordinal);
    private string calendarExportStatus = "No calendar export requested";
    private string lastWorkbenchEvent = "No workbench interaction recorded yet.";

    private readonly IReadOnlyList<CanvasBenchmarkSurfaceDefinition> benchmarkDefinitions = CanvasBenchmarkSamples.CreateDefinitions();
    private string selectedTierKey = CanvasBenchmarkSamples.DefaultTierKey;
    private bool benchmarkPreviewNeedsRender = true;
    private bool isBenchmarkRunning;
    private string? lastMeasuredLabel;
    private ElementReference prototypeCanvas;
    private IJSObjectReference? benchmarkModule;
    private CanvasBenchmarkRunResult? benchmarkResult;

    private CanvasBenchmarkSurfaceDefinition SelectedBenchmarkDefinition => CanvasBenchmarkSamples.GetDefinition(selectedTierKey);

    private CanvasWorkbenchSurface WorkbenchSurface
    {
        get
        {
            var surface = SandboxCanvasSamples.CreateWorkbenchSurface(CurrentScenario, workbenchUiState, inspectorWindowState);
            foreach (var node in surface.Nodes)
            {
                if (nodePositionOverrides.TryGetValue(node.Id, out var position))
                {
                    node.X = position.X;
                    node.Y = position.Y;
                }
            }

            return surface;
        }
    }

    private CanvasWorkbenchWindowState InspectorWindowState => inspectorWindowState;

    private CanvasWorkbenchWindowState ActivityWindowState => activityWindowState;

    private CanvasCalendarSurface CurrentCalendarSurface => currentCalendarSurface;

    private string InspectorSummary => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "Dense review still leaves room for floating context without obscuring the toolbar or stage.",
        SandboxScenarioKey.DisabledState => "Read-only state keeps the same shared window treatment while muting edit intent.",
        SandboxScenarioKey.LongText => "Longer node titles and supporting copy should still fit the floating window comfortably.",
        _ => "The floating window demonstrates shared overlay behavior on top of the real workbench."
    };

    private string SelectedWorkbenchNodeLabel
        => WorkbenchSurface.Nodes
            .FirstOrDefault(node => workbenchUiState.SelectedNodeIds.Contains(node.Id, StringComparer.Ordinal))?.Title
            ?? "Nothing selected";

    private string ScenarioBadgeText => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "Dense pass",
        SandboxScenarioKey.DisabledState => "Read only",
        SandboxScenarioKey.EmptyState => "Empty",
        SandboxScenarioKey.LongText => "Long text",
        _ => "Happy path"
    };

    private string ScenarioBadgeTone => CurrentScenario switch
    {
        SandboxScenarioKey.DenseContent => "warning",
        SandboxScenarioKey.DisabledState => "warning",
        SandboxScenarioKey.EmptyState => "info",
        _ => "success"
    };

    private CalendarSelectionPanelSnapshot CalendarSelectionSnapshot => CalendarSelectionPanelFactory.Create(CurrentCalendarSurface);

    private CalendarExportMenuSnapshot CalendarExportSnapshot => CalendarExportMenuFactory.Create(CurrentCalendarSurface);

    private CalendarMiniMonthNavigatorSnapshot CalendarMiniMonthSnapshot => CalendarMiniMonthNavigatorFactory.Create(CurrentCalendarSurface);

    private CalendarTimeGridRendererSnapshot CalendarTimeGridSnapshot => CalendarTimeGridRendererFactory.Create(CurrentCalendarSurface);

    private CanvasSceneHostPreviewSnapshot SceneHostSnapshot => CanvasSceneHostPreviewFactory.CreateForWorkbench(WorkbenchSurface);

    private LayerStackPreviewSnapshot LayerStackSnapshot => LayerStackPreviewFactory.CreateForWorkbench();

    private ViewportControllerPreviewSnapshot ViewportSnapshot => ViewportControllerPreviewFactory.CreateForWorkbench(WorkbenchSurface);

    private SerializationPersistencePackPreviewSnapshot SerializationSnapshot => SerializationPersistencePackPreviewFactory.CreateForWorkbench(WorkbenchSurface);

    private TextMeasurePreviewSnapshot TextMeasureSnapshot => TextMeasurePreviewFactory.CreateForWorkbench(WorkbenchSurface);

    private JsInteropBridgePreviewSnapshot InteropSnapshot => JsInteropBridgePreviewFactory.CreateForWorkbench(WorkbenchSurface);

    private CommandHistoryStorePreviewSnapshot CommandHistorySnapshot => CommandHistoryStorePreviewFactory.CreateForWorkbench(WorkbenchSurface);

    private AnimationTimelinePreviewSnapshot AnimationSnapshot => AnimationTimelinePreviewFactory.CreateForWorkbench(WorkbenchSurface);

    protected override void OnParametersSet()
    {
        if (initializedScenario == CurrentScenario)
        {
            return;
        }

        initializedScenario = CurrentScenario;
        workbenchUiState = SandboxCanvasSamples.CreateWorkbenchUiState(CurrentScenario);
        inspectorWindowState = SandboxCanvasSamples.CreateInspectorWindowState(CurrentScenario);
        activityWindowState = CreateActivityWindowState(CurrentScenario);
        currentCalendarSurface = SandboxCanvasSamples.CreateCalendarSurface(CurrentScenario);
        nodePositionOverrides.Clear();
        calendarExportStatus = "No calendar export requested";
        lastWorkbenchEvent = "No workbench interaction recorded yet.";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            benchmarkModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/canvasBenchmarkPage.js");
            benchmarkPreviewNeedsRender = true;
        }

        if (!benchmarkPreviewNeedsRender || benchmarkModule is null)
        {
            return;
        }

        benchmarkPreviewNeedsRender = false;
        await benchmarkModule.InvokeVoidAsync("renderPrototype", prototypeCanvas, SelectedBenchmarkDefinition);
    }

    private void SelectTier(string key)
    {
        if (string.Equals(selectedTierKey, key, StringComparison.Ordinal))
        {
            return;
        }

        selectedTierKey = key;
        benchmarkPreviewNeedsRender = true;
    }

    private async Task RunBenchmarkAsync()
    {
        if (isBenchmarkRunning || benchmarkModule is null)
        {
            return;
        }

        isBenchmarkRunning = true;
        StateHasChanged();

        try
        {
            benchmarkResult = await benchmarkModule.InvokeAsync<CanvasBenchmarkRunResult>(
                "runBenchmarkSuite",
                prototypeCanvas,
                benchmarkDefinitions,
                4);
            lastMeasuredLabel = $"Measured {DateTimeOffset.UtcNow:yyyy-MM-dd HH:mm} UTC";
        }
        finally
        {
            isBenchmarkRunning = false;
            benchmarkPreviewNeedsRender = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatDuration(double value)
    {
        return $"{value:F2} ms";
    }

    private static string FormatDelta(double value)
    {
        var percent = value * 100d;
        return percent >= 0
            ? $"{percent:F1}% faster"
            : $"{Math.Abs(percent):F1}% slower";
    }

    private Task HandleWorkbenchSelectionChanged(CanvasWorkbenchSelectionChangedEventArgs args)
    {
        workbenchUiState.SelectedNodeIds = [.. args.SelectedNodeIds];
        lastWorkbenchEvent = $"Selection changed: {args.SelectedNodeIds.Count} node(s); primary {args.PrimaryNodeId ?? "none"}.";
        return Task.CompletedTask;
    }

    private Task HandleWorkbenchNodesMoved(CanvasWorkbenchNodesMovedEventArgs args)
    {
        foreach (var position in args.Positions)
        {
            nodePositionOverrides[position.NodeId] = position;
        }

        lastWorkbenchEvent = $"Moved {args.Positions.Count} node(s).";
        return Task.CompletedTask;
    }

    private Task HandleWorkbenchContextActionRequested(CanvasWorkbenchContextActionRequest request)
    {
        lastWorkbenchEvent = $"Context action '{request.ActionId}' on {request.TargetKind} {request.NodeId ?? "surface"}.";
        return Task.CompletedTask;
    }

    private Task HandleWorkbenchCreateActionInvoked(CanvasWorkbenchCreateActionRequest request)
    {
        lastWorkbenchEvent = $"Create action '{request.ActionId}' at {request.X:0}, {request.Y:0}.";
        return Task.CompletedTask;
    }

    private Task HandleWorkbenchNodeEdited(CanvasWorkbenchNodeEditRequest request)
    {
        lastWorkbenchEvent = $"Edited node {request.NodeId}.";
        return Task.CompletedTask;
    }

    private Task HandleWorkbenchNodeOpened(string nodeId)
    {
        lastWorkbenchEvent = $"Opened node {nodeId}.";
        return Task.CompletedTask;
    }

    private Task HandleWorkbenchClipboardRequested(CanvasWorkbenchClipboardRequest request)
    {
        lastWorkbenchEvent = $"Clipboard action '{request.Action}' requested for {request.SelectedNodeIds.Count} node(s).";
        return Task.CompletedTask;
    }

    private Task HandleWorkbenchStateChanged(string json)
    {
        workbenchUiState = CanvasWorkbenchUiState.Parse(json);
        lastWorkbenchEvent = "Workbench viewport or persisted UI state changed.";
        return Task.CompletedTask;
    }

    private Task HandleInspectorWindowStateChanged(CanvasWorkbenchWindowState state)
    {
        inspectorWindowState = CanvasWorkbenchWindowState.Normalize(state);
        return Task.CompletedTask;
    }

    private Task HandleActivityWindowStateChanged(CanvasWorkbenchWindowState state)
    {
        activityWindowState = CanvasWorkbenchWindowState.Normalize(state);
        lastWorkbenchEvent = "Activity window geometry or visibility changed.";
        return Task.CompletedTask;
    }

    private Task ShowActivityWindow()
    {
        activityWindowState.IsVisible = true;
        activityWindowState.IsMinimized = false;
        lastWorkbenchEvent = "Activity window shown.";
        return Task.CompletedTask;
    }

    private Task OverlapCanvasWindows()
    {
        inspectorWindowState = CanvasWorkbenchWindowState.Normalize(new CanvasWorkbenchWindowState
        {
            IsVisible = true,
            Left = 520,
            Top = 120,
            Width = 380,
            Height = 420
        });
        activityWindowState = CanvasWorkbenchWindowState.Normalize(new CanvasWorkbenchWindowState
        {
            IsVisible = true,
            Left = 600,
            Top = 190,
            Width = 340,
            Height = 300
        });
        lastWorkbenchEvent = "Windows intentionally overlapped; click either title bar to verify activation order.";
        return Task.CompletedTask;
    }

    private Task SelectThreeWorkbenchNodes()
    {
        workbenchUiState.SelectedNodeIds = WorkbenchSurface.Nodes.Take(3).Select(node => node.Id).ToList();
        lastWorkbenchEvent = $"Deterministic stress control selected {workbenchUiState.SelectedNodeIds.Count} nodes.";
        return Task.CompletedTask;
    }

    private Task MoveSelectedWorkbenchNodes()
    {
        var surface = WorkbenchSurface;
        foreach (var node in surface.Nodes.Where(node => workbenchUiState.SelectedNodeIds.Contains(node.Id, StringComparer.Ordinal)))
        {
            nodePositionOverrides[node.Id] = new CanvasWorkbenchNodePositionChange(node.Id, node.X + 40, node.Y + 24);
        }

        lastWorkbenchEvent = $"Deterministic stress control moved {workbenchUiState.SelectedNodeIds.Count} selected nodes.";
        return Task.CompletedTask;
    }

    private static CanvasWorkbenchWindowState CreateActivityWindowState(SandboxScenarioKey scenario)
        => CanvasWorkbenchWindowState.Normalize(new CanvasWorkbenchWindowState
        {
            IsVisible = scenario == SandboxScenarioKey.DenseContent,
            Left = 24,
            Top = 360,
            Width = 340,
            Height = 300
        });

    private Task ShowInspectorWindow()
    {
        var next = inspectorWindowState.Clone();
        next.IsVisible = true;
        next.IsMinimized = false;
        inspectorWindowState = CanvasWorkbenchWindowState.Normalize(next);
        return Task.CompletedTask;
    }

    private Task ResetInspectorWindow()
    {
        inspectorWindowState = SandboxCanvasSamples.CreateInspectorWindowState(CurrentScenario);
        return Task.CompletedTask;
    }

    private string InspectorWindowStateLabel => inspectorWindowState.IsVisible
        ? inspectorWindowState.IsMinimized ? "Inspector minimized" : "Inspector visible"
        : "Inspector hidden";

    private string InspectorWindowStateTone => inspectorWindowState.IsVisible
        ? inspectorWindowState.IsMinimized ? "warning" : "success"
        : "warning";

    private Task HandleCalendarSelectionChanged(CanvasCalendarSelectionChangedEventArgs args)
    {
        currentCalendarSurface.SelectedEventId = args.SelectedEvent?.EventId ?? args.SelectedEvent?.Id ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task HandleCalendarStateChanged(CanvasCalendarStateChangedEventArgs args)
    {
        currentCalendarSurface.ViewStateJson = args.StateJson;
        currentCalendarSurface.SelectedDate = args.SelectedDate;
        currentCalendarSurface.InitialView = args.View;
        currentCalendarSurface.Timezone = args.Timezone;
        if (!string.IsNullOrWhiteSpace(args.SelectedEventId))
        {
            currentCalendarSurface.SelectedEventId = args.SelectedEventId;
        }

        return Task.CompletedTask;
    }

    private Task<CanvasCalendarEvent?> HandleCalendarEventSaveAsync(CanvasCalendarSaveRequest request)
    {
        var saved = NormalizeCalendarEvent(request.Event);
        ReplaceCalendarEvent(saved);
        currentCalendarSurface.SelectedEventId = saved.EventId;
        return Task.FromResult<CanvasCalendarEvent?>(saved);
    }

    private Task HandleCalendarEventDeleteAsync(CanvasCalendarDeleteRequest request)
    {
        var eventId = ResolveCalendarEventId(request.Event);
        currentCalendarSurface.Events.RemoveAll(item => IsCalendarEventMatch(item, eventId));

        if (string.Equals(currentCalendarSurface.SelectedEventId, eventId, StringComparison.Ordinal))
        {
            currentCalendarSurface.SelectedEventId = currentCalendarSurface.Events.FirstOrDefault()?.EventId ?? string.Empty;
        }

        return Task.CompletedTask;
    }

    private Task<IReadOnlyList<CanvasCalendarPlaylist>> HandleCalendarPlaylistSearchAsync(CanvasCalendarPlaylistSearchRequest request)
    {
        var query = request.Query.Trim();
        var candidates = CreateSandboxPlaylistCatalog(request.Event);
        if (!string.IsNullOrWhiteSpace(query))
        {
            candidates = candidates
                .Where(playlist =>
                    playlist.Title.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    playlist.Purpose.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    playlist.Status.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        return Task.FromResult<IReadOnlyList<CanvasCalendarPlaylist>>(candidates);
    }

    private Task<CanvasCalendarEvent?> HandleCalendarPlaylistLinkAsync(CanvasCalendarPlaylistMutationRequest request)
        => Task.FromResult<CanvasCalendarEvent?>(ApplyPlaylistMutation(request.Event, request.Playlist, PlaylistMutationMode.Link));

    private Task<CanvasCalendarEvent?> HandleCalendarPlaylistCloneAsync(CanvasCalendarPlaylistMutationRequest request)
        => Task.FromResult<CanvasCalendarEvent?>(ApplyPlaylistMutation(request.Event, request.Playlist, PlaylistMutationMode.Clone));

    private Task<CanvasCalendarEvent?> HandleCalendarPlaylistUnlinkAsync(CanvasCalendarPlaylistMutationRequest request)
        => Task.FromResult<CanvasCalendarEvent?>(ApplyPlaylistMutation(request.Event, request.Playlist, PlaylistMutationMode.Unlink));

    private async Task HandleCalendarExportAsync(CanvasCalendarExportRequest request)
    {
        calendarExportStatus = $"Last calendar export: {request.Format.ToUpperInvariant()} ({request.VisibleEvents.Count} events)";
        await InvokeAsync(StateHasChanged);
    }

    private enum PlaylistMutationMode
    {
        Link,
        Clone,
        Unlink
    }

    private CanvasCalendarEvent ApplyPlaylistMutation(
        CanvasCalendarEvent requestedEvent,
        CanvasCalendarPlaylist requestedPlaylist,
        PlaylistMutationMode mode)
    {
        var eventId = ResolveCalendarEventId(requestedEvent);
        var calendarEvent = currentCalendarSurface.Events.FirstOrDefault(item => IsCalendarEventMatch(item, eventId))
            ?? NormalizeCalendarEvent(requestedEvent);
        var playlistId = requestedPlaylist.PlaylistId.Trim();

        if (mode == PlaylistMutationMode.Unlink)
        {
            calendarEvent.LinkedPlaylists.RemoveAll(playlist => string.Equals(playlist.PlaylistId, playlistId, StringComparison.Ordinal));
        }
        else
        {
            var playlist = ClonePlaylist(requestedPlaylist);
            if (mode == PlaylistMutationMode.Clone)
            {
                playlist.PlaylistId = $"{playlist.PlaylistId}-{calendarEvent.EventId}-copy";
                playlist.Title = $"{playlist.Title} copy";
                playlist.ConnectedEvents = [];
                playlist.ConnectedEventCount = 0;
                playlist.IsPrimaryEvent = false;
            }

            if (!calendarEvent.LinkedPlaylists.Any(item => string.Equals(item.PlaylistId, playlist.PlaylistId, StringComparison.Ordinal)))
            {
                playlist.IsPrimaryEvent = calendarEvent.LinkedPlaylists.Count == 0;
                calendarEvent.LinkedPlaylists.Add(playlist);
            }
        }

        calendarEvent.LinkedPlaylistCount = calendarEvent.LinkedPlaylists.Count;
        ReplaceCalendarEvent(calendarEvent);
        currentCalendarSurface.SelectedEventId = calendarEvent.EventId;
        return calendarEvent;
    }

    private void ReplaceCalendarEvent(CanvasCalendarEvent calendarEvent)
    {
        var eventId = ResolveCalendarEventId(calendarEvent);
        var existingIndex = currentCalendarSurface.Events.FindIndex(item => IsCalendarEventMatch(item, eventId));
        if (existingIndex >= 0)
        {
            currentCalendarSurface.Events[existingIndex] = calendarEvent;
        }
        else
        {
            currentCalendarSurface.Events.Add(calendarEvent);
        }

        currentCalendarSurface.Events.Sort((left, right) => Nullable.Compare(left.StartUtc, right.StartUtc));
    }

    private static CanvasCalendarEvent NormalizeCalendarEvent(CanvasCalendarEvent calendarEvent)
    {
        var eventId = ResolveCalendarEventId(calendarEvent);
        if (string.IsNullOrWhiteSpace(eventId))
        {
            eventId = $"sandbox-calendar-{Guid.NewGuid():N}";
        }

        calendarEvent.Id = eventId;
        calendarEvent.EventId = eventId;
        calendarEvent.Timezone = string.IsNullOrWhiteSpace(calendarEvent.Timezone) ? "UTC" : calendarEvent.Timezone;
        calendarEvent.TimezoneName = string.IsNullOrWhiteSpace(calendarEvent.TimezoneName) ? calendarEvent.Timezone : calendarEvent.TimezoneName;
        calendarEvent.Currency = string.IsNullOrWhiteSpace(calendarEvent.Currency) ? "USD" : calendarEvent.Currency.ToUpperInvariant();
        calendarEvent.LinkedPlaylistCount = calendarEvent.LinkedPlaylists.Count;
        calendarEvent.ChecklistItemCount = calendarEvent.ChecklistRows.Count;
        calendarEvent.UpdatedUtc = CalendarProofTimestamp;
        calendarEvent.CreatedUtc ??= calendarEvent.UpdatedUtc;
        return calendarEvent;
    }

    private static bool IsCalendarEventMatch(CanvasCalendarEvent calendarEvent, string eventId)
        => string.Equals(calendarEvent.Id, eventId, StringComparison.Ordinal) ||
           string.Equals(calendarEvent.EventId, eventId, StringComparison.Ordinal);

    private static string ResolveCalendarEventId(CanvasCalendarEvent calendarEvent)
        => (string.IsNullOrWhiteSpace(calendarEvent.EventId) ? calendarEvent.Id : calendarEvent.EventId).Trim();

    private static List<CanvasCalendarPlaylist> CreateSandboxPlaylistCatalog(CanvasCalendarEvent? calendarEvent)
    {
        var eventId = calendarEvent is null ? string.Empty : ResolveCalendarEventId(calendarEvent);
        return
        [
            new CanvasCalendarPlaylist
            {
                PlaylistId = "playlist-release-proof",
                Title = "Release proof playlist",
                Subtitle = "Cross-event validation set",
                Purpose = "Reuse proof evidence for publishing readiness",
                Status = "Ready",
                TotalScores = 12,
                ConnectedEventCount = 1,
                BuilderUrl = "/groups/canvas?scenario=dense-content",
                ConnectedEvents =
                [
                    new CanvasCalendarConnectedEvent
                    {
                        EventId = "release-window",
                        Title = "Release window",
                        ScheduledStartUtc = new DateTimeOffset(2026, 4, 6, 15, 0, 0, TimeSpan.Zero),
                        TimezoneName = "UTC",
                        LocationLabel = "Deployment lane",
                        IsPrimary = true
                    }
                ]
            },
            new CanvasCalendarPlaylist
            {
                PlaylistId = "playlist-mobile-review",
                Title = "Mobile review playlist",
                Subtitle = "Small viewport QA",
                Purpose = "Validate compact calendar and preview states",
                Status = "Draft",
                TotalScores = 8,
                ConnectedEventCount = string.Equals(eventId, "canvas-proof", StringComparison.Ordinal) ? 1 : 0,
                BuilderUrl = "/groups/canvas?scenario=long-text"
            }
        ];
    }

    private static CanvasCalendarPlaylist ClonePlaylist(CanvasCalendarPlaylist playlist)
        => new()
        {
            PlaylistId = playlist.PlaylistId,
            Title = playlist.Title,
            Subtitle = playlist.Subtitle,
            Purpose = playlist.Purpose,
            Status = playlist.Status,
            TotalScores = playlist.TotalScores,
            ConnectedEventCount = playlist.ConnectedEventCount,
            IsPrimaryEvent = playlist.IsPrimaryEvent,
            BuilderUrl = playlist.BuilderUrl,
            ConnectedEvents = [.. playlist.ConnectedEvents]
        };

    public async ValueTask DisposeAsync()
    {
        Dispose();

        if (benchmarkModule is null)
        {
            return;
        }

        try
        {
            await benchmarkModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

