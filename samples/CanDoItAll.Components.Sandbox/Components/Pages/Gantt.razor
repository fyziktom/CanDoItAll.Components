@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/gantt"
@inherits CatalogPageBase
@using CanDoItAll.Components.Sandbox.Components.Examples.Gantt

<PageTitle>Gantt</PageTitle>

<CatalogPageFrame Group="@Group"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @foreach (var section in Sections)
        {
            <section id="@section.Anchor" class="sandbox-component-section">
                <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                @if (section.ComponentName == "GanttChart")
                {
                    <ExampleBlock Title="Interactive controlled schedule"
                                  Description="Drag bars to move them, resize with green handles, reconnect dependencies with blue ports, drag the staged task onto a bridge, and export the projection as PNG. Every gesture returns a typed request that this page accepts into a replacement model."
                                  SourceId="examples/Gantt/ControlledSchedule.razor"
                                  ApiTypes="@GanttChartApiTypes">
                        <ControlledSchedule />
                    </ExampleBlock>
                }
            </section>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Gantt);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Gantt);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/gantt");
    private static readonly IReadOnlyList<Type> GanttChartApiTypes = [typeof(GanttChart), typeof(GanttTaskDragSource)];
}
