@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/feedback"
@inherits CatalogPageBase
@using CanDoItAll.Components.Common

<PageTitle>Feedback</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.EmptyState)
        {
            <EmptyState Eyebrow="Feedback" Title="No incidents this hour" Description="No active warnings or evidence requests are waiting on the sandbox owner." />
        }
        else if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Feedback" Title="Refreshing health snapshot" Description="The status summary remains calm while probes and examples refresh." />
        }
        else
        {
            <SummaryTiles>
                <SummaryTile Label="Checks" Value="18" HelperText="Total review questions in the screenshot pass." Tone="info" />
                <SummaryTile Label="Warnings" Value="2" HelperText="Dense and mobile variants still need a closer look." Tone="warning" />
                <SummaryTile Label="Ready" Value="5" HelperText="Routes already verified for desktop and mobile." Tone="success" />
            </SummaryTiles>

            @foreach (var section in Sections)
            {
                <section id="@section.Anchor" class="sandbox-component-section">
                    <h2 class="sandbox-component-section__heading">@($"<{section.ComponentName}>")</h2>

                    @if (section.ComponentName == "Alert")
                    {
                        <ExampleBlock Title="Alert stack"
                                      Description="Operational feedback should stay readable in sequence."
                                      SourceId="examples/Feedback/AlertStack.razor"
                                      ApiTypes="@AlertApiTypes">
                            <div class="space-y-3">
                                <Alert AlertStyle="@(AlertStyle.Info)">The sandbox route loaded the shared assets and the page scaffold is ready for proof review.</Alert>
                                <Alert AlertStyle="@(AlertStyle.Warning)">Dense scenarios still need a screenshot review before the migration can be accepted.</Alert>
                                @if (CurrentScenario == SandboxScenarioKey.LongText)
                                {
                                    <Alert AlertStyle="@(AlertStyle.Danger)">Longer explanatory alerts should still remain readable without forcing the user to decode an oversized block of red text or lose the rest of the page hierarchy.</Alert>
                                }
                                else
                                {
                                    <Alert AlertStyle="@(AlertStyle.Success)">The default pass is stable enough to move on to dense and empty-state proof.</Alert>
                                }
                            </div>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "Callout")
                    {
                        <ExampleBlock Title="Callouts"
                                      Description="Inline guidance that stays calmer than a full alert."
                                      SourceId="examples/Feedback/Callouts.razor"
                                      ApiTypes="@CalloutApiTypes">
                            <div class="space-y-3">
                                <Callout Tone="@(CalloutTone.Ok)" data-testid="sandbox-feedback-callout-ok">
                                    Shared feedback primitives keep positive status calm and readable.
                                </Callout>
                                <Callout data-testid="sandbox-feedback-callout-default">
                                    @LongCalloutText
                                </Callout>
                            </div>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "TooltipTarget")
                    {
                        <ExampleBlock Title="Tooltip"
                                      Description="Tooltip text stays compact and viewport constrained."
                                      SourceId="examples/Feedback/TooltipTargetExample.razor"
                                      ApiTypes="@TooltipTargetApiTypes">
                            <span data-testid="sandbox-feedback-tooltip-trigger">
                                <TooltipTarget Text="@TooltipText"
                                               Position="@(TooltipPosition.Bottom)"
                                               TestId="sandbox-feedback-tooltip-open">
                                    <Button Text="Hover help"
                                            Icon="help"
                                            ButtonStyle="@(ButtonStyle.Light)"
                                            Variant="@(Variant.Outlined)" />
                                </TooltipTarget>
                            </span>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "HelpPopover")
                    {
                        <ExampleBlock Title="Help popover"
                                      Description="A pinned popover for longer contextual explanations."
                                      SourceId="examples/Feedback/HelpPopoverExample.razor"
                                      ApiTypes="@HelpPopoverApiTypes">
                            <span data-testid="sandbox-feedback-help-popover">
                                <HelpPopover AriaLabel="Show feedback help"
                                             Title="Show feedback help"
                                             Heading="Feedback help"
                                             Body="@HelpPopoverBody"
                                             PanelTestId="sandbox-feedback-help-popover-panel"
                                             Tip="Use Escape or blur to close." />
                            </span>
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "StatusCheckList")
                    {
                        <ExampleBlock Title="Validation checks"
                                      Description="Status lists prove icon, label, description, and badge rhythm."
                                      SourceId="examples/Feedback/ValidationChecks.razor"
                                      ApiTypes="@StatusCheckListApiTypes">
                            <StatusCheckList Title="Validation checks"
                                             Description="Status lists prove icon, label, description, and badge rhythm."
                                             Items="@StatusItems"
                                             EmptyText="No validation checks are waiting."
                                             data-testid="sandbox-feedback-status-check-list" />
                        </ExampleBlock>
                    }
                    else if (section.ComponentName == "VerificationList")
                    {
                        <ExampleBlock Title="Verification"
                                      Description="Compatibility wrapper around the same status list surface."
                                      SourceId="examples/Feedback/Verification.razor"
                                      ApiTypes="@VerificationListApiTypes">
                            <VerificationList Title="Verification"
                                              Description="Compatibility wrapper around the same status list surface."
                                              Items="@VerificationItems"
                                              TestId="sandbox-feedback-verification-list" />
                        </ExampleBlock>
                    }
                </section>
            }
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Feedback);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Feedback);
    private static readonly IReadOnlyList<SandboxPageSection> Sections = SandboxCatalogRegistry.GetSections("/groups/feedback");

    private static readonly IReadOnlyList<Type> AlertApiTypes = [typeof(Alert)];
    private static readonly IReadOnlyList<Type> CalloutApiTypes = [typeof(Callout)];
    private static readonly IReadOnlyList<Type> TooltipTargetApiTypes = [typeof(TooltipTarget)];
    private static readonly IReadOnlyList<Type> HelpPopoverApiTypes = [typeof(HelpPopover)];
    private static readonly IReadOnlyList<Type> StatusCheckListApiTypes = [typeof(StatusCheckList)];
    private static readonly IReadOnlyList<Type> VerificationListApiTypes = [typeof(VerificationList)];

    private string LongCalloutText => CurrentScenario == SandboxScenarioKey.LongText
        ? "Long callout text should maintain a useful line length and avoid pushing adjacent feedback examples wider than their grid column."
        : "Default feedback callouts carry neutral next-step guidance.";

    private string TooltipText => CurrentScenario == SandboxScenarioKey.LongText
        ? "Tooltip text can be longer, but it still needs to stay inside the viewport and wrap in a readable block."
        : "Tooltip text stays compact and viewport constrained.";

    private string HelpPopoverBody => CurrentScenario == SandboxScenarioKey.LongText
        ? "HelpPopover panels should stay readable with longer explanatory copy and remain close to the trigger without clipping."
        : "HelpPopover panels explain why a feedback state appears.";

    private IReadOnlyList<StatusCheckItem> StatusItems => CurrentScenario == SandboxScenarioKey.LongText
        ? LongStatusItems
        : BaseStatusItems;

    private IReadOnlyList<StatusCheckItem> VerificationItems => CurrentScenario == SandboxScenarioKey.DenseContent
        ? DenseVerificationItems
        : BaseVerificationItems;

    private static readonly IReadOnlyList<StatusCheckItem> BaseStatusItems =
    [
        new()
        {
            Label = "Alert hierarchy",
            Description = "Info, success, warning, and danger treatments remain distinct.",
            Status = "Ready",
            Tone = "success",
            Complete = true
        },
        new()
        {
            Label = "Toast open state",
            Description = "Notification host renders service messages without clipping.",
            Status = "Needs proof",
            Tone = "warning",
            Complete = false
        }
    ];

    private static readonly IReadOnlyList<StatusCheckItem> LongStatusItems =
    [
        new()
        {
            Label = "Extended mobile feedback validation with long status copy",
            Description = "This row intentionally carries a longer label and description so the status list can prove wrapping without horizontal overflow.",
            Status = "Awaiting screenshot review",
            Tone = "warning",
            Complete = false
        },
        new()
        {
            Label = "Notification host",
            Description = "Persistent notifications should stay inside the viewport even with action affordances.",
            Status = "Ready",
            Tone = "success",
            Complete = true
        }
    ];

    private static readonly IReadOnlyList<StatusCheckItem> BaseVerificationItems =
    [
        new()
        {
            Label = "Copyable warning",
            Description = "Warning notifications expose copy affordances.",
            Status = "Ready",
            Tone = "success",
            Complete = true
        }
    ];

    private static readonly IReadOnlyList<StatusCheckItem> DenseVerificationItems =
    [
        new()
        {
            Label = "Copyable warning",
            Description = "Warning notifications expose copy affordances.",
            Status = "Ready",
            Tone = "success",
            Complete = true
        },
        new()
        {
            Label = "Persistent toast",
            Description = "Duration zero notifications remain until dismissed or cleared.",
            Status = "Review",
            Tone = "info",
            Complete = false
        }
    ];

}
