@namespace CanDoItAll.Components.Sandbox.Components
@inject NavigationManager NavigationManager

<div class="sandbox-toolbar" data-testid="sandbox-toolbar">
    <div class="flex justify-center items-center gap-2.5"><img class="inline-block" src="./assets/logo.svg" alt="CanDoItAll" height="32" width="32"> CanDoItAll</div>

    <div class="sandbox-toolbar__controls">
        @if (ToolbarState is { HasContext: true } toolbarState)
        {
            <div class="sandbox-toolbar__scenario">
                <DropDown TValue="SandboxScenarioKey"
                          Data="@ScenarioOptions"
                          TextProperty="Text"
                          ValueProperty="Value"
                          Value="@toolbarState.Scenario"
                          ValueChanged="HandleScenarioChanged"
                          aria-label="Scenario"
                          data-testid="sandbox-toolbar-scenario"/>
            </div>

            <div class="sandbox-toolbar__frame">
                <DropDown TValue="SandboxFramePreset"
                          Data="@FrameOptions"
                          TextProperty="Text"
                          ValueProperty="Value"
                          Value="@toolbarState.Frame"
                          ValueChanged="HandleFrameChanged"
                          aria-label="Frame preset"
                          data-testid="sandbox-toolbar-frame"/>
            </div>

            <Button Text="Coverage"
                    ButtonStyle="@(toolbarState.ShowCoverage ? ButtonStyle.Primary : ButtonStyle.Light)"
                    Variant="@(toolbarState.ShowCoverage ? Variant.Filled : Variant.Outlined)"
                    Size="ButtonSize.Small"
                    Click="@(() => toolbarState.ToggleCoverage())"
                    aria-pressed="@(toolbarState.ShowCoverage ? "true" : "false")"
                    data-testid="sandbox-toolbar-coverage-toggle"/>
        }

        @if (ThemeState is not null)
        {
            <Button Text="@(ThemeState.IsDark ? "Dark" : "Light")"
                    Icon="@(ThemeState.IsDark ? "dark_mode" : "light_mode")"
                    ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Outlined"
                    Size="ButtonSize.Small"
                    Click="ToggleDarkMode"
                    aria-pressed="@(ThemeState.IsDark ? "true" : "false")"
                    data-testid="sandbox-toolbar-dark-toggle"/>
        }
    </div>
</div>

@code {
    private static readonly IReadOnlyList<FrameOption> FrameOptions = Enum.GetValues<SandboxFramePreset>()
        .Select(value => new FrameOption(value.ToLabel(), value))
        .ToArray();

    private static readonly IReadOnlyList<ScenarioOption> ScenarioOptions = Enum.GetValues<SandboxScenarioKey>()
        .Select(value => new ScenarioOption(value.ToLabel(), value))
        .ToArray();

    [CascadingParameter]
    public SandboxToolbarState? ToolbarState { get; set; }

    [CascadingParameter]
    public SandboxThemeState? ThemeState { get; set; }

    private Task HandleScenarioChanged(SandboxScenarioKey scenario)
        => ToolbarState!.ScenarioChanged.InvokeAsync(scenario);

    private Task HandleFrameChanged(SandboxFramePreset frame)
        => ToolbarState!.FrameChanged.InvokeAsync(frame);

    private void ToggleDarkMode()
        => NavigationManager.NavigateTo(SandboxQueryLinks.WithDark(NavigationManager, !ThemeState!.IsDark));

    private sealed record ScenarioOption(string Text, SandboxScenarioKey Value);

    private sealed record FrameOption(string Text, SandboxFramePreset Value);
}
