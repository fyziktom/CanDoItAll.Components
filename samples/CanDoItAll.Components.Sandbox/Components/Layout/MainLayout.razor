@namespace CanDoItAll.Components.Sandbox.Components
@using Microsoft.JSInterop
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits LayoutComponentBase
@implements IDisposable

<ThemeHost ThemeKey="@themeState.ThemeKey">
    <CascadingValue Value="@themeState">
        <CascadingValue Value="@toolbarState">
            <div class="sandbox-layout">
                <SandboxToolbar />
                <div class="sandbox-layout__backdrop" aria-hidden="true"></div>
                <div class="sandbox-layout__shell">
                    <aside id="sandbox-navigation" class="sandbox-sidebar">
                        <a href="@BuildSidebarLink("/")"
                           class="sandbox-nav__link @(IsActiveRoute("/") ? "is-active" : string.Empty)">
                            <span class="sandbox-nav__title">Components Sandbox</span>
                            @* <span class="sandbox-nav__meta">Home</span> *@
                        </a>

                        <nav class="sandbox-nav" aria-label="Standard proof groups">
                            @foreach (var group in SandboxCatalogRegistry.StandardGroups)
                            {
                                <a href="@BuildSidebarLink(group.Route)"
                                   class="sandbox-nav__link @(IsActive(group) ? "is-active" : string.Empty)">
                                    <span class="sandbox-nav__title">@group.Title</span>
                                    <span class="sandbox-nav__meta">@string.Join(" / ", group.FocusAreas.Take(3))</span>
                                </a>

                                @if (IsActive(group))
                                {
                                    var sections = SandboxCatalogRegistry.GetSections(group.Route);
                                    if (sections.Count > 0)
                                    {
                                        <nav class="sandbox-nav sandbox-nav--sub" aria-label="@($"{group.Title} sections")">
                                            @foreach (var section in sections)
                                            {
                                                <a href="@BuildSectionLink(group.Route, section.Anchor)"
                                                   class="sandbox-nav__link sandbox-nav__link--sub">
                                                    <span class="sandbox-nav__title">@section.ComponentName</span>
                                                </a>
                                            }
                                        </nav>
                                    }
                                }
                            }
                        </nav>

                        @if (SandboxCatalogRegistry.DeferredGroups.Count > 0)
                        {
                            <div class="space-y-2">
                                @* <TextBlock TextStyle="@(TextStyle.Eyebrow)" Value="Deferred proof scope" /> *@
                                <nav class="sandbox-nav" aria-label="Deferred proof groups">
                                    @foreach (var group in SandboxCatalogRegistry.DeferredGroups)
                                    {
                                        <a href="@BuildSidebarLink(group.Route)"
                                           class="sandbox-nav__link @(IsActive(group) ? "is-active" : string.Empty)">
                                            <span class="sandbox-nav__title">@group.Title</span>
                                            <span class="sandbox-nav__meta">@string.Join(" / ", group.FocusAreas.Take(3))</span>
                                        </a>

                                        @if (IsActive(group))
                                        {
                                            var deferredSections = SandboxCatalogRegistry.GetSections(group.Route);
                                            if (deferredSections.Count > 0)
                                            {
                                                <nav class="sandbox-nav sandbox-nav--sub" aria-label="@($"{group.Title} sections")">
                                                    @foreach (var section in deferredSections)
                                                    {
                                                        <a href="@BuildSectionLink(group.Route, section.Anchor)"
                                                           class="sandbox-nav__link sandbox-nav__link--sub">
                                                            <span class="sandbox-nav__title">@section.ComponentName</span>
                                                        </a>
                                                    }
                                                </nav>
                                            }
                                        }
                                    }
                                </nav>
                            </div>
                        }
                    </aside>

                    <main class="sandbox-main">
                        <DialogHost />
                        <Tooltip />
                        <Notification />
                        @Body
                    </main>
                </div>
            </div>
        </CascadingValue>
    </CascadingValue>
</ThemeHost>

@code {
    private readonly SandboxThemeState themeState = new();
    private readonly SandboxToolbarState toolbarState = new();

    protected override void OnInitialized()
    {
        themeState.Changed += HandleThemeChanged;
        toolbarState.Changed += HandleToolbarChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
        SyncThemeFromQuery();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/sandbox-toolbar.js");
            await module.InvokeVoidAsync("observeToolbarHeight", ".sandbox-toolbar");
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncThemeFromQuery();
    }

    private void SyncThemeFromQuery()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var isDark = query.TryGetValue("dark", out var value)
            && string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);

        themeState.SetTheme(isDark ? CadThemes.Dark : CadThemes.Light);
    }

    private bool IsActive(SandboxGroupDefinition group)
        => IsActiveRoute(group.Route);

    private bool IsActiveRoute(string route)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var currentPath = relativePath.Split('?', 2, StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        if (string.IsNullOrWhiteSpace(currentPath))
        {
            return string.Equals(route, "/", StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals($"/{currentPath.TrimStart('/')}", route, StringComparison.OrdinalIgnoreCase);
    }

    private string BuildSidebarLink(string route)
    {
        return SandboxQueryLinks.BuildCrossPageLink(
            NavigationManager,
            route,
            toolbarState.HasContext ? toolbarState.Scenario : null,
            toolbarState.HasContext ? toolbarState.Frame : null,
            themeState.IsDark);
    }

    private string BuildSectionLink(string route, string anchor)
    {
        return IsActiveRoute(route)
            ? SandboxQueryLinks.WithFragment(NavigationManager, anchor)
            : $"{BuildSidebarLink(route)}#{anchor}";
    }

    private void HandleThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleToolbarChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        themeState.Changed -= HandleThemeChanged;
        toolbarState.Changed -= HandleToolbarChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
