@namespace CanDoItAll.Components.Sandbox.Components
@using CanDoItAll.Components.Sandbox.Documentation

<section class="sandbox-example" data-testid="@TestId">
    <header class="sandbox-example__header">
        <div class="sandbox-example__heading">
            <TextBlock TextStyle="@(TextStyle.Subtitle1)" Value="@Title" />
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <TextBlock TextStyle="@(TextStyle.Body2)" Value="@Description" />
            }
        </div>
    </header>

    <div>

    <div class="sandbox-example__toolbar">
        <Tabs class="sandbox-example__tabs"
              SelectedIndex="@selectedTabIndex"
              SelectedIndexChanged="HandleTabChanged"
              RenderMode="@(TabRenderMode.Server)"
              Density="@(TabsDensity.Compact)"
              Rounded="@(TabsRounded.None)"
              BorderMode="@(TabsBorderMode.None)"
              NoContent="true"
              AriaLabel="@($"{Title} view")"
              data-testid="@($"{TestId}-tabs")">
            <TabItems>
                <TabsItem Text="Example" />
                @if (ApiTypes is { Count: > 0 })
                {
                    <TabsItem Text="API" />
                }
                @if (HasSource)
                {
                    <TabsItem Text="Code" />
                }
            </TabItems>
        </Tabs>

        <div>
        @if (HasSource)
        {
            <CopyButton Value="@Source"
                        Text="Copy"
                        Variant="Variant.Text"
                        Density="ButtonDensity.Compact"
                        CopiedText="Copied"
                        Size="CopyButtonSize.Small"
                        data-testid="@($"{TestId}-copy")" />
        }

        @if (GitHubSourceUrl is not null)
        {
            <Button Text="Source"
                    Icon="link"
                    Href="@GitHubSourceUrl"
                    Target="_blank"
                    Variant="Variant.Text"
                    Density="ButtonDensity.Compact"
                    Size="ButtonSize.Small"
                    data-testid="@($"{TestId}-github")" />
        }
        </div>
    </div>

    <div class="border p-5 border-(--tone-primary-soft-border)">
    @switch (ActivePanel)
    {
        case PanelKind.Example:
            <div class="sandbox-demo-frame @Frame.ToSurfaceClass()"
                 data-testid="@($"{TestId}-demo")">
                <div class="sandbox-example__demo">
                    @ChildContent
                </div>
            </div>
            break;
        case PanelKind.Api:
            <div class="sandbox-example__api" data-testid="@($"{TestId}-api")">
                <ComponentApiTable Types="@ApiTypes" />
            </div>
            break;
        case PanelKind.Code:
            <div class="sandbox-example__source" data-testid="@($"{TestId}-source")">
                <pre class="sandbox-example__code"><code>@Source</code></pre>
            </div>
            break;
    }

    @if (!HasSource)
    {
        <p class="sandbox-example__missing" data-testid="@($"{TestId}-missing")">
            No embedded source found for <code>@SourceId</code>.
        </p>
    }
    </div>

    </div>
</section>

@code {
    private enum PanelKind
    {
        Example,
        Api,
        Code
    }

    private int selectedTabIndex;

    /// <summary>Heading shown above the live demo.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Optional sentence explaining what the example is demonstrating.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// Logical name of the embedded example resource, for example
    /// <c>examples/Actions/PrimaryHierarchy.razor</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public string SourceId { get; set; } = string.Empty;

    /// <summary>The live rendering of the example, normally the example component itself.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Starts with the Code tab selected instead of Example.</summary>
    [Parameter]
    public bool SourceExpanded { get; set; }

    /// <summary>When set, shows an "API" tab that renders a ComponentApiTable scoped to these types.</summary>
    [Parameter]
    public IReadOnlyList<Type>? ApiTypes { get; set; }

    /// <summary>
    /// The library component this example demonstrates, when it isn't already implied by the
    /// first entry of <see cref="ApiTypes"/> — for example a second example of a component that
    /// doesn't need its own "API" tab. Combined with the cascaded catalog group to resolve a
    /// "View on GitHub" link automatically; see <see cref="ComponentSourceCatalog"/>.
    /// </summary>
    [Parameter]
    public Type? ComponentType { get; set; }

    /// <summary>The catalog group this example is filed under, supplied by CatalogPageFrame.</summary>
    [CascadingParameter]
    public SandboxGroupDefinition? Group { get; set; }

    /// <summary>The viewport preset applied only to the live example rendering.</summary>
    [CascadingParameter(Name = "SandboxFramePreset")]
    public SandboxFramePreset Frame { get; set; } = SandboxFramePreset.LiveViewport;

    private string? Source => ExampleSource.TryGet(SourceId);

    private bool HasSource => !string.IsNullOrEmpty(Source);

    private Type? PrimaryApiType => ComponentType ?? ApiTypes?.FirstOrDefault();

    private string? LibrarySourcePath => PrimaryApiType is null
        ? null
        : ComponentSourceCatalog.Resolve(Group?.Key, PrimaryApiType);

    private string? GitHubSourceUrl => LibrarySourcePath is null
        ? null
        : $"https://github.com/fyziktom/CanDoItAll.Components/blob/{GitInfo.CurrentBranch}/{LibrarySourcePath}";

    private string TestId => "sandbox-example-" + SourceId
        .Replace("examples/", string.Empty, StringComparison.OrdinalIgnoreCase)
        .Replace(".razor", string.Empty, StringComparison.OrdinalIgnoreCase)
        .Replace('/', '-')
        .ToLowerInvariant();

    private List<PanelKind> VisiblePanels
    {
        get
        {
            var panels = new List<PanelKind> { PanelKind.Example };

            if (ApiTypes is { Count: > 0 })
            {
                panels.Add(PanelKind.Api);
            }

            if (HasSource)
            {
                panels.Add(PanelKind.Code);
            }

            return panels;
        }
    }

    private PanelKind ActivePanel
    {
        get
        {
            var panels = VisiblePanels;
            var index = Math.Clamp(selectedTabIndex, 0, panels.Count - 1);
            return panels[index];
        }
    }

    protected override void OnInitialized()
    {
        if (SourceExpanded && HasSource)
        {
            selectedTabIndex = VisiblePanels.IndexOf(PanelKind.Code);
        }
    }

    private void HandleTabChanged(int index)
    {
        selectedTabIndex = index;
    }
}
