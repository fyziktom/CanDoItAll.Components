@namespace CanDoItAll.Components.Sandbox.Components
@using System.Reflection
@using Microsoft.JSInterop
@implements IDisposable
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@if (queryRouteData is { } routeData)
{
    <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
}
else
{
    <Router AppAssembly="@typeof(Routes).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
}

@code {
    private RouteData? queryRouteData;
    private string? pendingAnchor;
    private bool pendingScroll;
    private IJSObjectReference? toolbarModule;
    private DotNetObjectReference<Routes>? dotNetReference;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        UpdateQueryRoute();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        UpdateQueryRoute();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateQueryRoute(string? hash = null)
    {
        if (!SandboxQueryLinks.UseHashRouting)
        {
            queryRouteData = null;
            return;
        }

        var routeHash = (hash ?? NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Fragment).TrimStart('#');
        var parts = routeHash.Split('?', 2);
        if (parts.Length == 0 || string.IsNullOrWhiteSpace(parts[0]))
        {
            queryRouteData = null;
            pendingAnchor = null;
            pendingScroll = true;
            SandboxQueryLinks.CurrentHashRoute = string.Empty;
            return;
        }

        var route = Uri.UnescapeDataString(parts[0]).Trim('/');
        var template = $"/{route}";
        SandboxQueryLinks.CurrentHashRoute = route;
        pendingAnchor = parts.Length == 2 ? Uri.UnescapeDataString(parts[1]) : null;
        var componentType = typeof(Routes).Assembly.ExportedTypes.FirstOrDefault(type =>
            typeof(IComponent).IsAssignableFrom(type)
            && type.GetCustomAttributes<RouteAttribute>()
                .Any(attribute => string.Equals(attribute.Template, template, StringComparison.OrdinalIgnoreCase)));

        queryRouteData = componentType is null
            ? null
            : new RouteData(componentType, new Dictionary<string, object?>());
        pendingScroll = queryRouteData is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && SandboxQueryLinks.UseHashRouting)
        {
            toolbarModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/sandbox-toolbar.js");
            dotNetReference = DotNetObjectReference.Create(this);
            await toolbarModule.InvokeVoidAsync("observeHashChanges", dotNetReference);
        }

        if (!SandboxQueryLinks.UseHashRouting || !pendingScroll)
        {
            return;
        }

        if (toolbarModule is not null)
        {
            if (string.IsNullOrWhiteSpace(pendingAnchor))
            {
                await toolbarModule.InvokeVoidAsync("scrollToTop");
            }
            else
            {
                await toolbarModule.InvokeVoidAsync("scrollToAnchor", pendingAnchor);
            }
        }
        pendingAnchor = null;
        pendingScroll = false;
    }

    [JSInvokable]
    public Task HandleHashChanged(string hash)
    {
        UpdateQueryRoute(hash);
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose() => NavigationManager.LocationChanged -= HandleLocationChanged;

    public async ValueTask DisposeAsync()
    {
        if (toolbarModule is not null)
        {
            await toolbarModule.InvokeVoidAsync("stopObservingHashChanges");
            await toolbarModule.DisposeAsync();
        }

        dotNetReference?.Dispose();
    }
}
