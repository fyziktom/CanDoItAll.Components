<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanDoItAll.Components.Sandbox</AssemblyName>
    <RootNamespace>CanDoItAll.Components.Sandbox</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="*.cs" />
    <Compile Include="Program.cs" />
    <Compile Remove="Documentation\**\*.cs" />
    <Compile Remove="Components\**\*.cs" />
    <RazorComponent Remove="Components\**\*.razor" />
    <RazorComponent Include="_Imports.razor" />
    <RazorComponent Include="Components\App.razor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanDoItAll.Components.Sandbox.Catalog\CanDoItAll.Components.Sandbox.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

</Project>
