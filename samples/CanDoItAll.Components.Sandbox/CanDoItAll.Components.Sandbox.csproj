<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanDoItAll.Components.Sandbox</AssemblyName>
    <RootNamespace>CanDoItAll.Components.Sandbox</RootNamespace>
    <IsPackable>false</IsPackable>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <!--
    The catalog shows the original markup of each example next to the live demo. Razor compiles to
    BuildRenderTree calls, so the authored source cannot be recovered by reflection - it is embedded
    here instead, which makes the displayed snippet the exact bytes that rendered the demo.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Components\Examples\**\*.razor"
                      LogicalName="examples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CanDoItAll.Components.BaseLib\CanDoItAll.Components.BaseLib.csproj" />
    <ProjectReference Include="..\..\src\CanDoItAll.Components.CanvasLib\CanDoItAll.Components.CanvasLib.csproj" />
    <ProjectReference Include="..\..\src\CanDoItAll.Components.Charts\CanDoItAll.Components.Charts.csproj" />
    <ProjectReference Include="..\..\src\CanDoItAll.Components.Common\CanDoItAll.Components.Common.csproj" />
    <ProjectReference Include="..\..\src\CanDoItAll.Components.Gantt\CanDoItAll.Components.Gantt.csproj" />
    <ProjectReference Include="..\..\src\CanDoItAll.Components.Mermaid\CanDoItAll.Components.Mermaid.csproj" />
    <ProjectReference Include="..\..\src\CanDoItAll.Components.OverlayLib\CanDoItAll.Components.OverlayLib.csproj" />
    <ProjectReference Include="..\..\src\CanDoItAll.Components.QRCode\CanDoItAll.Components.QRCode.csproj" />
  </ItemGroup>

</Project>
