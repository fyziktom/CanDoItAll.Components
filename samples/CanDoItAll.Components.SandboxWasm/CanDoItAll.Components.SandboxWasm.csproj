<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanDoItAll.Components.SandboxWasm</AssemblyName>
    <RootNamespace>CanDoItAll.Components.SandboxWasm</RootNamespace>
    <IsPackable>false</IsPackable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CanDoItAll.Components.Sandbox.Catalog\CanDoItAll.Components.Sandbox.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CanDoItAll.Components.Sandbox\wwwroot\**\*"
             Exclude="..\CanDoItAll.Components.Sandbox\wwwroot\assets\logo.svg"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

</Project>
