<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanDoItAll.Components.WebGlLibOnlyViewer</AssemblyName>
    <RootNamespace>CanDoItAll.Components.WebGlLibOnlyViewer</RootNamespace>
    <Description>Minimal WebGlLib-only viewer sample without WebGlRunLib references.</Description>
    <IsPackable>false</IsPackable>
    <ComponentsWebGlLibProject>..\..\src\CanDoItAll.Components.WebGlLib\CanDoItAll.Components.WebGlLib.csproj</ComponentsWebGlLibProject>
    <UseComponentsWebGlLibPackage Condition="'$(UseComponentsWebGlLibPackage)' == ''">false</UseComponentsWebGlLibPackage>
    <ComponentsWebGlLibPackageVersion Condition="'$(ComponentsWebGlLibPackageVersion)' == ''">$(PackageVersion)</ComponentsWebGlLibPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UseComponentsWebGlLibPackage)' != 'true' and Exists('$(ComponentsWebGlLibProject)')" Include="$(ComponentsWebGlLibProject)" />
    <PackageReference Condition="'$(UseComponentsWebGlLibPackage)' == 'true'" Include="CanDoItAll.Components.WebGlLib" Version="$(ComponentsWebGlLibPackageVersion)" />
  </ItemGroup>

  <Target Name="ValidateComponentsWebGlLibReference" BeforeTargets="ResolveReferences" Condition="'$(UseComponentsWebGlLibPackage)' != 'true' and !Exists('$(ComponentsWebGlLibProject)')">
    <Error Text="CanDoItAll.Components.WebGlLib project reference was not found at '$(ComponentsWebGlLibProject)'. Set ComponentsWebGlLibProject to the local project or set UseComponentsWebGlLibPackage=true with ComponentsWebGlLibPackageVersion." />
  </Target>

</Project>
