@namespace CanDoItAll.Components.WebGlSandbox.Components
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<ThemeHost>
    <div class="webgl-shell">
        <aside class="webgl-nav">
            <a class="webgl-brand" href="/">
                <span class="webgl-brand__eyebrow">CanDoItAll</span>
                <span class="webgl-brand__title">WebGL Sandbox</span>
            </a>
            <nav class="webgl-nav__links" aria-label="WebGL sandbox routes">
                <a class="@ResolveNavClass("/")" href="/">Overview</a>
                <a class="@ResolveNavClass("/tycoon-village")" href="/tycoon-village">Tycoon Village</a>
                <a class="@ResolveNavClass("/run-playback")" href="/run-playback">Run Play</a>
                <a class="@ResolveNavClass("/performance-proof")" href="/performance-proof">Performance</a>
                <a class="@ResolveNavClass("/model-lab")" href="/model-lab">Model Lab</a>
                <a class="@ResolveNavClass("/asset-catalog")" href="/asset-catalog">Asset Catalog</a>
            </nav>
        </aside>
        <main class="webgl-main">
            <div class="webgl-screen-warning" role="status">
                This WebGL sandbox is optimized for desktop/large-screen use.
            </div>
            <DialogHost />
            <Tooltip />
            <Notification />
            @Body
        </main>
    </div>
</ThemeHost>

@code {
    private string ResolveNavClass(string route)
    {
        var current = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', 2)[0].Trim('/');
        if (current == "/")
        {
            current = "/";
        }

        return string.Equals(current, route, StringComparison.OrdinalIgnoreCase)
            ? "webgl-nav__link is-active"
            : "webgl-nav__link";
    }
}

