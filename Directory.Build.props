<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      .artifacts/**;
      .mcp-state/**;
      output/**;
      playwright-report/**;
      test-results/**;
      TestResults/**;
      coverage/**;
    </DefaultItemExcludes>
    <IsPackable>false</IsPackable>
    <CanDoItAllPackageBaseVersion Condition="'$(CanDoItAllPackageBaseVersion)' == ''">0.3.0</CanDoItAllPackageBaseVersion>
    <CanDoItAllPackageProofSuffix Condition="'$(CanDoItAllPackageProofSuffix)' == ''"></CanDoItAllPackageProofSuffix>
    <Version>$(CanDoItAllPackageBaseVersion)$(CanDoItAllPackageProofSuffix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>fyziktom</Authors>
    <PackageOwners>fyziktom</PackageOwners>
    <Company>CanDoItAll</Company>
    <Copyright>Copyright © 2026 fyziktom</Copyright>
    <PackageProjectUrl>https://aicandoitall.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fyziktom/CanDoItAll.Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>CanDoItAll;Blazor;Components</PackageTags>
    <Description Condition="'$(Description)' == ''">Shared CanDoItAll Blazor component package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
