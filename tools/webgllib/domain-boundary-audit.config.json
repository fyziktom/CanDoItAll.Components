{
  "schemaVersion": "domain-boundary-audit/v1",
  "termFiles": [
    "tests/CanDoItAll.Components.WebGlRunLib.Tests/fixtures/domain-leakage-terms.json"
  ],
  "defaultExtensions": [
    ".cs",
    ".razor",
    ".js",
    ".css",
    ".json",
    ".md",
    ".csproj",
    ".props",
    ".targets",
    ".yml",
    ".yaml"
  ],
  "defaultExcludeDirs": [
    ".git",
    "bin",
    "obj",
    "node_modules",
    "vendor"
  ],
  "globalAllowlist": {
    "paths": [
      {
        "glob": "tools/webgllib/domain-boundary-audit.config.json",
        "reason": "The audit config is the explicit owner of domain boundary terms and allowlist reasons.",
        "owner": "webgl-boundary",
        "expires": "2026-12-31"
      },
      {
        "glob": "tools/webgllib/domain-boundary-auditor.cjs",
        "reason": "The auditor itself references domain-boundary terminology while enforcing the registry.",
        "owner": "webgl-boundary",
        "expires": "2026-12-31"
      },
      {
        "glob": "tests/CanDoItAll.Components.WebGlRunLib.Tests/fixtures/domain-leakage-terms.json",
        "reason": "Driver-owned validation fixture supplies forbidden terms for focused validator tests.",
        "owner": "webgl-boundary",
        "expires": "2026-12-31"
      },
      {
        "glob": "codex/bundles/WebGlEngine_Economy_Followup_v12/**",
        "reason": "The active v12 bundle intentionally discusses the audited domain terms as proof and requirements, not shipped behavior.",
        "owner": "webglrunlib-boundary",
        "expires": "2026-12-31"
      },
      {
        "glob": "codex/bundles/WebGlEngine_Economy_Followup_v13/**",
        "reason": "The active v13 freeze bundle intentionally discusses the audited domain terms as proof and requirements, not shipped behavior.",
        "owner": "webglrunlib-boundary",
        "expires": "2026-12-31"
      },
      {
        "glob": "codex/bundles/WebGlEngine_Stabilization_v14/**",
        "reason": "The active v14 stabilization bundle intentionally discusses the audited domain terms as proof and requirements, not shipped behavior.",
        "owner": "webglrunlib-boundary",
        "expires": "2026-12-31"
      },
      {
        "glob": "codex/bundles/WebGlEngine_Stabilization_v16/**",
        "reason": "The active v16 stabilization bundle intentionally discusses audited domain terms as proof and requirements, not shipped behavior.",
        "owner": "webgl-boundary",
        "expires": "2026-12-31"
      },
      {
        "glob": "codex/bundles/WebGlEngine_Stabilization_v17/**",
        "reason": "The active v17 stabilization bundle intentionally discusses audited domain terms as proof and requirements, not shipped behavior.",
        "owner": "webgl-boundary",
        "expires": "2026-12-31"
      }
    ],
    "lines": [
      {
        "pattern": "\\bClaimStatus\\b|claim status|research-ready claim|readiness claim|overclaim",
        "terms": [
          "claim"
        ],
        "reason": "Generic proof code uses claim as an evidence-status word, not the Economy claim instrument."
      },
      {
        "pattern": "machine-readable|machine readable",
        "terms": [
          "machine"
        ],
        "reason": "Generic tooling uses machine-readable to describe output format."
      },
      {
        "pattern": "WebGlEngine_Economy_Followup_v1[123]|WebGl_Economy_|webgl-economy|webgl-engine-economy",
        "reason": "Artifact and bundle directory names preserve historical proof lineage."
      }
    ]
  },
