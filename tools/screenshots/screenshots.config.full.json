{
  "baseUrl": "https://localhost:55173",
  "routesEndpoint": "/api/pages.json",
  "routes": [],
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 900 },
    { "name": "tablet", "width": 1024, "height": 768 },
    { "name": "mobile", "width": 390, "height": 844 }
  ],
  "themes": {
    "light": "",
    "dark": "dark=true"
  },
  "alternatives": {
    "default": "",
    "dense-content": "scenario=dense-content",
    "empty-state": "scenario=empty-state",
    "loading-state": "scenario=loading-state",
    "disabled-state": "scenario=disabled-state",
    "long-text": "scenario=long-text"
  },
  "readySelector": "body",
  "defaultSettleMs": 300,
  "outputDir": "../../.artifacts/screenshots",
  "storageRepoPath": "../../../CanDoItAll.Components.Screenshots",
  "gitignore": [".idea/", ".vscode/", ".DS_Store", "Thumbs.db"]
}
