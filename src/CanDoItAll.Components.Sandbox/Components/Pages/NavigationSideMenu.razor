@namespace CanDoItAll.Components.Sandbox.Components
@page "/groups/navigation/side-menu"
@inherits CatalogPageBase
@implements IDisposable
@inject SideMenuService SideMenus

<PageTitle>Side Menu Lab</PageTitle>

<CatalogPageFrame Group="@Group"
                  Scenario="@CurrentScenario"
                  Frame="@CurrentFrame"
                  ExampleCount="@Examples.Count"
                  HeroTitle="Prove a menu can change context without changing its contract."
                  HeroSummary="This lab combines parameter-fed and declarative items, measured overflow, bottom utilities, custom panels, external selection, and service-driven context switching in one bounded workspace."
                  DemoTitle="Responsive side menu proof lab"
                  DemoSummary="Start with the large rail, reduce its available height, collapse it, open More and utility panels, then resize the real browser through medium and small breakpoints."
                  ScenarioChanged="NavigateScenario"
                  FrameChanged="NavigateFrame">
    <Notes>
        <div class="sandbox-proof-list">
            <p><code>Items</code> and nested <code>MenuItems</code> compose into one declared menu.</p>
            <p><code>SideMenuService.SetItems</code> temporarily replaces the primary set for tab- or context-driven navigation.</p>
            <p><code>SelectAsync</code> uses the same callback and service-subscription pipeline as a pointer selection.</p>
            <p>The narrow layout is a real top menu whose content opens downward; validate it by resizing the browser, not only the preview frame.</p>
        </div>
    </Notes>

    <ChildContent>
        @if (CurrentScenario == SandboxScenarioKey.LoadingState)
        {
            <LoadingState Eyebrow="Side menu"
                          Title="Preparing navigation contexts"
                          Description="The sandbox is assembling declarative, list-fed, overflow, and utility menu items." />
        }
        else
        {
            <Stack GapScale="LayoutGap.Large">
                <div class="sandbox-side-menu-toolbar" data-testid="side-menu-service-controls">
                    <div>
                        <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Service controls" />
                        <TextBlock TextStyle="@(TextStyle.Note)" Value="These buttons act through SideMenuService rather than a component reference." />
                    </div>
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <Button Text="Project context"
                                Icon="folder_open"
                                Size="ButtonSize.Small"
                                Click="UseProjectContextAsync"
                                data-testid="side-menu-context-project" />
                        <Button Text="Analytics context"
                                Icon="monitoring"
                                ButtonStyle="@(ButtonStyle.Info)"
                                Variant="@(Variant.Outlined)"
                                Size="ButtonSize.Small"
                                Click="UseAnalyticsContextAsync"
                                data-testid="side-menu-context-analytics" />
                        <Button Text="Restore declared items"
                                Icon="restart_alt"
                                ButtonStyle="@(ButtonStyle.Light)"
                                Variant="@(Variant.Outlined)"
                                Size="ButtonSize.Small"
                                Click="RestoreDeclaredItemsAsync"
                                data-testid="side-menu-context-declared" />
                        <Button Text="Select first externally"
                                Icon="ads_click"
                                ButtonStyle="@(ButtonStyle.Light)"
                                Variant="@(Variant.Outlined)"
                                Size="ButtonSize.Small"
                                Click="SelectFirstExternallyAsync"
                                data-testid="side-menu-select-external" />
                        <Button Text="Toggle via service"
                                Icon="swap_horiz"
                                ButtonStyle="@(ButtonStyle.Light)"
                                Variant="@(Variant.Outlined)"
                                Size="ButtonSize.Small"
                                Click="ToggleFromServiceAsync"
                                data-testid="side-menu-toggle-external" />
                    </Cluster>
                </div>

                <div class="sandbox-side-menu-lab @(CurrentScenario == SandboxScenarioKey.DenseContent ? "is-height-stressed" : null)"
                     data-scenario="@CurrentScenario.ToSlug()"
                     data-testid="side-menu-lab">
                    <div class="sandbox-side-menu-host" data-testid="side-menu-host">
                        <SideMenu MenuId="@MenuId"
                                  Title="Delivery workspace"
                                  Subtitle="@ContextLabel"
                                  Icon="apps"
                                  Expanded="@menuExpanded"
                                  ExpandedChanged="HandleExpandedChanged"
                                  Items="@DeclaredPropertyItems"
                                  MoreItems="@DeclaredMoreItems"
                                  BottomItems="@DeclaredBottomItems"
                                  ItemSelected="HandleComponentSelection"
                                  data-testid="side-menu-proof">
                            <MenuItems>
                                @if (CurrentScenario != SandboxScenarioKey.EmptyState)
                                {
                                    <SideMenuItem Id="timeline"
                                                  Text="Timeline"
                                                  Icon="timeline"
                                                  Description="Milestones and delivery dates."
                                                  Selected="HandleDeclarativeSelection" />
                                    <SideMenuItem Id="requirements"
                                                  Text="Requirements"
                                                  Icon="fact_check"
                                                  Description="Scope, constraints, and acceptance." />
                                    <SideMenuItem Id="resources"
                                                  Text="Resource planning"
                                                  Icon="inventory_2"
                                                  Description="People, agents, tools, and allocations."
                                                  BadgeText="8" />
                                    <SideMenuItem Id="automations"
                                                  Text="Automations"
                                                  Icon="smart_toy"
                                                  Description="Scheduled and event-driven work." />
                                    <SideMenuItem Id="quality"
                                                  Text="Quality review"
                                                  Icon="verified"
                                                  Description="Tests, evidence, and release gates."
                                                  Disabled="@(CurrentScenario == SandboxScenarioKey.DisabledState)" />
                                    <SideMenuItem Id="financials"
                                                  Text="Financial controls"
                                                  Icon="payments"
                                                  Description="Budget, spend, and approval status." />
                                    <SideMenuItem Id="vendors"
                                                  Text="Vendors and external dependencies"
                                                  Icon="handshake"
                                                  Description="Partners, contracts, and outside delivery risk." />
                                    <SideMenuItem Id="audit"
                                                  Text="Audit archive"
                                                  Icon="inventory"
                                                  Description="Historical decisions and immutable evidence."
                                                  OverflowBehavior="@(SideMenuOverflowBehavior.AlwaysInMore)" />
                                }
                            </MenuItems>

                            <MoreMenuItems>
                                <SideMenuItem Id="shortcuts"
                                              Text="Keyboard shortcuts"
                                              Icon="keyboard"
                                              Description="Review navigation and command keys." />
                            </MoreMenuItems>

                            <MoreContent>
                                <Stack GapScale="LayoutGap.Small">
                                    <div>
                                        <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Custom More content" />
                                        <TextBlock TextStyle="@(TextStyle.Note)" Value="Consumers can append arbitrary BaseLib content beneath typed overflow actions." />
                                    </div>
                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                        <StatusBadge Text="Scoped to current tab" Tone="info" />
                                        <Button Text="Run readiness action"
                                                Icon="play_arrow"
                                                Size="ButtonSize.Small"
                                                Click="RunReadinessActionAsync"
                                                data-testid="side-menu-custom-more-action" />
                                    </Cluster>
                                </Stack>
                            </MoreContent>

                            <BottomMenuItems>
                                <SideMenuItem Id="account"
                                              Text="Account"
                                              Icon="account_circle"
                                              Description="Profile, team, and session actions."
                                              PanelTitle="Account and workspace"
                                              Children="@AccountItems" />
                                <SideMenuItem Id="settings"
                                              Text="Settings"
                                              Icon="settings"
                                              Description="Workspace preferences and menu behavior."
                                              PanelTitle="Workspace settings">
                                    <PanelContent>
                                        <Stack GapScale="LayoutGap.Medium">
                                            <div>
                                                <TextBlock TextStyle="@(TextStyle.Subtitle2)" Value="Navigation preferences" />
                                                <TextBlock TextStyle="@(TextStyle.Note)" Value="Expansion is synchronized through the service and remembered in localStorage." />
                                            </div>
                                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                                <StatusBadge Text="Persistence on" Tone="success" />
                                                <Button Text="Toggle menu"
                                                        Icon="swap_horiz"
                                                        Size="ButtonSize.Small"
                                                        Click="ToggleFromServiceAsync"
                                                        data-testid="side-menu-settings-toggle" />
                                            </Cluster>
                                        </Stack>
                                    </PanelContent>
                                </SideMenuItem>
                            </BottomMenuItems>
                        </SideMenu>
                    </div>

                    <section class="sandbox-side-menu-workspace" aria-label="Side menu selection proof">
                        <header class="sandbox-side-menu-workspace__header">
                            <div>
                                <span class="sandbox-side-menu-workspace__eyebrow">@ContextLabel</span>
                                <h3>@SelectedHeading</h3>
                                <p>Selections can start inside the menu or in another service-aware component and still reach the same listeners.</p>
                            </div>
                            <StatusBadge Text="@(menuExpanded ? "Open" : "Compact")" Tone="@(menuExpanded ? "success" : "neutral")" />
                        </header>

                        <div class="sandbox-side-menu-signal-grid">
                            <div class="sandbox-side-menu-signal">
                                <span>Service subscription</span>
                                <strong data-testid="side-menu-service-selection">@lastServiceSelection</strong>
                            </div>
                            <div class="sandbox-side-menu-signal">
                                <span>Component callback</span>
                                <strong data-testid="side-menu-component-selection">@lastComponentSelection</strong>
                            </div>
                            <div class="sandbox-side-menu-signal">
                                <span>Declarative item callback</span>
                                <strong data-testid="side-menu-declarative-selection">@lastDeclarativeSelection</strong>
                            </div>
                        </div>

                        @if (CurrentScenario == SandboxScenarioKey.EmptyState)
                        {
                            <EmptyState Eyebrow="Menu context"
                                        Title="No primary destinations"
                                        Description="Bottom utilities and custom More content remain available while the current tab has no primary menu model." />
                        }
                        else
                        {
                            <div class="sandbox-side-menu-activity">
                                <div class="sandbox-side-menu-activity__row">
                                    <span class="sandbox-side-menu-activity__icon"><Icon Name="sync" /></span>
                                    <div><strong>Context switching</strong><p>Project, analytics, and declared item sets can replace each other without remounting the menu.</p></div>
                                    <StatusBadge Text="Ready" Tone="success" />
                                </div>
                                <div class="sandbox-side-menu-activity__row">
                                    <span class="sandbox-side-menu-activity__icon"><Icon Name="unfold_less" /></span>
                                    <div><strong>Measured overflow</strong><p>The available item-region height decides what remains visible and what moves under More.</p></div>
                                    <StatusBadge Text="Observed" Tone="info" />
                                </div>
                                <div class="sandbox-side-menu-activity__row">
                                    <span class="sandbox-side-menu-activity__icon"><Icon Name="devices" /></span>
                                    <div><strong>Responsive mode</strong><p>Large and medium rails become a top-triggered downward menu below the small breakpoint.</p></div>
                                    <StatusBadge Text="3 modes" Tone="warning" />
                                </div>
                            </div>
                        }
                    </section>
                </div>
            </Stack>
        }
    </ChildContent>
</CatalogPageFrame>

@code {
    private const string MenuId = "sandbox-side-menu";
    private static readonly SandboxGroupDefinition Group = SandboxCatalogRegistry.GetGroup(SandboxGroupKey.Navigation);
    private static readonly IReadOnlyList<SandboxExampleDefinition> Examples = SandboxCatalogRegistry.GetExamples(SandboxGroupKey.Navigation);

    private static readonly IReadOnlyList<ISideMenuItem> BasePropertyItems =
    [
        new SideMenuItemDefinition { Id = "overview", Text = "Overview", Icon = "dashboard", Description = "Current delivery status and decisions.", OverflowBehavior = SideMenuOverflowBehavior.PreferVisible },
        new SideMenuItemDefinition { Id = "inbox", Text = "Inbox", Icon = "inbox", Description = "Requests that need review.", BadgeText = "12", OverflowBehavior = SideMenuOverflowBehavior.PreferVisible },
        new SideMenuItemDefinition { Id = "projects", Text = "Projects", Icon = "folder_open", Description = "Active project portfolio and context." }
    ];

    private static readonly IReadOnlyList<ISideMenuItem> DeclaredMoreItems =
    [
        new SideMenuItemDefinition { Id = "command-center", Text = "Command center", Icon = "terminal", Description = "Open advanced workspace commands." }
    ];

    private static readonly IReadOnlyList<ISideMenuItem> DeclaredBottomItems =
    [
        new SideMenuItemDefinition { Id = "help", Text = "Help", Icon = "help", Description = "Open contextual documentation." }
    ];

    private static readonly IReadOnlyList<ISideMenuItem> AccountItems =
    [
        new SideMenuItemDefinition { Id = "profile", Text = "Your profile", Icon = "person", Description = "Identity and personal preferences." },
        new SideMenuItemDefinition { Id = "team", Text = "Switch team", Icon = "groups", Description = "Change the active delivery team.", BadgeText = "3" },
        new SideMenuItemDefinition { Id = "sign-out", Text = "Sign out", Icon = "logout", Description = "End the current session." }
    ];

    private static readonly IReadOnlyList<ISideMenuItem> ProjectContextItems =
    [
        new SideMenuItemDefinition { Id = "project-health", Text = "Project health", Icon = "monitor_heart", Description = "Delivery, cost, and quality signals.", OverflowBehavior = SideMenuOverflowBehavior.PreferVisible },
        new SideMenuItemDefinition { Id = "project-board", Text = "Delivery board", Icon = "view_kanban", Description = "Work moving through the current phase.", BadgeText = "24" },
        new SideMenuItemDefinition { Id = "project-plan", Text = "Plan", Icon = "account_tree", Description = "Scope and dependency model." },
        new SideMenuItemDefinition { Id = "project-team", Text = "Team", Icon = "groups", Description = "People and agent assignments." },
        new SideMenuItemDefinition { Id = "project-calendar", Text = "Calendar", Icon = "calendar_month", Description = "Milestones and scheduled runs." },
        new SideMenuItemDefinition { Id = "project-risk", Text = "Risks", Icon = "warning", Description = "Open threats and mitigations.", BadgeText = "5" },
        new SideMenuItemDefinition { Id = "project-budget", Text = "Budget", Icon = "payments", Description = "Budget, actuals, and forecast." },
        new SideMenuItemDefinition { Id = "project-quality", Text = "Quality", Icon = "verified", Description = "Evidence and release gates." },
        new SideMenuItemDefinition { Id = "project-history", Text = "History", Icon = "history", Description = "Decisions and previous phases." },
        new SideMenuItemDefinition { Id = "project-archive", Text = "Archive", Icon = "inventory", Description = "Closed work and snapshots.", OverflowBehavior = SideMenuOverflowBehavior.AlwaysInMore }
    ];

    private static readonly IReadOnlyList<ISideMenuItem> AnalyticsContextItems =
    [
        new SideMenuItemDefinition { Id = "analytics-summary", Text = "Analytics summary", Icon = "monitoring", Description = "Current performance indicators.", OverflowBehavior = SideMenuOverflowBehavior.PreferVisible },
        new SideMenuItemDefinition { Id = "analytics-throughput", Text = "Throughput", Icon = "speed", Description = "Delivery rate and cycle time." },
        new SideMenuItemDefinition { Id = "analytics-quality", Text = "Quality trends", Icon = "query_stats", Description = "Defects, tests, and reliability." },
        new SideMenuItemDefinition { Id = "analytics-cost", Text = "Cost trends", Icon = "payments", Description = "Spend and forecast variance." },
        new SideMenuItemDefinition { Id = "analytics-capacity", Text = "Capacity", Icon = "groups", Description = "Team and agent utilization." },
        new SideMenuItemDefinition { Id = "analytics-exports", Text = "Exports", Icon = "download", Description = "Reports and downstream datasets.", OverflowBehavior = SideMenuOverflowBehavior.AlwaysInMore }
    ];

    private IDisposable? serviceSubscription;
    private bool menuExpanded = true;
    private string contextLabel = "Declared + parameter items";
    private string selectedHeading = "No destination selected";
    private string lastServiceSelection = "Waiting for selection";
    private string lastComponentSelection = "Waiting for selection";
    private string lastDeclarativeSelection = "Select Timeline to prove this callback";

    private IReadOnlyList<ISideMenuItem> DeclaredPropertyItems => CurrentScenario == SandboxScenarioKey.EmptyState
        ? []
        : CurrentScenario == SandboxScenarioKey.LongText
            ? BasePropertyItems
                .Select(item => item is SideMenuItemDefinition definition
                    ? definition with { Text = $"{definition.Text} with a deliberately extended navigation label" }
                    : item)
                .ToArray()
            : BasePropertyItems;

    private string ContextLabel => contextLabel;

    private string SelectedHeading => selectedHeading;

    protected override void OnInitialized()
    {
        serviceSubscription = SideMenus.Subscribe(MenuId, HandleServiceSelectionAsync);
    }

    private Task UseProjectContextAsync()
    {
        SideMenus.SetItems(MenuId, ProjectContextItems);
        contextLabel = "Project tab context";
        selectedHeading = "No destination selected";
        return InvokeAsync(StateHasChanged);
    }

    private Task UseAnalyticsContextAsync()
    {
        SideMenus.SetItems(MenuId, AnalyticsContextItems);
        contextLabel = "Analytics tab context";
        selectedHeading = "No destination selected";
        return InvokeAsync(StateHasChanged);
    }

    private Task RestoreDeclaredItemsAsync()
    {
        SideMenus.ResetItems(MenuId);
        contextLabel = "Declared + parameter items";
        selectedHeading = "No destination selected";
        return InvokeAsync(StateHasChanged);
    }

    private async Task SelectFirstExternallyAsync()
    {
        var firstItem = SideMenus.GetSnapshot(MenuId).Items.FirstOrDefault(item => item.Visible && !item.Disabled);
        if (firstItem is not null)
        {
            await SideMenus.SelectAsync(MenuId, firstItem.Id);
        }
    }

    private Task ToggleFromServiceAsync()
    {
        SideMenus.ToggleExpanded(MenuId);
        return Task.CompletedTask;
    }

    private Task RunReadinessActionAsync()
        => SideMenus.SelectAsync(MenuId, "command-center");

    private Task HandleExpandedChanged(bool isExpanded)
    {
        menuExpanded = isExpanded;
        return Task.CompletedTask;
    }

    private Task HandleComponentSelection(SideMenuSelection selection)
    {
        lastComponentSelection = $"{selection.Item.Text} / {selection.Source}";
        return Task.CompletedTask;
    }

    private Task HandleDeclarativeSelection(SideMenuSelection selection)
    {
        lastDeclarativeSelection = $"{selection.Item.Text} callback received";
        return Task.CompletedTask;
    }

    private async ValueTask HandleServiceSelectionAsync(SideMenuSelection selection)
    {
        await InvokeAsync(() =>
        {
            selectedHeading = selection.Item.Text;
            lastServiceSelection = $"{selection.Item.Text} / {selection.Source}";
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        serviceSubscription?.Dispose();
    }
}
