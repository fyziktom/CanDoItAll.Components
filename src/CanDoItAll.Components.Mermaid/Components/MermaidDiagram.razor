@namespace CanDoItAll.Components.Mermaid
@using CanDoItAll.Components.BaseLib
@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @attributes="AdditionalAttributes" class="@RootClass" style="@Style">
    @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description) || ShowControls)
    {
        <div class="cda-mermaid__header">
            <div class="cda-mermaid__copy">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h3 class="cda-mermaid__title">@Title</h3>
                }
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="cda-mermaid__description">@Description</p>
                }
            </div>

            @if (ShowControls && PanZoomEnabled)
            {
                <div class="cda-mermaid__toolbar" aria-label="Mermaid diagram controls">
                    <button type="button" class="cda-mermaid__tool" title="Zoom out" aria-label="Zoom out" @onclick="ZoomOutAsync">-</button>
                    <button type="button" class="cda-mermaid__tool" title="Reset view" aria-label="Reset view" @onclick="ResetViewAsync">Reset</button>
                    <button type="button" class="cda-mermaid__tool" title="Zoom in" aria-label="Zoom in" @onclick="ZoomInAsync">+</button>
                </div>
            }
        </div>
    }

    <div class="cda-mermaid__viewport-shell">
        <ZoomPanFrame @ref="_zoomPanFrame"
                      Enabled="PanZoomEnabled"
                      ShowControls="false"
                      AriaLabel="@($"{ResolvedAriaLabel} viewport")"
                      ResetKey="@BuildRenderKey()"
                      Style="block-size: 100%; --cda-zoom-pan-min-height: var(--cda-mermaid-min-height, 22rem);">
            <div class="cda-mermaid__viewport"
                 @ref="_diagramElement"
                 role="img"
                 aria-label="@ResolvedAriaLabel"
                 data-testid="mermaid-diagram-viewport"></div>
        </ZoomPanFrame>

        @if (_isRendering)
        {
            <div class="cda-mermaid__state">Rendering diagram...</div>
        }
        else if (!HasSource)
        {
            <div class="cda-mermaid__state">No Mermaid source provided.</div>
        }
    </div>

    @if (_currentError is not null)
    {
        <div class="cda-mermaid__error" role="alert" data-testid="mermaid-error">
            <strong>Mermaid syntax error</strong>
            <p>@_currentError.Message</p>
            <p>@_currentError.LocationText</p>
            @if (!string.IsNullOrWhiteSpace(_currentError.Excerpt))
            {
                <pre>@_currentError.Excerpt</pre>
            }
            @if (!string.IsNullOrWhiteSpace(_currentError.Token) || !string.IsNullOrWhiteSpace(_currentError.Text))
            {
                <p>Token: @(_currentError.Token ?? _currentError.Text)</p>
            }
            @if (_currentError.ExpectedTokens.Count > 0)
            {
                <p>Expected: @string.Join(", ", _currentError.ExpectedTokens.Take(8))</p>
            }
        </div>
    }
</div>

@code {
    private static readonly JsonSerializerOptions KeySerializerOptions = new(JsonSerializerDefaults.Web);

    private readonly string _instanceId = $"cda-mermaid-{Guid.NewGuid():N}";
    private readonly SemaphoreSlim _lifecycleGate = new(1, 1);
    private ElementReference _diagramElement;
    private ZoomPanFrame? _zoomPanFrame;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MermaidDiagram>? _dotNetReference;
    private string? _lastRenderKey;
    private MermaidRenderError? _currentError;
    private bool _isRendering;
    private bool _renderingStateWasRendered;
    private bool _disposed;
    private string NormalizedSource => MermaidSourceNormalizer.Normalize(Source);

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Source { get; set; }

    [Parameter]
    public MermaidDiagramOptions Options { get; set; } = new();

    [Parameter]
    public bool PanZoomEnabled { get; set; } = true;

    [Parameter]
    public bool ShowControls { get; set; } = true;

    [Parameter]
    public EventCallback<MermaidNodeClickEventArgs> NodeClicked { get; set; }

    [Parameter]
    public EventCallback<MermaidRenderResult> Rendered { get; set; }

    [Parameter]
    public EventCallback<MermaidRenderError> Error { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasSource => !string.IsNullOrWhiteSpace(NormalizedSource);

    private string ResolvedAriaLabel => !string.IsNullOrWhiteSpace(Title)
        ? Title
        : "Mermaid diagram";

    private string RootClass => string.Join(
        ' ',
        new[]
        {
            "cda-mermaid",
            _currentError is null ? null : "has-error",
            Class
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        if (_isRendering)
        {
            _renderingStateWasRendered = true;
            return;
        }

        await _lifecycleGate.WaitAsync();
        try
        {
            if (_disposed)
            {
                return;
            }

            if (firstRender)
            {
                var importedModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/CanDoItAll.Components.Mermaid/js/mermaidDiagram.js");
                if (_disposed)
                {
                    await DisposeModuleAsync(importedModule);
                    return;
                }

                _module = importedModule;
                _dotNetReference = DotNetObjectReference.Create(this);
            }

            var renderKey = BuildRenderKey();
            if (_module is not null && await ShouldRenderDiagramAsync(renderKey) && !_disposed)
            {
                await RenderAsync(renderKey);
            }
        }
        finally
        {
            _lifecycleGate.Release();
        }
    }

    [JSInvokable]
    public async Task HandleNodeClickedAsync(MermaidNodeClickEventArgs args)
    {
        await _lifecycleGate.WaitAsync();
        try
        {
            if (_disposed)
            {
                return;
            }

            args.DiagramId ??= _instanceId;
            await NodeClicked.InvokeAsync(args);
        }
        finally
        {
            _lifecycleGate.Release();
        }
    }

    private async Task RenderAsync(string renderKey)
    {
        if (_module is null || _dotNetReference is null)
        {
            return;
        }

        var hadError = _currentError is not null;
        _isRendering = true;
        _renderingStateWasRendered = false;
        _currentError = null;

        try
        {
            var result = await _module.InvokeAsync<MermaidRenderResult>(
                "render",
                _diagramElement,
                _dotNetReference,
                new
                {
                    diagramId = _instanceId,
                    source = NormalizedSource,
                    options = Options
                });

            if (_disposed)
            {
                return;
            }

            _lastRenderKey = renderKey;
            if (result is null)
            {
                return;
            }

            _currentError = result.Error;

            if (result.Succeeded)
            {
                if (PanZoomEnabled && _zoomPanFrame is not null)
                {
                    await _zoomPanFrame.ResetAsync();
                }

                if (_disposed)
                {
                    return;
                }

                await Rendered.InvokeAsync(result);
            }
            else if (result.Error is not null)
            {
                await Error.InvokeAsync(result.Error);
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            if (_disposed)
            {
                return;
            }

            _lastRenderKey = renderKey;
            _currentError = new MermaidRenderError
            {
                Message = ex.Message
            };
            await Error.InvokeAsync(_currentError);
        }
        finally
        {
            _isRendering = false;
            var renderingStateWasRendered = _renderingStateWasRendered;
            _renderingStateWasRendered = false;
            if (!_disposed && (renderingStateWasRendered || _currentError is not null || hadError))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private string BuildRenderKey()
    {
        return JsonSerializer.Serialize(
            new
            {
                Source = NormalizedSource,
                Options
            },
            KeySerializerOptions);
    }

    private async Task<bool> ShouldRenderDiagramAsync(string renderKey)
    {
        if (!string.Equals(renderKey, _lastRenderKey, StringComparison.Ordinal))
        {
            return true;
        }

        if (!HasSource || _currentError is not null)
        {
            return false;
        }

        try
        {
            return !await _module!.InvokeAsync<bool>("hasRenderedSvg", _diagramElement);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            return true;
        }
    }

    private async Task ZoomInAsync()
    {
        if (_zoomPanFrame is not null)
        {
            await _zoomPanFrame.ZoomInAsync();
        }
    }

    private async Task ZoomOutAsync()
    {
        if (_zoomPanFrame is not null)
        {
            await _zoomPanFrame.ZoomOutAsync();
        }
    }

    private async Task ResetViewAsync()
    {
        if (_zoomPanFrame is not null)
        {
            await _zoomPanFrame.ResetAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _lifecycleGate.WaitAsync();
        try
        {
            await DisposeInteropAsync();
        }
        finally
        {
            _lifecycleGate.Release();
        }
    }

    private async ValueTask DisposeInteropAsync()
    {
        var currentModule = _module;
        var currentDotNetReference = _dotNetReference;
        _module = null;
        _dotNetReference = null;

        try
        {
            if (currentModule is null)
            {
                return;
            }

            try
            {
                await currentModule.InvokeVoidAsync("destroy", _diagramElement);
            }
            catch (Exception exception) when (IsLifecycleException(exception))
            {
            }
            finally
            {
                await DisposeModuleAsync(currentModule);
            }
        }
        finally
        {
            currentDotNetReference?.Dispose();
        }
    }

    private static async ValueTask DisposeModuleAsync(IJSObjectReference currentModule)
    {
        try
        {
            await currentModule.DisposeAsync();
        }
        catch (Exception exception) when (IsLifecycleException(exception))
        {
        }
    }

    private static bool IsLifecycleException(Exception exception)
        => exception is JSDisconnectedException
            or InvalidOperationException
            or ObjectDisposedException;
}
