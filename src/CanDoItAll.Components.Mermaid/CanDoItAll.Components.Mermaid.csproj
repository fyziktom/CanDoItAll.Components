<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CanDoItAll.Components.Mermaid</AssemblyName>
    <RootNamespace>CanDoItAll.Components.Mermaid</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Blazor Mermaid diagram rendering with typed events, error handling, pan and zoom controls, and packaged browser assets.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MermaidVendor.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE.mermaid" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

</Project>
