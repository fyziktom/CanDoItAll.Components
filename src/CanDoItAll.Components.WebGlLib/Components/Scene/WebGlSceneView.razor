@namespace CanDoItAll.Components.WebGlLib
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="wgl-scene-shell"
     data-testid="webgl-scene-shell"
     data-webgl-scene-id="@Scene.SceneId">
    <div @ref="host"
         class="wgl-scene-host"
         data-testid="webgl-scene-host"
         tabindex="0"
         aria-label="@AriaLabel">
    </div>
</div>

@code {
    private ElementReference host;
    private DotNetObjectReference<WebGlSceneView>? objectReference;
    private string? pendingSceneKey;
    private string? appliedSceneKey;
    private string? externalImportSceneKey;
    private string? externalImportReplacedParameterKey;
    private string? externalImportReplacedSceneId;

    [Parameter, EditorRequired]
    public WebGlSceneModel Scene { get; set; } = default!;

    [Parameter]
    public WebGlRuntimeOptions Options { get; set; } = new();

    [Parameter]
    public string AriaLabel { get; set; } = "WebGL scene";

    [Parameter]
    public EventCallback<WebGlSceneSelectionChangedEventArgs> SelectionChanged { get; set; }

    [Parameter]
    public EventCallback<WebGlSceneHoverChangedEventArgs> HoverChanged { get; set; }

    [Parameter]
    public EventCallback<WebGlObjectMovedEventArgs> ObjectsMoved { get; set; }

    [Parameter]
    public EventCallback<string> StateChanged { get; set; }

    [Parameter]
    public EventCallback<WebGlRuntimeReadyEventArgs> RuntimeReady { get; set; }

    [Parameter]
    public EventCallback<WebGlRuntimeErrorEventArgs> RuntimeError { get; set; }

    [Parameter]
    public EventCallback<WebGlSceneCommandResult> MotionCompleted { get; set; }

    [Parameter]
    public EventCallback<WebGlSceneCommandResult> CommandCompleted { get; set; }

    [Parameter]
    public EventCallback<WebGlSceneCommandResult> CommandFailed { get; set; }

    protected override void OnParametersSet()
    {
        string parameterSceneKey = CreateSceneLifecycleKey(Scene, Options);
        if (ShouldKeepExternalImport(parameterSceneKey, Scene.SceneId))
        {
            pendingSceneKey = externalImportSceneKey;
            return;
        }

        if (!string.Equals(parameterSceneKey, externalImportSceneKey, StringComparison.Ordinal))
        {
            ClearExternalImportLifecycle();
        }

        pendingSceneKey = parameterSceneKey;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        objectReference ??= DotNetObjectReference.Create(this);

        try
        {
            if (string.IsNullOrWhiteSpace(appliedSceneKey))
            {
                var created = await JsRuntime.InvokeAsync<bool>(
                    "CanDoItAll.webglScene.create",
                    host,
                    objectReference,
                    Scene,
                    Options);

                if (created)
                {
                    appliedSceneKey = pendingSceneKey;
                    return;
                }

                await RuntimeError.InvokeAsync(new WebGlRuntimeErrorEventArgs(Scene.SceneId, "WebGL scene create failed.", "The JavaScript runtime returned false during scene creation."));
                return;
            }

            if (string.Equals(appliedSceneKey, pendingSceneKey, StringComparison.Ordinal))
            {
                return;
            }

            var updated = await JsRuntime.InvokeAsync<bool>(
                "CanDoItAll.webglScene.update",
                host,
                Scene,
                Options);

            if (updated)
            {
                appliedSceneKey = pendingSceneKey;
                ClearExternalImportLifecycle();
            }
        }
        catch (JSException ex)
        {
            await RuntimeError.InvokeAsync(new WebGlRuntimeErrorEventArgs(Scene.SceneId, "WebGL scene interop failed.", ex.Message));
        }
    }

    [JSInvokable]
    public Task OnSceneSelectionChanged(string eventJson)
    {
        var args = Deserialize<WebGlSceneSelectionChangedEventArgs>(eventJson);
        return args is null ? Task.CompletedTask : SelectionChanged.InvokeAsync(args);
    }

    [JSInvokable]
    public Task OnSceneHoverChanged(string eventJson)
    {
        var args = Deserialize<WebGlSceneHoverChangedEventArgs>(eventJson);
        return args is null ? Task.CompletedTask : HoverChanged.InvokeAsync(args);
    }

    [JSInvokable]
    public Task OnObjectsMoved(string eventJson)
    {
        var args = Deserialize<WebGlObjectMovedEventArgs>(eventJson);
        return args is null ? Task.CompletedTask : ObjectsMoved.InvokeAsync(args);
    }

    [JSInvokable]
    public Task OnSceneStateChanged(string stateJson)
        => StateChanged.InvokeAsync(stateJson);

    [JSInvokable]
    public Task OnRuntimeReady(string eventJson)
    {
        var args = Deserialize<WebGlRuntimeReadyEventArgs>(eventJson);
        return args is null ? Task.CompletedTask : RuntimeReady.InvokeAsync(args);
    }

    [JSInvokable]
    public Task OnRuntimeError(string eventJson)
    {
        var args = Deserialize<WebGlRuntimeErrorEventArgs>(eventJson);
        return args is null ? Task.CompletedTask : RuntimeError.InvokeAsync(args);
    }

    [JSInvokable]
    public Task OnMotionCompleted(string eventJson)
    {
        var args = Deserialize<WebGlSceneCommandResult>(eventJson);
        return args is null ? Task.CompletedTask : MotionCompleted.InvokeAsync(args);
    }

    [JSInvokable]
    public Task OnCommandCompleted(string eventJson)
    {
        var args = Deserialize<WebGlSceneCommandResult>(eventJson);
        return args is null ? Task.CompletedTask : CommandCompleted.InvokeAsync(args);
    }

    [JSInvokable]
    public Task OnCommandFailed(string eventJson)
    {
        var args = Deserialize<WebGlSceneCommandResult>(eventJson);
        return args is null ? Task.CompletedTask : CommandFailed.InvokeAsync(args);
    }

    public async ValueTask DisposeAsync()
    {
        if (string.IsNullOrWhiteSpace(appliedSceneKey))
        {
            objectReference?.Dispose();
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("CanDoItAll.webglScene.dispose", host);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        objectReference?.Dispose();
    }

}
