@namespace CanDoItAll.Components.CanvasLib
@implements IAsyncDisposable
@using CanDoItAll.Components.CanvasLib
@inject IJSRuntime JsRuntime

<CanvasBoundaryCard TestHookId="@Snapshot.TestHookId"
                           Label="@Snapshot.Label"
                           Title="@Snapshot.Title"
                           Summary="@Snapshot.Summary"
                           StatePill="@Snapshot.StatePill"
                           Metrics="@Snapshot.Metrics">
    <div class="space-y-3" @ref="host">
        <div class="flex items-center justify-between gap-3 rounded-[1.4rem] border border-chrome-200 bg-chrome-50/85 px-4 py-3">
            <strong class="text-sm text-chrome-950">@Snapshot.MonthLabel</strong>
            <span class="rounded-full bg-chrome-100 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-chrome-600">Jump to date</span>
        </div>
        <div class="grid grid-cols-7 gap-2 rounded-[1.4rem] border border-chrome-200 bg-chrome-50/85 p-3">
            @foreach (var day in Snapshot.Days)
            {
                var classes = day.IsSelected
                    ? "bg-chrome-900 text-chrome-50"
                    : day.HasEvents
                        ? "bg-sky-100 text-sky-800"
                        : day.IsCurrentMonth
                            ? "bg-chrome-50 text-chrome-700"
                            : "bg-chrome-50/60 text-chrome-400";

                <div class="flex aspect-square items-center justify-center rounded-xl text-sm font-semibold @classes">
                    @day.DayLabel
                </div>
            }
        </div>
    </div>
</CanvasBoundaryCard>

@code {
    private readonly CanvasSceneHost sceneHost = new();
    private ElementReference host;
    private string? pendingSnapshotKey;

    /// <summary>The visible month, selected day, and marker data rendered by this boundary card.</summary>
    [Parameter, EditorRequired]
    public CalendarMiniMonthNavigatorSnapshot Snapshot { get; set; } = default!;

    protected override void OnParametersSet()
    {
        pendingSnapshotKey = SerializationPersistencePack.Serialize(Snapshot);
        sceneHost.QueueSync(
            pendingSnapshotKey,
            !string.Equals(sceneHost.AppliedStateKey, pendingSnapshotKey, StringComparison.Ordinal));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var bridge = new JsInteropBridge(JsRuntime);
        if (sceneHost.ShouldCreate())
        {
            await bridge.InvokeVoidAsync("CanDoItAll.calendarMiniMonthNavigator.create", host, Snapshot);
            sceneHost.MarkApplied();
            return;
        }

        if (!sceneHost.ShouldUpdate())
        {
            return;
        }

        await bridge.InvokeVoidAsync("CanDoItAll.calendarMiniMonthNavigator.update", host, Snapshot);
        sceneHost.MarkApplied();
    }

    public async ValueTask DisposeAsync()
    {
        if (!sceneHost.IsInitialized)
        {
            return;
        }

        try
        {
            await new JsInteropBridge(JsRuntime).InvokeVoidAsync("CanDoItAll.calendarMiniMonthNavigator.dispose", host);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}


