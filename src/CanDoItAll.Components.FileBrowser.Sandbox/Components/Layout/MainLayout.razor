@inherits LayoutComponentBase
@implements IDisposable
@inject SandboxThemeState ThemeState

<ThemeHost ThemeKey="@ThemeState.ThemeKey">
    <Layout FitViewport="true" LockOverflow="true">
        <Body FillHeight="true" Scrollable="false">
            @Body
        </Body>
    </Layout>
    <DialogHost />
    <Tooltip />
    <Notification />
</ThemeHost>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x2715;</span>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeState.Changed += HandleThemeChanged;
    }

    private async void HandleThemeChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    public void Dispose()
    {
        ThemeState.Changed -= HandleThemeChanged;
    }
}
