@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject SandboxThemeState ThemeState
@using CanDoItAll.Components.FileBrowser.Sandbox.Providers

<PageTitle>File Browser Lab · CanDoItAll</PageTitle>

<div class="file-browser-sandbox">
    <PageScaffold Mode="PageScaffoldMode.FocusWorkbench" FillHeight="true" MaxWidthClass="max-w-full">
        <Header>
            <header class="file-browser-sandbox__header">
                <div class="file-browser-sandbox__brand">
                    <span class="file-browser-sandbox__mark" aria-hidden="true"><Icon Name="folder_copy" /></span>
                    <div>
                        <h1 class="file-browser-sandbox__title">File Browser Lab</h1>
                        <p class="file-browser-sandbox__subtitle">Provider-neutral lazy hierarchy · BaseLib renderer · Canvas-ready core</p>
                    </div>
                </div>

                <div class="file-browser-sandbox__header-actions">
                    <StatusBadge Text="Shallow paging" Tone="success" />
                    <StatusBadge Text="@($"{TotalDemoRequestCount} mock calls")" Tone="neutral" Class="file-browser-sandbox__optional-badge" />
                    <TooltipTarget Text="@(ThemeState.IsDark ? "Use light theme" : "Use dark theme")">
                        <Button Icon="@(ThemeState.IsDark ? "light_mode" : "dark_mode")"
                                ButtonStyle="ButtonStyle.Light"
                                Variant="Variant.Outlined"
                                Size="ButtonSize.Small"
                                Click="ThemeState.Toggle"
                                aria-label="@(ThemeState.IsDark ? "Use light theme" : "Use dark theme")"
                                data-testid="toggle-theme" />
                    </TooltipTarget>
                    <Button Text="@(compactFrame ? "Full workspace" : "Compact frame")"
                            Icon="aspect_ratio"
                            ButtonStyle="ButtonStyle.Light"
                            Variant="Variant.Outlined"
                            Size="ButtonSize.Small"
                            Click="ToggleFrame"
                            data-testid="toggle-compact-frame" />
                </div>
            </header>
        </Header>

        <ChildContent>
            @if (session is not null && snapshot is not null)
            {
                <div class="file-browser-sandbox__workspace">
                    <div class="explorer-shell @(compactFrame ? "explorer-shell--compact" : null)"
                         data-testid="file-browser-sandbox-shell">
                        <aside class="explorer-shell__rail">
                            <FileBrowserSourceNavigation Snapshot="@snapshot"
                                                         Title="Browse"
                                                         SourceChanged="ChangeSourceAsync" />

                            <section class="architecture-proof" aria-labelledby="architecture-proof-title">
                                <span class="architecture-proof__eyebrow">Architecture proof</span>
                                <h2 id="architecture-proof-title">One UI, different source semantics</h2>
                                <ul>
                                    <li><Icon Name="layers" /><span>Folder pages load on demand</span></li>
                                    <li><Icon Name="fingerprint" /><span>Occurrence keys stay separate from CIDs</span></li>
                                    <li><Icon Name="travel_explore" /><span>Search scope selects a strategy</span></li>
                                    <li><Icon Name="memory" /><span>Loaded state uses bounded retention</span></li>
                                </ul>
                            </section>
                        </aside>

                        <main class="explorer-shell__main">
                            <div class="explorer-shell__source-picker">
                                <label for="sandbox-source-picker"><Icon Name="source" /> Source</label>
                                <DropDown TValue="string"
                                          Id="sandbox-source-picker"
                                          Data="@MobileSourceChoices"
                                          TextProperty="Text"
                                          ValueProperty="Value"
                                          Value="@snapshot.CurrentSource?.Id.Value"
                                          ValueChanged="ChangeSourceByValueAsync"
                                          Disabled="@snapshot.IsBusy"
                                          aria-label="File source"
                                          data-testid="mobile-source-picker" />
                            </div>

                            <div class="explorer-context">
                                <div class="explorer-context__copy">
                                    <span class="explorer-context__eyebrow">@snapshot.CurrentSource?.DisplayName</span>
                                    <strong>@(snapshot.CurrentContainer?.Name ?? "Preparing source")</strong>
                                    <span>@(snapshot.CurrentSource?.Description ?? "Resolving the selected provider")</span>
                                </div>
                                <div class="explorer-context__telemetry" aria-label="Loaded state telemetry">
                                    <span><strong>@snapshot.Diagnostics.CachedContainerQueryCount</strong> @(snapshot.Diagnostics.CachedContainerQueryCount == 1 ? "folder" : "folders") cached</span>
                                    <span><strong>@snapshot.Diagnostics.CachedItemCount</strong> @(snapshot.Diagnostics.CachedItemCount == 1 ? "item" : "items") retained</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(activityMessage))
                            {
                                <div class="explorer-activity" role="status" data-testid="sandbox-activity">
                                    <Icon Name="info" />
                                    <span>@activityMessage</span>
                                    <button type="button" aria-label="Dismiss status" @onclick="ClearActivity">×</button>
                                </div>
                            }

                            <div class="explorer-shell__browser">
                                <FileBrowser Session="@session"
                                             InitialSourceId="@ProjectsSourceId"
                                             SnapshotChanged="HandleSnapshotChanged"
                                             ItemInvoked="HandleItemInvokedAsync"
                                             ActionRequested="HandleActionRequestedAsync"
                                             AriaLabel="CanDoItAll project and resource browser" />
                            </div>
                        </main>
                    </div>
                </div>
            }
        </ChildContent>
    </PageScaffold>
</div>

@code {
    private static readonly FileBrowserSourceId ProjectsSourceId = new("projects");
    private InMemoryFileBrowserProvider? projectsProvider;
    private InMemoryFileBrowserProvider? ipfsProvider;
    private IFileBrowserSession? session;
    private FileBrowserSnapshot? snapshot;
    private string? activityMessage;
    private bool compactFrame;

    private int TotalDemoRequestCount
        => (projectsProvider?.RequestCount ?? 0) + (ipfsProvider?.RequestCount ?? 0);

    private IReadOnlyList<FileBrowserChoice<string>> MobileSourceChoices
        => snapshot?.Sources
            .Select(source => new FileBrowserChoice<string>(source.DisplayName, source.Id.Value))
            .ToArray() ?? [];

    protected override void OnInitialized()
    {
        projectsProvider = DemoFileBrowserSources.CreateProjects();
        ipfsProvider = DemoFileBrowserSources.CreateIpfs();
        var repositoryRoot = FindRepositoryRoot(HostEnvironment.ContentRootPath);
        var workspaceProvider = new FileSystemFileBrowserProvider(
            new FileSystemFileBrowserOptions(
                new FileBrowserSourceId("workspace"),
                repositoryRoot,
                displayName: "Workspace files",
                includeHidden: false,
                followDirectoryReparsePoints: false,
                recommendedPageSize: 8,
                maximumPageSize: 100));
        var recoveryProvider = DemoFileBrowserSources.CreateRecoveryDemo();

        session = new FileBrowserSession(
            [projectsProvider, ipfsProvider, workspaceProvider, recoveryProvider],
            new FileBrowserSessionOptions(
                pageSize: 8,
                cache: new FileBrowserTreeStoreOptions(maximumContainers: 32, maximumItems: 500)));
        snapshot = session.Snapshot;
    }

    private Task HandleSnapshotChanged(FileBrowserSnapshot value)
    {
        snapshot = value;
        return Task.CompletedTask;
    }

    private async Task ChangeSourceAsync(FileBrowserSourceId sourceId)
    {
        if (session!.Snapshot.IsBusy || session.Snapshot.CurrentSource?.Id == sourceId)
        {
            return;
        }

        activityMessage = null;
        await session.ChangeSourceAsync(sourceId);
    }

    private Task ChangeSourceByValueAsync(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? Task.CompletedTask
            : ChangeSourceAsync(new FileBrowserSourceId(value));

    private Task HandleItemInvokedAsync(FileBrowserItemInvokedEventArgs args)
    {
        activityMessage = $"Preview requested for {args.Item.Name}. The host owns preview and editor routing.";
        return Task.CompletedTask;
    }

    private async Task HandleActionRequestedAsync(FileBrowserItemActionEventArgs args)
    {
        var result = await session!.ExecuteActionAsync(new FileBrowserActionRequest(args.Item.Key, args.ActionId));
        if (!result.Succeeded)
        {
            activityMessage = result.Error?.Message ?? result.Message ?? "The requested action could not be completed.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(result.Value))
        {
            try
            {
                await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", result.Value);
                activityMessage = result.Message ?? $"Copied value for {args.Item.Name}.";
            }
            catch (JSException)
            {
                activityMessage = "Clipboard access was denied by the browser. Use the inline copy action or grant clipboard permission.";
            }

            return;
        }

        if (!string.IsNullOrWhiteSpace(result.NavigationUri)
            && args.ActionId == FileBrowserActionIds.OpenInNewTab)
        {
            try
            {
                await JavaScript.InvokeVoidAsync("open", result.NavigationUri, "_blank", "noopener,noreferrer");
            }
            catch (JSException)
            {
                activityMessage = "The browser blocked the new tab. Allow popups and try again.";
                return;
            }
        }

        activityMessage = result.Message ?? $"Action '{args.ActionId}' completed for {args.Item.Name}.";
    }

    private void ToggleFrame() => compactFrame = !compactFrame;

    private void ClearActivity() => activityMessage = null;

    private static string FindRepositoryRoot(string startingPath)
    {
        foreach (var candidate in new[] { startingPath, Directory.GetCurrentDirectory(), AppContext.BaseDirectory })
        {
            var current = new DirectoryInfo(Path.GetFullPath(candidate));
            while (current is not null)
            {
                if (File.Exists(Path.Combine(current.FullName, "CanDoItAll.Components.slnx")))
                {
                    return current.FullName;
                }

                current = current.Parent;
            }
        }

        return Path.GetFullPath(startingPath);
    }

    public async ValueTask DisposeAsync()
    {
        if (session is not null)
        {
            await session.DisposeAsync();
        }
    }
}
