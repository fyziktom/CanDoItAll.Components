@namespace CanDoItAll.Components.QRCode.Components
@inject DialogService DialogService

<PageHeaderActionButton Icon="@Icon"
                        Label="@Label"
                        TooltipText="@TooltipText"
                        ButtonStyle="@ButtonStyle"
                        Variant="@Variant"
                        Size="@Size"
                        Disabled="@Disabled"
                        Click="@OpenDialogAsync"
                        TestId="@TestId" />

@code {
    [Parameter, EditorRequired]
    public QrCodePayload Payload { get; set; } = new(string.Empty);

    [Parameter]
    public string Icon { get; set; } = "qr_code_2";

    [Parameter]
    public string Label { get; set; } = "Show QR code";

    [Parameter]
    public string? TooltipText { get; set; }

    [Parameter]
    public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Light;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Small;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "cda-qr-code-button";

    private Task OpenDialogAsync()
    {
        if (Payload.IsEmpty)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<QrCodeDialogContent>(
            Payload.DisplayLabel,
            new Dictionary<string, object?>
            {
                [nameof(QrCodeDialogContent.Payload)] = Payload
            },
            new DialogOptions
            {
                Size = ModalSize.Medium,
                DenseChrome = true,
                TestId = "cda-qr-code-dialog"
            });
    }
}
