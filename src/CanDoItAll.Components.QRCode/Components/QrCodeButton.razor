@namespace CanDoItAll.Components.QRCode.Components
@inject DialogService DialogService

<PageHeaderActionButton Icon="@Icon"
                        Label="@Label"
                        TooltipText="@TooltipText"
                        Tone="@Tone"
                        Variant="@Variant"
                        Size="@Size"
                        Disabled="@Disabled"
                        Click="@OpenDialogAsync"
                        TestId="@TestId" />

@code {
    /// <summary>The payload shown in the dialog when opened. An empty payload disables the click handler.</summary>
    [Parameter, EditorRequired]
    public QrCodePayload Payload { get; set; } = new(string.Empty);

    /// <summary>Material icon token rendered on the button.</summary>
    [Parameter]
    public string Icon { get; set; } = "qr_code_2";

    /// <summary>Visible label and dialog title.</summary>
    [Parameter]
    public string Label { get; set; } = "Show QR code";

    /// <summary>Optional tooltip text shown on hover.</summary>
    [Parameter]
    public string? TooltipText { get; set; }

    /// <summary>Semantic tone of the trigger button.</summary>
    [Parameter]
    public ButtonTone Tone { get; set; } = ButtonTone.Default;

    /// <summary>Emphasis treatment of the trigger button.</summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    /// <summary>Control height and padding scale of the trigger button.</summary>
    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Small;

    /// <summary>Blocks interaction with the trigger button.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Value applied to <c>data-testid</c> on the trigger button, for test targeting.</summary>
    [Parameter]
    public string? TestId { get; set; } = "cda-qr-code-button";

    private Task OpenDialogAsync()
    {
        if (Payload.IsEmpty)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<QrCodeDialogContent>(
            Payload.DisplayLabel,
            new Dictionary<string, object?>
            {
                [nameof(QrCodeDialogContent.Payload)] = Payload
            },
            new DialogOptions
            {
                Size = ModalSize.Medium,
                DenseChrome = true,
                TestId = "cda-qr-code-dialog"
            });
    }
}
