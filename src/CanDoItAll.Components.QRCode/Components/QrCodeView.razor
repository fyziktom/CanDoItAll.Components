@namespace CanDoItAll.Components.QRCode.Components
@inject IQrCodeRenderer Renderer

<figure class="@ResolveClass()" data-testid="@TestId">
    @if (string.IsNullOrWhiteSpace(Payload))
    {
        <div class="cda-qr-view__empty" role="status">No QR payload</div>
    }
    else if (!string.IsNullOrWhiteSpace(renderError))
    {
        <div class="cda-qr-view__empty" role="alert">Unable to render QR code: @renderError</div>
    }
    else
    {
        <div class="cda-qr-view__svg" role="img" aria-label="@AriaLabel">
            @((MarkupString)renderedSvg!)
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Caption))
    {
        <figcaption>@Caption</figcaption>
    }
</figure>

@code {
    private string? renderedSvg;
    private string? renderError;

    [Parameter, EditorRequired]
    public string Payload { get; set; } = string.Empty;

    [Parameter]
    public string? Caption { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "QR code";

    [Parameter]
    public QrCodeRenderOptions? Options { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "cda-qr-code-view";

    protected override void OnParametersSet()
    {
        renderedSvg = null;
        renderError = null;

        if (string.IsNullOrWhiteSpace(Payload))
        {
            return;
        }

        try
        {
            renderedSvg = Renderer.RenderSvg(Payload, Options);
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            renderError = exception.Message;
        }
    }

    private string ResolveClass()
        => string.Join(" ", new[] { "cda-qr-view", Class }.Where(static value => !string.IsNullOrWhiteSpace(value)));
}
