    <AssemblyName>CanDoItAll.Components.BaseLib</AssemblyName>
    <RootNamespace>CanDoItAll.Components.BaseLib</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Reusable Tailwind-styled Blazor components for forms, navigation, layout, feedback, dialogs, and product application shells.</Description>
