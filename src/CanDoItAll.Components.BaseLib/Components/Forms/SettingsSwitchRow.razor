@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes("flex items-center justify-between gap-3 rounded-xl border border-chrome-200 bg-white px-4 py-3")'>
    @ChildContent
</div>

@code {
    /// <summary>The row's content, typically a <see cref="SettingsSwitchLabel"/> and a <see cref="Switch"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
