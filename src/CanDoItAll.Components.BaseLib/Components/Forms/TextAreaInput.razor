@namespace CanDoItAll.Components.BaseLib
@inherits StyledInputBase<string?>
@using System.Diagnostics.CodeAnalysis

@if (Immediate) {
    <textarea @attributes='BuildAttributes(CssClassBuilder.Join(ResolveCssClass(), ResolveDensityCssClass("ui-input")))'
              aria-labelledby="@ResolveLabelledBy()"
              readonly="@ReadOnly"
              disabled="@Disabled"
              rows="@ResolveRows()"
              @bind:get="displayedValue" @bind:set="OnChangedAsync" @bind:event="oninput"></textarea>
} else {
    <textarea @attributes='BuildAttributes(CssClassBuilder.Join(ResolveCssClass(), ResolveDensityCssClass("ui-input")))'
              aria-labelledby="@ResolveLabelledBy()"
              readonly="@ReadOnly"
              disabled="@Disabled"
              rows="@ResolveRows()"
              @bind:get="displayedValue" @bind:set="OnChangedAsync" @bind:event="onchange"></textarea>
}

@code {
    private string? displayedValue;
    private string? observedValue;
    private bool initialized;

    [Parameter]
    public bool Immediate { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public int Rows { get; set; }

    [Parameter]
    public TextAreaSize Size { get; set; } = TextAreaSize.Standard;

    [Parameter]
    public EventCallback<string?> Change { get; set; }

    protected override void OnParametersSet() {
        if (!initialized || Value != observedValue) {
            displayedValue = Value;
        }
        observedValue = Value;
        initialized = true;
    }

    private async Task OnChangedAsync(string? next) {
        if (Disabled || ReadOnly) {
            return;
        }

        displayedValue = next;
        await ValueChanged.InvokeAsync(next);
        await Change.InvokeAsync(next);
        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }

    private string ResolveCssClass() => Look switch {
        InputLook.Plain => "form-input",
        InputLook.Filled => "form-input ui-input ui-input--textarea ui-input--filled",
        _ => "form-input ui-input ui-input--textarea ui-input--outlined"
    };

    private int ResolveRows() {
        if (Rows < 0) {
            throw new ArgumentOutOfRangeException(nameof(Rows), Rows, "Text area rows cannot be negative.");
        }
        if (Rows > 0) {
            return Rows;
        }
        return Size switch {
            TextAreaSize.Compact => 3,
            TextAreaSize.Standard => 5,
            TextAreaSize.Extended => 10,
            _ => throw new ArgumentOutOfRangeException(nameof(Size), Size, "Unsupported text area size.")
        };
    }

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string? result, [NotNullWhen(false)] out string? validationErrorMessage) {
        result = value;
        validationErrorMessage = null;
        return true;
    }
}
