@namespace CanDoItAll.Components.BaseLib
@inherits StyledInputBase<string?>
@using System.Diagnostics.CodeAnalysis

<textarea @attributes='BuildAttributes(ResolveCssClass())'
          aria-labelledby="@ResolveLabelledBy()"
          @bind="CurrentValue"></textarea>

@code {
    private string ResolveCssClass()
    {
        return Look switch
        {
            InputLook.Plain => string.Empty,
            InputLook.Filled => "form-input ui-input ui-input--textarea ui-input--filled",
            _ => "form-input ui-input ui-input--textarea ui-input--outlined"
        };
    }

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string? result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }
}
