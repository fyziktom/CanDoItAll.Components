@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

@if (Immediate)
{
    <textarea @attributes='BuildAttributes(ResolveCssClass())'
              aria-labelledby="@ResolveLabelledBy()"
              placeholder="@Placeholder"
              readonly="@ReadOnly"
              disabled="@Disabled"
              rows="@ResolveRows()"
              @oninput="OnChangedAsync">@Value</textarea>
}
else
{
    <textarea @attributes='BuildAttributes(ResolveCssClass())'
              aria-labelledby="@ResolveLabelledBy()"
              placeholder="@Placeholder"
              readonly="@ReadOnly"
              disabled="@Disabled"
              rows="@ResolveRows()"
              @onchange="OnChangedAsync">@Value</textarea>
}

@code {
    /// <summary>The text value.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Raised whenever <see cref="Value"/> changes.</summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Raised after the value changes, with the new value.</summary>
    [Parameter]
    public EventCallback<string?> Change { get; set; }

    /// <summary>Placeholder text shown when <see cref="Value"/> is empty.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>When <c>true</c>, the value is displayed but cannot be edited.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>Explicit row count; overrides the row count derived from <see cref="Size"/> when greater than zero.</summary>
    [Parameter]
    public int Rows { get; set; }

    /// <summary>Preset height, expressed as a row count, used when <see cref="Rows"/> is unset.</summary>
    [Parameter]
    public TextAreaSize Size { get; set; } = TextAreaSize.Standard;

    /// <summary>When <c>true</c>, the textarea cannot be interacted with.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>When <c>true</c>, <see cref="ValueChanged"/>/<see cref="Change"/> fire on every keystroke instead of on blur/commit.</summary>
    [Parameter]
    public bool Immediate { get; set; }

    /// <summary>The visual style applied to the textarea element.</summary>
    [Parameter]
    public InputLook Look { get; set; } = InputLook.Default;

    [CascadingParameter(Name = "FormFieldLabelId")]
    public string? FormFieldLabelId { get; set; }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        if (Disabled || ReadOnly)
        {
            return;
        }

        var next = args.Value?.ToString();
        await ValueChanged.InvokeAsync(next);
        await Change.InvokeAsync(next);
    }

    private string ResolveCssClass()
    {
        return Look switch
        {
            InputLook.Plain => string.Empty,
            _ => "cda-input cda-input--textarea"
        };
    }

    private int ResolveRows()
    {
        if (Rows < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(Rows), Rows, "Text area rows cannot be negative.");
        }

        if (Rows > 0)
        {
            return Rows;
        }

        return Size switch
        {
            TextAreaSize.Compact => 3,
            TextAreaSize.Standard => 5,
            TextAreaSize.Extended => 10,
            _ => throw new ArgumentOutOfRangeException(nameof(Size), Size, "Unsupported text area size.")
        };
    }

    private string? ResolveLabelledBy()
        => HasExplicitAccessibleName() ? null : FormFieldLabelId;

    private bool HasExplicitAccessibleName()
        => AdditionalAttributes is not null
            && AdditionalAttributes.Keys.Any(key =>
                string.Equals(key, "aria-label", StringComparison.OrdinalIgnoreCase)
                || string.Equals(key, "aria-labelledby", StringComparison.OrdinalIgnoreCase));
}







