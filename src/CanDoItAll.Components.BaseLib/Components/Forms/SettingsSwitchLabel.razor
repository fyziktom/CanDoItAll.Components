@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<span @attributes='BuildAttributes("text-sm font-medium text-chrome-700")'>@RenderContent()</span>

@code {
    /// <summary>The label text; ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Custom label content, taking precedence over <see cref="Text"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private RenderFragment RenderContent()
    {
        if (ChildContent is not null)
        {
            return ChildContent;
        }

        return builder => builder.AddContent(0, Text);
    }
}
