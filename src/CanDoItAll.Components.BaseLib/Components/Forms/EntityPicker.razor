@namespace CanDoItAll.Components.BaseLib

<section @attributes='AdditionalAttributes.WithClass("cda-entity-picker")'
         aria-disabled="@FormatBoolean(Disabled)">
    @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description))
    {
        <header class="cda-entity-picker__header">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <h4 id="@titleId">@Title</h4>
            }
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </header>
    }

    @if (Items.Count == 0)
    {
        <div class="cda-entity-picker__empty">@EmptyText</div>
    }
    else
    {
        <div class="cda-entity-picker__list"
             role="listbox"
             aria-label="@ResolvedListAriaLabel"
             aria-labelledby="@ResolvedListLabelledBy">
            @foreach (var item in Items)
            {
                <button type="button"
                        class="@ResolveItemClass(item)"
                        role="option"
                        aria-selected="@FormatBoolean(IsSelected(item))"
                        disabled="@(Disabled || item.Disabled)"
                        @onclick="() => SelectAsync(item)">
                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                    {
                        <span class="material-symbols-rounded" aria-hidden="true">@item.Icon</span>
                    }
                    <span>
                        <strong>@item.Label</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <small>@item.Description</small>
                        }
                    </span>
                    @if (!string.IsNullOrWhiteSpace(item.Meta))
                    {
                        <em>@item.Meta</em>
                    }
                </button>
            }
        </div>
    }
</section>

@code {
    private readonly string titleId = $"cda-entity-picker-{Guid.NewGuid():N}";

    /// <summary>Heading shown above the item list.</summary>
    [Parameter]
    public string Title { get; set; } = "Select item";

    /// <summary>Supporting text shown below <see cref="Title"/>.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>Message shown when <see cref="Items"/> is empty.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "No items are available.";

    /// <summary>The selectable items.</summary>
    [Parameter]
    public IReadOnlyList<EntityPickerItem> Items { get; set; } = [];

    /// <summary>The id of the currently selected item.</summary>
    [Parameter]
    public string? SelectedId { get; set; }

    /// <summary>When <c>true</c>, no item can be selected.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Accessible label for the item list; used only when <see cref="Title"/> is unset.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Raised with the selected item's id whenever the selection changes.</summary>
    [Parameter]
    public EventCallback<string> SelectedIdChanged { get; set; }

    /// <summary>Raised with the selected item whenever the selection changes.</summary>
    [Parameter]
    public EventCallback<EntityPickerItem> Selected { get; set; }

    /// <summary>Additional attributes applied to the picker's root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsSelected(EntityPickerItem item)
        => string.Equals(SelectedId, item.Id, StringComparison.Ordinal);

    private string ResolveItemClass(EntityPickerItem item)
        => IsSelected(item)
            ? "cda-entity-picker__item cda-entity-picker__item--selected"
            : "cda-entity-picker__item";

    private async Task SelectAsync(EntityPickerItem item)
    {
        if (Disabled || item.Disabled)
        {
            return;
        }

        await SelectedIdChanged.InvokeAsync(item.Id);
        await Selected.InvokeAsync(item);
    }

    private string? ResolvedListAriaLabel
        => string.IsNullOrWhiteSpace(Title) ? AriaLabel : null;

    private string? ResolvedListLabelledBy
        => string.IsNullOrWhiteSpace(Title) ? null : titleId;

    private static string FormatBoolean(bool value)
        => value ? "true" : "false";
}
