@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase
@implements IDisposable

<div class="@ResolveRootCssClass()">
    <div class="cda-secret-field__control">
        <input type="@(isRevealed ? "text" : "password")"
               @attributes='BuildAttributes(ResolveInputCssClass())'
               aria-labelledby="@ResolveLabelledBy()"
               value="@Value"
               placeholder="@Placeholder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               autocomplete="@Autocomplete"
               @onchange="OnChangedAsync" />
        @if (EnableTimedReveal)
        {
            <Button Text="@ResolveRevealText()"
                    Icon="@ResolveRevealIcon()"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Small"
                    Class="cda-secret-field__reveal"
                    aria-label="@ResolveRevealAriaLabel()"
                    Disabled="@Disabled"
                    Click="ToggleRevealAsync" />
        }
    </div>
    @if (ShowValueCopy || ShowNameCopy)
    {
        <Cluster Gap="LayoutGap.Tiny"
                 Wrap="FlexWrap.Wrap"
                 Class="cda-secret-field__actions">
            @if (ShowValueCopy)
            {
                <CopyButton Value="@Value"
                            Text="Copy value"
                            AriaLabel="Copy secret value"
                            Size="CopyButtonSize.Small"
                            Disabled="@(Disabled || string.IsNullOrEmpty(Value))" />
            }
            @if (ShowNameCopy)
            {
                <CopyButton Value="@SecretName"
                            Text="Copy name"
                            AriaLabel="Copy secret name"
                            Size="CopyButtonSize.Small"
                            Disabled="@(string.IsNullOrWhiteSpace(SecretName))" />
            }
        </Cluster>
    }
</div>

@code {
    private CancellationTokenSource? revealCts;
    private bool isRevealed;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> Change { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? SecretName { get; set; }

    [Parameter]
    public bool ShowValueCopy { get; set; } = true;

    [Parameter]
    public bool ShowNameCopy { get; set; }

    [Parameter]
    public bool EnableTimedReveal { get; set; } = true;

    [Parameter]
    public int RevealDurationSeconds { get; set; } = 30;

    [Parameter]
    public string Autocomplete { get; set; } = "off";

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public InputLook Look { get; set; } = InputLook.Default;

    [CascadingParameter(Name = "FormFieldLabelId")]
    public string? FormFieldLabelId { get; set; }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        if (Disabled || ReadOnly)
        {
            return;
        }

        var next = args.Value?.ToString();
        await ValueChanged.InvokeAsync(next);
        await Change.InvokeAsync(next);
    }

    private Task ToggleRevealAsync()
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        if (isRevealed)
        {
            HideValue();
            return Task.CompletedTask;
        }

        StartTimedReveal();
        return Task.CompletedTask;
    }

    private void StartTimedReveal()
    {
        CancelRevealTimer();
        var timer = new CancellationTokenSource();
        revealCts = timer;
        isRevealed = true;
        _ = HideAfterDelayAsync(timer);
    }

    private async Task HideAfterDelayAsync(CancellationTokenSource timer)
    {
        try
        {
            var delay = TimeSpan.FromSeconds(Math.Clamp(RevealDurationSeconds, 1, 300));
            await Task.Delay(delay, timer.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ReferenceEquals(revealCts, timer))
        {
            return;
        }

        revealCts = null;
        timer.Dispose();
        isRevealed = false;
        await InvokeAsync(StateHasChanged);
    }

    private void HideValue()
    {
        CancelRevealTimer();
        isRevealed = false;
    }

    private void CancelRevealTimer()
    {
        var timer = revealCts;
        revealCts = null;

        if (timer is null)
        {
            return;
        }

        timer.Cancel();
        timer.Dispose();
    }

    private string ResolveRevealText()
        => isRevealed ? "Hide" : $"Show {Math.Clamp(RevealDurationSeconds, 1, 300)}s";

    private string ResolveRevealAriaLabel()
        => isRevealed
            ? "Hide secret"
            : $"Show secret for {Math.Clamp(RevealDurationSeconds, 1, 300)} seconds";

    private string ResolveRevealIcon()
        => isRevealed ? "visibility_off" : "visibility";

    private string ResolveRootCssClass()
        => BuildClass("cda-secret-field");

    private string ResolveInputCssClass()
    {
        return Look switch
        {
            InputLook.Plain => string.Empty,
            _ => "rz-input min-w-0 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 disabled:cursor-not-allowed disabled:opacity-60"
        };
    }

    private string? ResolveLabelledBy()
        => HasExplicitAccessibleName() ? null : FormFieldLabelId;

    private bool HasExplicitAccessibleName()
        => AdditionalAttributes is not null
            && AdditionalAttributes.Keys.Any(key =>
                string.Equals(key, "aria-label", StringComparison.OrdinalIgnoreCase)
                || string.Equals(key, "aria-labelledby", StringComparison.OrdinalIgnoreCase));

    public void Dispose()
    {
        CancelRevealTimer();
    }
}
