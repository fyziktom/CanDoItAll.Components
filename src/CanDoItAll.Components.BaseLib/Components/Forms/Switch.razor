@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<label @attributes='BuildAttributes("rz-switch inline-flex cursor-pointer items-center gap-2")'>
    <input type="checkbox"
           class="peer sr-only"
           aria-label="@AriaLabel"
           aria-labelledby="@ResolveLabelledBy()"
           checked="@Value"
           disabled="@Disabled"
           @onchange="OnChangedAsync" />
    <span class="h-5 w-9 rounded-full bg-slate-300 transition peer-checked:bg-indigo-500 peer-disabled:opacity-40"></span>
</label>

@code {
    /// <summary>Whether the switch is on.</summary>
    [Parameter]
    public bool Value { get; set; }

    /// <summary>Raised whenever <see cref="Value"/> changes.</summary>
    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>Raised after the value changes, with the new value.</summary>
    [Parameter]
    public EventCallback<bool> Change { get; set; }

    /// <summary>When <c>true</c>, the switch cannot be toggled.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Accessible label for the switch. Takes precedence over <see cref="AriaLabelledBy"/> and the enclosing FormField's label.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Id of an element that labels the switch. Used when <see cref="AriaLabel"/> is unset.</summary>
    [Parameter]
    public string? AriaLabelledBy { get; set; }

    [CascadingParameter(Name = "FormFieldLabelId")]
    public string? FormFieldLabelId { get; set; }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        var next = args.Value is bool boolValue && boolValue;
        await ValueChanged.InvokeAsync(next);
        await Change.InvokeAsync(next);
    }

    private string? ResolveLabelledBy()
        => !string.IsNullOrWhiteSpace(AriaLabel)
            ? null
            : !string.IsNullOrWhiteSpace(AriaLabelledBy)
                ? AriaLabelledBy
                : FormFieldLabelId;
}






