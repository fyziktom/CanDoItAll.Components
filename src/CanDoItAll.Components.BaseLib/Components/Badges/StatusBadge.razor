@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<span @attributes='BuildAttributes(ResolveCssClass(), ResolveBadgeStyle())'>@Text</span>

@code {
    /// <summary>Label rendered inside the badge.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>Tone as a loosely-typed string (<c>"success"</c>, <c>"warning"</c>, <c>"danger"</c>, <c>"info"</c>, <c>"accent"</c>, or any other value for neutral). Ignored when <see cref="TypedTone"/> is set.</summary>
    [Parameter]
    public string Tone { get; set; } = "neutral";

    /// <summary>Tone as a <see cref="BadgeTone"/> enum value. Takes precedence over <see cref="Tone"/> when set.</summary>
    [Parameter]
    public BadgeTone? TypedTone { get; set; }

    /// <summary>Truncates the label to a single line with an ellipsis instead of wrapping.</summary>
    [Parameter]
    public bool NoWrap { get; set; }

    private string ResolveCssClass()
    {
        var resolvedTone = TypedTone switch
        {
            BadgeTone.Success => "success",
            BadgeTone.Warn => "warning",
            BadgeTone.Accent => "info",
            BadgeTone.Info => "info",
            BadgeTone.Promo => "accent",
            BadgeTone.Rank => "accent",
            _ => Tone
        };

        var toneCss = resolvedTone.ToLowerInvariant() switch
        {
            "success" => "cda-status-badge--tone-success",
            "warning" => "cda-status-badge--tone-warning",
            "danger" => "cda-status-badge--tone-danger",
            "info" => "cda-status-badge--tone-info",
            "accent" => "cda-status-badge--tone-secondary",
            _ => "cda-status-badge--tone-base"
        };

        return $"cda-status-badge {toneCss}";
    }

    private string ResolveBadgeStyle()
        => NoWrap
            ? "max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center;"
            : "max-width:100%;white-space:normal;overflow-wrap:anywhere;text-align:center;";
}


