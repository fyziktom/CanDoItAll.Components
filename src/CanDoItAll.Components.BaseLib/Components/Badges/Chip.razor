@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<span @attributes='BuildAttributes("inline-flex max-w-full min-w-0 items-center rounded-2xl border border-slate-200 bg-white px-3 py-1.5 text-left text-xs font-medium leading-5 text-slate-700")'>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
</span>

@code {
    /// <summary>Label rendered inside the chip. Ignored when <see cref="ChildContent"/> is supplied.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Custom chip content. Takes precedence over <see cref="Text"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
