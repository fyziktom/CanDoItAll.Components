@namespace CanDoItAll.Components.BaseLib
@if (Items.Count > 0)
{
    <Stack GapScale="@(Dense ? LayoutGap.Small : LayoutGap.Large)">
        @if (Header is not null)
        {
            <div>
                @Header
            </div>
        }

        <Cluster Gap="LayoutGap.Small">
            @foreach (var item in Items)
            {
                var isSelected = string.Equals(item.Key, SelectedKey, StringComparison.Ordinal);
                <button type="button"
                        class="ui-secondary-tab @(Dense ? "rounded-full border px-3.5 py-1.5 text-sm font-semibold transition" : "rounded-full border px-4 py-2 text-sm font-semibold transition") @(isSelected ? "ui-secondary-tab--selected" : null)"
                        @onclick="() => SelectedKeyChanged.InvokeAsync(item.Key)">
                    <span>@item.Label</span>
                    @if (!string.IsNullOrWhiteSpace(item.Count))
                    {
                        <span class="ui-secondary-tab__count ml-2 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em]">@item.Count</span>
                    }
                </button>
            }
        </Cluster>

        @if (ShowActiveDescription && ActiveItem?.Description is { Length: > 0 } description)
        {
            <p class="@(Dense ? "m-0 text-sm leading-5 text-chrome-600" : "m-0 text-sm leading-6 text-chrome-600")">@description</p>
        }
    </Stack>
}

@code {
    [Parameter]
    public IReadOnlyList<SecondaryTabItem> Items { get; set; } = [];

    [Parameter]
    public string SelectedKey { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedKeyChanged { get; set; }

    [Parameter]
    public RenderFragment? Header { get; set; }

    [Parameter]
    public bool Dense { get; set; }

    [Parameter]
    public bool ShowActiveDescription { get; set; } = true;

    private SecondaryTabItem? ActiveItem => Items.FirstOrDefault(item => string.Equals(item.Key, SelectedKey, StringComparison.Ordinal));
}


