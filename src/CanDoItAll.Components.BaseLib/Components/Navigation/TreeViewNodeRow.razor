@namespace CanDoItAll.Components.BaseLib
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

<li class="cda-treeview__item"
    role="none"
    style="@($"--cda-treeview-level:{Level};")">
    <div class="cda-treeview__row-shell">
        @if (Node.HasChildren)
        {
            <button type="button"
                    class="cda-treeview__toggle"
                    tabindex="-1"
                    title="@(Node.IsExpanded ? "Collapse" : "Expand")"
                    aria-label="@(Node.IsExpanded ? $"Collapse {Node.Text}" : $"Expand {Node.Text}")"
                    @onclick="HandleToggleAsync">
                <Icon Name="@(Node.IsExpanded ? "expand_more" : "chevron_right")" />
            </button>
        }
        else
        {
            <span class="cda-treeview__toggle cda-treeview__toggle--placeholder" aria-hidden="true"></span>
        }

        <TooltipTarget Text="@ResolveTooltipDetails()"
                       Position="@(TooltipPosition.Right)"
                       Duration="@((TimeSpan?)null)"
                       TriggerClass="cda-treeview__tooltip-target">
            <span id="@ResolveElementId()"
                 role="treeitem"
                 class="@ResolveRowCssClass()"
                 data-testid="@ResolveDataTestId()"
                 aria-label="@ResolveAccessibleLabel()"
                 aria-description="@ResolveAccessibleDescription()"
                 aria-disabled="@(Node.IsDisabled ? "true" : null)"
                 aria-level="@(Level + 1)"
                 aria-expanded="@(Node.HasChildren ? Node.IsExpanded.ToString().ToLowerInvariant() : null)"
                 aria-selected="@(Node.IsSelectable ? Node.IsSelected.ToString().ToLowerInvariant() : null)"
                 @onclick="HandleRowClickAsync"
                 @oncontextmenu="HandleContextMenuAsync"
                 @oncontextmenu:preventDefault="true">
                @if (!string.IsNullOrWhiteSpace(Node.Icon))
                {
                    <span class="cda-treeview__icon" aria-hidden="true">
                        <Icon Name="@Node.Icon" />
                    </span>
                }

                <span class="cda-treeview__text">@Node.Text</span>

                @if (!string.IsNullOrWhiteSpace(Node.BadgeText))
                {
                    <span class="cda-treeview__badge" aria-hidden="true">
                        <span class="cda-treeview__badge-full">@Node.BadgeText</span>
                        <span class="cda-treeview__badge-compact">@ResolveCompactBadgeText()</span>
                    </span>
                }
            </span>
        </TooltipTarget>
    </div>

    @if (Node.HasChildren && Node.IsExpanded)
    {
        <ul class="cda-treeview__children"
            role="group"
            data-testid="@ResolveChildrenDataTestId()">
            @foreach (var child in Node.Children)
            {
                <TreeViewNodeRow Node="@child"
                                 Level="@(Level + 1)"
                                 TreeId="@TreeId"
                                 Style="@Style"
                                 ActiveNodeId="@ActiveNodeId"
                                 OnActivate="@OnActivate"
                                 OnSelect="OnSelect"
                                 OnToggle="OnToggle"
                                 OnContextMenu="OnContextMenu" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public TreeViewNode Node { get; set; } = default!;

    [Parameter]
    public int Level { get; set; }

    [Parameter, EditorRequired]
    public string TreeId { get; set; } = string.Empty;

    [Parameter]
    public TreeViewStyle Style { get; set; }

    [Parameter]
    public string? ActiveNodeId { get; set; }

    [Parameter]
    public EventCallback<string> OnActivate { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback<string> OnToggle { get; set; }

    [Parameter]
    public EventCallback<TreeViewNodeContextMenuRequest> OnContextMenu { get; set; }

    private Task HandleToggleAsync()
    {
        if (Node.IsDisabled || !Node.HasChildren)
        {
            return Task.CompletedTask;
        }

        return OnToggle.InvokeAsync(Node.Id);
    }

    private async Task HandleRowClickAsync()
    {
        if (Node.IsDisabled)
        {
            return;
        }

        await OnActivate.InvokeAsync(Node.Id);

        if (Node.HasChildren && !Node.IsSelectable)
        {
            await OnToggle.InvokeAsync(Node.Id);
            return;
        }

        await OnSelect.InvokeAsync(Node.Id);
    }

    private Task HandleContextMenuAsync(MouseEventArgs args)
    {
        if (Node.IsDisabled || !OnContextMenu.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return ActivateAndOpenContextMenuAsync(args);
    }

    private async Task ActivateAndOpenContextMenuAsync(MouseEventArgs args)
    {
        await OnActivate.InvokeAsync(Node.Id);
        await OnContextMenu.InvokeAsync(new TreeViewNodeContextMenuRequest(Node.Id, args.ClientX, args.ClientY));
    }

    private string ResolveRowCssClass()
    {
        var cssClass = "cda-treeview__row";
        if (Style == TreeViewStyle.Workbench)
        {
            cssClass += " cda-treeview__row--workbench";
        }

        if (Node.IsSelected)
        {
            cssClass += " cda-treeview__row--selected";
        }

        if (Node.Id == ActiveNodeId)
        {
            cssClass += " cda-treeview__row--active";
        }

        if (Node.HasChildren)
        {
            cssClass += " cda-treeview__row--branch";
        }

        if (Node.IsDisabled)
        {
            cssClass += " cda-treeview__row--disabled";
        }

        return cssClass;
    }

    private string ResolveTooltipDetails()
    {
        if (!string.IsNullOrWhiteSpace(Node.Tooltip))
        {
            return Node.Tooltip.Trim();
        }

        return string.Join(
            " · ",
            new[] { Node.Text, Node.BadgeText }
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => value.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase));
    }

    private string ResolveAccessibleLabel()
        => string.Join(
            " ",
            new[] { Node.Text, Node.BadgeText }
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => value.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase));

    private string? ResolveAccessibleDescription()
        => string.IsNullOrWhiteSpace(Node.Tooltip)
            ? null
            : Node.Tooltip.Trim();

    private string ResolveCompactBadgeText()
    {
        var badgeText = Node.BadgeText.Trim();
        var textElementIndexes = StringInfo.ParseCombiningCharacters(badgeText);
        return textElementIndexes.Length <= 3
            ? badgeText
            : badgeText[..textElementIndexes[3]] + "...";
    }

    private string? ResolveDataTestId()
    {
        return string.IsNullOrWhiteSpace(Node.DataTestId)
            ? null
            : Node.DataTestId;
    }

    private string? ResolveChildrenDataTestId()
    {
        return string.IsNullOrWhiteSpace(Node.ChildrenDataTestId)
            ? null
            : Node.ChildrenDataTestId;
    }

    private string ResolveElementId()
    {
        return TreeView.ResolveNodeElementId(TreeId, Node.Id);
    }
}
