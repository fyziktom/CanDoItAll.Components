@namespace CanDoItAll.Components.BaseLib
<div class="@(Compact ? "cda-page-header cda-page-header--compact" : "cda-page-header")">
    <div class="cda-page-header__main">
        <div class="@(Compact ? "cda-page-header__copy cda-page-header__copy--compact" : "cda-page-header__copy")">
            <p class="@(Compact ? "cda-page-header__eyebrow cda-page-header__eyebrow--compact" : "cda-page-header__eyebrow")">@Eyebrow</p>
            <h1 class="@(Compact ? "cda-page-header__title cda-page-header__title--compact" : "cda-page-header__title")">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="@(Compact ? "cda-page-header__description cda-page-header__description--compact" : "cda-page-header__description")">@Description</p>
            }
        </div>

        @if (Stats is not null)
        {
            <div class="cda-page-header__stats">
                @Stats
            </div>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="cda-page-header__actions">
            @Actions
        </div>
    }
</div>

@code {
    /// <summary>Small label shown above <see cref="Title"/>.</summary>
    [Parameter]
    public string Eyebrow { get; set; } = "Workspace";

    /// <summary>The page's primary heading.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Supporting text shown below <see cref="Title"/>.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>When <c>true</c>, reduces the header's spacing and type scale for use in constrained panes.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Action buttons rendered on the trailing edge of the header.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Compact stat content rendered alongside the title/description block.</summary>
    [Parameter]
    public RenderFragment? Stats { get; set; }
}

