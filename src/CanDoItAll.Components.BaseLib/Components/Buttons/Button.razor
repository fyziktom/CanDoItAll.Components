@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase
@{
    var iconName = ResolveIconName(Icon);
}

@if (IsAnchor)
{
    <a href="@(IsDisabled ? null : Href)"
       target="@Target"
       rel="@ResolvedRel"
       tabindex="@(IsDisabled ? -1 : null)"
       aria-disabled="@FormatBoolean(IsDisabled)"
       aria-busy="@(IsBusy ? "true" : null)"
       @attributes="BuildAttributes(ResolveButtonCssClass())"
       @onclick="OnClickAsync"
       @onclick:preventDefault="@IsDisabled">
        @RenderButtonContent(iconName)
    </a>
}
else
{
    <button type="@Type"
            disabled="@IsDisabled"
            aria-busy="@(IsBusy ? "true" : null)"
            @attributes="BuildAttributes(ResolveButtonCssClass())"
            @onclick="OnClickAsync">
        @RenderButtonContent(iconName)
    </button>
}

@code {
    /// <summary>Label rendered inside the button. Ignored when <see cref="ChildContent"/> is supplied.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Short badge rendered before the label, for a keyboard hint or count.</summary>
    [Parameter]
    public string? Token { get; set; }

    /// <summary>Custom label content. Takes precedence over <see cref="Text"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Material icon token, for example <c>download</c>. When no label is present the token also supplies the accessible name.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Semantic tone of the action. Reserve <c>Primary</c> for the one action that carries the surface.</summary>
    [Parameter]
    public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Primary;

    /// <summary>Control height and padding scale.</summary>
    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Medium;

    /// <summary>Emphasis treatment: filled, outlined, or text.</summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Filled;

    /// <summary>Tonal shade applied on top of <see cref="ButtonStyle"/>.</summary>
    [Parameter]
    public Shade Shade { get; set; } = Shade.Default;

    /// <summary>Escape hatch to legacy or sheet-card presets. Leave at <c>Default</c> for the standard button language.</summary>
    [Parameter]
    public ButtonLook Look { get; set; } = ButtonLook.Default;

    /// <summary>Blocks interaction. The button is also disabled while busy or while a click is in flight.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Swaps the icon for a spinner and blocks further clicks. Set this for in-flight work rather than disabling manually.</summary>
    [Parameter]
    public bool IsBusy { get; set; }

    /// <summary>Invoked on activation. Re-entrant clicks are suppressed until the handler completes, so the handler may be async without extra guarding.</summary>
    [Parameter]
    public EventCallback Click { get; set; }

    /// <summary>Native button type. Set to <c>submit</c> inside a form.</summary>
    [Parameter]
    public string Type { get; set; } = "button";

    /// <summary>Renders an anchor instead of a button. Presentation is unchanged.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Anchor target. Only meaningful together with <see cref="Href"/>.</summary>
    [Parameter]
    public string? Target { get; set; }

    /// <summary>Anchor rel. Defaults to <c>noopener noreferrer</c> when the target is <c>_blank</c>.</summary>
    [Parameter]
    public string? Rel { get; set; }

    private bool isClickInFlight;

    private bool IsDisabled => Disabled || IsBusy || isClickInFlight;

    private bool IsAnchor => !string.IsNullOrWhiteSpace(Href);

    private string? ResolvedRel => string.Equals(Target, "_blank", StringComparison.OrdinalIgnoreCase)
        && string.IsNullOrWhiteSpace(Rel)
            ? "noopener noreferrer"
            : Rel;

    private async Task OnClickAsync()
    {
        if (IsDisabled)
        {
            return;
        }

        isClickInFlight = true;
        try
        {
            await Click.InvokeAsync();
        }
        finally
        {
            isClickInFlight = false;
        }
    }

    private static string? ResolveIconName(string? iconToken)
    {
        if (MaterialIconCatalog.TryResolveIconName(iconToken, out var resolvedIconName))
        {
            return resolvedIconName;
        }

        return null;
    }

    private static string ResolveIconLabel(string? iconToken)
    {
        if (string.IsNullOrWhiteSpace(iconToken))
        {
            return "action";
        }

        return iconToken
            .Replace('_', ' ')
            .Replace('-', ' ');
    }

    private string ResolveButtonCssClass()
    {
        if (Look != ButtonLook.Default)
        {
            return Look switch
            {
                ButtonLook.SheetCard => "cad-card-button zy-card-button",
                ButtonLook.SheetCardGhost => "cad-card-button zy-card-button cad-card-button--ghost zy-card-button--ghost",
                ButtonLook.SheetCardWarn => "cad-card-button zy-card-button cad-card-button--warn zy-card-button--warn",
                ButtonLook.Legacy => "btn",
                ButtonLook.LegacyGhost => "btn ghost",
                ButtonLook.LegacyExtraSmall => "btn xs",
                ButtonLook.LegacyExtraSmallGhost => "btn xs ghost",
                ButtonLook.LegacyPrimaryFullWidth => "btn primary w-full",
                _ => string.Empty
            };
        }

        return $"rz-button cda-button {ResolveSizeCssClass()} {ResolveVariantCssClass()} {ResolveToneCssClass()}";
    }

    private RenderFragment RenderButtonContent(string? iconName)
    {
        return builder =>
        {
            var sequence = 0;

            if (IsBusy)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "cda-button__spinner");
                builder.CloseElement();
            }
            else if (iconName is not null)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "rz-icon cda-material-icon material-symbols-rounded");
                builder.AddAttribute(sequence++, "aria-hidden", "true");
                builder.AddContent(sequence++, iconName);
                builder.CloseElement();
            }
            else if (!string.IsNullOrWhiteSpace(Icon))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "rz-icon-fallback");
                builder.AddAttribute(sequence++, "title", $"Unknown icon token: {Icon}");
                builder.AddAttribute(sequence++, "aria-hidden", "true");
                builder.AddContent(sequence++, Icon);
                builder.CloseElement();
            }

            if (!string.IsNullOrWhiteSpace(Token))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "cda-button__token");
                builder.AddContent(sequence++, Token);
                builder.CloseElement();
            }

            if (ChildContent is not null)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "rz-button-text");
                builder.AddContent(sequence++, ChildContent);
                builder.CloseElement();
                return;
            }

            if (!string.IsNullOrWhiteSpace(Text))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "rz-button-text");
                builder.AddContent(sequence++, Text);
                builder.CloseElement();
                return;
            }

            if (!string.IsNullOrWhiteSpace(Icon))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "sr-only");
                builder.AddContent(sequence++, ResolveIconLabel(Icon));
                builder.CloseElement();
            }
        };
    }

    private string ResolveStyleCss()
    {
        return ButtonStyle switch
        {
            ButtonStyle.Light => "cda-button--tone-light",
            ButtonStyle.Secondary => "cda-button--tone-secondary",
            ButtonStyle.Success => "cda-button--tone-success",
            ButtonStyle.Info => "cda-button--tone-info",
            ButtonStyle.Warning => "cda-button--tone-warning",
            ButtonStyle.Danger => "cda-button--tone-danger",
            ButtonStyle.Dark => "cda-button--tone-dark",
            ButtonStyle.Base => "cda-button--tone-base",
            _ => "cda-button--tone-primary"
        };
    }

    private string ResolveSizeCssClass()
    {
        return Size switch
        {
            ButtonSize.Small => "cda-button--size-sm",
            ButtonSize.Large => "cda-button--size-lg",
            _ => "cda-button--size-md"
        };
    }

    private string ResolveVariantCssClass()
    {
        return Variant switch
        {
            Variant.Outlined => "cda-button--outlined",
            Variant.Text => "cda-button--text",
            _ => "cda-button--filled"
        };
    }

    private string ResolveToneCssClass()
    {
        return ResolveStyleCss();
    }

    private static string FormatBoolean(bool value)
        => value ? "true" : "false";
}







