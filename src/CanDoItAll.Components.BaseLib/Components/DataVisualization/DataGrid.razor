@namespace CanDoItAll.Components.BaseLib
@typeparam TItem
@using Microsoft.AspNetCore.Components.Web

<CascadingValue Value="this" IsFixed="true">
    <div style="display:none">
        @if (Columns is not null)
        {
            @Columns
        }
        @if (ChildContent is not null)
        {
            @ChildContent
        }
    </div>
</CascadingValue>

<div @attributes='AdditionalAttributes.WithClass("rz-data-grid w-full min-w-0 overflow-x-auto")'
     aria-busy="@(Loading ? "true" : null)">
    <table class="min-w-full border-collapse text-sm">
        <caption class="sr-only">@Caption</caption>
        <thead>
            <tr class="border-b border-slate-200 text-left text-slate-600">
                @foreach (var column in columns)
                {
                    <th scope="col" class="px-3 py-2 font-semibold">@column.HeaderText</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Loading)
            {
                <tr>
                    <td colspan="@ColumnSpan" class="px-3 py-6 text-center text-slate-500" role="status">
                        @LoadingText
                    </td>
                </tr>
            }
            else if (VisibleItems.Count == 0)
            {
                <tr>
                    <td colspan="@ColumnSpan" class="px-3 py-6 text-center text-slate-500">
                        @EmptyText
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in VisibleItems)
                {
                    <tr class="@ResolveRowCssClass()"
                        tabindex="@(RowSelect.HasDelegate ? 0 : null)"
                        @onclick="() => OnRowSelectAsync(item)"
                        @onkeydown="args => OnRowKeyDownAsync(args, item)">
                        @foreach (var column in columns)
                        {
                            <td class="px-3 py-2 align-top">@column.RenderCell(item)</td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (AllowPaging && TotalPages > 1)
    {
        <nav aria-label="Data grid pagination">
            <Cluster JustifyContent="JustifyContent.End"
                     Gap="LayoutGap.Small"
                     Class="mt-3 text-xs text-slate-600">
            <button type="button"
                    class="rounded border border-slate-300 px-2 py-1 disabled:opacity-40"
                    disabled="@(currentPage == 0)"
                    aria-label="Previous page"
                    @onclick="PreviousPageAsync">Prev</button>
            <span aria-live="polite">Page @(currentPage + 1) of @TotalPages</span>
            <button type="button"
                    class="rounded border border-slate-300 px-2 py-1 disabled:opacity-40"
                    disabled="@(currentPage >= TotalPages - 1)"
                    aria-label="Next page"
                    @onclick="NextPageAsync">Next</button>
            </Cluster>
        </nav>
    }
</div>

@code {
    private readonly List<DataGridColumn<TItem>> columns = [];
    private IReadOnlyList<TItem> dataList = [];
    private IReadOnlyList<TItem> visibleItems = [];
    private int currentPage;

    /// <summary>The rows to display. Re-evaluated into an internal list on every parameter change.</summary>
    [Parameter]
    public IEnumerable<TItem>? Data { get; set; }

    /// <summary>Invoked when a row is activated by click, Enter, or Space. Supplying a handler also makes rows keyboard-focusable.</summary>
    [Parameter]
    public EventCallback<TItem> RowSelect { get; set; }

    /// <summary>Enables the built-in pager, splitting <see cref="Data"/> into pages of <see cref="PageSize"/> rows.</summary>
    [Parameter]
    public bool AllowPaging { get; set; }

    /// <summary>Rows per page when <see cref="AllowPaging"/> is enabled.</summary>
    [Parameter]
    public int PageSize { get; set; } = 10;

    /// <summary>Screen-reader-only table caption.</summary>
    [Parameter]
    public string Caption { get; set; } = "Data grid";

    /// <summary>Shows a single loading row spanning all columns instead of <see cref="Data"/>.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Message shown in the loading row.</summary>
    [Parameter]
    public string LoadingText { get; set; } = "Loading data…";

    /// <summary>Message shown when there are no rows to display and <see cref="Loading"/> is <c>false</c>.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "No data to display.";

    /// <summary>The <c>DataGridColumn</c> declarations describing each column, in display order.</summary>
    [Parameter]
    public RenderFragment? Columns { get; set; }

    /// <summary>Alternate slot for column declarations. Rendered alongside <see cref="Columns"/> in the same hidden registration region.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional HTML attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    internal void RegisterColumn(DataGridColumn<TItem> column)
    {
        if (!columns.Contains(column))
        {
            columns.Add(column);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    internal void UnregisterColumn(DataGridColumn<TItem> column)
    {
        if (columns.Remove(column))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<TItem> VisibleItems => visibleItems;

    private int ColumnSpan => Math.Max(1, columns.Count);

    private int TotalPages
    {
        get
        {
            if (!AllowPaging)
            {
                return 1;
            }

            var effectivePageSize = Math.Max(1, PageSize);
            return Math.Max(1, (int)Math.Ceiling(dataList.Count / (double)effectivePageSize));
        }
    }

    protected override void OnParametersSet()
    {
        dataList = Data switch
        {
            null => [],
            IReadOnlyList<TItem> list => list,
            _ => Data.ToList()
        };

        if (AllowPaging && currentPage >= TotalPages)
        {
            currentPage = Math.Max(0, TotalPages - 1);
        }

        if (!AllowPaging)
        {
            currentPage = 0;
        }

        UpdateVisibleItems();
    }

    private async Task OnRowSelectAsync(TItem item)
    {
        await RowSelect.InvokeAsync(item);
    }

    private Task OnRowKeyDownAsync(KeyboardEventArgs args, TItem item)
    {
        return args.Key is "Enter" or " "
            ? OnRowSelectAsync(item)
            : Task.CompletedTask;
    }

    private string ResolveRowCssClass()
        => RowSelect.HasDelegate
            ? "border-b border-slate-100 hover:bg-slate-50 focus:outline-2 focus:outline-offset-[-2px] focus:outline-sky-500 cursor-pointer"
            : "border-b border-slate-100";

    private Task PreviousPageAsync()
    {
        if (currentPage > 0)
        {
            currentPage--;
            UpdateVisibleItems();
        }

        return Task.CompletedTask;
    }

    private Task NextPageAsync()
    {
        if (currentPage < TotalPages - 1)
        {
            currentPage++;
            UpdateVisibleItems();
        }

        return Task.CompletedTask;
    }

    private void UpdateVisibleItems()
    {
        visibleItems = AllowPaging
            ? dataList.Skip(currentPage * Math.Max(1, PageSize)).Take(Math.Max(1, PageSize)).ToList()
            : dataList;
    }
}




