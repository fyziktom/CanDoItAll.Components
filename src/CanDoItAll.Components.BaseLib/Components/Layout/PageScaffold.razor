@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(ResolveContainerClass(), ResolveContainerStyle())'>
    @if (Header is not null)
    {
        <Stack GapScale="LayoutGap.Medium"
               AlignItems="AlignItems.Stretch"
               Class="@ResolveHeaderClass()">
            @Header
        </Stack>
    }

    @if (Lead is not null)
    {
        <Stack GapScale="LayoutGap.Medium"
               AlignItems="AlignItems.Stretch"
               Class="@ResolveLeadClass()">
            @Lead
        </Stack>
    }

    @if (SecondaryRail is not null)
    {
        <Grid Gap="LayoutGap.Large"
              Class="@ResolveScaffoldGridClass()"
              ColumnTemplate2Xl="minmax(0,1fr) 18rem">
            <Stack GapScale="LayoutGap.Large"
                   AlignItems="AlignItems.Stretch"
                   Class="@ResolvePrimaryContentClass()">
                @ChildContent
            </Stack>

            <Stack Section="true"
                   GapScale="LayoutGap.Medium"
                   Class="@ResolveSecondaryRailClass()">
                @SecondaryRail
            </Stack>
        </Grid>
    }
    else if (ChildContent is not null)
    {
        <Stack GapScale="LayoutGap.Large"
               AlignItems="AlignItems.Stretch"
               Class="@ResolvePrimaryContentClass()">
            @ChildContent
        </Stack>
    }
</div>

@code {
    /// <summary>The scaffold's overall density and max-width behavior.</summary>
    [Parameter]
    public PageScaffoldMode Mode { get; set; } = PageScaffoldMode.Standard;

    /// <summary>Overrides the max-width CSS class derived from <see cref="Mode"/>.</summary>
    [Parameter]
    public string? MaxWidthClass { get; set; }

    /// <summary>When <c>true</c>, the scaffold fills its parent's height and scrolls internally instead of the page scrolling.</summary>
    [Parameter]
    public bool FillHeight { get; set; }

    /// <summary>The page header, rendered above <see cref="Lead"/>.</summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    /// <summary>Lead content rendered above the primary/secondary region split, such as summary tiles.</summary>
    [Parameter]
    public RenderFragment? Lead { get; set; }

    /// <summary>Supporting rail content rendered alongside <see cref="ChildContent"/>; when set, the primary region and rail share a grid.</summary>
    [Parameter]
    public RenderFragment? SecondaryRail { get; set; }

    /// <summary>The scaffold's primary content region.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveContainerClass()
    {
        var maxWidthClass = !string.IsNullOrWhiteSpace(MaxWidthClass)
            ? MaxWidthClass
            : Mode == PageScaffoldMode.FocusWorkbench
                ? "max-w-full"
                : "max-w-[1720px] 2xl:max-w-[1820px]";

        var spacingClass = Mode == PageScaffoldMode.FocusWorkbench ? "gap-3" : "gap-3.5 xl:gap-4";
        return CssClassBuilder.Join(
            "mx-auto flex h-full min-h-0 w-full min-w-0 flex-col",
            spacingClass,
            maxWidthClass,
            FillHeight ? "flex-1 overflow-hidden" : "overflow-y-auto");
    }

    private string ResolveContainerStyle()
    {
        var styles = new List<string>
        {
            "height:100%",
            "min-height:0"
        };

        if (!FillHeight)
        {
            styles.Add("scrollbar-gutter:stable");
        }

        return string.Join(';', styles) + ';';
    }

    private string ResolveHeaderClass()
        => FillHeight ? "w-full shrink-0" : "w-full";

    private string ResolveLeadClass()
        => FillHeight ? "w-full shrink-0" : "w-full";

    private string ResolveScaffoldGridClass()
        => FillHeight ? "min-h-0 flex-1 overflow-hidden" : string.Empty;

    private string ResolvePrimaryContentClass()
        => CssClassBuilder.Join(
            "min-w-0 w-full",
            FillHeight ? "min-h-0 flex-1 overflow-hidden" : null);

    private string ResolveSecondaryRailClass()
        => FillHeight ? "min-h-0 overflow-hidden" : string.Empty;
}


