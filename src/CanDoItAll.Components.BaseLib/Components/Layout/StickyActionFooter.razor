@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes("cda-sticky-action-footer")'>
    <Split Breakpoint="LayoutBreakpoint.Xl"
           Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween">
        <Stack GapScale="LayoutGap.Tiny">
            @if (!string.IsNullOrWhiteSpace(StatusLabel))
            {
                <p class="cda-eyebrow cda-eyebrow--tight">@StatusLabel</p>
            }

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <p class="@ResolveStatusClass()">@StatusMessage</p>
            }
        </Stack>

        <Cluster JustifyContent="JustifyContent.End"
                 Class="w-full xl:w-auto">
            @if (SecondaryActions is not null)
            {
                @SecondaryActions
            }

            @if (PrimaryActions is not null)
            {
                @PrimaryActions
            }

            @if (DangerActions is not null)
            {
                <Cluster Class="ml-0 md:ml-3 md:border-l md:border-slate-200 md:pl-3">
                    @DangerActions
                </Cluster>
            }
        </Cluster>
    </Split>
</div>

@code {
    [Parameter]
    public string? StatusLabel { get; set; }

    [Parameter]
    public string? StatusMessage { get; set; }

    [Parameter]
    public string StatusTone { get; set; } = "neutral";

    [Parameter]
    public RenderFragment? PrimaryActions { get; set; }

    [Parameter]
    public RenderFragment? SecondaryActions { get; set; }

    [Parameter]
    public RenderFragment? DangerActions { get; set; }

    private string ResolveStatusClass()
    {
        var toneClass = StatusTone.ToLowerInvariant() switch
        {
            "success" => "cda-sticky-action-footer__status--success",
            "warning" => "cda-sticky-action-footer__status--warning",
            "danger" => "cda-sticky-action-footer__status--danger",
            "info" => "cda-sticky-action-footer__status--info",
            _ => string.Empty
        };

        return CssClassBuilder.Join("cda-sticky-action-footer__status", toneClass);
    }
}


