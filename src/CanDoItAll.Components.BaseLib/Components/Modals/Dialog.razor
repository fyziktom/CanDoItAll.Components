@namespace CanDoItAll.Components.BaseLib
@using Microsoft.JSInterop
@inherits StyledComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <dialog @ref="dialogElement"
            @attributes='ResolveRootAttributes()'
            data-testid="@TestId"
            aria-label="@ResolvedExplicitAriaLabel"
            aria-labelledby="@ResolvedLabelledBy">
        <Stack AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.Center"
               GapScale="LayoutGap.None"
               Class="cda-dialog-layer"
               Style="z-index:1200;">
            <div class="cda-dialog__backdrop"
                 aria-hidden="true"
                 @onclick="HandleBackdropCloseAsync"></div>

            <section class="@ResolveDialogCssClass()"
                     style="@BuildStyle("z-index:1201")"
                     @onclick:stopPropagation="true">
                <header class="@ResolveHeaderCssClass()">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Stack GapScale="LayoutGap.Tiny"
                               Class="cda-dialog__copy">
                            @if (!string.IsNullOrWhiteSpace(Eyebrow))
                            {
                                <div class="cda-eyebrow">@Eyebrow</div>
                            }

                            <div class="inline-flex min-w-0 items-center gap-2">
                                <h2 id="@titleElementId" class="cda-dialog__title">@Title</h2>
                                @if (HasHelp)
                                {
                                    <HelpPopover RootClass="pf-help-popover inline-flex items-center"
                                                 ToggleClass="pf-help-popover__toggle pf-help-popover__toggle--compact"
                                                 OpenOnHover="true"
                                                 AriaLabel="@ResolvedHelpAriaLabel"
                                                 Title="@ResolvedHelpAriaLabel"
                                                 Heading="@ResolvedHelpHeading"
                                                 Body="@(HelpText!)" />
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Subtitle))
                            {
                                <p class="cda-dialog__subtitle">@Subtitle</p>
                            }
                        </Stack>

                        <Cluster Gap="LayoutGap.Small"
                                 Class="cda-dialog__header-actions">
                            @if (HeaderActions is not null)
                            {
                                @HeaderActions
                            }

                            @if (ShowCloseButton)
                            {
                                <button type="button"
                                        class="cda-dialog__close"
                                        aria-label="Close"
                                        @onclick="HandleCloseAsync">
                                    <Icon Name="close" />
                                    <span>Close</span>
                                </button>
                            }
                        </Cluster>
                    </Split>
                </header>

                <div class="@ResolveBodyCssClass()">
                    @ChildContent
                </div>

                @if (Footer is not null)
                {
                    <footer class="@ResolveFooterCssClass()">
                        @Footer
                    </footer>
                }
            </section>
        </Stack>
    </dialog>
}

@code {
    private readonly string dialogInstanceId = $"cda-dialog-{Guid.NewGuid():N}";
    private readonly string titleElementId = $"cda-dialog-title-{Guid.NewGuid():N}";
    private ElementReference dialogElement;
    private DialogInterop? dialogInterop;
    private DotNetObjectReference<Dialog>? dotNetReference;
    private bool browserDialogOpen;

    /// <summary>Controls visibility. The dialog is a controlled component: set this from the host's own state rather than expecting the dialog to track it internally.</summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>Heading shown in the dialog header.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Small label rendered above <see cref="Title"/>.</summary>
    [Parameter]
    public string? Eyebrow { get; set; }

    /// <summary>Supporting sentence rendered under <see cref="Title"/>.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Body text for the header's help popover. Omit to hide the help affordance.</summary>
    [Parameter]
    public string? HelpText { get; set; }

    /// <summary>Heading for the header's help popover. Falls back to <see cref="Title"/> when unset.</summary>
    [Parameter]
    public string? HelpHeading { get; set; }

    /// <summary>Width preset for the dialog surface.</summary>
    [Parameter]
    public ModalSize Size { get; set; } = ModalSize.Medium;

    /// <summary>Accessible name for the dialog's <c>role="dialog"</c> container. Falls back to <see cref="Title"/> when unset.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Value applied to <c>data-testid</c> on the dialog surface, for test targeting.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Closes the dialog when the backdrop is clicked.</summary>
    [Parameter]
    public bool CloseOnBackdrop { get; set; } = true;

    /// <summary>Shows the built-in close button in the header.</summary>
    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    /// <summary>Reduces header and body padding for compact dialogs.</summary>
    [Parameter]
    public bool DenseChrome { get; set; }

    /// <summary>Additional content (typically buttons) rendered in the header, next to the close button.</summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    /// <summary>The dialog's body content.</summary>
    [Parameter]
    public RenderFragment ChildContent { get; set; } = default!;

    /// <summary>Content rendered in a dedicated footer region, typically primary and secondary actions.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>Invoked when the dialog requests to close, from the close button, backdrop click, or Escape key. The host must set <see cref="IsOpen"/> to <c>false</c> in response.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private string? ResolvedExplicitAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? null : AriaLabel;

    private string? ResolvedLabelledBy => string.IsNullOrWhiteSpace(AriaLabel) ? titleElementId : null;

    private bool HasHelp => !string.IsNullOrWhiteSpace(HelpText);

    private string ResolvedHelpHeading => string.IsNullOrWhiteSpace(HelpHeading) ? Title : HelpHeading;

    private string ResolvedHelpAriaLabel => $"Show help for {Title}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !browserDialogOpen)
        {
            dialogInterop ??= new DialogInterop(JS);
            dotNetReference ??= DotNetObjectReference.Create(this);
            await dialogInterop.OpenAsync(dialogElement, dialogInstanceId, dotNetReference);
            browserDialogOpen = true;
            return;
        }

        if (!IsOpen && browserDialogOpen && dialogInterop is not null)
        {
            await dialogInterop.CloseAsync(dialogInstanceId);
            browserDialogOpen = false;
        }
    }

    private string ResolveDialogCssClass()
    {
        var sizeCss = Size switch
        {
            ModalSize.Compact => "cda-dialog--compact",
            ModalSize.Medium => "cda-dialog--medium",
            ModalSize.Wide => "cda-dialog--wide",
            ModalSize.Full => "cda-dialog--full",
            _ => throw new ArgumentOutOfRangeException(nameof(Size), Size, "Unsupported dialog size.")
        };

        return CssClassBuilder.Join(
            "cda-dialog",
            sizeCss,
            Class);
    }

    private string ResolveHeaderCssClass()
    {
        return DenseChrome
            ? "cda-dialog__header cda-dialog__header--dense"
            : "cda-dialog__header";
    }

    private string ResolveBodyCssClass()
    {
        return DenseChrome
            ? "cda-dialog__body cda-dialog__body--dense"
            : "cda-dialog__body";
    }

    private string ResolveFooterCssClass()
    {
        return DenseChrome
            ? "cda-dialog__footer cda-dialog__footer--dense"
            : "cda-dialog__footer";
    }

    private IReadOnlyDictionary<string, object>? ResolveRootAttributes()
    {
        return ComponentAttributes.WithClassAndStyle(
            AdditionalAttributes,
            CssClassBuilder.Join(
                "cda-dialog-root fixed inset-0 m-0 h-screen w-screen max-h-none max-w-none border-0 bg-transparent p-0",
                Class),
            CssClassBuilder.JoinStyles("z-index:1200", Style));
    }

    private Task HandleCloseAsync()
    {
        return OnClose.InvokeAsync();
    }

    private Task HandleBackdropCloseAsync()
    {
        return CloseOnBackdrop
            ? OnClose.InvokeAsync()
            : Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnDialogDismissRequested()
    {
        return OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (dialogInterop is not null)
        {
            await dialogInterop.CloseAsync(dialogInstanceId);
            await dialogInterop.DisposeAsync();
        }

        dotNetReference?.Dispose();
    }
}



