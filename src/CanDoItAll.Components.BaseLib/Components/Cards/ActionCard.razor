@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(Active ? "rounded-[1.5rem] border border-info-200/30 bg-info-500/20 p-4 shadow-sm shadow-info-100" : "rounded-[1.5rem] border border-chrome-200 bg-chrome-50 p-4 shadow-sm")'>
    @ChildContent
</div>

@code {
    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
