@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<Grid Section="@Section"
      Gap="LayoutGap.Medium"
      ColumnTemplateSm="repeat(auto-fit,minmax(min(100%,18rem),1fr))"
      Class="@Class"
      Style="@Style"
      @attributes="AdditionalAttributes">
    @ChildContent
</Grid>

@code {
    [Parameter]
    public bool Section { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
