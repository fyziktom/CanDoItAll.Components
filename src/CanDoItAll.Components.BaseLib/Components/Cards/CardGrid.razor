@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<Grid Section="@Section"
      Gap="LayoutGap.Medium"
      ColumnTemplateSm="repeat(auto-fit,minmax(min(100%,18rem),1fr))"
      Class="@Class"
      Style="@Style"
      @attributes="AdditionalAttributes">
    @ChildContent
</Grid>

@code {
    /// <summary>Renders the grid as a <c>&lt;section&gt;</c> element instead of a <c>&lt;div&gt;</c>.</summary>
    [Parameter]
    public bool Section { get; set; }

    /// <summary>The <c>Card</c> elements to lay out in the responsive grid.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
