@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes(ResolveCssClass())'>
    @if (UsesStructuredLayout)
    {
        @if (Media is not null)
        {
            <div class="cda-card__media">
                @Media
            </div>
        }

        <div class="cda-card__body">
            @if (Header is not null)
            {
                <div class="cda-card__header">
                    @Header
                </div>
            }

            @if (Tags is not null)
            {
                <div class="cda-card__tags">
                    @Tags
                </div>
            }

            @if (ChildContent is not null)
            {
                <div class="cda-card__content">
                    @ChildContent
                </div>
            }

            @if (Actions is not null)
            {
                <div class="cda-card__actions">
                    @Actions
                </div>
            }
        </div>
    }
    else
    {
        @ChildContent
    }
</div>

@code {
    /// <summary>Media (typically an image) rendered above the card body. Supplying any of <see cref="Media"/>, <see cref="Header"/>, <see cref="Tags"/>, or <see cref="Actions"/> switches the card into structured layout.</summary>
    [Parameter]
    public RenderFragment? Media { get; set; }

    /// <summary>Header content, typically a title and status badge.</summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    /// <summary>Tag or fact badges rendered between the header and main content.</summary>
    [Parameter]
    public RenderFragment? Tags { get; set; }

    /// <summary>Main card content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Action content (typically buttons) rendered at the bottom of the card.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    private bool UsesStructuredLayout
        => Media is not null
            || Header is not null
            || Tags is not null
            || Actions is not null;

    private string ResolveCssClass()
        => UsesStructuredLayout
            ? "rz-card cda-card cda-card--structured"
            : "rz-card cda-card";
}






