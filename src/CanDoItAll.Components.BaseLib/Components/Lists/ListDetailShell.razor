@namespace CanDoItAll.Components.BaseLib
@inherits StyledComponentBase

<div @attributes='BuildAttributes("cda-list-detail-shell", ResolveShellStyle())'>
    <div class="cda-list-detail-shell__grid">
        <section class="@ResolvePaneClass(ListPaneClass)">
            @if (ListHeader is not null)
            {
                <div class="@ResolveHeaderClass()">
                    @ListHeader
                </div>
            }

            <div class="@ResolveContentClass()">
                @ListContent
            </div>
        </section>

        <section class="@ResolvePaneClass(DetailPaneClass)">
            @if (DetailHeader is not null)
            {
                <div class="@ResolveHeaderClass()">
                    @DetailHeader
                </div>
            }

            <div class="@ResolveContentClass()">
                @DetailContent
            </div>
        </section>
    </div>
</div>

@code {
    [Parameter]
    public string ListPaneWidth { get; set; } = "24rem";

    [Parameter]
    public string? ListPaneClass { get; set; }

    [Parameter]
    public string? DetailPaneClass { get; set; }

    [Parameter]
    public bool Dense { get; set; }

    [Parameter]
    public RenderFragment? ListHeader { get; set; }

    [Parameter]
    public RenderFragment? ListContent { get; set; }

    [Parameter]
    public RenderFragment? DetailHeader { get; set; }

    [Parameter]
    public RenderFragment? DetailContent { get; set; }

    private static string ResolvePaneClass(string? customClass)
    {
        var usesExplicitMinHeight = HasExplicitMinHeight(customClass);
        var baseClass = CssClassBuilder.Join(
            "flex min-w-0 flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white/90 shadow-sm shadow-slate-200/60",
            usesExplicitMinHeight ? null : "min-h-[26rem]");
        return CssClassBuilder.Join(baseClass, customClass);
    }

    private static bool HasExplicitMinHeight(string? customClass)
    {
        if (string.IsNullOrWhiteSpace(customClass))
        {
            return false;
        }

        return customClass
            .Split([' ', '\r', '\n', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Any(segment => segment.StartsWith("min-h-", StringComparison.Ordinal));
    }

    private string? ResolveShellStyle()
    {
        return BuildStyle(
            $"--list-pane-width:{ListPaneWidth};",
            $"--cda-list-detail-gap:{LayoutValueResolver.ResolveGap(Dense ? LayoutGap.Medium : LayoutGap.XLarge)};");
    }

    private string ResolveHeaderClass()
    {
        return Dense
            ? "border-b border-slate-200 px-3 py-2.5"
            : "border-b border-slate-200 px-4 py-3.5";
    }

    private string ResolveContentClass()
    {
        return Dense
            ? "flex-1 min-h-0 px-3 py-2.5"
            : "flex-1 min-h-0 px-4 py-4";
    }
}


