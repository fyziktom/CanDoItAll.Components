@namespace CanDoItAll.Components.BaseLib

@if (Model is not null)
{
    <div class="@ResolveContainerClass()" @attributes="AdditionalAttributes">
        <Stack GapScale="LayoutGap.Medium">
            @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
            {
                <p class="cda-eyebrow">@Model.Eyebrow</p>
            }

            <Split Breakpoint="LayoutBreakpoint.Md"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Start"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                    <p class="m-0 text-base font-semibold text-chrome-950">@Model.Title</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="m-0 text-sm leading-5 text-chrome-600">@Model.Description</p>
                    }
                </Stack>

                <StorageBadgeStrip Badges="Model.Badges" />
            </Split>

            @if (Model.Facts.Count > 0)
            {
                <FactTable>
                    <div class="grid gap-x-4 gap-y-3 md:grid-cols-2">
                        @foreach (var fact in Model.Facts)
                        {
                            <div class="min-w-0">
                                <p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-chrome-500">@fact.Label</p>
                                <p class="mb-0 mt-1 break-words text-sm text-chrome-700">@fact.Value</p>
                            </div>
                        }
                    </div>
                </FactTable>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Footnote))
            {
                <p class="m-0 text-xs leading-5 text-chrome-500">@Model.Footnote</p>
            }
        </Stack>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public StorageSummaryModel Model { get; set; } = new();

    [Parameter]
    public bool Emphasized { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ResolveContainerClass()
    {
        return Emphasized
            ? "rounded-[1.5rem] border border-sky-200 bg-sky-50/70 p-4 shadow-sm"
            : "rounded-[1.5rem] border border-chrome-200 bg-chrome-50/80 p-4";
    }
}
