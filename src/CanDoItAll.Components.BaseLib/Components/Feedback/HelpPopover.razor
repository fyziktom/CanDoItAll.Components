@namespace CanDoItAll.Components.BaseLib
@implements IDisposable

<div class="@RootClass"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave">
    @if (isOpen)
    {
        <div class="pf-help-popover__scrim" aria-hidden="true" @onclick="CloseAsync"></div>
    }

    <button type="button"
            class="@ToggleClass"
            aria-label="@AriaLabel"
            title="@Title"
            aria-expanded="@FormatBoolean(isOpen)"
            aria-haspopup="dialog"
            @onclick="ToggleAsync"
            @onblur="HandleBlurAsync"
            @onkeydown="HandleKeyDownAsync">
        <span aria-hidden="true">@Glyph</span>
    </button>

    @if (isOpen)
    {
        <div class="@PanelClass"
             role="dialog"
             aria-label="@ResolvePanelLabel()"
             data-testid="@PanelTestId">
            @if (!string.IsNullOrWhiteSpace(Heading))
            {
                <strong>@Heading</strong>
            }

            @if (!string.IsNullOrWhiteSpace(Body))
            {
                <p>@Body</p>
            }

            @if (!string.IsNullOrWhiteSpace(Tip))
            {
                <small>@Tip</small>
            }

            @PanelContent
        </div>
    }
</div>

@code {
    private bool isOpen;
    private bool isPinnedOpen;
    private bool pointerInside;
    private CancellationTokenSource? closeDelayCts;

    /// <summary>CSS class applied to the root element.</summary>
    [Parameter]
    public string RootClass { get; set; } = "pf-help-popover";

    /// <summary>CSS class applied to the toggle button.</summary>
    [Parameter]
    public string ToggleClass { get; set; } = "pf-help-popover__toggle";

    /// <summary>CSS class applied to the open panel.</summary>
    [Parameter]
    public string PanelClass { get; set; } = "pf-help-popover__panel";

    /// <summary>Value applied to <c>data-testid</c> on the open panel, for test targeting.</summary>
    [Parameter]
    public string? PanelTestId { get; set; }

    /// <summary>Glyph rendered inside the toggle button.</summary>
    [Parameter]
    public string Glyph { get; set; } = "?";

    /// <summary>Accessible name and default panel label for the toggle button.</summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Show help";

    /// <summary>Native <c>title</c> tooltip shown on hover over the toggle button.</summary>
    [Parameter]
    public string Title { get; set; } = "Show help";

    /// <summary>Bold heading shown at the top of the panel. Falls back to <see cref="AriaLabel"/> for the panel's accessible label when set.</summary>
    [Parameter]
    public string Heading { get; set; } = string.Empty;

    /// <summary>Main explanatory text shown in the panel.</summary>
    [Parameter]
    public string Body { get; set; } = string.Empty;

    /// <summary>Small supplementary hint shown below <see cref="Body"/>.</summary>
    [Parameter]
    public string Tip { get; set; } = string.Empty;

    /// <summary>Delay before the panel closes after the pointer leaves, giving the user time to move onto the panel itself.</summary>
    [Parameter]
    public int CloseDelayMs { get; set; } = 220;

    /// <summary>Opens the panel on hover in addition to click. Hover-opened panels are not pinned and close automatically when the pointer leaves.</summary>
    [Parameter]
    public bool OpenOnHover { get; set; }

    /// <summary>Additional custom content rendered after <see cref="Heading"/>, <see cref="Body"/>, and <see cref="Tip"/>.</summary>
    [Parameter]
    public RenderFragment? PanelContent { get; set; }

    private async Task ToggleAsync()
    {
        CancelScheduledClose();

        if (isOpen && isPinnedOpen)
        {
            isOpen = false;
            isPinnedOpen = false;
            pointerInside = false;
        }
        else
        {
            isOpen = true;
            isPinnedOpen = true;
            pointerInside = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseAsync()
    {
        CancelScheduledClose();
        isOpen = false;
        isPinnedOpen = false;
        pointerInside = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleMouseEnter()
    {
        pointerInside = true;
        CancelScheduledClose();

        if (!OpenOnHover || isOpen)
        {
            return;
        }

        isOpen = true;
        isPinnedOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleMouseLeave()
    {
        pointerInside = false;

        if (isPinnedOpen)
        {
            return;
        }

        await ScheduleCloseAsync();
    }

    private async Task HandleBlurAsync(FocusEventArgs _)
    {
        if (!isPinnedOpen)
        {
            await ScheduleCloseAsync();
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            return;
        }

        await CloseAsync();
    }

    private async Task ScheduleCloseAsync()
    {
        if (!isOpen)
        {
            return;
        }

        CancelScheduledClose();
        closeDelayCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(CloseDelayMs, closeDelayCts.Token);
            if (!pointerInside)
            {
                isOpen = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private string ResolvePanelLabel()
        => !string.IsNullOrWhiteSpace(Heading) ? Heading : AriaLabel;

    private static string FormatBoolean(bool value)
        => value ? "true" : "false";

    private void CancelScheduledClose()
    {
        closeDelayCts?.Cancel();
        closeDelayCts?.Dispose();
        closeDelayCts = null;
    }

    public void Dispose()
        => CancelScheduledClose();
}


