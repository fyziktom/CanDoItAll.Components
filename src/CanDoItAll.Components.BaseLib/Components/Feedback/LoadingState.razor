@namespace CanDoItAll.Components.BaseLib
<div class="rounded-2xl border border-chrome-200 bg-chrome-50/80 px-4 py-5">
    @if (!string.IsNullOrWhiteSpace(Eyebrow))
    {
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.22em] text-chrome-500">@Eyebrow</p>
    }

    <h3 class="mb-0 mt-1.5 text-base font-semibold text-chrome-950">@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="mb-0 mt-1 text-sm leading-5 text-chrome-600">@Description</p>
    }

    <div class="mt-4 space-y-2">
        <div class="h-3 w-32 animate-pulse rounded-full bg-chrome-200"></div>
        <div class="h-3 w-full animate-pulse rounded-full bg-chrome-200"></div>
        <div class="h-3 w-5/6 animate-pulse rounded-full bg-chrome-200"></div>
    </div>
</div>

@code {
    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }
}


