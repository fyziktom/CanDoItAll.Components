@namespace CanDoItAll.Components.BaseLib
@using Microsoft.JSInterop
@inject TooltipService TooltipService
@inject IJSRuntime JS
@implements IAsyncDisposable

<span @ref="triggerElement"
      class="@ResolveTriggerCssClass()"
      tabindex="@TabIndex"
      aria-describedby="@tooltipElementId"
      @onmouseenter="OpenFromMouse"
      @onmouseleave="CloseIfConfigured"
      @onfocusin="OpenFromFocus"
      @onfocusout="CloseFromFocusAsync">
    @ChildContent
</span>

@code {
    private readonly string tooltipElementId = $"cda-tooltip-{Guid.NewGuid():N}";
    private ElementReference triggerElement;
    private TooltipInterop? tooltipInterop;
    private int disposalStarted;

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public RenderFragment<TooltipService>? TooltipContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public TooltipPosition Position { get; set; } = TooltipPosition.Top;

    [Parameter]
    public TimeSpan? Delay { get; set; }

    [Parameter]
    public TimeSpan? Duration { get; set; } = TimeSpan.FromSeconds(4);

    [Parameter]
    public bool CloseOnMouseLeave { get; set; } = true;

    [Parameter]
    public string? TriggerClass { get; set; }

    [Parameter]
    public string? TooltipClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public int? TabIndex { get; set; }

    private void OpenFromMouse(MouseEventArgs args)
    {
        Open(args.ClientX, args.ClientY);
    }

    private async Task OpenFromFocus()
    {
        if (IsDisposalStarted)
        {
            return;
        }

        var interop = GetOrCreateInterop();
        if (interop is null)
        {
            return;
        }

        var anchor = await interop.GetAnchorPointAsync(triggerElement, tooltipElementId);
        if (IsDisposalStarted || anchor is null)
        {
            return;
        }

        Open(anchor.X, anchor.Y);
    }

    private void Open(double clientX, double clientY)
    {
        if (IsDisposalStarted)
        {
            return;
        }

        var options = new TooltipOptions
        {
            Id = tooltipElementId,
            Position = Position,
            Delay = Delay,
            Duration = Duration,
            Class = TooltipClass,
            TestId = TestId,
            CloseOnMouseLeave = CloseOnMouseLeave
        };

        if (TooltipContent is not null)
        {
            TooltipService.Open(TooltipContent, clientX, clientY, options);
            return;
        }

        if (!string.IsNullOrWhiteSpace(Text))
        {
            TooltipService.Open(Text, clientX, clientY, options);
        }
    }

    private void CloseIfConfigured()
    {
        if (CloseOnMouseLeave)
        {
            TooltipService.Close();
        }
    }

    private string ResolveTriggerCssClass()
    {
        return CssClassBuilder.Join("inline-flex min-w-0", TriggerClass);
    }

    public async ValueTask DisposeAsync()
    {
        if (Interlocked.Exchange(ref disposalStarted, 1) != 0)
        {
            return;
        }

        if (TooltipService.Current?.Options.Id == tooltipElementId)
        {
            TooltipService.Close();
        }

        var interop = Interlocked.Exchange(ref tooltipInterop, null);
        if (interop is not null)
        {
            await interop.DisposeAsync();
        }
    }

    private async Task CloseFromFocusAsync()
    {
        if (IsDisposalStarted)
        {
            return;
        }

        var interop = Volatile.Read(ref tooltipInterop);
        if (interop is not null)
        {
            await interop.ClearFocusedTargetAsync(triggerElement, tooltipElementId);
        }

        if (!IsDisposalStarted)
        {
            CloseIfConfigured();
        }
    }

    private TooltipInterop? GetOrCreateInterop()
    {
        if (IsDisposalStarted)
        {
            return null;
        }

        var existing = Volatile.Read(ref tooltipInterop);
        if (existing is not null)
        {
            return existing;
        }

        var candidate = new TooltipInterop(JS);
        existing = Interlocked.CompareExchange(ref tooltipInterop, candidate, null);
        var result = existing ?? candidate;
        return IsDisposalStarted ? null : result;
    }

    private bool IsDisposalStarted => Volatile.Read(ref disposalStarted) != 0;
}
