@namespace CanDoItAll.Components.BaseLib
@implements IAsyncDisposable
@inject NotificationService NotificationService
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop

@if (NotificationService.ActiveOutlet == PresentationOutlet) {
    renderedAnnouncementVersion = NotificationService.AnnouncementVersion;
<div class="rz-notification pointer-events-none fixed inset-0 z-[90]"
     style="@(IsModalOutlet ? "z-index:1300;" : "z-index:900;")"
     aria-live="@(NotificationService.HasNewAnnouncement ? "polite" : "off")"
     aria-atomic="false"
     data-notification-outlet="@PresentationOutlet">
    @foreach (var group in GetMessageGroups())
    {
        <Stack GapScale="LayoutGap.Small"
               Class="@ResolveStackCssClass(group.Key)"
               data-notification-position="@group.Key">
            @foreach (var message in group)
            {
                <div @key="message.Id"
                     class="@ResolveNotificationCssClass(message)"
                     style="@message.Style"
                     data-testid="@message.TestId"
                     @onclick="@(() => HandleMessageClick(message))">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Medium"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.NoWrap">
                        <div class="min-w-0 space-y-1">
                            @if (message.SummaryContent is not null)
                            {
                                <div class="text-sm font-semibold break-words">@message.SummaryContent(NotificationService)</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(message.Summary))
                            {
                                <div class="text-sm font-semibold break-words">@message.Summary</div>
                            }

                            @if (message.DetailContent is not null)
                            {
                                <div class="text-sm leading-6 break-words">@message.DetailContent(NotificationService)</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(message.Detail))
                            {
                                <div class="text-sm leading-6 break-words">@message.Detail</div>
                            }
                        </div>
                        <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.NoWrap" Class="shrink-0">
                            @if (CanCopy(message))
                            {
                                <span @onclick:stopPropagation="true">
                                    <CopyButton Value="@BuildCopyValue(message)"
                                                DisplayMode="CopyButtonDisplayMode.IconOnly"
                                                Size="CopyButtonSize.Small"
                                                AriaLabel="Copy notification details"
                                                title="Copy notification details" />
                                </span>
                            }
                            <button type="button"
                                    class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold leading-none hover:bg-current/10"
                                    aria-label="@message.CloseAriaLabel"
                                    title="@message.CloseAriaLabel"
                                    @onclick:stopPropagation="true"
                                    @onclick="@(() => DismissToastAsync(message))">
                                <Icon Name="close" />
                            </button>
                        </Cluster>
                    </Split>
                </div>
            }
        </Stack>
    }
</div>
}

@code {
    private readonly Guid rootOutletId = Guid.NewGuid();
    private IJSObjectReference? module;
    private DotNetObjectReference<Notification>? reference;
    private bool disposed;
    private long renderedAnnouncementVersion;

    [Parameter]
    public NotificationPosition Position { get; set; } = NotificationPosition.BottomCenter;

    [Parameter]
    public Guid? OutletId { get; set; }

    [Parameter]
    public bool IsModalOutlet { get; set; }

    private Guid PresentationOutlet => IsModalOutlet
        ? OutletId ?? throw new InvalidOperationException("A modal notification outlet requires its dialog identity.")
        : rootOutletId;

    protected override void OnInitialized()
    {
        NotificationService.Changed += HandleNotificationsChanged;
        if (!IsModalOutlet) {
            NotificationService.RegisterRoot(rootOutletId, Position);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (disposed) {
            return;
        }
        NotificationService.Presented(PresentationOutlet, renderedAnnouncementVersion);
        if (firstRender && !IsModalOutlet) {
            IJSObjectReference imported;
            try {
                imported = await JS.InvokeAsync<IJSObjectReference>("import",
                    "./_content/CanDoItAll.Components.BaseLib/Components/Feedback/Notification.razor.js");
            } catch (Exception exception) when (disposed && exception is JSDisconnectedException or OperationCanceledException) {
                return;
            }
            if (disposed) {
                try {
                    await imported.DisposeAsync();
                } catch (Exception exception) when (exception is JSDisconnectedException or OperationCanceledException) {
                }
                return;
            }
            module = imported;
            reference = DotNetObjectReference.Create(this);
            try {
                await module.InvokeVoidAsync("connect", rootOutletId, reference);
            } catch (Exception exception) when (disposed && exception is JSDisconnectedException or OperationCanceledException) {
            }
        }
    }

    [JSInvokable]
    public Task OnNotificationLayerChanged(Guid? outletId)
        => disposed ? Task.CompletedTask : InvokeAsync(() => NotificationService.SetActiveModal(outletId));

    private void HandleNotificationsChanged() {
        if (!disposed) {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private Task DismissToastAsync(NotificationMessage message)
    {
        NotificationService.Dismiss(message);
        return InvokeAsync(StateHasChanged);
    }

    private void HandleMessageClick(NotificationMessage message)
    {
        NotificationService.Click(message);
    }

    private static bool CanCopy(NotificationMessage message)
    {
        return message.Severity is NotificationSeverity.Warning or NotificationSeverity.Error &&
               (!string.IsNullOrWhiteSpace(message.Summary) || !string.IsNullOrWhiteSpace(message.Detail));
    }

    private static string BuildCopyValue(NotificationMessage message)
    {
        return string.Join(
            Environment.NewLine,
            new[] { message.Summary, message.Detail }
                .Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private IEnumerable<IGrouping<NotificationPosition, NotificationMessage>> GetMessageGroups()
    {
        return NotificationService.Snapshot().GroupBy(ResolveMessagePosition);
    }

    private NotificationPosition ResolveMessagePosition(NotificationMessage message)
    {
        return message.Position ?? NotificationService.DefaultPosition;
    }

    private static string ResolveNotificationCssClass(NotificationMessage message)
    {
        return CssClassBuilder.Join(
            "rounded-2xl border px-4 py-3 shadow-lg",
            GetSeverityCss(message.Severity),
            message.CloseOnClick ? "cursor-pointer" : null,
            message.Class);
    }

    private static string ResolveStackCssClass(NotificationPosition position)
    {
        return CssClassBuilder.Join(
            "rz-notification-stack pointer-events-auto fixed w-[min(24rem,calc(100vw-2rem))] max-w-sm",
            position switch
            {
                NotificationPosition.TopLeft => "left-4 top-4",
                NotificationPosition.TopCenter => "left-1/2 top-4 -translate-x-1/2",
                NotificationPosition.BottomRight => "bottom-4 right-4",
                NotificationPosition.BottomLeft => "bottom-4 left-4",
                NotificationPosition.BottomCenter => "bottom-4 left-1/2 -translate-x-1/2",
                NotificationPosition.CenterLeft => "left-4 top-1/2 -translate-y-1/2",
                NotificationPosition.CenterRight => "right-4 top-1/2 -translate-y-1/2",
                NotificationPosition.Center => "left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2",
                _ => "right-4 top-4"
            });
    }

    private static string GetSeverityCss(NotificationSeverity severity)
    {
        return severity switch
        {
            NotificationSeverity.Success => "border-(--tone-success-soft-border) bg-(--tone-success-soft-bg) text-(--tone-success-soft-fg)",
            NotificationSeverity.Warning => "border-(--tone-warning-soft-border) bg-(--tone-warning-soft-bg) text-(--tone-warning-soft-fg)",
            NotificationSeverity.Error => "border-(--tone-danger-soft-border) bg-(--tone-danger-soft-bg) text-(--tone-danger-soft-fg)",
            _ => "border-(--tone-info-soft-border) bg-(--tone-info-soft-bg) text-(--tone-info-soft-fg)"
        };
    }

    public async ValueTask DisposeAsync() {
        if (disposed) {
            return;
        }
        disposed = true;
        NotificationService.Changed -= HandleNotificationsChanged;
        if (!IsModalOutlet) {
            NotificationService.UnregisterRoot(rootOutletId);
        }
        try {
            if (module is not null) {
                try {
                    await module.InvokeVoidAsync("disconnect", rootOutletId);
                } finally {
                    await module.DisposeAsync();
                }
            }
        } catch (Exception exception) when (exception is JSDisconnectedException or OperationCanceledException) {
        } finally {
            reference?.Dispose();
        }
    }
}



