@namespace CanDoItAll.Components.BaseLib
<div role="alert" @attributes='AdditionalAttributes.WithClass(ResolveCssClass())'>
    @ChildContent
</div>

@code {
    /// <summary>Severity of the message, driving its tone and default coloring.</summary>
    [Parameter]
    public AlertStyle AlertStyle { get; set; } = AlertStyle.Info;

    /// <summary>Emphasis treatment: filled, outlined, or text.</summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Filled;

    /// <summary>Tonal shade applied on top of <see cref="AlertStyle"/>.</summary>
    [Parameter]
    public Shade Shade { get; set; } = Shade.Default;

    /// <summary>The alert's message content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Additional HTML attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ResolveCssClass()
    {
        var themeCss = AlertStyle switch
        {
            AlertStyle.Success => "cda-alert--tone-success",
            AlertStyle.Warning => "cda-alert--tone-warning",
            AlertStyle.Danger => "cda-alert--tone-danger",
            AlertStyle.Light => "cda-alert--tone-base",
            AlertStyle.Secondary => "cda-alert--tone-secondary",
            _ => "cda-alert--tone-info"
        };

        return $"rz-alert cda-alert {themeCss}";
    }
}






