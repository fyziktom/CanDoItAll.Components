@namespace CanDoItAll.Components.FileBrowser.BaseLib

<nav class="cda-file-browser-sources" aria-label="File sources" data-testid="file-browser-sources">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="cda-file-browser-sources__heading">@Title</div>
    }
    <div class="cda-file-browser-sources__items">
        @foreach (var source in Snapshot.Sources)
        {
            var isCurrent = source.Id == Snapshot.CurrentSource?.Id;
            <button @key="source.Id"
                    type="button"
                    class="cda-file-browser-sources__item @(isCurrent ? "is-current" : null)"
                    aria-pressed="@isCurrent"
                    disabled="@Snapshot.IsBusy"
                    @onclick="() => SourceChanged.InvokeAsync(source.Id)"
                    data-source-id="@source.Id.Value">
                <span class="cda-file-browser-sources__icon"><Icon Name="@source.Icon" /></span>
                <span class="cda-file-browser-sources__copy">
                    <span class="cda-file-browser-sources__name">@source.DisplayName</span>
                    @if (!string.IsNullOrWhiteSpace(source.Description))
                    {
                        <span class="cda-file-browser-sources__description">@source.Description</span>
                    }
                </span>
            </button>
        }
    </div>
</nav>

@code {
    [Parameter, EditorRequired]
    public FileBrowserSnapshot Snapshot { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Sources";

    [Parameter]
    public EventCallback<FileBrowserSourceId> SourceChanged { get; set; }
}
