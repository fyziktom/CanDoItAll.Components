@namespace CanDoItAll.Components.FileBrowser.BaseLib

<div class="cda-file-browser__list" role="region" aria-label="Files and folders">
    <table class="cda-file-browser__table">
        <caption class="sr-only">Files and folders in the current location</caption>
        <thead>
            <tr>
                <th class="cda-file-browser__selection-column"><span class="sr-only">Selection</span></th>
                <th scope="col" aria-sort="@ResolveAriaSort(FileBrowserSortField.Name)">
                    @RenderSortControl(FileBrowserSortField.Name, "Name")
                </th>
                <th scope="col" class="cda-file-browser__owner-column" aria-sort="@ResolveAriaSort(FileBrowserSortField.Owner)">
                    @RenderSortControl(FileBrowserSortField.Owner, "Owner")
                </th>
                <th scope="col" class="cda-file-browser__modified-column" aria-sort="@ResolveAriaSort(FileBrowserSortField.ModifiedAt)">
                    @RenderSortControl(FileBrowserSortField.ModifiedAt, "Modified")
                </th>
                <th scope="col" class="cda-file-browser__size-column" aria-sort="@ResolveAriaSort(FileBrowserSortField.Size)">
                    @RenderSortControl(FileBrowserSortField.Size, "Size")
                </th>
                <th scope="col" class="cda-file-browser__type-column" aria-sort="@ResolveAriaSort(FileBrowserSortField.Type)">
                    @RenderSortControl(FileBrowserSortField.Type, "Type")
                </th>
                <th scope="col" class="cda-file-browser__actions-column"><span class="sr-only">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Snapshot.Items)
            {
                var selected = Snapshot.SelectedKeys.Contains(item.Key);
                <tr @key="item.Key"
                    class="cda-file-browser__row @(selected ? "is-selected" : null)"
                    aria-selected="@(CanSelect(item) ? selected.ToString().ToLowerInvariant() : null)"
                    data-item-key="@item.Key.Value"
                    @oncontextmenu="args => OpenMenuAsync(item, args)"
                    @oncontextmenu:preventDefault="true">
                    <td class="cda-file-browser__selection-column">
                        @if (CanSelect(item))
                        {
                            <span @onclick:stopPropagation="true">
                                <CheckBox TValue="bool"
                                          Value="@selected"
                                          ValueChanged="value => ToggleSelectionAsync(item, value)"
                                          aria-label="@($"Select {item.Name}")" />
                            </span>
                        }
                    </td>
                    <td class="cda-file-browser__name-cell">
                        @if (CanActivate(item))
                        {
                            <button type="button"
                                    class="cda-file-browser__item-main"
                                    @onclick="() => HandleMainClickAsync(item)"
                                    @ondblclick="() => HandleDoubleClickAsync(item)"
                                    @onkeyup="args => HandleItemKeyUpAsync(item, args)"
                                    aria-label="@BuildMainLabel(item)">
                                <FileBrowserItemIdentity Item="@item" ShowPath="@Snapshot.IncludeDescendants" />
                            </button>
                        }
                        else
                        {
                            <div class="cda-file-browser__item-main">
                                <FileBrowserItemIdentity Item="@item" ShowPath="@Snapshot.IncludeDescendants" />
                            </div>
                        }
                    </td>
                    <td class="cda-file-browser__owner-column">@(item.Owner ?? "—")</td>
                    <td class="cda-file-browser__modified-column">@FileBrowserDisplayFormatter.FormatDate(item.ModifiedAt)</td>
                    <td class="cda-file-browser__size-column">@(item.IsContainer ? "—" : FileBrowserDisplayFormatter.FormatSize(item.Size))</td>
                    <td class="cda-file-browser__type-column">@FileBrowserDisplayFormatter.FormatType(item)</td>
                    <td class="cda-file-browser__actions-column">
                        <FileBrowserItemActions Item="@item"
                                                IsMenuOpen="@(OpenMenuItemKey == item.Key)"
                                                ActionRequested="ActionRequested"
                                                MenuRequested="MenuRequested" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public FileBrowserSnapshot Snapshot { get; set; } = default!;

    [Parameter]
    public EventCallback<FileBrowserItem> SelectRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItem> ToggleSelectionRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItemInvokedEventArgs> InvokeRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserSortField> SortRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItemActionEventArgs> ActionRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserActionMenuRequest> MenuRequested { get; set; }

    [Parameter]
    public FileBrowserItemKey? OpenMenuItemKey { get; set; }

    private Task ToggleSelectionAsync(FileBrowserItem item, bool selected)
        => ToggleSelectionRequested.InvokeAsync(item);

    private Task InvokeAsync(FileBrowserItem item, FileBrowserInvocationKind kind)
        => InvokeRequested.InvokeAsync(new FileBrowserItemInvokedEventArgs(item, kind));

    private Task OpenMenuAsync(FileBrowserItem item, MouseEventArgs args)
        => MenuRequested.InvokeAsync(new FileBrowserActionMenuRequest(item, args.ClientX, args.ClientY));

    private Task HandleItemKeyUpAsync(FileBrowserItem item, KeyboardEventArgs args)
        => args.Key == "Enter" && CanSelect(item) && CanInvoke(item)
            ? InvokeAsync(item, FileBrowserInvocationKind.Keyboard)
            : Task.CompletedTask;

    private Task HandleMainClickAsync(FileBrowserItem item)
        => CanSelect(item)
            ? SelectRequested.InvokeAsync(item)
            : CanInvoke(item)
                ? InvokeAsync(item, FileBrowserInvocationKind.PrimaryAction)
                : Task.CompletedTask;

    private Task HandleDoubleClickAsync(FileBrowserItem item)
        => CanSelect(item) && CanInvoke(item)
            ? InvokeAsync(item, FileBrowserInvocationKind.PointerDoubleClick)
            : Task.CompletedTask;

    private static bool CanSelect(FileBrowserItem item)
        => item.Supports(FileBrowserItemCapabilities.Select);

    private static bool CanInvoke(FileBrowserItem item)
        => item.IsContainer
            ? item.Supports(FileBrowserItemCapabilities.Navigate) || item.Supports(FileBrowserItemCapabilities.Open)
            : item.Supports(FileBrowserItemCapabilities.Open) || item.Supports(FileBrowserItemCapabilities.Preview);

    private static bool CanActivate(FileBrowserItem item) => CanSelect(item) || CanInvoke(item);

    private static string BuildMainLabel(FileBrowserItem item)
        => CanSelect(item) && CanInvoke(item)
            ? $"Select {item.Name}; press Enter or double-click to open"
            : CanSelect(item)
                ? $"Select {item.Name}"
                : $"Open {item.Name}";

    private string? ResolveAriaSort(FileBrowserSortField field)
        => !CanSort(field) || Snapshot.Sort.Field != field
            ? null
            : Snapshot.Sort.Direction == FileBrowserSortDirection.Ascending
                ? "ascending"
                : "descending";

    private bool CanSort(FileBrowserSortField field)
        => Snapshot.CurrentSource?.SupportedSortFields.Contains(field) == true;

    private RenderFragment RenderSortControl(FileBrowserSortField field, string label)
        => builder =>
        {
            if (!CanSort(field))
            {
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", "cda-file-browser__sort-label");
                builder.AddContent(2, label);
                builder.CloseElement();
                return;
            }

            builder.OpenElement(0, "button");
            builder.AddAttribute(1, "type", "button");
            builder.AddAttribute(2, "class", "cda-file-browser__sort-button");
            builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => SortRequested.InvokeAsync(field)));
            builder.AddContent(4, label);
            if (Snapshot.Sort.Field == field)
            {
                builder.OpenComponent<Icon>(5);
                builder.AddAttribute(6, nameof(Icon.Name), Snapshot.Sort.Direction == FileBrowserSortDirection.Ascending ? "arrow_upward" : "arrow_downward");
                builder.AddAttribute(7, nameof(Icon.Class), "cda-file-browser__sort-icon");
                builder.CloseComponent();
            }

            builder.CloseElement();
        };
}
