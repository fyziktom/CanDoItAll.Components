@namespace CanDoItAll.Components.FileBrowser.BaseLib
@implements IAsyncDisposable

<section class="cda-file-browser @Class"
         aria-label="@AriaLabel"
         aria-busy="@Snapshot.IsBusy"
         data-view-mode="@viewMode.ToString().ToLowerInvariant()"
         data-testid="file-browser">
    <FileBrowserBreadcrumbs Snapshot="@Snapshot"
                            BackRequested="GoBackAsync"
                            ForwardRequested="GoForwardAsync"
                            UpRequested="GoUpAsync"
                            NavigateRequested="NavigateAsync" />

    <FileBrowserToolbar Snapshot="@Snapshot"
                        SearchText="@searchText"
                        SearchTextChanged="HandleSearchTextChangedAsync"
                        SearchScope="@searchScope"
                        SearchScopeChanged="HandleSearchScopeChangedAsync"
                        ViewMode="@viewMode"
                        ViewModeChanged="HandleViewModeChangedAsync"
                        CategoryChanged="HandleCategoryChangedAsync"
                        SortChanged="HandleSortChangedAsync"
                        SortDirectionReversed="ReverseSortAsync"
                        IncludeDescendantsChanged="SetIncludeDescendantsAsync"
                        RefreshRequested="RefreshAsync" />

    @if (Snapshot.Error is not null)
    {
        <Alert AlertStyle="@(Snapshot.Error.IsRetryable ? AlertStyle.Warning : AlertStyle.Danger)"
               data-testid="file-browser-error">
            <div class="cda-file-browser__alert-content">
                <span><strong>@Snapshot.Error.Code:</strong> @Snapshot.Error.Message</span>
                @if (Snapshot.Error.IsRetryable)
                {
                    <Button Text="Retry"
                            Icon="refresh"
                            ButtonStyle="ButtonStyle.Light"
                            Variant="Variant.Outlined"
                            Size="ButtonSize.Small"
                            Click="RetryAsync"
                            data-testid="file-browser-retry" />
                }
            </div>
        </Alert>
    }
    else if (Snapshot.Warnings.Count > 0 || Snapshot.BrowseCompleteness == FileBrowserCompleteness.Partial)
    {
        <Alert AlertStyle="AlertStyle.Info" data-testid="file-browser-partial-warning">
            @(Snapshot.Warnings.Count > 0
                ? Snapshot.Warnings[0].Message
                : "The source returned a partial folder result. More content may exist beyond this response.")
        </Alert>
    }

    <div class="cda-file-browser__results"
         aria-busy="@ResultsAreReplacing"
         inert="@(ResultsAreReplacing ? string.Empty : null)"
         data-testid="file-browser-results">
        @if (Snapshot.Error is not null && Snapshot.Items.Count == 0)
        {
            <EmptyState Eyebrow="File browser"
                        Title="Unable to load this folder"
                        Description="The source returned no folder page. Use Retry above when the failure is temporary." />
        }
        else if (Snapshot.CurrentSource is null)
        {
            <LoadingState Eyebrow="File browser" Title="Preparing sources" Description="Loading the first bounded folder page." />
        }
        else if (Snapshot.Items.Count == 0
                 && Snapshot.Operation is FileBrowserOperationKind.Initializing
                     or FileBrowserOperationKind.LoadingFolder
                     or FileBrowserOperationKind.Refreshing
                     or FileBrowserOperationKind.Searching
                     or FileBrowserOperationKind.LoadingMore)
        {
            <LoadingState Eyebrow="File browser" Title="Loading items" Description="The source is resolving only the requested page." />
        }
        else if (Snapshot.Items.Count == 0)
        {
            <EmptyState Eyebrow="File browser"
                        Title="@(Snapshot.Search is null ? "This folder is empty" : "No matching items")"
                        Description="@(Snapshot.Search is null ? "There are no files or folders in this location." : "Try another phrase, type, or search scope.")">
                <Actions>
                    @if (Snapshot.Search is not null)
                    {
                        <Button Text="Clear search" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Click="ClearSearchAsync" />
                    }
                    else
                    {
                        <Button Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Click="RefreshAsync" />
                    }
                </Actions>
            </EmptyState>
        }
        else if (viewMode == FileBrowserViewMode.List)
        {
            <FileBrowserListView Snapshot="@Snapshot"
                                 SelectRequested="SelectItem"
                                 ToggleSelectionRequested="ToggleSelection"
                                 InvokeRequested="InvokeItemAsync"
                                 SortRequested="HandleSortRequestedAsync"
                                 ActionRequested="HandleActionRequestedAsync"
                                 OpenMenuItemKey="@(menuOpen ? menuItem?.Key : null)"
                                 MenuRequested="OpenMenu" />
        }
        else
        {
            <FileBrowserCardView Snapshot="@Snapshot"
                                 SelectRequested="SelectItem"
                                 ToggleSelectionRequested="ToggleSelection"
                                 InvokeRequested="InvokeItemAsync"
                                 ActionRequested="HandleActionRequestedAsync"
                                 OpenMenuItemKey="@(menuOpen ? menuItem?.Key : null)"
                                 MenuRequested="OpenMenu" />
        }

        @if (Snapshot.HasMore)
        {
            <div class="cda-file-browser__load-more">
                <Button Text="Load more"
                        Icon="expand_more"
                        ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Outlined"
                        IsBusy="@(Snapshot.Operation == FileBrowserOperationKind.LoadingMore)"
                        Disabled="@Snapshot.IsBusy"
                        Click="LoadMoreAsync"
                        data-testid="file-browser-load-more" />
            </div>
        }
    </div>

    <FileBrowserStatusBar Snapshot="@Snapshot" />

    <ContextMenu IsOpen="@menuOpen"
                 X="@menuX"
                 Y="@menuY"
                 Heading="@menuItem?.Name"
                 Description="@menuItem?.DisplayPath"
                 Items="@menuItems"
                 ItemSelected="HandleMenuItemSelectedAsync"
                 OnClose="CloseMenuAsync"
                 TestId="file-browser-context-menu"
                 AriaLabel="File actions" />
</section>
