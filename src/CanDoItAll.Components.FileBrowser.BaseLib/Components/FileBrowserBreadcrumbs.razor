@namespace CanDoItAll.Components.FileBrowser.BaseLib

<nav class="cda-file-browser__location" aria-label="Current folder" data-testid="file-browser-breadcrumbs">
    <div class="cda-file-browser__history-actions">
        <TooltipTarget Text="Back">
            <Button Icon="arrow_back"
                    ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Text"
                    Size="ButtonSize.Small"
                    Disabled="@(Snapshot.IsBusy || !Snapshot.CanGoBack)"
                    Click="BackRequested"
                    aria-label="Back"
                    data-testid="file-browser-back" />
        </TooltipTarget>
        <TooltipTarget Text="Forward">
            <Button Icon="arrow_forward"
                    ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Text"
                    Size="ButtonSize.Small"
                    Disabled="@(Snapshot.IsBusy || !Snapshot.CanGoForward)"
                    Click="ForwardRequested"
                    aria-label="Forward"
                    data-testid="file-browser-forward" />
        </TooltipTarget>
        <TooltipTarget Text="Up one level">
            <Button Icon="arrow_upward"
                    ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Text"
                    Size="ButtonSize.Small"
                    Disabled="@(Snapshot.IsBusy || !Snapshot.CanGoUp)"
                    Click="UpRequested"
                    aria-label="Up one level"
                    data-testid="file-browser-up" />
        </TooltipTarget>
    </div>

    <ol class="cda-file-browser__breadcrumb-list">
        @if (Snapshot.Location is not null)
        {
            @for (var index = 0; index < VisiblePath.Count; index++)
            {
                var item = VisiblePath[index];
                var isCurrent = item.Key == Snapshot.Location.Key;
                @if (PathIsTruncated && index == 1)
                {
                    <li class="cda-file-browser__breadcrumb-item cda-file-browser__breadcrumb-ellipsis"
                        aria-label="@($"{OmittedPathCount} intermediate folders omitted")">
                        <Icon Name="chevron_right" Class="cda-file-browser__breadcrumb-separator" />
                        <span aria-hidden="true">…</span>
                    </li>
                }
                <li @key="item.Key" class="cda-file-browser__breadcrumb-item">
                    @if (item.Key != VisiblePath[0].Key)
                    {
                        <Icon Name="chevron_right" Class="cda-file-browser__breadcrumb-separator" />
                    }
                    @if (isCurrent)
                    {
                        <span class="cda-file-browser__breadcrumb-current" aria-current="page">@item.Name</span>
                    }
                    else
                    {
                        <button type="button"
                                class="cda-file-browser__breadcrumb-button"
                                disabled="@Snapshot.IsBusy"
                                @onclick="() => NavigateRequested.InvokeAsync(item.Key)">@item.Name</button>
                    }
                </li>
            }
        }
    </ol>
</nav>

@code {
    [Parameter, EditorRequired]
    public FileBrowserSnapshot Snapshot { get; set; } = default!;

    [Parameter]
    public EventCallback BackRequested { get; set; }

    [Parameter]
    public EventCallback ForwardRequested { get; set; }

    [Parameter]
    public EventCallback UpRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItemKey> NavigateRequested { get; set; }

    private IReadOnlyList<FileBrowserItem> VisiblePath
    {
        get
        {
            var path = Snapshot.Location?.Path ?? [];
            if (path.Count <= 5)
            {
                return path;
            }

            return [path[0], path[^3], path[^2], path[^1]];
        }
    }

    private bool PathIsTruncated => Snapshot.Location?.Path.Count > 5;

    private int OmittedPathCount => Math.Max(0, (Snapshot.Location?.Path.Count ?? 0) - 4);
}
