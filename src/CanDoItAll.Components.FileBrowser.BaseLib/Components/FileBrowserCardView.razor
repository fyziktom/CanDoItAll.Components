@namespace CanDoItAll.Components.FileBrowser.BaseLib

<Grid ColumnTemplate="repeat(auto-fit,minmax(min(13rem,100%),1fr))"
      Gap="LayoutGap.Medium"
      Class="cda-file-browser__card-grid"
      role="list">
    @foreach (var item in Snapshot.Items)
    {
        var selected = Snapshot.SelectedKeys.Contains(item.Key);
        <article @key="item.Key"
                 class="cda-file-browser__card-shell @(selected ? "is-selected" : null)"
                 role="listitem"
                 data-item-key="@item.Key.Value"
                 data-selected="@selected"
                 @oncontextmenu="args => OpenMenuAsync(item, args)"
                 @oncontextmenu:preventDefault="true">
            <Card Class="cda-file-browser__card">
                @if (CanActivate(item))
                {
                    <button type="button"
                            class="cda-file-browser__card-main"
                            aria-pressed="@(CanSelect(item) ? selected.ToString().ToLowerInvariant() : null)"
                            @onclick="() => HandleMainClickAsync(item)"
                            @ondblclick="() => HandleDoubleClickAsync(item)"
                            @onkeyup="args => HandleKeyUpAsync(item, args)"
                            aria-label="@BuildMainLabel(item)">
                        <FileBrowserCardIdentity Item="@item" />
                    </button>
                }
                else
                {
                    <div class="cda-file-browser__card-main">
                        <FileBrowserCardIdentity Item="@item" />
                    </div>
                }

                <div class="cda-file-browser__card-footer">
                    @if (CanSelect(item))
                    {
                        <label class="cda-file-browser__card-select" @onclick:stopPropagation="true">
                            <CheckBox TValue="bool"
                                      Value="@selected"
                                      ValueChanged="value => ToggleSelectionRequested.InvokeAsync(item)"
                                      aria-label="@($"Select {item.Name}")" />
                            <span class="sr-only">Select @item.Name</span>
                        </label>
                    }
                    <FileBrowserItemActions Item="@item"
                                            IsMenuOpen="@(OpenMenuItemKey == item.Key)"
                                            ActionRequested="ActionRequested"
                                            MenuRequested="MenuRequested" />
                </div>
            </Card>
        </article>
    }
</Grid>

@code {
    [Parameter, EditorRequired]
    public FileBrowserSnapshot Snapshot { get; set; } = default!;

    [Parameter]
    public EventCallback<FileBrowserItem> SelectRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItem> ToggleSelectionRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItemInvokedEventArgs> InvokeRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItemActionEventArgs> ActionRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserActionMenuRequest> MenuRequested { get; set; }

    [Parameter]
    public FileBrowserItemKey? OpenMenuItemKey { get; set; }

    private Task InvokeAsync(FileBrowserItem item, FileBrowserInvocationKind kind)
        => InvokeRequested.InvokeAsync(new FileBrowserItemInvokedEventArgs(item, kind));

    private Task OpenMenuAsync(FileBrowserItem item, MouseEventArgs args)
        => MenuRequested.InvokeAsync(new FileBrowserActionMenuRequest(item, args.ClientX, args.ClientY));

    private Task HandleKeyUpAsync(FileBrowserItem item, KeyboardEventArgs args)
        => args.Key == "Enter" && CanSelect(item) && CanInvoke(item)
            ? InvokeAsync(item, FileBrowserInvocationKind.Keyboard)
            : Task.CompletedTask;

    private Task HandleMainClickAsync(FileBrowserItem item)
        => CanSelect(item)
            ? SelectRequested.InvokeAsync(item)
            : CanInvoke(item)
                ? InvokeAsync(item, FileBrowserInvocationKind.PrimaryAction)
                : Task.CompletedTask;

    private Task HandleDoubleClickAsync(FileBrowserItem item)
        => CanSelect(item) && CanInvoke(item)
            ? InvokeAsync(item, FileBrowserInvocationKind.PointerDoubleClick)
            : Task.CompletedTask;

    private static bool CanSelect(FileBrowserItem item)
        => item.Supports(FileBrowserItemCapabilities.Select);

    private static bool CanInvoke(FileBrowserItem item)
        => item.IsContainer
            ? item.Supports(FileBrowserItemCapabilities.Navigate) || item.Supports(FileBrowserItemCapabilities.Open)
            : item.Supports(FileBrowserItemCapabilities.Open) || item.Supports(FileBrowserItemCapabilities.Preview);

    private static bool CanActivate(FileBrowserItem item) => CanSelect(item) || CanInvoke(item);

    private static string BuildMainLabel(FileBrowserItem item)
        => CanSelect(item) && CanInvoke(item)
            ? $"Select {item.Name}; press Enter or double-click to open"
            : CanSelect(item)
                ? $"Select {item.Name}"
                : $"Open {item.Name}";
}
