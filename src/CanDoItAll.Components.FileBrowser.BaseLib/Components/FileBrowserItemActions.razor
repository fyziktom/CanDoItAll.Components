@namespace CanDoItAll.Components.FileBrowser.BaseLib
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div class="cda-file-browser__item-actions" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
    @if (Item.Supports(FileBrowserItemCapabilities.CopyPath) && !string.IsNullOrWhiteSpace(Item.DisplayPath))
    {
        <TooltipTarget Text="Copy path">
            <CopyButton Value="@Item.DisplayPath"
                        DisplayMode="CopyButtonDisplayMode.IconOnly"
                        Size="CopyButtonSize.ExtraSmall"
                        AriaLabel="@($"Copy path for {Item.Name}")"
                        data-testid="file-browser-copy-path" />
        </TooltipTarget>
    }

    @if (Item.Supports(FileBrowserItemCapabilities.CopyContentIdentity) && Item.ContentIdentity is not null)
    {
        <TooltipTarget Text="Copy content ID">
            <CopyButton Value="@Item.ContentIdentity.Value"
                        Icon="fingerprint"
                        DisplayMode="CopyButtonDisplayMode.IconOnly"
                        Size="CopyButtonSize.ExtraSmall"
                        AriaLabel="@($"Copy content ID for {Item.Name}")"
                        data-testid="file-browser-copy-content-id" />
        </TooltipTarget>
    }

    @if (Item.Supports(FileBrowserItemCapabilities.OpenInNewTab))
    {
        <TooltipTarget Text="Open in new tab">
            @if (!string.IsNullOrWhiteSpace(Item.OpenUri))
            {
                <Button Icon="open_in_new"
                        Href="@Item.OpenUri"
                        Target="_blank"
                        ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Text"
                        Size="ButtonSize.Small"
                        Class="cda-file-browser__quick-action"
                        aria-label="@($"Open {Item.Name} in new tab")"
                        data-testid="file-browser-open-new-tab" />
            }
            else
            {
                <Button Icon="open_in_new"
                        ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Text"
                        Size="ButtonSize.Small"
                        Class="cda-file-browser__quick-action"
                        Click="@(() => ActionRequested.InvokeAsync(new FileBrowserItemActionEventArgs(Item, FileBrowserActionIds.OpenInNewTab)))"
                        aria-label="@($"Open {Item.Name} in new tab")"
                        data-testid="file-browser-open-new-tab" />
            }
        </TooltipTarget>
    }

    @if (Item.Supports(FileBrowserItemCapabilities.DownloadFile)
        || Item.Supports(FileBrowserItemCapabilities.DownloadDirectory))
    {
        <TooltipTarget Text="Download">
            @if (!string.IsNullOrWhiteSpace(Item.DownloadUri))
            {
                <Button Icon="download"
                        Href="@Item.DownloadUri"
                        ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Text"
                        Size="ButtonSize.Small"
                        Class="cda-file-browser__quick-action"
                        download=""
                        aria-label="@($"Download {Item.Name}")"
                        data-testid="file-browser-download" />
            }
            else
            {
                <Button Icon="download"
                        ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Text"
                        Size="ButtonSize.Small"
                        Class="cda-file-browser__quick-action"
                        Click="@(() => ActionRequested.InvokeAsync(new FileBrowserItemActionEventArgs(Item, FileBrowserActionIds.Download)))"
                        aria-label="@($"Download {Item.Name}")"
                        data-testid="file-browser-download" />
            }
        </TooltipTarget>
    }

    @if (HasOverflowActions)
    {
        <span @ref="menuTriggerElement"
              class="cda-file-browser__more-trigger"
              @onclick="OpenMenuAsync"
              @onclick:stopPropagation="true">
            <TooltipTarget Text="More actions">
                <Button Icon="more_vert"
                        ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Text"
                        Size="ButtonSize.Small"
                        Class="cda-file-browser__quick-action"
                        aria-label="@($"More actions for {Item.Name}")"
                        aria-haspopup="menu"
                        aria-expanded="@IsMenuOpen"
                        data-testid="file-browser-more-actions" />
            </TooltipTarget>
        </span>
    }
</div>

@code {
    private const string ModulePath = "./_content/CanDoItAll.Components.FileBrowser.BaseLib/Components/FileBrowserItemActions.razor.js";
    private ElementReference menuTriggerElement;
    private IJSObjectReference? module;

    [Parameter, EditorRequired]
    public FileBrowserItem Item { get; set; } = default!;

    [Parameter]
    public bool IsMenuOpen { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItemActionEventArgs> ActionRequested { get; set; }

    [Parameter]
    public EventCallback<FileBrowserActionMenuRequest> MenuRequested { get; set; }

    private bool HasOverflowActions
        => (Item.IsContainer
                ? Item.Supports(FileBrowserItemCapabilities.Navigate) || Item.Supports(FileBrowserItemCapabilities.Open)
                : Item.Supports(FileBrowserItemCapabilities.Open))
            || Item.Supports(FileBrowserItemCapabilities.OpenInNewTab)
            || Item.Supports(FileBrowserItemCapabilities.CopyPath) && !string.IsNullOrWhiteSpace(Item.DisplayPath)
            || Item.Supports(FileBrowserItemCapabilities.CopyContentIdentity) && Item.ContentIdentity is not null
            || Item.Supports(FileBrowserItemCapabilities.DownloadFile)
            || Item.Supports(FileBrowserItemCapabilities.DownloadDirectory)
            || Item.Supports(FileBrowserItemCapabilities.CustomActions);

    private async Task OpenMenuAsync(MouseEventArgs args)
    {
        var x = args.ClientX;
        var y = args.ClientY;
        if (x == 0 && y == 0)
        {
            module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", ModulePath);
            var anchor = await module.InvokeAsync<MenuAnchorPoint>("getCenter", menuTriggerElement);
            x = anchor.X;
            y = anchor.Y;
        }

        await MenuRequested.InvokeAsync(new FileBrowserActionMenuRequest(Item, x, y));
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record MenuAnchorPoint(double X, double Y);
}
