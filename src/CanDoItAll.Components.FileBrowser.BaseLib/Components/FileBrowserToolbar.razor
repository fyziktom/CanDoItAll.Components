@namespace CanDoItAll.Components.FileBrowser.BaseLib

<div class="cda-file-browser__toolbar" data-testid="file-browser-toolbar">
    <div class="cda-file-browser__search-field">
        <Icon Name="search" Class="cda-file-browser__search-icon" />
        <TextBox Value="@SearchText"
                 ValueChanged="HandleSearchTextInputAsync"
                 Immediate="true"
                 Placeholder="Search files and folders"
                 aria-label="Search files and folders"
                 data-testid="file-browser-search" />
        @if (!string.IsNullOrWhiteSpace(SearchText))
        {
            <Button Icon="close"
                    ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Text"
                    Size="ButtonSize.Small"
                    Class="cda-file-browser__search-clear"
                    Click="ClearSearchAsync"
                    aria-label="Clear search"
                    data-testid="file-browser-search-clear" />
        }
    </div>

    <div class="cda-file-browser__toolbar-fields">
        <DropDown TValue="string"
                  Data="@SearchScopeChoices"
                  TextProperty="Text"
                  ValueProperty="Value"
                  Value="@SearchScope.ToString()"
                  ValueChanged="HandleSearchScopeChangedAsync"
                  aria-label="Search scope"
                  data-testid="file-browser-search-scope" />

        <DropDown TValue="string"
                  Data="@CategoryChoices"
                  TextProperty="Text"
                  ValueProperty="Value"
                  Value="@CategoryValue"
                  ValueChanged="HandleCategoryChangedAsync"
                  Disabled="@Snapshot.IsBusy"
                  aria-label="File type filter"
                  data-testid="file-browser-type-filter" />

        <DropDown TValue="string"
                  Data="@SortChoices"
                  TextProperty="Text"
                  ValueProperty="Value"
                  Value="@Snapshot.Sort.Field.ToString()"
                  ValueChanged="HandleSortChangedAsync"
                  Disabled="@Snapshot.IsBusy"
                  aria-label="Sort field"
                  data-testid="file-browser-sort-field" />

        <TooltipTarget Text="Reverse sort direction">
            <Button Icon="@(Snapshot.Sort.Direction == FileBrowserSortDirection.Ascending ? "arrow_upward" : "arrow_downward")"
                    ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Outlined"
                    Size="ButtonSize.Small"
                    Disabled="@Snapshot.IsBusy"
                    Click="ReverseSortAsync"
                    aria-label="Reverse sort direction"
                    data-testid="file-browser-sort-direction" />
        </TooltipTarget>
    </div>

    <div class="cda-file-browser__toolbar-actions">
        @if (Snapshot.CurrentSource?.Supports(FileBrowserSourceCapabilities.RecursiveBrowse) == true)
        {
            <label class="cda-file-browser__recursive-toggle">
                <CheckBox TValue="bool"
                          Value="@Snapshot.IncludeDescendants"
                          ValueChanged="HandleIncludeDescendantsChangedAsync"
                          Disabled="@Snapshot.IsBusy"
                          aria-label="Include files from subprojects" />
                <span>Include subprojects</span>
            </label>
        }

        <TooltipTarget Text="Refresh folder">
            <Button Icon="refresh"
                    ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Text"
                    Size="ButtonSize.Small"
                    IsBusy="@(Snapshot.Operation == FileBrowserOperationKind.Refreshing)"
                    Disabled="@Snapshot.IsBusy"
                    Click="RefreshRequested"
                    aria-label="Refresh folder"
                    data-testid="file-browser-refresh" />
        </TooltipTarget>

        <div class="cda-file-browser__view-toggle" role="group" aria-label="View mode">
            <Button Icon="view_list"
                    ButtonStyle="@(ViewMode == FileBrowserViewMode.List ? ButtonStyle.Info : ButtonStyle.Light)"
                    Variant="@(ViewMode == FileBrowserViewMode.List ? Variant.Filled : Variant.Text)"
                    Size="ButtonSize.Small"
                    Click="@(() => ViewModeChanged.InvokeAsync(FileBrowserViewMode.List))"
                    aria-label="List view"
                    aria-pressed="@(ViewMode == FileBrowserViewMode.List)"
                    data-testid="file-browser-view-list" />
            <Button Icon="grid_view"
                    ButtonStyle="@(ViewMode == FileBrowserViewMode.Cards ? ButtonStyle.Info : ButtonStyle.Light)"
                    Variant="@(ViewMode == FileBrowserViewMode.Cards ? Variant.Filled : Variant.Text)"
                    Size="ButtonSize.Small"
                    Click="@(() => ViewModeChanged.InvokeAsync(FileBrowserViewMode.Cards))"
                    aria-label="Card view"
                    aria-pressed="@(ViewMode == FileBrowserViewMode.Cards)"
                    data-testid="file-browser-view-cards" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public FileBrowserSnapshot Snapshot { get; set; } = default!;

    [Parameter]
    public string? SearchText { get; set; }

    [Parameter]
    public EventCallback<string?> SearchTextChanged { get; set; }

    [Parameter]
    public FileBrowserSearchScope SearchScope { get; set; } = FileBrowserSearchScope.LoadedFolder;

    [Parameter]
    public EventCallback<FileBrowserSearchScope> SearchScopeChanged { get; set; }

    [Parameter]
    public FileBrowserViewMode ViewMode { get; set; }

    [Parameter]
    public EventCallback<FileBrowserViewMode> ViewModeChanged { get; set; }

    [Parameter]
    public EventCallback<FileBrowserItemCategory?> CategoryChanged { get; set; }

    [Parameter]
    public EventCallback<FileBrowserSortField> SortChanged { get; set; }

    [Parameter]
    public EventCallback SortDirectionReversed { get; set; }

    [Parameter]
    public EventCallback<bool> IncludeDescendantsChanged { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    private string CategoryValue
        => Snapshot.Filter.Categories.Count == 1
            ? Snapshot.Filter.Categories.Single().ToString()
            : "All";

    private IReadOnlyList<FileBrowserChoice<string>> SearchScopeChoices
        => Snapshot.AvailableSearchScopes
            .Select(scope => new FileBrowserChoice<string>(FormatScope(scope), scope.ToString()))
            .ToArray();

    private static IReadOnlyList<FileBrowserChoice<string>> CategoryChoices { get; } =
    [
        new("All types", "All"),
        new("Folders", FileBrowserItemCategory.Folder.ToString()),
        new("Documents", FileBrowserItemCategory.Document.ToString()),
        new("Images", FileBrowserItemCategory.Image.ToString()),
        new("Video", FileBrowserItemCategory.Video.ToString()),
        new("Audio", FileBrowserItemCategory.Audio.ToString()),
        new("Code", FileBrowserItemCategory.Code.ToString()),
        new("Data", FileBrowserItemCategory.Data.ToString()),
        new("Archives", FileBrowserItemCategory.Archive.ToString()),
        new("Links", FileBrowserItemCategory.Link.ToString()),
        new("Other", FileBrowserItemCategory.Other.ToString())
    ];

    private IReadOnlyList<FileBrowserChoice<string>> SortChoices
        => (Snapshot.CurrentSource?.SupportedSortFields ?? Enum.GetValues<FileBrowserSortField>().ToHashSet())
            .Select(sortField => new FileBrowserChoice<string>(FormatSort(sortField), sortField.ToString()))
            .ToArray();

    private Task ClearSearchAsync() => HandleSearchTextInputAsync(string.Empty);

    private Task HandleSearchTextInputAsync(string? value)
    {
        SearchText = value;
        return SearchTextChanged.InvokeAsync(value);
    }

    private Task HandleSearchScopeChangedAsync(string? value)
        => Enum.TryParse<FileBrowserSearchScope>(value, out var scope)
            ? SearchScopeChanged.InvokeAsync(scope)
            : Task.CompletedTask;

    private Task HandleCategoryChangedAsync(string? value)
        => string.Equals(value, "All", StringComparison.Ordinal)
            ? CategoryChanged.InvokeAsync(null)
            : Enum.TryParse<FileBrowserItemCategory>(value, out var category)
                ? CategoryChanged.InvokeAsync(category)
                : Task.CompletedTask;

    private Task HandleSortChangedAsync(string? value)
        => Enum.TryParse<FileBrowserSortField>(value, out var field)
            ? SortChanged.InvokeAsync(field)
            : Task.CompletedTask;

    private Task ReverseSortAsync() => SortDirectionReversed.InvokeAsync();

    private Task HandleIncludeDescendantsChangedAsync(bool value)
        => IncludeDescendantsChanged.InvokeAsync(value);

    private static string FormatScope(FileBrowserSearchScope scope)
        => scope switch
        {
            FileBrowserSearchScope.LoadedFolder => "This loaded folder",
            FileBrowserSearchScope.LoadedDescendants => "Loaded descendants",
            FileBrowserSearchScope.Provider => "All source items",
            _ => "Progressive deep search"
        };

    private static string FormatSort(FileBrowserSortField field)
        => field switch
        {
            FileBrowserSortField.ModifiedAt => "Modified",
            _ => field.ToString()
        };
}
