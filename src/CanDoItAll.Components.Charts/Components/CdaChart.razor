@namespace CanDoItAll.Components.Charts
@using ApexCharts
@implements IDisposable

@if (!HasRenderableData)
{
    <div @attributes="AdditionalAttributes" data-cda-chart-state="empty" class="@ShellClass" style="@Style" role="figure" aria-label="@ResolvedAriaLabel">
        @RenderHeading()

        <div class="flex min-h-48 items-center justify-center rounded-lg border border-dashed border-slate-300 bg-slate-50/70 p-6 text-center text-sm text-slate-500">
            <div class="max-w-prose space-y-1">
                <p class="font-semibold text-slate-700">@EmptyText</p>
            </div>
        </div>
    </div>
}
else
{
    <div @attributes="AdditionalAttributes" data-cda-chart-state="ready" class="@ShellClass" style="@Style" role="figure" aria-label="@ResolvedAriaLabel">
        @RenderHeading()

        <div class="min-w-0 overflow-hidden" aria-hidden="true">
            <ApexChart @ref="_chart"
                       TItem="CdaChartPoint"
                       Height="@Height"
                       Options="@_apexOptions">
                @foreach (var chartSeries in _renderSeries)
                {
                    <ApexPointSeries TItem="CdaChartPoint"
                                     Items="@chartSeries.Points"
                                     Name="@chartSeries.Name"
                                     Hidden="@(chartSeries.Hidden ? true : null)"
                                     SeriesType="@ResolveSeriesType(chartSeries)"
                                     XValue="point => point.XValue"
                                     YValue="point => (decimal?)point.Value"
                                     Color="@chartSeries.Color"
                                     PointColor="point => ResolvePointColor(chartSeries, point)"
                                     Stroke="@BuildSeriesStroke(chartSeries)"
                                     ShowDataLabels="@ResolveDataLabels(chartSeries)" />
                }
            </ApexChart>
        </div>
        <div class="sr-only">@ResolvedAccessibleSummary</div>
    </div>
}

@code {
    private ApexChart<CdaChartPoint>? _chart;
    private ApexChartOptions<CdaChartPoint> _apexOptions = new();
    private IReadOnlyList<CdaChartSeries> _renderSeries = [];

    /// <summary>Heading rendered above the chart. Omitted entirely when both this and <see cref="Description"/> are empty.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Supporting sentence rendered under <see cref="Title"/>.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>Accessible name for the chart's <c>role="figure"</c> container. Falls back to <see cref="Title"/>, then <c>"Chart"</c>.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Screen-reader-only text summarizing the series. A per-series min/max summary is generated automatically when omitted.</summary>
    [Parameter]
    public string? AccessibleSummary { get; set; }

    /// <summary>The series to plot. Series with no points are dropped before rendering.</summary>
    [Parameter]
    public IReadOnlyList<CdaChartSeries> Series { get; set; } = [];

    /// <summary>Axis, legend, palette, and formatting configuration shared across every series.</summary>
    [Parameter]
    public CdaChartOptions Options { get; set; } = new();

    /// <summary>Chart height, passed through to the underlying ApexCharts instance as-is.</summary>
    [Parameter]
    public object Height { get; set; } = 320;

    /// <summary>Message shown in the placeholder surface when no series has renderable points.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "No chart data.";

    /// <summary>Additional CSS class merged onto the root element.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Inline style applied to the root element.</summary>
    [Parameter]
    public string? Style { get; set; }

    /// <summary>Additional HTML attributes splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasRenderableData => _renderSeries.Any(series => series.Points.Count > 0);

    private string ResolvedAriaLabel => !string.IsNullOrWhiteSpace(AriaLabel)
        ? AriaLabel
        : !string.IsNullOrWhiteSpace(Title) ? Title : "Chart";

    private string ResolvedAccessibleSummary => !string.IsNullOrWhiteSpace(AccessibleSummary)
        ? AccessibleSummary
        : string.Join(
            " ",
            _renderSeries.Select(series =>
                $"{series.Name}: {series.Points.Count} points, minimum {series.Points.Min(point => point.Value)}, maximum {series.Points.Max(point => point.Value)}."));

    private string ShellClass => string.Join(
        ' ',
        new[]
        {
            "min-w-0 w-full overflow-hidden rounded-lg border border-slate-200 bg-white p-4 shadow-sm",
            Class
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private RenderFragment RenderHeading() => builder =>
    {
        if (string.IsNullOrWhiteSpace(Title) && string.IsNullOrWhiteSpace(Description))
        {
            return;
        }

        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "mb-3 min-w-0 space-y-1");

        if (!string.IsNullOrWhiteSpace(Title))
        {
            builder.OpenElement(sequence++, "h3");
            builder.AddAttribute(sequence++, "class", "break-words text-base font-semibold text-slate-950");
            builder.AddContent(sequence++, Title);
            builder.CloseElement();
        }

        if (!string.IsNullOrWhiteSpace(Description))
        {
            builder.OpenElement(sequence++, "p");
            builder.AddAttribute(sequence++, "class", "break-words text-sm text-slate-600");
            builder.AddContent(sequence++, Description);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    protected override void OnParametersSet()
    {
        Options ??= new CdaChartOptions();
        _renderSeries = NormalizeSeries(Series);
        _apexOptions = CdaApexChartOptionsFactory.Build(Options, _renderSeries, null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chart is null || !HasRenderableData)
        {
            return;
        }

        if (!firstRender)
        {
            await _chart.UpdateSeriesAsync(Options.Animate);
            await _chart.UpdateOptionsAsync(true, Options.Animate, true);
        }
    }

    private static IReadOnlyList<CdaChartSeries> NormalizeSeries(IReadOnlyList<CdaChartSeries>? series)
    {
        return series?
            .Where(item => item.Points.Count > 0)
            .Select(item => item with { Points = item.Points.ToArray() })
            .ToArray() ?? [];
    }

    private SeriesType ResolveSeriesType(CdaChartSeries chartSeries)
    {
        return CdaApexChartOptionsFactory.ResolveSeriesType(chartSeries.Type ?? Options.Type);
    }

    private bool ResolveDataLabels(CdaChartSeries chartSeries)
    {
        return chartSeries.ShowDataLabels ?? Options.ShowDataLabels;
    }

    private string? ResolvePointColor(CdaChartSeries chartSeries, CdaChartPoint point)
    {
        return point.Color ?? chartSeries.PointColorSelector?.Invoke(point);
    }

    private SeriesStroke? BuildSeriesStroke(CdaChartSeries chartSeries)
    {
        if (chartSeries.StrokeWidth is null && chartSeries.StrokeDash <= 0 && string.IsNullOrWhiteSpace(chartSeries.Color))
        {
            return null;
        }

        return new SeriesStroke
        {
            Color = chartSeries.Color ?? "#64748b",
            DashSpace = Math.Max(0, chartSeries.StrokeDash),
            Width = Math.Max(0, chartSeries.StrokeWidth ?? Options.StrokeWidth)
        };
    }

    public void Dispose()
    {
        _chart?.Dispose();
    }
}
