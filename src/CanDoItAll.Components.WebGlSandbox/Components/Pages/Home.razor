@namespace CanDoItAll.Components.WebGlSandbox.Components.Pages
@page "/"

<PageTitle>WebGL Sandbox</PageTitle>

<div class="webgl-page">
    <PageScaffold MaxWidthClass="max-w-[1180px]">
        <Header>
            <PageHeader Eyebrow="Generic WebGL" Title="Symbolic scene sandbox" Description="A focused proof host for reusable WebGlLib scene contracts, runtime assets, and browser validation." />
        </Header>
        <ChildContent>
            <div class="webgl-home-grid">
                <a class="webgl-route-card" href="/tycoon-village">
                    <span class="webgl-route-card__eyebrow">Main proof</span>
                    <span class="webgl-route-card__title">Tycoon Village</span>
                    <span class="webgl-route-card__body">Render buildings, props, agents, status symbols, selection, camera commands, and proof snapshots.</span>
                </a>
                <a class="webgl-route-card" href="/run-playback">
                    <span class="webgl-route-card__eyebrow">Run layer</span>
                    <span class="webgl-route-card__title">Run Play</span>
                    <span class="webgl-route-card__body">Exercise generic action playback, frame stepping, ordered command batches, and scene proof snapshots.</span>
                </a>
                <a class="webgl-route-card" href="/performance-proof">
                    <span class="webgl-route-card__eyebrow">Profiler-lite</span>
                    <span class="webgl-route-card__title">Performance</span>
                    <span class="webgl-route-card__body">Inspect frame timing, command batch, motion queue, asset cache, and link diagnostics for a generic scene.</span>
                </a>
                <a class="webgl-route-card" href="/asset-catalog">
                    <span class="webgl-route-card__eyebrow">Assets</span>
                    <span class="webgl-route-card__title">Asset Catalog</span>
                    <span class="webgl-route-card__body">Inspect logical asset ids, GLB mappings, primitive fallbacks, tags, and source metadata.</span>
                </a>
            </div>
        </ChildContent>
    </PageScaffold>
</div>

