@namespace CanDoItAll.Components.WebGlSandbox.Components.Pages
@page "/run-playback"

<PageTitle>WebGL Run Playback</PageTitle>

<div class="webgl-page webgl-page--fill">
    <PageScaffold MaxWidthClass="max-w-full" FillHeight="true">
        <Header>
            <PageHeader Eyebrow="Generic run layer" Title="Run Playback" Description="Domain-neutral frame playback over WebGL scene patches.">
                <Actions>
                    <Button Text="Play" Icon="play_arrow" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Click="@PlayAsync" />
                    <Button Text="Pause" Icon="pause" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Click="@PauseAsync" />
                    <Button Text="Step" Icon="skip_next" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Click="@StepAsync" />
                    <Button Text="Seek start" Icon="first_page" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Click="@SeekStartAsync" />
                    <Button Text="Snapshot" Icon="photo_camera" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Click="@CaptureProofAsync" />
                </Actions>
            </PageHeader>
        </Header>
        <ChildContent>
            <div class="webgl-village-workspace">
                <section class="webgl-village-stage" data-testid="webgl-run-playback-stage">
                    <WebGlSceneView @ref="sceneView"
                                    Scene="@scene"
                                    Options="@runtimeOptions"
                                    AriaLabel="Generic WebGL run playback scene"
                                    MotionCompleted="@HandleMotionCompleted" />
                </section>

                <aside class="webgl-village-panel" aria-label="Run playback inspector">
                    <section class="webgl-panel-section">
                        <div class="webgl-panel-heading">
                            <span>Playback</span>
                            <StatusBadge Text="@PlaybackStatus" Tone="@PlaybackTone" />
                        </div>
                        <dl class="webgl-proof-grid">
                            <div>
                                <dt>Frame</dt>
                                <dd data-testid="webgl-run-frame">@playbackState.CurrentFrameIndex</dd>
                            </div>
                            <div>
                                <dt>Playing</dt>
                                <dd data-testid="webgl-run-playing">@playbackState.IsPlaying</dd>
                            </div>
                            <div>
                                <dt>Renders</dt>
                                <dd data-testid="webgl-run-render-count">@latestSnapshot?.RenderCount</dd>
                            </div>
                            <div>
                                <dt>Motions</dt>
                                <dd>@latestSnapshot?.ActiveMotionCount</dd>
                            </div>
                        </dl>
                        <p class="webgl-proof-note" data-testid="webgl-run-status">@statusText</p>
                    </section>

                    <section class="webgl-panel-section">
                        <div class="webgl-panel-heading">
                            <span>Timeline</span>
                            <StatusBadge Text="@($"{runDocument.Timeline.Frames.Count} frames")" Tone="info" />
                        </div>
                        <div class="webgl-object-list">
                            @foreach (var frame in runDocument.Timeline.Frames)
                            {
                                <button type="button"
                                        class="@(playbackState.CurrentFrameIndex == frame.Index ? "webgl-object-list__item is-active" : "webgl-object-list__item")"
                                        @onclick="() => SeekAsync(frame.Index)">
                                    <span>Frame @frame.Index</span>
                                    <small>@frame.TimeSeconds.ToString("0.0")s</small>
                                </button>
                            }
                        </div>
                    </section>
                </aside>
            </div>
        </ChildContent>
    </PageScaffold>
</div>
