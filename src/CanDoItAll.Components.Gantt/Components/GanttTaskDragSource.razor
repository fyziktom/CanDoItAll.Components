@namespace CanDoItAll.Components.Gantt
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div @ref="dragElement"
     class="cda-gantt-drag-source @(Disabled ? "cda-gantt-drag-source--disabled" : null) @Class"
     role="group"
     aria-disabled="@Disabled"
     aria-label="@ResolvedAriaLabel">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <Pill Text="@Task.Title" Tone="PillTone.Info" />
    }
</div>

@code {
    private ElementReference dragElement;
    private IJSObjectReference? registration;
    private string payload = string.Empty;
    private (string Payload, string DataFormat)? registeredKey;
    private readonly SemaphoreSlim registrationGate = new(1, 1);
    private bool disposed;

    /// <summary>The task offered for insertion when this element is dragged onto a <see cref="GanttChart"/> dependency bridge.</summary>
    [Parameter, EditorRequired]
    public GanttTask Task { get; set; } = default!;

    /// <summary>Custom drag handle content. Falls back to a <c>Pill</c> showing <see cref="Task"/>'s title when omitted.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Disables the drag interaction, for example after the task has already been accepted by the host.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Must match the target <see cref="GanttChart.DragDataFormat"/> for the drop to be recognized.</summary>
    [Parameter]
    public string DragDataFormat { get; set; } = GanttTaskDragSerialization.DataFormat;

    /// <summary>Accessible name for the drag handle. Defaults to a generated label naming <see cref="Task"/>.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Additional CSS class merged onto the root element.</summary>
    [Parameter]
    public string? Class { get; set; }

    private string ResolvedAriaLabel => AriaLabel ?? $"Drag {Task.Title} into the Gantt chart";

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Task);
        if (string.IsNullOrWhiteSpace(DragDataFormat))
        {
            throw new ArgumentException("A Gantt drag data format is required.", nameof(DragDataFormat));
        }

        payload = GanttTaskDragSerialization.Serialize(Task);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (disposed) {
            return;
        }
        await registrationGate.WaitAsync();
        try {
            if (disposed || !Disabled && registeredKey == (payload, DragDataFormat)) {
                return;
            }
            await DisposeRegistrationAsync();
            if (disposed || Disabled) {
                return;
            }
            var registrationKey = (Payload: payload, DataFormat: DragDataFormat);
            registration = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "CanDoItAll.ganttChart.registerDragSource",
                dragElement,
                registrationKey.Payload,
                registrationKey.DataFormat);
            registeredKey = registrationKey;
        } finally {
            registrationGate.Release();
        }
    }

    public async ValueTask DisposeAsync() {
        if (disposed) {
            return;
        }
        disposed = true;
        await registrationGate.WaitAsync();
        try {
            await DisposeRegistrationAsync();
        } finally {
            registrationGate.Release();
            GC.SuppressFinalize(this);
        }
    }

    private async ValueTask DisposeRegistrationAsync() {
        var ownedRegistration = registration;
        registration = null;
        registeredKey = null;
        if (ownedRegistration is null) {
            return;
        }
        try {
            await ownedRegistration.InvokeVoidAsync("dispose");
        } catch (JSDisconnectedException) {
        } finally {
            try {
                await ownedRegistration.DisposeAsync();
            } catch (JSDisconnectedException) {
            }
        }
    }
}
