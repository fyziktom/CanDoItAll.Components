{
  "name": "candoitall-components",
  "version": "0.1.0",
  "private": true,
  "description": "Shared CanDoItAll Blazor component libraries, sandbox, assets, and package build scripts.",
  "scripts": {
    "assets:test-generated-text": "node --test tools/assets/generated-text.test.cjs",
    "assets:verify": "npm run assets:test-generated-text && npm run canvaslib:verify-assets && npm run webgllib:verify-assets",
    "canvaslib:build-assets": "node tools/canvaslib/build-assets.cjs",
    "canvaslib:verify-assets": "node tools/canvaslib/verify-assets.cjs",
    "gantt:test-routing": "node tools/gantt/test-routing.cjs",
    "gantt:test-grid": "node tools/gantt/test-grid.cjs",
    "components-usage": "node tools/components-usage/components-usage.cjs",
    "webgllib:build-assets": "node tools/webgllib/build-assets.cjs",
    "webgllib:verify-assets": "node tools/webgllib/verify-assets.cjs",
    "webgllib:inventory-glb": "node tools/webgllib/inventory-glb-assets.cjs",
    "webgllib:model-diagnostics": "node tools/webgllib/export-model-diagnostics.cjs",
    "webgllib:audit-scene-runtime": "node tools/webgllib/audit-scene-runtime.cjs",
    "webgllib:audit-scene-runtime-imports": "node tools/webgllib/audit-scene-runtime-imports.cjs",
    "webgllib:audit-boundary": "node tools/webgllib/audit-webgllib-boundary.cjs",
    "webglrunlib:audit-boundary": "node tools/webgllib/audit-webglrunlib-boundary.cjs",
    "webgllib:test-resource-ownership": "node tools/webgllib/test-resource-ownership.mjs",
    "webgllib:audit-large-scene-performance": "node tools/webgllib/audit-large-scene-performance.cjs",
    "webgllib:audit-command-batch-parity": "node tools/webgllib/audit-command-batch-parity.cjs",
    "webgllib:audit-motion-queue": "node tools/webgllib/audit-motion-queue.cjs",
    "webgllib:audit-stage-runner": "node tools/webgllib/audit-stage-runner.cjs",
    "webgllib:test-runtime-idle-policy": "node tools/webgllib/test-runtime-idle-policy.mjs",
    "webgllib:test-command-batch-runtime-idle-policy": "node tools/webgllib/test-command-batch-runtime-idle-policy.cjs",
    "webgl:validate-rc": "powershell -ExecutionPolicy Bypass -File scripts/validate-webgl-rc.ps1",
    "build:tailwind": "npm --prefix Tailwind run build",
    "build:sandbox-wasm-static": "npm run build:tailwind && node -e \"require('node:fs').rmSync('artifacts/sandbox-wasm-publish', { recursive: true, force: true })\" && dotnet publish ./samples/CanDoItAll.Components.SandboxWasm/CanDoItAll.Components.SandboxWasm.csproj --configuration Release --property:CompressionEnabled=false --output ./artifacts/sandbox-wasm-publish",
    "serve:sandbox-wasm-static": "npx http-server ./artifacts/sandbox-wasm-publish/wwwroot -c-1 -s -o",
    "deploy:sandbox-wasm-gh-pages": "npm run build:sandbox-wasm-static && gh-pages --dist ./artifacts/sandbox-wasm-publish/wwwroot --branch gh-pages --dotfiles",
    "watch:tailwind": "npm --prefix Tailwind run watch",
    "watch:sandbox": "dotnet watch --project ./samples/CanDoItAll.Components.Sandbox",
    "watch:sandbox-wasm": "dotnet watch --project ./samples/CanDoItAll.Components.SandboxWasm",
    "watch:sandbox-wasm:release": "dotnet watch -c Release --project ./samples/CanDoItAll.Components.SandboxWasm",
    "screenshots": "node tools/screenshots/snapshot.cjs",
    "screenshots:capture": "node tools/screenshots/capture.cjs",
    "screenshots:diff": "node tools/screenshots/diff.cjs",
    "screenshots:report": "node tools/screenshots/report.cjs",
    "screenshots:store": "node tools/screenshots/store.cjs",
    "screenshots:prune": "node tools/screenshots/prune.cjs",
    "build": "dotnet build CanDoItAll.Components.slnx",
    "pack": "powershell -ExecutionPolicy Bypass -File tools/deployment/nugets/Build-NuGets.ps1"
  },
  "type": "commonjs",
  "license": "MIT",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "material-symbols": "^0.45.10",
    "mustache": "^4.2.0",
    "odiff-bin": "^4.5.0",
    "playwright": "^1.60.0",
    "three": "^0.184.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
